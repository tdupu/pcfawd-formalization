/-!
# The other-branch component of the bounding correction

This is the `B ∩ Z` part of Step 0 in `paper-p.tex`, Theorem
`thm:bounding`. The closed set `Z` is generated by the weighted branch
divisors other than the image divisor `B`. Its intersection with the
original reduced `B` is proper closed and contains only finitely many
integral effective divisors of `B`.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace

namespace Pcf

universe u
noncomputable section

set_option linter.style.haveILetI false

/-- The manuscript's `Z`: the closed union of the weighted branch
components other than the image divisor `B`, expressed through their
generic points on the original target. -/
def paperPBoundingOtherBranch
    {X Y : Scheme.{u}} (f : X ⟶ Y)
    [IsFinite f] [IsDominant f]
    [IsIntegral X] [IsIntegral Y]
    [IsLocallyNoetherian X] [IsLocallyNoetherian Y]
    [IsFinite (Palomar.normalizationMap X)]
    [IsFinite (Palomar.normalizationMap Y)]
    (B : SchemeDivisorPoint Y) : Set Y :=
  closure {y | y ∈ weightedBranchPointSet f ∧ y ≠ B.1}

/-- No codimension-one point lies in the closed union of distinct
codimension-one point closures. Applied below to the image divisor. -/
theorem schemeDivisorPoint_notMem_closure_other_finite_divisors
    {Y : Scheme.{u}} (B : SchemeDivisorPoint Y)
    (S : Set Y) (hS : S.Finite)
    (hcodim : ∀ y ∈ S, Order.coheight y = 1)
    (hother : B.1 ∉ S) : B.1 ∉ closure S := by
  have hcl : closure S = ⋃ y ∈ S, closure ({y} : Set Y) := by
    calc
      closure S = closure (⋃ y ∈ S, ({y} : Set Y)) := by rw [Set.biUnion_of_singleton]
      _ = _ := hS.closure_biUnion _
  rw [hcl]
  simp only [Set.mem_iUnion]
  rintro ⟨y, hy, hmem⟩
  let E : SchemeDivisorPoint Y := ⟨y, hcodim y hy⟩
  have hne : E ≠ B := by
    intro h
    exact hother (congrArg Subtype.val h ▸ hy)
  exact (SchemeDivisorPoint.notMem_closure_of_ne B E hne) hmem

/-- The closed set defined by excluding the generic point of `B` is
literally the union of the manuscript's other irreducible branch
components.

`paper-p.tex` correspondence: Definition 7.4 (`def:bounding-data`). -/
theorem paperPBoundingOtherBranch_eq_other_components
    (k : Type u) [Field k]
    {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [IsLocallyNoetherian X] [IsLocallyNoetherian Y]
    [NoetherianSpace X]
    [IsFinite (Palomar.normalizationMap X)]
    [IsFinite (Palomar.normalizationMap Y)]
    (s : Y ⟶ Spec (.of k)) [LocallyOfFiniteType s]
    (f : X ⟶ Y) [IsFinite f] [IsDominant f]
    (hsep : IsGenericallySeparableSchemeMap f)
    (B : SchemeDivisorPoint Y) :
    paperPBoundingOtherBranch f B =
      ⋃₀ {D : Set Y | D ∈ relativeIrreducibleComponents (weightedBranchLocus f) ∧
        D ≠ closure ({B.1} : Set Y)} := by
  have hfin : (weightedBranchPointSet f).Finite := by
    rw [weightedBranchPointSet_eq_image_criticalPointSet]
    exact (weightedCriticalPointSet_finite_of_lift_genericallySeparable f
      (isGenericallySeparable_schemeGlobalNormalizationMorphism f hsep)).image f
  let S : Set Y := {y | y ∈ weightedBranchPointSet f ∧ y ≠ B.1}
  have hS : S.Finite := hfin.subset (fun y hy ↦ hy.1)
  have hcl : paperPBoundingOtherBranch f B =
      ⋃ y ∈ S, closure ({y} : Set Y) := by
    change closure S = _
    calc
      closure S = closure (⋃ y ∈ S, ({y} : Set Y)) := by rw [Set.biUnion_of_singleton]
      _ = _ := hS.closure_biUnion _
  rw [hcl]
  ext z
  simp only [Set.mem_iUnion, Set.mem_sUnion, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨y, hy, hz⟩
    refine ⟨closure ({y} : Set Y), ?_, hz⟩
    constructor
    · rw [weightedBranchLocus_components k s f hsep]
      exact ⟨y, hy.1, rfl⟩
    · intro heq
      have hgen : IsGenericPoint B.1 (closure ({y} : Set Y)) :=
        heq.symm ▸ (isGenericPoint_closure :
          IsGenericPoint B.1 (closure ({B.1} : Set Y)))
      exact hy.2 ((isGenericPoint_closure :
        IsGenericPoint y (closure ({y} : Set Y))).eq hgen)
  · rintro ⟨D, ⟨hD, hDne⟩, hz⟩
    rw [weightedBranchLocus_components k s f hsep] at hD
    obtain ⟨y, hy, rfl⟩ := hD
    refine ⟨y, ⟨hy, ?_⟩, hz⟩
    intro heq
    subst y
    exact hDne rfl

/-- The image divisor is outside the other branch components for any
generically separable finite cover. This is the geometric core of
`B ⊄ Z` in Step 0 of `thm:bounding`. -/
theorem paperPBoundingOtherBranch_avoids_of_separable
    (k : Type u) [Field k]
    {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [IsLocallyNoetherian X] [IsLocallyNoetherian Y]
    [NoetherianSpace X]
    [IsFinite (Palomar.normalizationMap X)]
    [IsFinite (Palomar.normalizationMap Y)]
    (s : Y ⟶ Spec (.of k)) [LocallyOfFiniteType s]
    (f : X ⟶ Y) [IsFinite f] [IsDominant f]
    (hsep : IsGenericallySeparableSchemeMap f)
    (B : SchemeDivisorPoint Y) :
    B.1 ∉ paperPBoundingOtherBranch f B := by
  have hfin : (weightedBranchPointSet f).Finite := by
    rw [weightedBranchPointSet_eq_image_criticalPointSet]
    exact (weightedCriticalPointSet_finite_of_lift_genericallySeparable f
      (isGenericallySeparable_schemeGlobalNormalizationMorphism f hsep)).image f
  let S : Set Y := {y | y ∈ weightedBranchPointSet f ∧ y ≠ B.1}
  have hS : S.Finite := hfin.subset (fun y hy ↦ hy.1)
  have hcodim : ∀ y ∈ S, Order.coheight y = 1 :=
    fun y hy ↦ weightedBranchPointSet_coheight_one k s f hy.1
  have hother : B.1 ∉ S := fun h ↦ h.2 rfl
  exact schemeDivisorPoint_notMem_closure_other_finite_divisors
    B S hS hcodim hother

/-- The prime-to-`p` case of `B ⊄ Z`, with all normalization-finiteness
instances derived from the finite-type variety hypotheses. -/
theorem paperPBoundingOtherBranch_avoids_image_divisor
    (p : ℕ) (_hp : p.Prime) (k : Type u) [Field k] [CharP k p]
    {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [IsNormalScheme X] [IsNormalScheme Y]
    [IsLocallyNoetherian X] [IsLocallyNoetherian Y]
    [NoetherianSpace X] [NoetherianSpace Y]
    (s : Y ⟶ Spec (.of k)) [LocallyOfFiniteType s]
    (f : X ⟶ Y) [IsFinite f] [IsDominant f]
    (hmono : IsPrimeToPMonodromyMap p f)
    (A : SchemeDivisorPoint X) :
    letI : IsFinite (Palomar.normalizationMap X) :=
      schemeGlobalNormalizationMap_isFinite X k (f ≫ s)
    letI : IsFinite (Palomar.normalizationMap Y) :=
      schemeGlobalNormalizationMap_isFinite Y k s
    (A.mapFiniteDominantNormal f).1 ∉
      paperPBoundingOtherBranch f (A.mapFiniteDominantNormal f) := by
  letI : IsFinite (Palomar.normalizationMap X) :=
    schemeGlobalNormalizationMap_isFinite X k (f ≫ s)
  letI : IsFinite (Palomar.normalizationMap Y) :=
    schemeGlobalNormalizationMap_isFinite Y k s
  exact paperPBoundingOtherBranch_avoids_of_separable k s f
    (isGenericallySeparableSchemeMap_of_primeToPMonodromyMap p f hmono)
    (A.mapFiniteDominantNormal f)

/-- The same other-branch avoidance in characteristic zero. -/
theorem paperPBoundingOtherBranch_avoids_image_divisor_charZero
    (k : Type u) [Field k] [CharZero k]
    {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [IsNormalScheme X] [IsNormalScheme Y]
    [IsLocallyNoetherian X] [IsLocallyNoetherian Y]
    [NoetherianSpace X] [NoetherianSpace Y]
    (s : Y ⟶ Spec (.of k)) [LocallyOfFiniteType s]
    (f : X ⟶ Y) [IsFinite f] [IsDominant f]
    (A : SchemeDivisorPoint X) :
    letI : IsFinite (Palomar.normalizationMap X) :=
      schemeGlobalNormalizationMap_isFinite X k (f ≫ s)
    letI : IsFinite (Palomar.normalizationMap Y) :=
      schemeGlobalNormalizationMap_isFinite Y k s
    (A.mapFiniteDominantNormal f).1 ∉
      paperPBoundingOtherBranch f (A.mapFiniteDominantNormal f) := by
  letI : IsFinite (Palomar.normalizationMap X) :=
    schemeGlobalNormalizationMap_isFinite X k (f ≫ s)
  letI : IsFinite (Palomar.normalizationMap Y) :=
    schemeGlobalNormalizationMap_isFinite Y k s
  exact paperPBoundingOtherBranch_avoids_of_separable k s f
    (PaperPTower.genericallySeparable_of_finite_charZero k s f)
    (A.mapFiniteDominantNormal f)

/-- The actual `B ∩ Z` correction is proper closed on the original reduced
image divisor and contains only finitely many of its integral effective
divisors. No regular-locus closedness theorem is used in this term. -/
theorem paperPBoundingOtherBranch_intersection_finite_of_separable
    (k : Type u) [Field k]
    {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [IsLocallyNoetherian X] [IsLocallyNoetherian Y]
    [NoetherianSpace X] [NoetherianSpace Y]
    [IsFinite (Palomar.normalizationMap X)]
    [IsFinite (Palomar.normalizationMap Y)]
    (s : Y ⟶ Spec (.of k)) [LocallyOfFiniteType s]
    (f : X ⟶ Y) [IsFinite f] [IsDominant f]
    (hsep : IsGenericallySeparableSchemeMap f)
    (B : SchemeDivisorPoint Y) :
    let I := pointClosureIdealSheaf B.1
    let Sigma : Set I.subscheme := I.subschemeι ⁻¹'
      paperPBoundingOtherBranch f B
    IsClosed Sigma ∧ Sigma ≠ Set.univ ∧
      {Q : SchemeDivisorPoint I.subscheme |
        closure ({Q.1} : Set I.subscheme) ⊆ Sigma}.Finite := by
  let I := pointClosureIdealSheaf B.1
  let Z := paperPBoundingOtherBranch f B
  let Sigma : Set I.subscheme := I.subschemeι ⁻¹' Z
  have hnot : B.1 ∉ Z := paperPBoundingOtherBranch_avoids_of_separable k s f hsep B
  have hc : IsClosed Sigma := isClosed_closure.preimage I.subschemeι.continuous
  have hproper : Sigma ≠ Set.univ := by
    intro h
    have hg : genericPoint I.subscheme ∈ Sigma := h ▸ Set.mem_univ _
    change I.subschemeι (genericPoint I.subscheme) ∈ Z at hg
    rw [pointClosureSubscheme_genericPoint] at hg
    exact hnot hg
  exact ⟨hc, hproper,
    finite_schemeDivisorPoint_closure_subset_of_proper_closed Sigma hc hproper⟩

/-- The source-facing positive-characteristic `B ∩ Z` correction. -/
theorem paperPBoundingOtherBranch_intersection_finite
    (p : ℕ) (_hp : p.Prime) (k : Type u) [Field k] [CharP k p]
    {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [IsNormalScheme X] [IsNormalScheme Y]
    [IsLocallyNoetherian X] [IsLocallyNoetherian Y]
    [NoetherianSpace X] [NoetherianSpace Y]
    (s : Y ⟶ Spec (.of k)) [LocallyOfFiniteType s]
    (f : X ⟶ Y) [IsFinite f] [IsDominant f]
    (hmono : IsPrimeToPMonodromyMap p f)
    (A : SchemeDivisorPoint X) :
    letI : IsFinite (Palomar.normalizationMap X) :=
      schemeGlobalNormalizationMap_isFinite X k (f ≫ s)
    letI : IsFinite (Palomar.normalizationMap Y) :=
      schemeGlobalNormalizationMap_isFinite Y k s
    let B := A.mapFiniteDominantNormal f
    let I := pointClosureIdealSheaf B.1
    let Sigma : Set I.subscheme := I.subschemeι ⁻¹'
      paperPBoundingOtherBranch f B
    IsClosed Sigma ∧ Sigma ≠ Set.univ ∧
      {Q : SchemeDivisorPoint I.subscheme |
        closure ({Q.1} : Set I.subscheme) ⊆ Sigma}.Finite := by
  letI : IsFinite (Palomar.normalizationMap X) :=
    schemeGlobalNormalizationMap_isFinite X k (f ≫ s)
  letI : IsFinite (Palomar.normalizationMap Y) :=
    schemeGlobalNormalizationMap_isFinite Y k s
  exact paperPBoundingOtherBranch_intersection_finite_of_separable k s f
    (isGenericallySeparableSchemeMap_of_primeToPMonodromyMap p f hmono)
    (A.mapFiniteDominantNormal f)

/-- The same `B ∩ Z` correction in characteristic zero. -/
theorem paperPBoundingOtherBranch_intersection_finite_charZero
    (k : Type u) [Field k] [CharZero k]
    {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [IsNormalScheme X] [IsNormalScheme Y]
    [IsLocallyNoetherian X] [IsLocallyNoetherian Y]
    [NoetherianSpace X] [NoetherianSpace Y]
    (s : Y ⟶ Spec (.of k)) [LocallyOfFiniteType s]
    (f : X ⟶ Y) [IsFinite f] [IsDominant f]
    (A : SchemeDivisorPoint X) :
    letI : IsFinite (Palomar.normalizationMap X) :=
      schemeGlobalNormalizationMap_isFinite X k (f ≫ s)
    letI : IsFinite (Palomar.normalizationMap Y) :=
      schemeGlobalNormalizationMap_isFinite Y k s
    let B := A.mapFiniteDominantNormal f
    let I := pointClosureIdealSheaf B.1
    let Sigma : Set I.subscheme := I.subschemeι ⁻¹'
      paperPBoundingOtherBranch f B
    IsClosed Sigma ∧ Sigma ≠ Set.univ ∧
      {Q : SchemeDivisorPoint I.subscheme |
        closure ({Q.1} : Set I.subscheme) ⊆ Sigma}.Finite := by
  letI : IsFinite (Palomar.normalizationMap X) :=
    schemeGlobalNormalizationMap_isFinite X k (f ≫ s)
  letI : IsFinite (Palomar.normalizationMap Y) :=
    schemeGlobalNormalizationMap_isFinite Y k s
  exact paperPBoundingOtherBranch_intersection_finite_of_separable k s f
    (PaperPTower.genericallySeparable_of_finite_charZero k s f)
    (A.mapFiniteDominantNormal f)

/-- In characteristic zero, all three Step-0 corrections of
`thm:bounding` contain only finitely many divisor generic points of the
original reduced image divisor: the other-branch intersection and the two
actual stalk singular loci. This does not yet prove the pointwise étale
conclusion outside those points. -/
theorem paperPBoundingStepZero_badDivisors_finite_charZero
    (k : Type u) [Field k] [CharZero k]
    {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [IsNormalScheme X] [IsNormalScheme Y]
    [IsLocallyNoetherian X] [IsLocallyNoetherian Y]
    [NoetherianSpace X] [NoetherianSpace Y]
    (s : Y ⟶ Spec (.of k)) [LocallyOfFiniteType s]
    (f : X ⟶ Y) [IsFinite f] [IsDominant f]
    (A : SchemeDivisorPoint X) :
    letI : IsFinite (Palomar.normalizationMap X) :=
      schemeGlobalNormalizationMap_isFinite X k (f ≫ s)
    letI : IsFinite (Palomar.normalizationMap Y) :=
      schemeGlobalNormalizationMap_isFinite Y k s
    let B := A.mapFiniteDominantNormal f
    let I := pointClosureIdealSheaf B.1
    let Sigma : Set I.subscheme := I.subschemeι ⁻¹'
      paperPBoundingOtherBranch f B
    ({Q : SchemeDivisorPoint I.subscheme |
      closure ({Q.1} : Set I.subscheme) ⊆ Sigma} ∪
      invariantDivisorSing B).Finite := by
  letI : IsFinite (Palomar.normalizationMap X) :=
    schemeGlobalNormalizationMap_isFinite X k (f ≫ s)
  letI : IsFinite (Palomar.normalizationMap Y) :=
    schemeGlobalNormalizationMap_isFinite Y k s
  let B : SchemeDivisorPoint Y := A.mapFiniteDominantNormal f
  have hother :=
    (paperPBoundingOtherBranch_intersection_finite_charZero k s f A).2.2
  exact hother.union (invariantDivisorSing_finite_of_perfectField k s B)

/-- The manuscript's full exceptional set on the original reduced image divisor:
`(B ∩ Z) ∪ (B ∩ Sing Y) ∪ Sing B`. The singular loci are defined by the
regularity of the actual scheme stalks.

`paper-p.tex` correspondence: Theorem 7.5 (`thm:bounding`). -/
def paperPBoundingSigma
    {X Y : Scheme.{u}} (f : X ⟶ Y)
    [IsFinite f] [IsDominant f]
    [IsIntegral X] [IsIntegral Y]
    [IsLocallyNoetherian X] [IsLocallyNoetherian Y]
    [IsFinite (Palomar.normalizationMap X)]
    [IsFinite (Palomar.normalizationMap Y)]
    (B : SchemeDivisorPoint Y) :
    Set (pointClosureIdealSheaf B.1).subscheme :=
  let I := pointClosureIdealSheaf B.1
  I.subschemeι ⁻¹' paperPBoundingOtherBranch f B ∪
    I.subschemeι ⁻¹' stalkSingularLocus Y ∪
      stalkSingularLocus I.subscheme

/-- Properness of the exact exceptional set uses only normality in codimension
one and generic regularity of the reduced divisor. The positive-characteristic
regular-locus openness theorem is needed for *closedness*, not this part. -/
theorem paperPBoundingSigma_ne_univ_of_separable
    (k : Type u) [Field k]
    {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [IsLocallyNoetherian X] [IsLocallyNoetherian Y]
    [IsNormalScheme Y] [NoetherianSpace X]
    [IsFinite (Palomar.normalizationMap X)]
    [IsFinite (Palomar.normalizationMap Y)]
    (s : Y ⟶ Spec (.of k)) [LocallyOfFiniteType s]
    (f : X ⟶ Y) [IsFinite f] [IsDominant f]
    (hsep : IsGenericallySeparableSchemeMap f)
    (B : SchemeDivisorPoint Y) :
    paperPBoundingSigma f B ≠ Set.univ := by
  intro h
  have hmem : genericPoint (pointClosureIdealSheaf B.1).subscheme ∈
      paperPBoundingSigma f B := h.symm ▸ Set.mem_univ _
  change genericPoint (pointClosureIdealSheaf B.1).subscheme ∈
    (pointClosureIdealSheaf B.1).subschemeι ⁻¹' paperPBoundingOtherBranch f B ∪
      (pointClosureIdealSheaf B.1).subschemeι ⁻¹' stalkSingularLocus Y ∪
        stalkSingularLocus (pointClosureIdealSheaf B.1).subscheme at hmem
  rcases hmem with (hmem | hmem) | hmem
  · change (pointClosureIdealSheaf B.1).subschemeι
      (genericPoint (pointClosureIdealSheaf B.1).subscheme) ∈
        paperPBoundingOtherBranch f B at hmem
    rw [pointClosureSubscheme_genericPoint] at hmem
    exact (paperPBoundingOtherBranch_avoids_of_separable k s f hsep B) hmem
  · exact (genericPoint_notMem_ambient_stalkSingularLocus B) hmem
  · exact genericPoint_notMem_stalkSingularLocus hmem

/-- The full exceptional set is proper for the manuscript's positive-
characteristic prime-to-`p` finite normal cover, without any extra local
covering or regular-locus assumption. -/
theorem paperPBoundingSigma_ne_univ
    (p : ℕ) (_hp : p.Prime) (k : Type u) [Field k] [CharP k p]
    {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [IsNormalScheme X] [IsNormalScheme Y]
    [IsLocallyNoetherian X] [IsLocallyNoetherian Y]
    [NoetherianSpace X] [NoetherianSpace Y]
    (s : Y ⟶ Spec (.of k)) [LocallyOfFiniteType s]
    (f : X ⟶ Y) [IsFinite f] [IsDominant f]
    (hmono : IsPrimeToPMonodromyMap p f)
    (A : SchemeDivisorPoint X) :
    letI : IsFinite (Palomar.normalizationMap X) :=
      schemeGlobalNormalizationMap_isFinite X k (f ≫ s)
    letI : IsFinite (Palomar.normalizationMap Y) :=
      schemeGlobalNormalizationMap_isFinite Y k s
    paperPBoundingSigma f (A.mapFiniteDominantNormal f) ≠ Set.univ := by
  letI : IsFinite (Palomar.normalizationMap X) :=
    schemeGlobalNormalizationMap_isFinite X k (f ≫ s)
  letI : IsFinite (Palomar.normalizationMap Y) :=
    schemeGlobalNormalizationMap_isFinite Y k s
  exact paperPBoundingSigma_ne_univ_of_separable k s f
    (isGenericallySeparableSchemeMap_of_primeToPMonodromyMap p f hmono)
    (A.mapFiniteDominantNormal f)

/-- Under closedness of the two actual singular loci, the exact `Σ` is closed
and proper and therefore contains only finitely many divisor generic points.
The outstanding finite-type regular-locus theorem must discharge these two
closedness hypotheses for the unrestricted positive-characteristic result. -/
theorem paperPBoundingSigma_closed_proper_finite_of_singularClosed
    (k : Type u) [Field k]
    {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [IsLocallyNoetherian X] [IsLocallyNoetherian Y]
    [IsNormalScheme Y] [NoetherianSpace X] [NoetherianSpace Y]
    [IsFinite (Palomar.normalizationMap X)]
    [IsFinite (Palomar.normalizationMap Y)]
    (s : Y ⟶ Spec (.of k)) [LocallyOfFiniteType s]
    (f : X ⟶ Y) [IsFinite f] [IsDominant f]
    (hsep : IsGenericallySeparableSchemeMap f)
    (B : SchemeDivisorPoint Y)
    (hY : IsClosed (stalkSingularLocus Y))
    (hB : IsClosed (stalkSingularLocus (pointClosureIdealSheaf B.1).subscheme)) :
    IsClosed (paperPBoundingSigma f B) ∧
      paperPBoundingSigma f B ≠ Set.univ ∧
      {Q : SchemeDivisorPoint (pointClosureIdealSheaf B.1).subscheme |
        closure ({Q.1} : Set (pointClosureIdealSheaf B.1).subscheme) ⊆
          paperPBoundingSigma f B}.Finite := by
  have hclosed : IsClosed (paperPBoundingSigma f B) := by
    change IsClosed
      ((pointClosureIdealSheaf B.1).subschemeι ⁻¹' paperPBoundingOtherBranch f B ∪
        (pointClosureIdealSheaf B.1).subschemeι ⁻¹' stalkSingularLocus Y ∪
          stalkSingularLocus (pointClosureIdealSheaf B.1).subscheme)
    exact ((isClosed_closure.preimage
      (pointClosureIdealSheaf B.1).subschemeι.continuous).union
        (hY.preimage (pointClosureIdealSheaf B.1).subschemeι.continuous)).union hB
  have hproper := paperPBoundingSigma_ne_univ_of_separable k s f hsep B
  exact ⟨hclosed, hproper,
    finite_schemeDivisorPoint_closure_subset_of_proper_closed _ hclosed hproper⟩

