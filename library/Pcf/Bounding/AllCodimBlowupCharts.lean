module

public import Pcf.Bounding.AllCodimBlowupProj

/-!
# Affine Rees charts of the blow-up center

For `a ∈ I`, the standard affine blow-up chart has ring `R[I/a]`, the
subalgebra of `Rₐ` generated by the fractions `b/a` for `b ∈ I`.
The Rees-algebra evaluation `t ↦ a⁻¹` realizes this ring as the image of
the actual Rees algebra in `Rₐ`. This file constructs that ring and proves
its defining degree-one and inverted-generator identities.

This gives affine chart rings without yet identifying them with Mathlib's
`HomogeneousLocalization.Away` or gluing them into `Proj`.
-/

@[expose] public section

open Polynomial

namespace Pcf.Bounding.AllCodimBlowup

noncomputable section

universe u

variable {R : Type u} [CommRing R]

theorem awayMap_invSelf {S : Type*} [CommRing S]
    (f : R →+* S) (a : R) :
    Localization.awayMap f a (IsLocalization.Away.invSelf a) =
      IsLocalization.Away.invSelf (f a) := by
  simp [IsLocalization.Away.invSelf, Localization.awayMap,
    IsLocalization.Away.map, IsLocalization.map_mk']

/-- Evaluation of a Rees polynomial at `t=a⁻¹` in `Rₐ`. Its image is
the affine blow-up chart ring `R[I/a]`. -/
def reesChartEval (I : Ideal R) (a : I) :
    reesAlgebra I →ₐ[R] Localization.Away a.1 :=
  (Polynomial.aeval (IsLocalization.Away.invSelf a.1)).comp
    (Subalgebra.val (reesAlgebra I))

/-- The affine chart ring `R[I/a]`, realized as the image of the actual
Rees algebra in `Rₐ` under `t ↦ a⁻¹`. -/
def affineBlowupChart (I : Ideal R) (a : I) :
    Subalgebra R (Localization.Away a.1) :=
  (reesChartEval I a).range

/-- A homogeneous Rees monomial `b tⁿ` evaluates to `b/aⁿ` on the chart. -/
@[simp] theorem reesChartEval_monomial (I : Ideal R) (a : I)
    (n : ℕ) (b : R) (hb : b ∈ I ^ n) :
    reesChartEval I a
      ⟨monomial n b, reesAlgebra.monomial_mem.mpr hb⟩ =
      algebraMap R (Localization.Away a.1) b *
        IsLocalization.Away.invSelf a.1 ^ n := by
  simp [reesChartEval, Polynomial.aeval_monomial]

/-- The degree-one Rees element `a t` becomes `1` on its standard chart. -/
@[simp] theorem reesChartEval_center (I : Ideal R) (a : I) :
    reesChartEval I a
      ⟨monomial 1 a.1, reesAlgebra.monomial_mem.mpr (by simp)⟩ = 1 := by
  change (Polynomial.aeval (IsLocalization.Away.invSelf a.1)) (monomial 1 a.1) = 1
  simpa only [Polynomial.aeval_monomial, pow_one] using
    IsLocalization.Away.mul_invSelf a.1

/-- Each generator `b/a` with `b ∈ I` lies in the actual affine Rees
chart ring. -/
theorem ratio_mem_affineBlowupChart (I : Ideal R) (a b : I) :
    algebraMap R (Localization.Away a.1) b.1 *
      IsLocalization.Away.invSelf a.1 ∈ affineBlowupChart I a := by
  change _ ∈ (reesChartEval I a).range
  refine ⟨⟨monomial 1 b.1,
    reesAlgebra.monomial_mem.mpr (by simp)⟩, ?_⟩
  change (Polynomial.aeval (IsLocalization.Away.invSelf a.1)) (monomial 1 b.1) = _
  simp only [Polynomial.aeval_monomial, pow_one]

/-- The image of a chosen chart generator under a ring map is a generator
of the extended center. -/
def mappedCenterElement {S : Type*} [CommRing S]
    (f : R →+* S) (I : Ideal R) (a : I) : I.map f :=
  ⟨f a.1, Ideal.mem_map_of_mem f a.2⟩

/-- Evaluation of ordinary polynomials at the inverse chart coordinate
commutes with coefficientwise base change. -/
theorem awayMap_aeval {S : Type*} [CommRing S]
    (f : R →+* S) (a : R) (P : R[X]) :
    Localization.awayMap f a
      ((Polynomial.aeval (IsLocalization.Away.invSelf a)) P) =
      (Polynomial.aeval (IsLocalization.Away.invSelf (f a))) (P.map f) := by
  induction P using Polynomial.induction_on' with
  | add P Q ihP ihQ => simp only [Polynomial.map_add, map_add, ihP, ihQ]
  | monomial n b =>
      simp only [Polynomial.aeval_monomial, map_mul, map_pow, Polynomial.map_monomial,
        awayMap_invSelf]
      rw [Localization.awayMap, IsLocalization.Away.map, IsLocalization.map_eq]

/-- The Rees chart evaluation commutes with the actual map on Rees rings
under base change of the center. -/
theorem awayMap_reesChartEval {S : Type*} [CommRing S]
    (f : R →+* S) (I : Ideal R) (a : I) (P : reesAlgebra I) :
    Localization.awayMap f a.1 (reesChartEval I a P) =
      reesChartEval (I.map f) (mappedCenterElement f I a)
        (reesAlgebraMap f I P) := by
  change Localization.awayMap f a.1
      ((Polynomial.aeval (IsLocalization.Away.invSelf a.1)) P.1) =
    (Polynomial.aeval (IsLocalization.Away.invSelf (f a.1)))
      (Polynomial.mapRingHom f P.1)
  exact awayMap_aeval f a.1 P.1

/-- Base change of the center induces a ring homomorphism between the
actual affine blow-up chart rings `R[I/a] → S[(IS)/f(a)]`. -/
def affineBlowupChartMap {S : Type*} [CommRing S]
    (f : R →+* S) (I : Ideal R) (a : I) :
    affineBlowupChart I a →+*
      affineBlowupChart (I.map f) (mappedCenterElement f I a) :=
  ((Localization.awayMap f a.1).comp
    (Subalgebra.val (affineBlowupChart I a)).toRingHom).codRestrict
      (affineBlowupChart (I.map f) (mappedCenterElement f I a)) (by
        intro x
        obtain ⟨P, hP⟩ := x.2
        refine ⟨reesAlgebraMap f I P, ?_⟩
        exact (awayMap_reesChartEval f I a P).symm.trans
          (congrArg (Localization.awayMap f a.1) hP))

/-- On affine blow-up charts, the base-change map sends the class of a
Rees polynomial to the class of its coefficientwise image. -/
@[simp] theorem affineBlowupChartMap_rees (S : Type*) [CommRing S]
    (f : R →+* S) (I : Ideal R) (a : I) (P : reesAlgebra I) :
    affineBlowupChartMap f I a
      ⟨reesChartEval I a P, ⟨P, rfl⟩⟩ =
      ⟨reesChartEval (I.map f) (mappedCenterElement f I a)
        (reesAlgebraMap f I P),
        ⟨reesAlgebraMap f I P, rfl⟩⟩ := by
  apply Subtype.ext
  exact awayMap_reesChartEval f I a P

open CategoryTheory AlgebraicGeometry in
/-- The corresponding morphism between affine blow-up charts. -/
def affineBlowupChartSpecMap {S : Type u} [CommRing S]
    (f : R →+* S) (I : Ideal R) (a : I) :
    Spec (.of (affineBlowupChart (I.map f) (mappedCenterElement f I a))) ⟶
      Spec (.of (affineBlowupChart I a)) :=
  Spec.map (CommRingCat.ofHom (affineBlowupChartMap f I a))

end

end Pcf.Bounding.AllCodimBlowup
