module

public import Pcf.Bounding.AllCodimBlowupProjChart
public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor

/-!
# Graded base change of the Rees algebra

The coefficientwise Rees map is homogeneous for the natural grading. The
induced map on degree-zero localizations is the map underlying functoriality
of blow-ups and, eventually, the global closed-immersion comparison in
`latex/paper-p.tex`, proof of Theorem `thm:allcodim-normal`.
-/

@[expose] public section

open Polynomial

namespace Pcf.Bounding.AllCodimBlowup

noncomputable section

variable {R S : Type*} [CommRing R] [CommRing S]

/-- The coefficientwise map of Rees algebras preserves each homogeneous
degree. -/
def gradedReesMap (f : R →+* S) (I : Ideal R) :
    reesGrade I →+*ᵍ reesGrade (I.map f) where
  toRingHom := reesAlgebraMap f I
  map_mem := by
    intro n P hP
    have hmono := reesGrade_eq_monomial I n P hP
    have hc : P.1.coeff n ∈ I ^ n :=
      (mem_reesAlgebra_iff I P.1).mp P.2 n
    have htarget : (reesAlgebraMap f I P).1 =
        monomial n (f (P.1.coeff n)) := by
      calc
        (reesAlgebraMap f I P).1 = (Polynomial.mapRingHom f) P.1 := rfl
        _ = (Polynomial.mapRingHom f) (monomial n (P.1.coeff n)) :=
          congrArg _ hmono
        _ = monomial n (f (P.1.coeff n)) := by simp
    rw [mem_reesGrade_iff, htarget, Polynomial.toFinsupp_monomial]
    exact AddMonoidAlgebra.single_mem_grade n (f (P.1.coeff n))

@[simp] theorem gradedReesMap_apply (f : R →+* S) (I : Ideal R)
    (P : reesAlgebra I) :
    gradedReesMap f I P = reesAlgebraMap f I P := rfl

/-- Each degree-one element of the extended center belongs to the ideal
generated by the image of the source irrelevant ideal. -/
private theorem degreeOne_mem_map_irrelevant (f : R →+* S) (I : Ideal R)
    {s : S} (hs : s ∈ I.map f) :
    (⟨monomial 1 s, reesAlgebra.monomial_mem.mpr (by simpa using hs)⟩ :
      reesAlgebra (I.map f)) ∈
      (HomogeneousIdeal.irrelevant (reesGrade I)).toIdeal.map (gradedReesMap f I) := by
  let K := (HomogeneousIdeal.irrelevant (reesGrade I)).toIdeal.map (gradedReesMap f I)
  change s ∈ Ideal.span (f '' (I : Set R)) at hs
  induction hs using Submodule.span_induction with
  | mem s hs =>
      obtain ⟨r, hr, rfl⟩ := hs
      have hsource : reesDegreeOne I ⟨r, hr⟩ ∈
          HomogeneousIdeal.irrelevant (reesGrade I) :=
        HomogeneousIdeal.mem_irrelevant_of_mem (reesGrade I)
          (by decide) (reesDegreeOne_mem_grade I ⟨r, hr⟩)
      have h := Ideal.mem_map_of_mem (gradedReesMap f I) hsource
      convert h using 1
      apply Subtype.ext
      simp [reesDegreeOne, gradedReesMap_apply]
  | zero =>
      have h : (0 : reesAlgebra (I.map f)) ∈ K := K.zero_mem
      convert h using 1
      apply Subtype.ext
      simp
  | add x y hx hy ihx ihy =>
      have h := K.add_mem ihx ihy
      convert h using 1
      apply Subtype.ext
      simp
  | smul c x hx ih =>
      have h := K.smul_mem (algebraMap S (reesAlgebra (I.map f)) c) ih
      convert h using 1
      apply Subtype.ext
      simp

/-- Every positive-degree homogeneous element of the extended Rees algebra
belongs to the image ideal of the source irrelevant ideal. -/
private theorem positiveMonomial_mem_map_irrelevant (f : R →+* S) (I : Ideal R)
    (n : ℕ) (hn : 0 < n) {s : S} (hs : s ∈ (I.map f) ^ n) :
    (⟨monomial n s, reesAlgebra.monomial_mem.mpr hs⟩ :
      reesAlgebra (I.map f)) ∈
      (HomogeneousIdeal.irrelevant (reesGrade I)).toIdeal.map (gradedReesMap f I) := by
  let J := I.map f
  let K := (HomogeneousIdeal.irrelevant (reesGrade I)).toIdeal.map (gradedReesMap f I)
  cases n with
  | zero => omega
  | succ m =>
      have hmem : ∀ r : S, r ∈ J * J ^ m →
          ∃ h : monomial (m + 1) r ∈ reesAlgebra J,
            (⟨monomial (m + 1) r, h⟩ : reesAlgebra J) ∈ K := by
        intro r hr
        refine Submodule.smul_induction_on hr ?_ ?_
        · intro x hx y hy
          have h1 := degreeOne_mem_map_irrelevant f I hx
          have hm : monomial (m + 1) (x * y) ∈ reesAlgebra J := by
            apply reesAlgebra.monomial_mem.mpr
            rw [pow_succ']
            exact Ideal.mul_mem_mul hx hy
          have h2 : monomial m y ∈ reesAlgebra J :=
            reesAlgebra.monomial_mem.mpr hy
          have h := Ideal.mul_mem_right
            (⟨monomial m y, h2⟩ : reesAlgebra J) K h1
          refine ⟨hm, ?_⟩
          convert h using 1
          apply Subtype.ext
          simp [Polynomial.monomial_mul_monomial, Nat.add_comm]
        · intro x y hx hy
          obtain ⟨hmx, hmx'⟩ := hx
          obtain ⟨hmy, hmy'⟩ := hy
          have hm : monomial (m + 1) (x + y) ∈ reesAlgebra J := by
            simpa using add_mem hmx hmy
          refine ⟨hm, ?_⟩
          convert K.add_mem hmx' hmy' using 1
          apply Subtype.ext
          simp
      obtain ⟨hm, hK⟩ := hmem s (by simpa [pow_succ'] using hs)
      convert hK using 1

/-- The extended irrelevant ideal lies in the ideal generated by the source
irrelevant ideal. This is the exact nonvanishing condition needed for
`Proj.map` under extension of a blow-up center. -/
theorem gradedReesMap_irrelevant_le (f : R →+* S) (I : Ideal R) :
    HomogeneousIdeal.irrelevant (reesGrade (I.map f)) ≤
      (HomogeneousIdeal.irrelevant (reesGrade I)).map (gradedReesMap f I) := by
  apply (HomogeneousIdeal.irrelevant_le (reesGrade (I.map f))).mpr
  intro n hn P hP
  have hmono := reesGrade_eq_monomial (I.map f) n P hP
  have hc : P.1.coeff n ∈ (I.map f) ^ n :=
    (mem_reesAlgebra_iff (I.map f) P.1).mp P.2 n
  have h := positiveMonomial_mem_map_irrelevant f I n hn hc
  have hp : P = (⟨monomial n (P.1.coeff n),
      reesAlgebra.monomial_mem.mpr hc⟩ : reesAlgebra (I.map f)) :=
    Subtype.ext hmono
  rw [hp]
  exact h

/-- The base-change map of degree-zero homogeneous localizations at a
degree-one Rees generator. -/
noncomputable def reesProjChartMap (f : R →+* S) (I : Ideal R) (a : I) :
    reesProjChart I a →+*
      reesProjChart (I.map f) (mappedCenterElement f I a) := by
  have e : gradedReesMap f I (reesDegreeOne I a) =
      reesDegreeOne (I.map f) (mappedCenterElement f I a) := by
    apply Subtype.ext
    change (Polynomial.mapRingHom f) (monomial 1 a.1) = monomial 1 (f a.1)
    simp
  change HomogeneousLocalization.Away (reesGrade I) (reesDegreeOne I a) →+*
    HomogeneousLocalization.Away (reesGrade (I.map f))
      (reesDegreeOne (I.map f) (mappedCenterElement f I a))
  rw [← e]
  exact HomogeneousLocalization.Away.map (gradedReesMap f I)
    (reesDegreeOne I a)

end

section Scheme

universe u

variable {A B : Type u} [CommRing A] [CommRing B]

open CategoryTheory AlgebraicGeometry

/-- The actual `Proj` morphism induced by extension of a blow-up center.
The irrelevant-ideal inequality above proves that this is defined on all
of the target Proj, including when the coefficient map is not surjective. -/
noncomputable def reesProjMap (f : A →+* B) (I : Ideal A) :
    reesProj (I.map f) ⟶ reesProj I :=
  Proj.map (gradedReesMap f I) (gradedReesMap_irrelevant_le f I)

/-- The global Proj map restricts on every standard affine open to the
degree-zero homogeneous-localization map. -/
theorem reesProjMap_chart (f : A →+* B) (I : Ideal A) (a : I) :
    Proj.awayι (reesGrade (I.map f))
        (gradedReesMap f I (reesDegreeOne I a))
        ((gradedReesMap f I).map_mem (reesDegreeOne_mem_grade I a))
        (by decide) ≫ reesProjMap f I =
      Spec.map (CommRingCat.ofHom
        (HomogeneousLocalization.Away.map (gradedReesMap f I)
          (reesDegreeOne I a))) ≫ reesProjChartOpen I a := by
  exact Proj.awayι_comp_map (gradedReesMap f I)
    (gradedReesMap_irrelevant_le f I) (by decide)
    (reesDegreeOne I a) (reesDegreeOne_mem_grade I a)

#print axioms gradedReesMap
#print axioms gradedReesMap_irrelevant_le
#print axioms reesProjChartMap
#print axioms reesProjMap
#print axioms reesProjMap_chart

end Scheme

end Pcf.Bounding.AllCodimBlowup
