module

public import Mathlib.FieldTheory.SeparablyGenerated
public import Mathlib.FieldTheory.PurelyInseparable.PerfectClosure
public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import Mathlib.FieldTheory.SeparableClosure
public import Mathlib.RingTheory.Smooth.Field
public import Mathlib.Algebra.Polynomial.Lifts

/-!
# Separable generation after a finite purely inseparable base change

For finitely many elements `X` of an algebraically closed field `Ω ⊇ k`, there is a
finite set `T` of elements of the perfect closure of `k` in `Ω` such that
`k(T)(X)` is formally smooth over `k(T)`. This is the form of Stacks Lemma
10.42.4 (`04KM`) used for generic regularity. The proof applies Mathlib's
separable generation over the perfect closure and descends the finitely many
coefficients involved to a finitely generated subextension.
-/

@[expose] public section

namespace Pcf

open IntermediateField Polynomial

universe u

set_option linter.style.haveILetI false


/-- Over the perfect closure of `k` in an algebraically closed `Ω`, the field
generated by a finite set `X` has a separating transcendence basis, recorded as
polynomial data in `Ω`. -/
theorem exists_separating_data_perfectClosure (k Ω : Type u) [Field k] [Field Ω]
    [Algebra k Ω] [IsAlgClosed Ω] (X : Finset Ω) :
    ∃ (ι : Type u) (_ : Finite ι) (v : ι → Ω),
      AlgebraicIndependent (perfectClosure k Ω) v ∧
      (∀ i, v i ∈ adjoin (perfectClosure k Ω) (X : Set Ω)) ∧
      ∀ x ∈ X, ∃ f : (adjoin (perfectClosure k Ω) (Set.range v))[X],
        f.Separable ∧ aeval x f = 0 := by
  set P := perfectClosure k Ω
  set M := adjoin P (X : Set Ω)
  obtain ⟨s, hs, hsep⟩ := exists_isTranscendenceBasis_and_isSeparable_of_perfectField P M
  refine ⟨s, inferInstance, fun i ↦ ((i : M) : Ω), ?_, fun i ↦ (i : M).2, ?_⟩
  · exact hs.1.map' (f := M.val) M.val.injective
  · intro x hx
    set EM := IntermediateField.adjoin P (s : Set M)
    have hEΩ : EM.map M.val = adjoin P (Set.range fun i : s ↦ ((i : M) : Ω)) := by
      rw [adjoin_map]
      congr 1
      ext y; simp
    let e : EM ≃ₐ[P] adjoin P (Set.range fun i : s ↦ ((i : M) : Ω)) :=
      (equivMap EM M.val).trans (equivOfEq hEΩ)
    let y : M := ⟨x, subset_adjoin _ _ hx⟩
    have hy : (minpoly EM y).Separable := Algebra.IsSeparable.isSeparable EM y
    refine ⟨(minpoly EM y).map e.toRingHom, hy.map, ?_⟩
    have key : ∀ z : EM, algebraMap (adjoin P (Set.range fun i : s ↦ ((i : M) : Ω))) Ω (e z) =
        M.val (algebraMap EM M z) := fun z ↦ rfl
    rw [aeval_def, eval₂_map]
    have : (algebraMap (adjoin P (Set.range fun i : s ↦ ((i : M) : Ω))) Ω).comp e.toRingHom =
        (M.val : M →+* Ω).comp (algebraMap EM M) := by
      ext z; exact key z
    rw [this]
    change eval₂ _ ((M.val : M →+* Ω) y) _ = 0
    rw [← Polynomial.hom_eval₂, ← aeval_def, minpoly.aeval, map_zero]
/-- Finitely many elements of `K(S)` lie in `k(T ∪ S)` for a finite `T ⊆ K`. -/
theorem exists_finset_subset_of_subset_adjoin {k Ω : Type u} [Field k] [Field Ω]
    [Algebra k Ω] (K : IntermediateField k Ω) (S : Set Ω) (Y : Finset Ω)
    (hY : ∀ y ∈ Y, y ∈ adjoin K S) :
    ∃ T : Finset Ω, (T : Set Ω) ⊆ K ∧ ∀ y ∈ Y, y ∈ adjoin k ((T : Set Ω) ∪ S) := by
  classical
  induction Y using Finset.induction_on with
  | empty => exact ⟨∅, by simp, by simp⟩
  | insert y Y hyY ih =>
    obtain ⟨T, hTK, hT⟩ := ih fun z hz ↦ hY z (Finset.mem_insert_of_mem hz)
    have hy : y ∈ restrictScalars k (adjoin K S) := hY y (Finset.mem_insert_self _ _)
    rw [restrictScalars_adjoin] at hy
    obtain ⟨F, hF, hyF⟩ := exists_finset_of_mem_adjoin hy
    refine ⟨T ∪ F.filter (· ∈ K), ?_, ?_⟩
    · intro z hz
      simp only [Finset.coe_union, Finset.coe_filter, Set.mem_union, Set.mem_ofPred_eq] at hz
      rcases hz with hz | hz
      · exact hTK hz
      · exact hz.2
    · intro z hz
      rcases Finset.mem_insert.mp hz with rfl | hz
      · refine adjoin.mono _ _ _ ?_ hyF
        intro w hw
        rcases hF hw with h | h
        · left
          simp only [Finset.coe_union, Finset.coe_filter, Set.mem_union, Set.mem_ofPred_eq]
          exact Or.inr ⟨hw, h⟩
        · right; exact h
      · exact adjoin.mono _ _ _ (Set.union_subset_union_left _ (by simp)) (hT z hz)

/-- A root of a separable polynomial whose coefficients come from `K` is separable over `K`. -/
theorem isSeparable_of_separable_of_coeff_mem {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω]
    (x : Ω) (F : Polynomial Ω) (hF : F.Separable) (hx : F.eval x = 0)
    (hc : ∀ n, F.coeff n ∈ Set.range (algebraMap K Ω)) : IsSeparable K x := by
  obtain ⟨g, hg⟩ := (Polynomial.mem_lifts F).mp ((Polynomial.lifts_iff_coeff_lifts F).mpr hc)
  have hgsep : g.Separable := by
    rw [← Polynomial.separable_map (algebraMap K Ω), hg]
    exact hF
  have hgx : aeval x g = 0 := by
    rw [aeval_def, Polynomial.eval₂_eq_eval_map, hg]
    exact hx
  exact hgsep.of_dvd (minpoly.dvd K x hgx)

/-- Algebraic independence descends to a smaller intermediate field. -/
theorem algebraicIndependent_of_le {k Ω ι : Type*} [Field k] [Field Ω] [Algebra k Ω]
    {K K' : IntermediateField k Ω} (h : K' ≤ K) {v : ι → Ω} (hv : AlgebraicIndependent K v) :
    AlgebraicIndependent K' v := by
  letI : Algebra K' K := (inclusion h).toRingHom.toAlgebra
  have : IsScalarTower K' K Ω := .of_algebraMap_eq fun _ ↦ rfl
  exact hv.restrictScalars (K := K) (inclusion h).injective

/-- Algebra 10.42.4 at the level needed here: for finitely many elements `X` of an
algebraically closed `Ω ⊇ k`, there is a finite set `T` of elements purely
inseparable over `k` such that `k(T)(X)` is formally smooth over `k(T)`.

Divergence from Stacks: Stacks asserts `K'/k'` is separably generated for an
abstract diagram; here `K' = k(T)(X)` inside `Ω` and the conclusion is formal
smoothness (which follows from separable generation). -/
@[stacks 04KM "formally smooth form, K' = k'(X) inside an algebraically closed field"]
theorem exists_finset_perfectClosure_formallySmooth_adjoin (k Ω : Type u) [Field k]
    [Field Ω] [Algebra k Ω] [IsAlgClosed Ω] (X : Finset Ω) :
    ∃ T : Finset Ω, (T : Set Ω) ⊆ perfectClosure k Ω ∧
      Algebra.FormallySmooth (adjoin k (T : Set Ω))
        (adjoin (adjoin k (T : Set Ω)) (X : Set Ω)) := by
  classical
  set P := perfectClosure k Ω
  obtain ⟨ι, hι, v, hind, hvX, hsep⟩ := exists_separating_data_perfectClosure k Ω X
  have := Fintype.ofFinite ι
  set E := adjoin P (Set.range v)
  choose pol hfsep hfroot using hsep
  obtain ⟨T₁, hT₁P, hT₁⟩ := exists_finset_subset_of_subset_adjoin P (X : Set Ω)
    (Finset.univ.image v) (by simpa using hvX)
  obtain ⟨T₂, hT₂P, hT₂⟩ := exists_finset_subset_of_subset_adjoin P (Set.range v)
    (X.attach.biUnion fun x ↦ (pol x.1 x.2).support.image fun n ↦ ((pol x.1 x.2).coeff n : Ω))
    (by
      intro y hy
      simp only [Finset.mem_biUnion, Finset.mem_image] at hy
      obtain ⟨x, -, n, -, rfl⟩ := hy
      exact ((pol x.1 x.2).coeff n).2)
  refine ⟨T₁ ∪ T₂, by simpa using ⟨hT₁P, hT₂P⟩, ?_⟩
  set k' := adjoin k ((T₁ ∪ T₂ : Finset Ω) : Set Ω)
  have hk'P : k' ≤ P := adjoin_le_iff.mpr (by simpa using ⟨hT₁P, hT₂P⟩)
  have hTk' : ((T₁ ∪ T₂ : Finset Ω) : Set Ω) ⊆ k' := subset_adjoin _ _
  -- (1) the basis lies in `k'(X)`
  have hv' : ∀ i, v i ∈ adjoin k' (X : Set Ω) := by
    intro i
    have h := hT₁ (v i) (by simp)
    change v i ∈ restrictScalars k (adjoin k' (X : Set Ω))
    rw [restrictScalars_adjoin]
    refine adjoin.mono _ _ _ (Set.union_subset_union_left _ ?_) h
    exact fun z hz ↦ hTk' (by simp [hz])
  have hind' : AlgebraicIndependent k' v := algebraicIndependent_of_le hk'P hind
  set E' := adjoin k' (Set.range v)
  have hsep' : ∀ x ∈ X, IsSeparable E' x := by
    intro x hx
    refine isSeparable_of_separable_of_coeff_mem x ((pol x hx).map (algebraMap E Ω))
      (Polynomial.Separable.map (f := algebraMap E Ω) (hfsep x hx))
      (by rw [← Polynomial.eval₂_eq_eval_map, ← aeval_def]; exact hfroot x hx) ?_
    intro n
    by_cases hn : n ∈ (pol x hx).support
    · have hc := hT₂ ((pol x hx).coeff n : Ω) (by
        simp only [Finset.mem_biUnion, Finset.mem_image]
        exact ⟨⟨x, hx⟩, Finset.mem_attach _ _, n, hn, rfl⟩)
      have : ((pol x hx).coeff n : Ω) ∈ restrictScalars k E' := by
        rw [restrictScalars_adjoin]
        refine adjoin.mono _ _ _ (Set.union_subset_union_left _ ?_) hc
        exact fun z hz ↦ hTk' (by simp [hz])
      exact ⟨⟨_, this⟩, by rw [Polynomial.coeff_map]; rfl⟩
    · rw [Polynomial.notMem_support_iff] at hn
      exact ⟨0, by rw [Polynomial.coeff_map, hn, map_zero, map_zero]⟩
  -- (4) assemble
  have : Algebra.FormallySmooth k' E' := Algebra.FormallySmooth.adjoin_of_algebraicIndependent hind'
  set G := adjoin E' (X : Set Ω)
  have : Algebra.IsSeparable E' G := (isSeparable_adjoin_iff_isSeparable E' Ω).mpr hsep'
  have : Algebra.FormallyEtale E' G := Algebra.FormallyEtale.of_isSeparable E' G
  have hG : Algebra.FormallySmooth k' G := .comp k' E' G
  have hEq : restrictScalars k' G = adjoin k' (X : Set Ω) := by
    rw [restrictScalars_adjoin]
    apply le_antisymm
    · exact adjoin_le_iff.mpr (Set.union_subset
        (adjoin_le_iff.mpr (by rintro _ ⟨i, rfl⟩; exact hv' i)) (subset_adjoin _ _))
    · exact adjoin.mono _ _ _ Set.subset_union_right
  have : Algebra.FormallySmooth k' (restrictScalars k' G) := hG
  exact .of_equiv (equivOfEq hEq)

#print axioms exists_separating_data_perfectClosure
#print axioms exists_finset_subset_of_subset_adjoin
#print axioms isSeparable_of_separable_of_coeff_mem
#print axioms algebraicIndependent_of_le
#print axioms exists_finset_perfectClosure_formallySmooth_adjoin

end Pcf
