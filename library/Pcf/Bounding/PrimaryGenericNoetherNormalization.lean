module

public import Mathlib.RingTheory.NoetherNormalization
public import Mathlib.RingTheory.MvPolynomial.Localization
public import Mathlib.RingTheory.Localization.Integral
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.RingTheory.MvPolynomial.Tower

/-!
# Generic Noether normalization over a domain

Let `R → B` be an injective map of domains with `B` of finite type over `R`.
There are elements `x₁, …, xₛ ∈ B`, algebraically independent over `R`, and
a nonzero `g ∈ R` such that every element of `B` becomes integral over
`R[x₁, …, xₛ]` after multiplication by a power of `g`. Equivalently `B[1/g]`
is integral over `R[1/g][x]`.

This is the generic finiteness input for the proof of `latex/paper-p.tex`,
Lemma `lem:primary-fibres`, given here in place of the paper's appeal to
Stacks Tags `04KT` and `0578`. It is obtained from Mathlib's Noether
normalization over the fraction field by clearing denominators.
-/

@[expose] public section

namespace Pcf.Bounding

open MvPolynomial

noncomputable section

set_option linter.style.haveILetI false

variable (R B : Type*) [CommRing R] [IsDomain R] [CommRing B] [Algebra R B]

/-- Elements of the `K`-algebra generated by `B` inside `Frac B` have
denominators in `R`. -/
theorem exists_denom_of_mem_adjoin_fractionField
    {K L : Type*} [Field K] [Field L] [Algebra R K] [IsFractionRing R K]
    [Algebra K L] [Algebra R L] [Algebra B L] [IsScalarTower R K L]
    [IsScalarTower R B L]
    (T : Set B) (z : L)
    (hz : z ∈ Algebra.adjoin K (algebraMap B L '' T)) :
    ∃ d : R, d ≠ 0 ∧ ∃ b : B, algebraMap R L d * z = algebraMap B L b := by
  induction hz using Algebra.adjoin_induction with
  | mem z hz =>
    obtain ⟨b, -, rfl⟩ := hz
    exact ⟨1, one_ne_zero, b, by simp⟩
  | algebraMap k =>
    obtain ⟨⟨a, d⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors R) k
    refine ⟨d, nonZeroDivisors.ne_zero d.2, algebraMap R B a, ?_⟩
    change algebraMap R L d * algebraMap K L (IsLocalization.mk' K a d) = _
    rw [IsScalarTower.algebraMap_apply R K L, ← map_mul, mul_comm,
      IsLocalization.mk'_spec, ← IsScalarTower.algebraMap_apply,
      IsScalarTower.algebraMap_apply R B L]
  | add z w _ _ hz hw =>
    obtain ⟨d, hd, b, hb⟩ := hz
    obtain ⟨e, he, c, hc⟩ := hw
    refine ⟨d * e, mul_ne_zero hd he, algebraMap R B e * b + algebraMap R B d * c, ?_⟩
    simp only [map_add, map_mul, ← IsScalarTower.algebraMap_apply R B L, ← hb, ← hc]
    ring
  | mul z w _ _ hz hw =>
    obtain ⟨d, hd, b, hb⟩ := hz
    obtain ⟨e, he, c, hc⟩ := hw
    refine ⟨d * e, mul_ne_zero hd he, b * c, ?_⟩
    simp only [map_mul, ← hb, ← hc]
    ring

omit [IsDomain R] in
/-- Integrality of an element of `B` over `R[x]` may be tested after an
injective map into a ring receiving the compatible polynomial evaluation. -/
theorem isIntegralElem_aeval_of_injective {s : ℕ} (x : Fin s → B)
    {L : Type*} [CommRing L] [Algebra R L] (ι : B →ₐ[R] L)
    (hι : Function.Injective ι) (b : B)
    (hb : (aeval (R := R) (fun i => ι (x i))).toRingHom.IsIntegralElem (ι b)) :
    (aeval (R := R) x).toRingHom.IsIntegralElem b := by
  obtain ⟨P, hmon, hP⟩ := hb
  refine ⟨P, hmon, hι ?_⟩
  rw [map_zero, ← hP]
  change (ι : B →+* L) _ = _
  rw [Polynomial.hom_eval₂]
  congr 1
  have h := MvPolynomial.comp_aeval (R := R) x ι
  exact congrArg AlgHom.toRingHom h

variable [IsDomain B] [FaithfulSMul R B]

/-- **Generic Noether normalization.** For an injective finite-type extension
of domains `R → B`, there are `x₁, …, xₛ ∈ B`, algebraically independent over
`R`, and a nonzero `g ∈ R` such that every `b ∈ B` has a multiple `gⁿ b`
integral over `R[x]`. -/
theorem exists_generic_noetherNormalization [Algebra.FiniteType R B] :
    ∃ (s : ℕ) (x : Fin s → B) (g : R), g ≠ 0 ∧
      Function.Injective (aeval (R := R) x) ∧
      ∀ b : B, ∃ n : ℕ,
        (aeval (R := R) x).toRingHom.IsIntegralElem (algebraMap R B g ^ n * b) := by
  classical
  let K := FractionRing R
  let L := FractionRing B
  letI : Algebra K L := FractionRing.liftAlgebra R L
  obtain ⟨t, ht⟩ := Algebra.FiniteType.out (R := R) (A := B)
  let A : Subalgebra K L := Algebra.adjoin K (algebraMap B L '' (t : Set B))
  have : Algebra.FiniteType K A := Algebra.FiniteType.adjoin_of_finite
    ((t.finite_toSet).image _)
  have hmemA (b : B) : algebraMap B L b ∈ A := by
    have hb : b ∈ Algebra.adjoin R (t : Set B) := by rw [ht]; trivial
    have := Algebra.adjoin_image R (IsScalarTower.toAlgHom R B L) (t : Set B)
    have hb' : algebraMap B L b ∈ Algebra.adjoin R (algebraMap B L '' (t : Set B)) := by
      rw [show algebraMap B L '' (t : Set B) = IsScalarTower.toAlgHom R B L '' (t : Set B)
        from rfl, this]
      exact ⟨b, hb, rfl⟩
    exact Algebra.adjoin_le (s := algebraMap B L '' (t : Set B))
      (S := A.restrictScalars R) Algebra.subset_adjoin hb'
  obtain ⟨s, g0, hinj0, hint0⟩ := exists_integral_inj_algHom_of_fg K A
  choose d hd x hx using fun i : Fin s =>
    exists_denom_of_mem_adjoin_fractionField R B (K := K) (L := L) (t : Set B)
      (g0 (X i) : L) (g0 (X i)).2
  let ι : B →ₐ[R] L := IsScalarTower.toAlgHom R B L
  have hιinj : Function.Injective ι := IsFractionRing.injective B L
  let xL : Fin s → L := fun i => ι (x i)
  let dK : Fin s → K := fun i => algebraMap R K (d i)
  have hdK (i : Fin s) : dK i ≠ 0 := by
    rw [Ne, ← map_zero (algebraMap R K)]
    exact (IsFractionRing.injective R K).ne (hd i)
  let φ : MvPolynomial (Fin s) K →ₐ[K] MvPolynomial (Fin s) K :=
    aeval fun i => C (dK i) * X i
  let ψ : MvPolynomial (Fin s) K →ₐ[K] MvPolynomial (Fin s) K :=
    aeval fun i => C (dK i)⁻¹ * X i
  have hψφ : ψ.comp φ = AlgHom.id K _ := by
    apply MvPolynomial.algHom_ext
    intro i
    simp only [φ, ψ, AlgHom.comp_apply, aeval_X, map_mul, aeval_C, AlgHom.id_apply,
      algebraMap_eq, ← mul_assoc, ← C_mul, mul_inv_cancel₀ (hdK i), C_1, one_mul]
  have hφψ : φ.comp ψ = AlgHom.id K _ := by
    apply MvPolynomial.algHom_ext
    intro i
    simp only [φ, ψ, AlgHom.comp_apply, aeval_X, map_mul, aeval_C, AlgHom.id_apply,
      algebraMap_eq, ← mul_assoc, ← C_mul, inv_mul_cancel₀ (hdK i), C_1, one_mul]
  have hcomp : (A.val.comp g0).comp φ = aeval (R := K) xL := by
    apply MvPolynomial.algHom_ext
    intro i
    simp only [φ, AlgHom.comp_apply, aeval_X, map_mul]
    rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, AlgHom.commutes]
    change algebraMap K L (algebraMap R K (d i)) * _ = _
    rw [← IsScalarTower.algebraMap_apply]
    exact hx i
  have hφinj : Function.Injective φ := by
    intro p q hpq
    have := congrArg ψ hpq
    rwa [← AlgHom.comp_apply, hψφ, ← AlgHom.comp_apply, hψφ] at this
  have hKinj : Function.Injective (aeval (R := K) xL) := by
    rw [← hcomp]
    exact (Subtype.val_injective.comp hinj0).comp hφinj
  have hιaeval (p : MvPolynomial (Fin s) R) :
      ι (aeval x p) = aeval (R := K) xL (MvPolynomial.map (algebraMap R K) p) := by
    rw [MvPolynomial.aeval_map_algebraMap K, ← AlgHom.comp_apply, MvPolynomial.comp_aeval]
  have hRinj : Function.Injective (aeval (R := R) x) := by
    intro p q hpq
    apply MvPolynomial.map_injective _ (IsFractionRing.injective R K)
    apply hKinj
    rw [← hιaeval, ← hιaeval, hpq]
  -- integrality of each generator after a constant multiplier
  have hgen (u : B) : ∃ r : R, r ≠ 0 ∧
      (aeval (R := R) x).toRingHom.IsIntegralElem (algebraMap R B r * u) := by
    have hA : ι u ∈ A := hmemA u
    obtain ⟨P, hPm, hP⟩ := hint0 ⟨ι u, hA⟩
    have hK : (aeval (R := K) xL).toRingHom.IsIntegralElem (ι u) := by
      refine ⟨P.map ψ.toRingHom, hPm.map _, ?_⟩
      rw [Polynomial.eval₂_map]
      have hcomp' : (aeval (R := K) xL).toRingHom.comp ψ.toRingHom =
          (A.val.comp g0).toRingHom := by
        rw [← hcomp]
        refine RingHom.ext fun q => ?_
        change ((A.val.comp g0).comp φ) (ψ q) = (A.val.comp g0) q
        rw [AlgHom.comp_apply _ φ, ← AlgHom.comp_apply φ ψ, hφψ, AlgHom.id_apply]
      rw [hcomp']
      change Polynomial.eval₂ ((A.val : A →+* L).comp g0.toRingHom) (ι u) P = 0
      have h := Polynomial.hom_eval₂ P g0.toRingHom (A.val : A →+* L) ⟨ι u, hA⟩
      rw [hP, map_zero] at h
      exact h.symm
    letI iK : Algebra (MvPolynomial (Fin s) K) L := (aeval (R := K) xL).toRingHom.toAlgebra
    letI iR : Algebra (MvPolynomial (Fin s) R) L := (aeval (R := R) xL).toRingHom.toAlgebra
    letI iRK : Algebra (MvPolynomial (Fin s) R) (MvPolynomial (Fin s) K) :=
      MvPolynomial.algebraMvPolynomial
    haveI : IsScalarTower (MvPolynomial (Fin s) R) (MvPolynomial (Fin s) K) L :=
      IsScalarTower.of_algebraMap_eq fun q => by
        change aeval xL q = aeval xL (MvPolynomial.map (algebraMap R K) q)
        rw [MvPolynomial.aeval_map_algebraMap K]
    haveI : IsLocalization ((nonZeroDivisors R).map (C : R →+* MvPolynomial (Fin s) R))
        (MvPolynomial (Fin s) K) :=
      MvPolynomial.isLocalization (nonZeroDivisors R) K
    obtain ⟨⟨m, hm⟩, hint⟩ := IsIntegral.exists_multiple_integral_of_isLocalization
      ((nonZeroDivisors R).map (C : R →+* MvPolynomial (Fin s) R)) (ι u) hK
    obtain ⟨r, hr, rfl⟩ := Submonoid.mem_map.mp hm
    refine ⟨r, nonZeroDivisors.ne_zero hr, ?_⟩
    apply isIntegralElem_aeval_of_injective R B x ι hιinj
    have hsmul : (⟨C r, hm⟩ : (nonZeroDivisors R).map (C : R →+* MvPolynomial (Fin s) R)) •
        ι u = ι (algebraMap R B r * u) := by
      rw [Submonoid.smul_def, Algebra.smul_def, map_mul, AlgHom.commutes]
      change aeval xL (C r) * ι u = _
      rw [aeval_C]
    rw [← hsmul]
    exact hint
  choose r hr hrint using hgen
  let G : R := ∏ u ∈ t, r u
  have hG : G ≠ 0 := Finset.prod_ne_zero_iff.mpr fun u _ => hr u
  letI : Algebra (MvPolynomial (Fin s) R) B := (aeval (R := R) x).toRingHom.toAlgebra
  have hconst (c : R) : IsIntegral (MvPolynomial (Fin s) R) (algebraMap R B c) := by
    have h : algebraMap R B c = algebraMap (MvPolynomial (Fin s) R) B (C c) := by
      change _ = aeval x (C c)
      rw [aeval_C]
    rw [h]
    exact isIntegral_algebraMap
  have hGpow (n : ℕ) : IsIntegral (MvPolynomial (Fin s) R) (algebraMap R B G ^ n) := by
    rw [← map_pow]
    exact hconst _
  have key : ∀ b ∈ Algebra.adjoin R (t : Set B), ∃ n : ℕ,
      IsIntegral (MvPolynomial (Fin s) R) (algebraMap R B G ^ n * b) := by
    intro b hb
    induction hb using Algebra.adjoin_induction with
    | mem u hu =>
      refine ⟨1, ?_⟩
      have hsplit : algebraMap R B G ^ 1 * u =
          algebraMap R B (∏ v ∈ t.erase u, r v) * (algebraMap R B (r u) * u) := by
        rw [pow_one, ← mul_assoc, ← map_mul, Finset.prod_erase_mul _ _ hu]
      rw [hsplit]
      exact (hconst _).mul (hrint u)
    | algebraMap c =>
      exact ⟨0, by rw [pow_zero, one_mul]; exact hconst c⟩
    | add a b _ _ ha hb =>
      obtain ⟨n, hn⟩ := ha
      obtain ⟨m, hm⟩ := hb
      refine ⟨n + m, ?_⟩
      have h : algebraMap R B G ^ (n + m) * (a + b) =
          algebraMap R B G ^ m * (algebraMap R B G ^ n * a) +
            algebraMap R B G ^ n * (algebraMap R B G ^ m * b) := by ring
      rw [h]
      exact ((hGpow m).mul hn).add ((hGpow n).mul hm)
    | mul a b _ _ ha hb =>
      obtain ⟨n, hn⟩ := ha
      obtain ⟨m, hm⟩ := hb
      refine ⟨n + m, ?_⟩
      have h : algebraMap R B G ^ (n + m) * (a * b) =
          (algebraMap R B G ^ n * a) * (algebraMap R B G ^ m * b) := by ring
      rw [h]
      exact hn.mul hm
  refine ⟨s, x, G, hG, hRinj, fun b => ?_⟩
  obtain ⟨n, hn⟩ := key b (by rw [ht]; trivial)
  exact ⟨n, hn⟩

#print axioms exists_denom_of_mem_adjoin_fractionField
#print axioms isIntegralElem_aeval_of_injective
#print axioms exists_generic_noetherNormalization

end

end Pcf.Bounding
