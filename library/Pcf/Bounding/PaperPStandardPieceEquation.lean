module

public import Pcf.Bounding.StandardPiece
public import Mathlib.RingTheory.AdjoinRoot

/-!
# `paper-p.tex`, equation `eq:standard-piece`

The fibre of a standard tamely ramified piece has equation `z^e = 0`.
When the branch divisor is reduced, its reduced fibre is the quotient by
`z`, canonically isomorphic to the branch divisor.
-/

@[expose] public section

namespace Pcf.LocalModel

open Polynomial

variable {R : Type*} [CommRing R] (u : Rˣ) (a : R) (e : ℕ)

private theorem localPoly_map_quotient :
    (localPoly u a e).map (Ideal.Quotient.mk (Ideal.span ({a} : Set R))) =
      (X : (R ⧸ Ideal.span ({a} : Set R))[X]) ^ e := by
  have ha : (Ideal.Quotient.mk (Ideal.span ({a} : Set R)) a :
      R ⧸ Ideal.span ({a} : Set R)) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self a)
  simp [localPoly, ha, map_mul]

/-- The first equality of `paper-p.tex`, equation `eq:standard-piece`:
`C/aC ≃ (R/aR)[z]/(z^e)`, where `C = R[z]/(z^e-ua)` and `aC` is the
extension of `(a)` along `R → C`.

`paper-p.tex` correspondence: equation (3) (`eq:standard-piece`). -/
noncomputable def paperP_standardPiece_fiberEquiv :
    AdjoinRoot (localPoly u a e) ⧸
        (Ideal.span ({a} : Set R)).map (AdjoinRoot.of (localPoly u a e)) ≃+*
      (R ⧸ Ideal.span ({a} : Set R))[X] ⧸
        Ideal.span ({(X : (R ⧸ Ideal.span ({a} : Set R))[X]) ^ e} :
          Set (R ⧸ Ideal.span ({a} : Set R))[X]) :=
  (AdjoinRoot.quotAdjoinRootEquivQuotPolynomialQuot
    (Ideal.span ({a} : Set R)) (localPoly u a e)).trans
      (Ideal.quotEquivOfEq (by rw [localPoly_map_quotient u a e]))

/-- The extended base ideal `(a)C` is the principal ideal generated by the
image of `a` in the standard piece.

`paper-p.tex` correspondence: equation (3) (`eq:standard-piece`). -/
theorem paperP_standardPiece_extendedIdeal_eq :
    (Ideal.span ({a} : Set R)).map (AdjoinRoot.of (localPoly u a e)) =
      Ideal.span {algebraMap R (AdjoinRoot (localPoly u a e)) a} := by
  simp [Ideal.map_span, AdjoinRoot.algebraMap_eq]

/-- The second equality of `paper-p.tex`, equation `eq:standard-piece`:
`(C/aC)_red ≃ C/zC ≃ R/aR`. The first equivalence uses that `R/aR`
is reduced (the manuscript obtains this from regularity).

`paper-p.tex` correspondence: equation (3) (`eq:standard-piece`). -/
noncomputable def paperP_standardPiece_reducedFiberToRootQuot
    (he : 1 ≤ e) [IsReduced (R ⧸ Ideal.span ({a} : Set R))] :
    AdjoinRoot (localPoly u a e) ⧸
        ((Ideal.span ({a} : Set R)).map (AdjoinRoot.of (localPoly u a e))).radical ≃+*
      AdjoinRoot (localPoly u a e) ⧸
        Ideal.span {AdjoinRoot.root (localPoly u a e)} :=
  Ideal.quotEquivOfEq (by
    rw [paperP_standardPiece_extendedIdeal_eq u a e,
      radical_span_algebraMap_eq_span_root u a he])

/-- The reduced scheme-theoretic fibre is canonically the reduced divisor.

`paper-p.tex` correspondence: equation (3) (`eq:standard-piece`). -/
noncomputable def paperP_standardPiece_reducedFiberEquiv
    (he : 1 ≤ e) [IsReduced (R ⧸ Ideal.span ({a} : Set R))] :
    AdjoinRoot (localPoly u a e) ⧸
        ((Ideal.span ({a} : Set R)).map (AdjoinRoot.of (localPoly u a e))).radical ≃+*
      R ⧸ Ideal.span ({a} : Set R) :=
  (paperP_standardPiece_reducedFiberToRootQuot u a e he).trans
    (quotientRootEquiv u a he).toRingEquiv

#print axioms paperP_standardPiece_fiberEquiv
#print axioms paperP_standardPiece_extendedIdeal_eq
#print axioms paperP_standardPiece_reducedFiberToRootQuot
#print axioms paperP_standardPiece_reducedFiberEquiv

end Pcf.LocalModel
