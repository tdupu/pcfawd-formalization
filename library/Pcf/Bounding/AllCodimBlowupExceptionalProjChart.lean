module

public import Pcf.Bounding.AllCodimBlowupExceptionalChart
public import Pcf.Bounding.AllCodimBlowupRelativeClosedImmersion

/-!
# Exceptional centre on the actual Rees Proj chart

The explicit affine chart calculation for the exceptional centre is
transported to the degree-zero homogeneous localization chart of the
actual Rees `Proj`. This is the chartwise Cartier input on the scheme
appearing in `paper-p.tex`, proof of `thm:allcodim-normal`.
-/

@[expose] public section

namespace Pcf.Bounding.AllCodimBlowup

open AlgebraicGeometry CategoryTheory

universe u

variable {R : Type u} [CommRing R]

set_option linter.style.haveILetI false

attribute [local instance] reesProjChartAlgebra

/-- On an actual standard `Proj` chart the extended centre ideal is
generated by the chart coordinate transported from `R[I/a]`. -/
theorem centerIdeal_map_reesProjChart_eq_span (I : Ideal R) (a : I) :
    I.map (algebraMap R (reesProjChart I a)) =
      Ideal.span (Set.singleton ((reesProjChartAlgEquiv I a).symm
        (algebraMap R (affineBlowupChart I a) a.1))) := by
  let e := reesProjChartAlgEquiv I a
  let c : reesProjChart I a := e.symm (algebraMap R (affineBlowupChart I a) a.1)
  have hcomp : e.toRingHom.comp (algebraMap R (reesProjChart I a)) =
      algebraMap R (affineBlowupChart I a) := by
    apply RingHom.ext
    intro r
    exact e.commutes r
  have hleft :
      (I.map (algebraMap R (reesProjChart I a))).map e.toRingHom =
        I.map (algebraMap R (affineBlowupChart I a)) := by
    rw [Ideal.map_map]
    rw [hcomp]
  have hright :
      (Ideal.span {c}).map e.toRingHom =
        Ideal.span {algebraMap R (affineBlowupChart I a) a.1} := by
    rw [Ideal.map_span]
    simp [c, e]
  have h := hleft.trans
    ((centerIdeal_map_affineBlowupChart_eq_span I a).trans hright.symm)
  have h' := congrArg (fun J : Ideal (affineBlowupChart I a) =>
    J.comap e.toRingHom) h
  change I.map (algebraMap R (reesProjChart I a)) = Ideal.span {c}
  simpa only [Ideal.comap_map_of_bijective e.toRingHom e.bijective] using h'

/-- On every nonempty Rees `Proj` chart of an integral affine base,
the local equation of the exceptional centre is a nonzero divisor. -/
theorem centerCoordinate_reesProjChart_mem_nonZeroDivisors
    (I : Ideal R) (a : I) [IsDomain R] (ha : a.1 ≠ 0) :
    (reesProjChartAlgEquiv I a).symm
        (algebraMap R (affineBlowupChart I a) a.1) ∈
      nonZeroDivisors (reesProjChart I a) := by
  letI : IsDomain (affineBlowupChart I a) :=
    affineBlowupChart_isDomain I a ha
  letI : IsDomain (reesProjChart I a) :=
    (reesProjChartAlgEquiv I a).toMulEquiv.isDomain _
  exact (mem_nonZeroDivisors_iff_ne_zero).mpr
    (by simpa only [map_zero] using
      ((reesProjChartAlgEquiv I a).symm.injective.ne
        (centerCoordinate_ne_zero I a ha)))

#print axioms centerIdeal_map_reesProjChart_eq_span
#print axioms centerCoordinate_reesProjChart_mem_nonZeroDivisors

/-- The inverse image of the affine centre under the actual Rees `Proj`
structural morphism is cut out on each standard chart by its Cartier
coordinate. This identifies the chart support used to glue the exceptional
divisor. -/
theorem centerSupport_reesProjChart
    (I : Ideal R) (a : I) :
    (reesProjChartOpen I a ≫ reesProjToSpec I).base ⁻¹'
      PrimeSpectrum.zeroLocus (I : Set R) =
    PrimeSpectrum.zeroLocus
      (Set.singleton ((reesProjChartAlgEquiv I a).symm
        (algebraMap R (affineBlowupChart I a) a.1))) := by
  rw [reesProjChartOpen_toSpec_alg]
  change (PrimeSpectrum.comap (algebraMap R (reesProjChart I a))) ⁻¹'
      PrimeSpectrum.zeroLocus (I : Set R) = _
  rw [PrimeSpectrum.preimage_comap_zeroLocus]
  have hmap :
      PrimeSpectrum.zeroLocus
          ((algebraMap R (reesProjChart I a)) '' (I : Set R)) =
        PrimeSpectrum.zeroLocus
          ((I.map (algebraMap R (reesProjChart I a))) :
            Set (reesProjChart I a)) := by
    rw [Ideal.map, PrimeSpectrum.zeroLocus_span]
  rw [hmap, centerIdeal_map_reesProjChart_eq_span,
    PrimeSpectrum.zeroLocus_span]

#print axioms centerSupport_reesProjChart

end Pcf.Bounding.AllCodimBlowup
