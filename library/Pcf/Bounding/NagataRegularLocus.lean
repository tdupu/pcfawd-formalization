/-!
# Nagata's criterion: J-0 for all quotient domains implies J-1

Let `R` be a Noetherian ring. If, for every prime `p`, the regular locus of
`R ⧸ p` contains a nonempty basic open set, then the regular locus of `R` is
open (Stacks Project Tag `07P9`, Lemma 15.48.3).

The proof avoids regular sequences: at a regular prime `p` of height `r`, the
ideal `p` becomes generated by `r` elements on a principal open `D(g)`. For a
prime `q ⊇ p` in `D(g)` with `(R ⧸ p)_q` regular, the embedding dimension of
`R_q` is at most `dim (R ⧸ p)_q + r ≤ dim R_q`.
-/

@[expose] public section

namespace Pcf

open IsLocalRing

universe u

set_option linter.style.haveILetI false

/-- The embedding dimension is at most that of a quotient plus the number of
generators of the kernel. -/
theorem spanFinrank_maximalIdeal_le_quotient_add
    {A : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (P : Ideal A) (hP : P ≠ ⊤) :
    letI : Nontrivial (A ⧸ P) := Ideal.Quotient.nontrivial_iff.mpr hP
    letI : IsLocalRing (A ⧸ P) := .of_surjective' _ Ideal.Quotient.mk_surjective
    (maximalIdeal A).spanFinrank ≤ (maximalIdeal (A ⧸ P)).spanFinrank + P.spanFinrank := by
  letI : Nontrivial (A ⧸ P) := Ideal.Quotient.nontrivial_iff.mpr hP
  letI : IsLocalRing (A ⧸ P) := .of_surjective' _ Ideal.Quotient.mk_surjective
  have : IsLocalHom (Ideal.Quotient.mk P) := .of_surjective _ Ideal.Quotient.mk_surjective
  set s := (maximalIdeal (A ⧸ P)).generators
  have hsf : s.Finite := (IsNoetherian.noetherian _).finite_generators
  set t := P.generators
  have htf : t.Finite := (IsNoetherian.noetherian _).finite_generators
  let s' : Set A := Quotient.out '' s
  have hs'f : s'.Finite := hsf.image _
  have himg : Ideal.Quotient.mk P '' s' = s := by
    ext y
    simp only [s', Set.mem_image, exists_exists_and_eq_and]
    constructor
    · rintro ⟨x, hx, rfl⟩
      simpa [Ideal.Quotient.mk_out] using hx
    · intro hy
      exact ⟨y, hy, Ideal.Quotient.mk_out y⟩
  have hm : maximalIdeal A = Ideal.span (s' ∪ t) := by
    rw [Ideal.span_union, show Ideal.span t = P from Submodule.span_generators P,
      ← Ideal.mk_ker (I := P), ← Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective,
      Ideal.map_span, himg]
    have : Ideal.span s = maximalIdeal (A ⧸ P) := Submodule.span_generators _
    rw [this, IsLocalRing.maximalIdeal_comap]
  rw [hm]
  calc (Ideal.span (s' ∪ t)).spanFinrank ≤ (s' ∪ t).ncard :=
        Submodule.spanFinrank_span_le_ncard_of_finite (hs'f.union htf)
    _ ≤ s'.ncard + t.ncard := Set.ncard_union_le _ _
    _ ≤ s.ncard + t.ncard := by
        gcongr
        exact Set.ncard_image_le hsf
    _ = _ := by
        rw [(IsNoetherian.noetherian _).generators_ncard,
          (IsNoetherian.noetherian _).generators_ncard]

/-- `ht P + dim (A ⧸ P) ≤ dim A` for a prime `P`. -/
theorem height_add_ringKrullDim_quotient_le {A : Type*} [CommRing A] (P : Ideal A)
    [P.IsPrime] :
    (P.height : WithBot ℕ∞) + ringKrullDim (A ⧸ P) ≤ ringKrullDim A := by
  let p : PrimeSpectrum A := ⟨P, inferInstance⟩
  have h1 : P.height = Order.height p := PrimeSpectrum.height_eq_orderHeight p
  have hset : (PrimeSpectrum.zeroLocus (P : Set A)) = Set.Ici p := by
    ext q
    change (P : Set A) ⊆ q.asIdeal ↔ p ≤ q
    rfl
  have h2 : ringKrullDim (A ⧸ P) = Order.coheight p := by
    rw [ringKrullDim_quotient, Order.coheight_eq_krullDim_Ici, ← hset]
  have : Nonempty (PrimeSpectrum A) := ⟨p⟩
  rw [h1, h2, ← WithBot.coe_add, ringKrullDim,
    Order.krullDim_eq_iSup_height_add_coheight_of_nonempty, WithBot.coe_le_coe]
  exact le_iSup (fun a : PrimeSpectrum A ↦ Order.height a + Order.coheight a) p

/-- A Noetherian local ring is regular if it has a regular quotient by a prime
generated by at most `height` elements. This replaces Stacks Lemma 10.106.7
(no regular sequence is needed). -/
theorem isRegularLocalRing_of_quotient_of_spanFinrank_le_height
    {A : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (P : Ideal A) [P.IsPrime] [IsRegularLocalRing (A ⧸ P)]
    (h : (P.spanFinrank : ℕ∞) ≤ P.height) : IsRegularLocalRing A := by
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  have hle := spanFinrank_maximalIdeal_le_quotient_add P Ideal.IsPrime.ne_top'
  have hreg : ((maximalIdeal (A ⧸ P)).spanFinrank : WithBot ℕ∞) = ringKrullDim (A ⧸ P) :=
    IsRegularLocalRing.spanFinrank_maximalIdeal
  calc ((maximalIdeal A).spanFinrank : WithBot ℕ∞)
      ≤ (((maximalIdeal (A ⧸ P)).spanFinrank + P.spanFinrank : ℕ) : WithBot ℕ∞) := by
        exact_mod_cast hle
    _ = ringKrullDim (A ⧸ P) + ((P.spanFinrank : ℕ∞) : WithBot ℕ∞) := by
        rw [Nat.cast_add, hreg]; rfl
    _ ≤ ringKrullDim (A ⧸ P) + (P.height : WithBot ℕ∞) := by
        gcongr
        exact_mod_cast h
    _ = (P.height : WithBot ℕ∞) + ringKrullDim (A ⧸ P) := add_comm _ _
    _ ≤ ringKrullDim A := height_add_ringKrullDim_quotient_le P

/-- At a prime `p` with `R_p` regular, there is `g ∉ p` and an ideal `J ≤ p`
generated by `ht p` elements with `g p ⊆ J`. -/
theorem exists_spanFinrank_le_height_and_mul_mem_of_isRegularLocalRing
    {R : Type u} [CommRing R] [IsNoetherianRing R] (p : Ideal R) [p.IsPrime]
    [IsRegularLocalRing (Localization.AtPrime p)] :
    ∃ (J : Ideal R) (g : R), J ≤ p ∧ g ∉ p ∧ ((J.spanFinrank : ℕ∞) ≤ p.height) ∧
      ∀ x ∈ p, g * x ∈ J := by
  classical
  set Rp := Localization.AtPrime p
  set T := (maximalIdeal Rp).generators
  have hTf : T.Finite := (IsNoetherian.noetherian _).finite_generators
  have hTcard : (T.ncard : WithBot ℕ∞) = (p.height : WithBot ℕ∞) := by
    rw [(IsNoetherian.noetherian _).generators_ncard, IsRegularLocalRing.spanFinrank_maximalIdeal,
      IsLocalization.AtPrime.ringKrullDim_eq_height p Rp]
  have hTsub : T ⊆ p.map (algebraMap R Rp) := by
    rw [Localization.AtPrime.map_eq_maximalIdeal]
    exact Submodule.FG.generators_mem _
  have hchoice : ∀ t ∈ T, ∃ a ∈ p, ∃ s ∈ p.primeCompl,
      t * algebraMap R Rp s = algebraMap R Rp a := by
    intro t ht
    obtain ⟨⟨a, s⟩, e⟩ := (IsLocalization.mem_map_algebraMap_iff p.primeCompl Rp).mp (hTsub ht)
    exact ⟨a, a.2, s, s.2, e⟩
  choose! a ha sm hsm hes using hchoice
  set J : Ideal R := Ideal.span (a '' T)
  have hJp : J ≤ p := Ideal.span_le.mpr (by rintro _ ⟨t, ht, rfl⟩; exact ha t ht)
  have hJcard : (J.spanFinrank : ℕ∞) ≤ p.height := by
    have h1 : J.spanFinrank ≤ (a '' T).ncard :=
      Submodule.spanFinrank_span_le_ncard_of_finite (hTf.image a)
    have h2 : (a '' T).ncard ≤ T.ncard := Set.ncard_image_le hTf
    have h3 : ((T.ncard : ℕ∞) : WithBot ℕ∞) = (p.height : WithBot ℕ∞) := hTcard
    rw [WithBot.coe_inj] at h3
    rw [← h3]
    exact_mod_cast h1.trans h2
  -- `J R_p = p R_p`
  have hJmap : p.map (algebraMap R Rp) ≤ J.map (algebraMap R Rp) := by
    rw [Localization.AtPrime.map_eq_maximalIdeal, ← Submodule.span_generators (maximalIdeal Rp)]
    refine Submodule.span_le.mpr fun t ht ↦ ?_
    have hu : IsUnit (algebraMap R Rp (sm t)) :=
      IsLocalization.map_units Rp (⟨sm t, hsm t ht⟩ : p.primeCompl)
    have : t = algebraMap R Rp (a t) * hu.unit⁻¹ := by
      rw [← hes t ht, mul_assoc, IsUnit.mul_val_inv, mul_one]
    rw [this]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨t, ht, rfl⟩))
  -- generators of `p`
  set G := p.generators
  have hGf : G.Finite := (IsNoetherian.noetherian _).finite_generators
  have hgen : ∀ x ∈ G, ∃ u ∉ p, u * x ∈ J := by
    intro x hx
    have hxJ : algebraMap R Rp x ∈ J.map (algebraMap R Rp) :=
      hJmap (Ideal.mem_map_of_mem _ (Submodule.FG.generators_mem p hx))
    obtain ⟨⟨j, s⟩, e⟩ := (IsLocalization.mem_map_algebraMap_iff p.primeCompl Rp).mp hxJ
    rw [← map_mul, IsLocalization.eq_iff_exists p.primeCompl] at e
    obtain ⟨c, hc⟩ := e
    refine ⟨c * s, ?_, ?_⟩
    · exact p.primeCompl.mul_mem c.2 s.2
    · have : c * s * x = c * j := by rw [← hc]; ring
      rw [this]
      exact J.mul_mem_left _ j.2
  choose! u hu hux using hgen
  refine ⟨J, ∏ x ∈ hGf.toFinset, u x, hJp, ?_, hJcard, ?_⟩
  · exact Ideal.IsPrime.prod_mem_iff.not.mpr (by simpa using fun x hx ↦ hu x hx)
  · intro y hy
    rw [← Submodule.span_generators p] at hy
    induction hy using Submodule.span_induction with
    | mem x hx =>
      rw [← Finset.mul_prod_erase _ _ (hGf.mem_toFinset.mpr hx), mul_comm (u x), mul_assoc]
      exact J.mul_mem_left _ (hux x hx)
    | zero => simp
    | add x y _ _ hx hy => rw [mul_add]; exact J.add_mem hx hy
    | smul r x _ hx =>
      rw [smul_eq_mul, mul_left_comm]
      exact J.mul_mem_left _ hx

/-- `(R ⧸ p)_q ≅ R_q ⧸ p R_q` transports regularity. -/
theorem isRegularLocalRing_quotient_map_of_regular_quotient_localization
    {R : Type u} [CommRing R] (p q : Ideal R) [p.IsPrime] [q.IsPrime] (hpq : p ≤ q)
    [(q.map (Ideal.Quotient.mk p)).IsPrime]
    (h : IsRegularLocalRing (Localization.AtPrime (q.map (Ideal.Quotient.mk p)))) :
    IsRegularLocalRing
      (Localization.AtPrime q ⧸ p.map (algebraMap R (Localization.AtPrime q))) := by
  set Q := q.map (Ideal.Quotient.mk p)
  have hM : Algebra.algebraMapSubmonoid (R ⧸ p) q.primeCompl = Q.primeCompl := by
    ext x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    constructor
    · rintro ⟨z, hz, e⟩
      change Ideal.Quotient.mk p z = Ideal.Quotient.mk p y at e
      change Ideal.Quotient.mk p y ∉ Q
      rw [← e, Ideal.mem_quotient_iff_mem hpq]
      exact hz
    · intro hy
      refine ⟨y, ?_, rfl⟩
      change y ∉ q
      rwa [← Ideal.mem_quotient_iff_mem hpq]
  have inst : IsLocalization (Algebra.algebraMapSubmonoid (R ⧸ p) q.primeCompl)
      (Localization.AtPrime q ⧸ p.map (algebraMap R (Localization.AtPrime q))) :=
    inferInstance
  rw [hM] at inst
  exact IsRegularLocalRing.of_ringEquiv
    (IsLocalization.algEquiv Q.primeCompl (Localization.AtPrime Q) _).toRingEquiv

/-- **Nagata's criterion** (Stacks Lemma 15.48.3, with Lemma 15.48.2). If `R` is
Noetherian and, for every prime `p`, the regular locus of `R ⧸ p` contains a
nonempty basic open set `D(h̄)`, then the regular locus of `R` is open. -/
@[stacks 07P9 "J-0 of each R ⧸ p phrased as a nonempty basic open D(h̄) ⊆ Reg(R ⧸ p)"]
theorem isOpen_primeRegularLocus_of_forall_quotient
    (R : Type u) [CommRing R] [IsNoetherianRing R]
    (H : ∀ p : Ideal R, p.IsPrime → ∃ h : R, h ∉ p ∧ ∀ Q : PrimeSpectrum (R ⧸ p),
      Ideal.Quotient.mk p h ∉ Q.asIdeal → Q ∈ primeRegularLocus (R ⧸ p)) :
    IsOpen (primeRegularLocus R) := by
  apply isOpen_of_stableUnderGeneralization_of_forall_nhds_inter_closure
  · intro x y hyx hx
    exact primeRegularLocus_generization_closed R y x
      ((PrimeSpectrum.le_iff_specializes y x).mpr hyx) hx
  · intro p hp
    have : IsRegularLocalRing (Localization.AtPrime p.asIdeal) := hp
    obtain ⟨J, g, hJp, hgp, hJcard, hgJ⟩ :=
      exists_spanFinrank_le_height_and_mul_mem_of_isRegularLocalRing p.asIdeal
    obtain ⟨h, hhp, hH⟩ := H p.asIdeal inferInstance
    refine ⟨PrimeSpectrum.basicOpen (g * h), (PrimeSpectrum.basicOpen (g * h)).2, ?_, ?_⟩
    · exact fun hm ↦ (Ideal.IsPrime.mul_mem_iff_mem_or_mem inferInstance).mp hm |>.elim hgp hhp
    rintro q ⟨hqU, hqcl⟩
    have hpq : p.asIdeal ≤ q.asIdeal :=
      (PrimeSpectrum.le_iff_specializes p q).mpr (specializes_iff_mem_closure.mpr hqcl)
    have hgq : g ∉ q.asIdeal := fun hg ↦ hqU (Ideal.mul_mem_right _ _ hg)
    have hhq : h ∉ q.asIdeal := fun hh ↦ hqU (Ideal.mul_mem_left _ _ hh)
    set Rq := Localization.AtPrime q.asIdeal
    set P' := p.asIdeal.map (algebraMap R Rq)
    have : P'.IsPrime := Ideal.isPrime_map_of_isLocalizationAtPrime q.asIdeal hpq
    -- `P' = J R_q`
    have hP'J : P' = J.map (algebraMap R Rq) := by
      refine le_antisymm (Ideal.map_le_iff_le_comap.mpr fun x hx ↦ ?_) (Ideal.map_mono hJp)
      have hu : IsUnit (algebraMap R Rq g) :=
        IsLocalization.map_units Rq (⟨g, hgq⟩ : q.asIdeal.primeCompl)
      have hgx : algebraMap R Rq (g * x) ∈ J.map (algebraMap R Rq) :=
        Ideal.mem_map_of_mem _ (hgJ x hx)
      rw [map_mul] at hgx
      have : algebraMap R Rq x = hu.unit⁻¹ * (algebraMap R Rq g * algebraMap R Rq x) := by
        rw [← mul_assoc, IsUnit.val_inv_mul, one_mul]
      change algebraMap R Rq x ∈ J.map (algebraMap R Rq)
      rw [this]
      exact Ideal.mul_mem_left _ _ hgx
    have hspan : (P'.spanFinrank : ℕ∞) ≤ P'.height := by
      rw [IsLocalization.height_map_of_disjoint q.asIdeal.primeCompl p.asIdeal
        (Set.disjoint_left.mpr fun x hx hxp ↦ hx (hpq hxp))]
      refine le_trans ?_ hJcard
      rw [hP'J]
      exact_mod_cast Ideal.spanFinrank_map_le_of_fg _ (IsNoetherian.noetherian J)
    have hQ : (q.asIdeal.map (Ideal.Quotient.mk p.asIdeal)).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rwa [Ideal.mk_ker])
    have hreg := hH ⟨_, hQ⟩ (by
      change Ideal.Quotient.mk p.asIdeal h ∉ q.asIdeal.map (Ideal.Quotient.mk p.asIdeal)
      rwa [Ideal.mem_quotient_iff_mem hpq])
    have : IsRegularLocalRing (Rq ⧸ P') :=
      isRegularLocalRing_quotient_map_of_regular_quotient_localization p.asIdeal q.asIdeal hpq hreg
    exact isRegularLocalRing_of_quotient_of_spanFinrank_le_height P' hspan

#print axioms spanFinrank_maximalIdeal_le_quotient_add
#print axioms height_add_ringKrullDim_quotient_le
#print axioms isRegularLocalRing_of_quotient_of_spanFinrank_le_height
#print axioms exists_spanFinrank_le_height_and_mul_mem_of_isRegularLocalRing
#print axioms isRegularLocalRing_quotient_map_of_regular_quotient_localization
#print axioms isOpen_primeRegularLocus_of_forall_quotient

end Pcf
