module

public import Pcf.LocalModel
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Nilpotent.Lemmas

/-!
# Step 3 of Theorem `thm:bounding`, completed on the standard piece

`Pcf/LocalModel.lean` proves that for `C = R[z]/(z^e − u a)` the restriction map
`R/(a) → C/(z)` is bijective (`Pcf.LocalModel.restrictionMap_bijective`). Equation
`eq:standard-piece` of `latex/paper-p.tex` says more: `(C/aC)_red = C/zC`, "because the regular
ring `R/aR` is reduced, so that `z` generates the nilradical of `C/aC`". This file proves
that sentence — `√(aC) = (z)` whenever `R/(a)` is reduced — and identifies the restriction
map with the canonical quotient map `Ideal.quotientMap`, which is the form in which
`Pcf/Bounding/LocalStructure.lean` consumes it.
-/

@[expose] public section

namespace Pcf.LocalModel

open Polynomial

variable {R : Type*} [CommRing R] (u : Rˣ) (a : R) {e : ℕ}

/-- `(a) ⊆ (z)` in `C`, as an inequality of ideals. -/
theorem span_algebraMap_le_span_root (he : 1 ≤ e) :
    Ideal.span {algebraMap R (AdjoinRoot (localPoly u a e)) a}
      ≤ Ideal.span {AdjoinRoot.root (localPoly u a e)} :=
  Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (algebraMap_mem_span_root u a he))

/-- The ideal `(z)` is radical when `R/(a)` is reduced, because `C/(z) ≅ R/(a)`. -/
theorem span_root_isRadical (he : 1 ≤ e) [IsReduced (R ⧸ Ideal.span ({a} : Set R))] :
    (Ideal.span {AdjoinRoot.root (localPoly u a e)}).IsRadical := by
  intro x hx
  obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hx
  have hred : IsReduced (AdjoinRoot (localPoly u a e) ⧸
      Ideal.span ({AdjoinRoot.root (localPoly u a e)} :
        Set (AdjoinRoot (localPoly u a e)))) :=
    isReduced_of_injective (quotientRootEquiv u a he).toRingHom
      (quotientRootEquiv u a he).injective
  have h0 : (Ideal.Quotient.mk _ x : AdjoinRoot (localPoly u a e) ⧸
      Ideal.span ({AdjoinRoot.root (localPoly u a e)} :
        Set (AdjoinRoot (localPoly u a e)))) ^ n = 0 := by
    rw [← map_pow]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hn
  exact Ideal.Quotient.eq_zero_iff_mem.mp (IsNilpotent.eq_zero ⟨n, h0⟩)

/-- **Equation `eq:standard-piece`.** The nilradical of `C/aC` is generated by `z`: as
ideals of `C`, `√(aC) = (z)`, provided `R/(a)` is reduced (in the manuscript, because it
is regular). -/
theorem radical_span_algebraMap_eq_span_root (he : 1 ≤ e)
    [IsReduced (R ⧸ Ideal.span ({a} : Set R))] :
    (Ideal.span {algebraMap R (AdjoinRoot (localPoly u a e)) a}).radical
      = Ideal.span {AdjoinRoot.root (localPoly u a e)} := by
  apply le_antisymm
  · exact (span_root_isRadical u a he).radical_le_iff.mpr (span_algebraMap_le_span_root u a he)
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_radical_iff]
    exact ⟨e, root_pow_mem_span_algebraMap u a⟩

/-- `(a) ≤ (z)` pulled back to `R`: the hypothesis `Ideal.quotientMap` needs. -/
theorem span_le_comap_span_root (he : 1 ≤ e) :
    Ideal.span ({a} : Set R)
      ≤ (Ideal.span {AdjoinRoot.root (localPoly u a e)}).comap
          (algebraMap R (AdjoinRoot (localPoly u a e))) :=
  Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (algebraMap_mem_span_root u a he))

/-- The canonical quotient map `R/(a) → C/(z)` induced by `R → C` is, as a function,
`Pcf.LocalModel.restrictionMap`. -/
theorem coe_quotientMap_eq_restrictionMap (he : 1 ≤ e) :
    ⇑(Ideal.quotientMap (Ideal.span {AdjoinRoot.root (localPoly u a e)})
        (algebraMap R (AdjoinRoot (localPoly u a e))) (span_le_comap_span_root u a he))
      = ⇑(restrictionMap u a he) := by
  funext x
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [Ideal.quotientMap_mk, restrictionMap_mk]

/-- **Step 3, in the form Step 4 consumes.** The canonical map `R/(a) → C/(z)` is
bijective. -/
theorem quotientMap_bijective (he : 1 ≤ e) :
    Function.Bijective (Ideal.quotientMap (Ideal.span {AdjoinRoot.root (localPoly u a e)})
        (algebraMap R (AdjoinRoot (localPoly u a e))) (span_le_comap_span_root u a he)) := by
  rw [coe_quotientMap_eq_restrictionMap]
  exact restrictionMap_bijective u a he

/-- `z^e ∈ (a)`: the root is nilpotent modulo `a`, in the form the local-structure lemma
takes. -/
theorem root_pow_mem_span_algebraMap_of_le :
    ∃ n, AdjoinRoot.root (localPoly u a e) ^ n
      ∈ Ideal.span {algebraMap R (AdjoinRoot (localPoly u a e)) a} :=
  ⟨e, root_pow_mem_span_algebraMap u a⟩

end Pcf.LocalModel
