module

public import Mathlib.RingTheory.Etale.StandardEtale
public import Mathlib.RingTheory.Unramified.LocalRing
public import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic
public import Mathlib.RingTheory.Adjoin.Polynomial.Basic

/-!
# Monogenic extensions with coprime derivative are unramified

Let `f ∈ O[X]` be monic with `f` coprime to `f'`, and let `θ` be a root of
`f` in an `O`-algebra. Then `O[X]/(f)` is standard étale over `O`, so its
quotient `O[θ]` is formally unramified. Consequently, at every prime `P` of
`O[θ]` over `p`, the extension of `p` generates the maximal ideal of the
localization. This is the unramified separable step in the proof of
`latex/paper-p.tex`, Lemma `lem:primary-fibres`.
-/

@[expose] public section

namespace Pcf.Bounding

open Polynomial IsLocalRing

variable {O S : Type*} [CommRing O] [CommRing S] [Algebra O S]

/-- `O[X]/(f)` is formally unramified when `f` is monic and coprime to `f'`. -/
theorem adjoinRoot_formallyUnramified_of_isCoprime_derivative
    (f : O[X]) (hf : f.Monic) (hcop : IsCoprime f (derivative f)) :
    Algebra.FormallyUnramified O (AdjoinRoot f) := by
  let SP : StandardEtalePair O :=
    { f := f
      monic_f := hf
      g := 1
      cond := by
        obtain ⟨a, b, h⟩ := hcop
        exact ⟨b, a, 1, by rw [one_pow, ← h]; ring⟩ }
  have : Algebra.FormallyUnramified O SP.Ring := inferInstance
  have : Algebra.FormallyUnramified O
      (Localization.Away (AdjoinRoot.mk f (1 : O[X]))) :=
    Algebra.FormallyUnramified.of_equiv SP.equivAwayAdjoinRoot
  have hunits : Submonoid.powers (AdjoinRoot.mk f (1 : O[X])) ≤
      IsUnit.submonoid (AdjoinRoot f) := by
    rintro _ ⟨n, rfl⟩
    simp
  exact Algebra.FormallyUnramified.of_equiv
    ((IsLocalization.atUnits (AdjoinRoot f) (Submonoid.powers _)
      (S := Localization.Away (AdjoinRoot.mk f (1 : O[X]))) hunits).restrictScalars O).symm

/-- A monogenic algebra generated by a root of a monic polynomial coprime to
its derivative is formally unramified. -/
theorem adjoin_formallyUnramified_of_isCoprime_derivative
    (f : O[X]) (hf : f.Monic) (hcop : IsCoprime f (derivative f))
    {θ : S} (hθ : aeval θ f = 0) :
    Algebra.FormallyUnramified O (Algebra.adjoin O ({θ} : Set S)) := by
  have := adjoinRoot_formallyUnramified_of_isCoprime_derivative f hf hcop
  let θ' : Algebra.adjoin O ({θ} : Set S) := ⟨θ, Algebra.subset_adjoin rfl⟩
  have hθ' : aeval θ' f = 0 := by
    apply Subtype.ext
    rw [← Subalgebra.aeval_coe]
    exact hθ
  let φ := AdjoinRoot.liftAlgHom f (Algebra.ofId O _) θ' hθ'
  refine Algebra.FormallyUnramified.of_surjective φ ?_
  rintro ⟨y, hy⟩
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hy
  obtain ⟨q, rfl⟩ := hy
  refine ⟨AdjoinRoot.mk f q, ?_⟩
  have h1 : φ (AdjoinRoot.mk f q) = aeval θ' q := by
    rfl
  apply Subtype.ext
  rw [h1]
  exact (Subalgebra.aeval_coe _ θ' q).symm

/-- **Unramified primes of a monogenic extension.** If `θ` is a root of a
monic polynomial coprime to its derivative, every prime `P` of `O[θ]` over
`p` satisfies `p · O[θ]_P = P · O[θ]_P`. -/
theorem adjoin_map_eq_maximalIdeal_of_isCoprime_derivative
    (f : O[X]) (hf : f.Monic) (hcop : IsCoprime f (derivative f))
    {θ : S} (hθ : aeval θ f = 0)
    (p : Ideal O) [p.IsPrime]
    (P : Ideal (Algebra.adjoin O ({θ} : Set S))) [P.IsPrime] [P.LiesOver p] :
    p.map (algebraMap O (Localization.AtPrime P)) = maximalIdeal _ := by
  have := adjoin_formallyUnramified_of_isCoprime_derivative f hf hcop hθ
  have hint : IsIntegral O θ := ⟨f, hf, by rwa [← aeval_def]⟩
  have : Module.Finite O (Algebra.adjoin O ({θ} : Set S)) :=
    Algebra.finite_adjoin_simple_of_isIntegral hint
  let _ := Localization.AtPrime.algebraOfLiesOver p P
  exact ((Algebra.isUnramifiedAt_iff_map_eq O p P).mp inferInstance).2

#print axioms adjoinRoot_formallyUnramified_of_isCoprime_derivative
#print axioms adjoin_formallyUnramified_of_isCoprime_derivative
#print axioms adjoin_map_eq_maximalIdeal_of_isCoprime_derivative

end Pcf.Bounding
