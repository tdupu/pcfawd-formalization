module

public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# Projective charts selected by the homogeneous coordinate forms

This formalizes the target-coordinate half of the open cover used in
`paper-p.tex`, Lemma `lem:jacobian`: homogeneous forms defining a
projective morphism have no common projective zero, so their basic opens
cover the actual projective-spectrum scheme. It does not construct the
degree-`d` morphism itself.
-/

@[expose] public section

namespace Pcf

open AlgebraicGeometry MvPolynomial TopologicalSpace HomogeneousLocalization

universe u

variable {K : Type u} [Field K] {n : ℕ}

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The standard algebraic condition that the forms `F_i` have no common
projective zero. -/
def PaperPFormsCoverProjective
    (F : Fin n ⊕ Unit → MvPolynomial (Fin n ⊕ Unit) K) : Prop :=
  (HomogeneousIdeal.irrelevant
    (MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K)).toIdeal ≤
      (Ideal.span (Set.range F)).radical

-- The radical in the hypothesis matters: the coordinatewise power map
-- has no common projective zero although `(X_i^d)_i` does not generate
-- the irrelevant ideal itself when `d > 1`.

/-- Every projective point lies on a target-coordinate chart selected
by one of the defining homogeneous forms. -/
theorem paperPForms_basicOpen_cover
    (F : Fin n ⊕ Unit → MvPolynomial (Fin n ⊕ Unit) K)
    (hcover : PaperPFormsCoverProjective F) :
    ⨆ i, Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K) (F i) = ⊤ := by
  classical
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K
  refine top_le_iff.mp fun x hx => TopologicalSpace.Opens.mem_iSup.mpr ?_
  by_contra! H
  simp only [Proj.mem_basicOpen, Decidable.not_not] at H
  have hspan : Ideal.span (Set.range F) ≤ x.asHomogeneousIdeal.toIdeal := by
    rwa [Ideal.span_le, Set.range_subset_iff]
  exact x.not_irrelevant_le
    (hcover.trans
      ((show Ideal.IsPrime x.asHomogeneousIdeal.toIdeal from x.isPrime).radical_le_iff.mpr
        hspan))

/-- The forms give an actual affine-open cover of projective spectrum,
even when their ideal contains only a power of the irrelevant ideal. -/
noncomputable def paperPFormsAffineOpenCover
    (F : Fin n ⊕ Unit → MvPolynomial (Fin n ⊕ Unit) K)
    (d : ℕ) (hd : 0 < d) (hF : ∀ i, (F i).IsHomogeneous d)
    (hcover : PaperPFormsCoverProjective F) :
    (Proj (MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K)).AffineOpenCover := by
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K
  let hf (i : Fin n ⊕ Unit) : F i ∈ 𝒜 d := hF i
  refine {
    I₀ := Fin n ⊕ Unit
    X i := ↧(Away 𝒜 (F i))
    f i := Proj.awayι 𝒜 (F i) (hf i) hd
    idx x := (TopologicalSpace.Opens.mem_iSup.mp
      ((paperPForms_basicOpen_cover F hcover).ge (Set.mem_univ x))).choose
    covers x := ?_
    map_prop := by intro j; infer_instance }
  change x ∈ (Proj.awayι 𝒜 (F _) (hf _) hd).opensRange
  rw [Proj.opensRange_awayι]
  exact (TopologicalSpace.Opens.mem_iSup.mp
    ((paperPForms_basicOpen_cover F hcover).ge (Set.mem_univ x))).choose_spec

#print axioms paperPForms_basicOpen_cover
#print axioms paperPFormsAffineOpenCover

/-- In a polynomial ring, every positive-degree homogeneous element
belongs to the ideal generated by the coordinates. -/
theorem paperPIrrelevant_le_coordinateIdeal :
    (HomogeneousIdeal.irrelevant
      (MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K)).toIdeal ≤
      MvPolynomial.idealOfVars (Fin n ⊕ Unit) K := by
  classical
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K
  rw [HomogeneousIdeal.irrelevant_eq_span]
  apply Ideal.span_le.mpr
  intro P hP
  rcases Set.mem_iUnion.mp hP with ⟨i, hP⟩
  rcases Set.mem_iUnion.mp hP with ⟨hi, hPi⟩
  have hHom : P.IsHomogeneous i := hPi
  change P ∈ MvPolynomial.idealOfVars (Fin n ⊕ Unit) K
  rw [← pow_one (MvPolynomial.idealOfVars (Fin n ⊕ Unit) K)]
  apply (MvPolynomial.mem_pow_idealOfVars_iff
    (σ := Fin n ⊕ Unit) (R := K) 1 P).mpr
  intro s hs
  have hsdeg := hHom.degree_eq_sum_deg_support hs
  change 1 ≤ ∑ j ∈ s.support, s j
  omega

/-- The ordinary source-coordinate charts `D₊(x_a)` cover projective
space. This is the other half of the chart cover used in `lem:jacobian`. -/
theorem paperPSourceCoordinates_basicOpen_cover :
    ⨆ i : Fin n ⊕ Unit,
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K)
        (MvPolynomial.X i) = ⊤ := by
  apply Proj.iSup_basicOpen_eq_top
    (MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K) MvPolynomial.X
  exact paperPIrrelevant_le_coordinateIdeal (K := K) (n := n)

#print axioms paperPSourceCoordinates_basicOpen_cover

/-- The opens `{x_a ≠ 0, F_b ≠ 0}` used in the manuscript's proof
cover the actual projective-spectrum scheme. -/
theorem paperPProjective_chart_cover
    (F : Fin n ⊕ Unit → MvPolynomial (Fin n ⊕ Unit) K)
    (hcover : PaperPFormsCoverProjective F) :
    ∀ ξ : Proj (MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K),
      ∃ a b : Fin n ⊕ Unit,
        ξ ∈ (Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K) (X a) ⊓
          Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K) (F b)) := by
  intro ξ
  obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp
    ((paperPSourceCoordinates_basicOpen_cover (K := K) (n := n)).ge
      (Set.mem_univ ξ))
  obtain ⟨b, hb⟩ := TopologicalSpace.Opens.mem_iSup.mp
    ((paperPForms_basicOpen_cover F hcover).ge (Set.mem_univ ξ))
  exact ⟨a, b, ha, hb⟩

#print axioms paperPProjective_chart_cover

/-- The intersection chart `x_a ≠ 0, F_b ≠ 0` is represented by an
explicit affine open immersion of the corresponding homogeneous
localization. -/
theorem paperPDoubleChart_homogeneous
    (F : Fin n ⊕ Unit → MvPolynomial (Fin n ⊕ Unit) K)
    (d : ℕ) (hF : ∀ i, (F i).IsHomogeneous d)
    (a b : Fin n ⊕ Unit) :
    X a * F b ∈ MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K (1 + d) :=
  (MvPolynomial.isHomogeneous_X K a).mul (hF b)

theorem paperPDoubleChart_degree (d : ℕ) : 0 < 1 + d := by omega

noncomputable def paperPProjectiveDoubleChart
    (F : Fin n ⊕ Unit → MvPolynomial (Fin n ⊕ Unit) K)
    (d : ℕ) (hF : ∀ i, (F i).IsHomogeneous d)
    (a b : Fin n ⊕ Unit) :
    Spec (↧(Away (MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K)
      (X a * F b))) ⟶
      Proj (MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K) :=
  Proj.awayι _ (X a * F b)
    (paperPDoubleChart_homogeneous F d hF a b) (paperPDoubleChart_degree d)

instance paperPProjectiveDoubleChart_isOpenImmersion
    (F : Fin n ⊕ Unit → MvPolynomial (Fin n ⊕ Unit) K)
    (d : ℕ) (hF : ∀ i, (F i).IsHomogeneous d)
    (a b : Fin n ⊕ Unit) :
    IsOpenImmersion (paperPProjectiveDoubleChart F d hF a b) := by
  exact (inferInstance : IsOpenImmersion
    (Proj.awayι _ (X a * F b)
      (paperPDoubleChart_homogeneous F d hF a b) (paperPDoubleChart_degree d)))

/-- The affine model above has precisely the double-chart open range. -/
theorem paperPProjectiveDoubleChart_opensRange
    (F : Fin n ⊕ Unit → MvPolynomial (Fin n ⊕ Unit) K)
    (d : ℕ) (hF : ∀ i, (F i).IsHomogeneous d)
    (a b : Fin n ⊕ Unit) :
    (paperPProjectiveDoubleChart F d hF a b).opensRange =
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K) (X a) ⊓
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K) (F b) := by
  exact (Proj.opensRange_awayι _ (X a * F b)
    (paperPDoubleChart_homogeneous F d hF a b) (paperPDoubleChart_degree d)).trans
      (Proj.basicOpen_mul _ _ _)

/-- The actual affine source charts `Spec ((K[X]_(x_a F_b))₀)` cover the
projective source whenever the forms have no common projective zero.

`paper-p.tex` correspondence: Lemma 4.1 (`lem:jacobian`). -/
theorem paperPProjectiveDoubleChart_cover
    (F : Fin n ⊕ Unit → MvPolynomial (Fin n ⊕ Unit) K)
    (d : ℕ) (hF : ∀ i, (F i).IsHomogeneous d)
    (hcover : PaperPFormsCoverProjective F) :
    ⨆ ab : (Fin n ⊕ Unit) × (Fin n ⊕ Unit),
      (paperPProjectiveDoubleChart F d hF ab.1 ab.2).opensRange = ⊤ := by
  ext ξ
  constructor
  · intro _
    trivial
  intro _
  obtain ⟨a, b, ha, hb⟩ := paperPProjective_chart_cover F hcover ξ
  apply TopologicalSpace.Opens.mem_iSup.mpr
  refine ⟨(a, b), ?_⟩
  rw [paperPProjectiveDoubleChart_opensRange]
  exact ⟨ha, hb⟩

#print axioms paperPProjectiveDoubleChart
#print axioms paperPProjectiveDoubleChart_opensRange
#print axioms paperPProjectiveDoubleChart_cover

/-- Coordinatewise positive-degree powers, including the manuscript's
squaring example, satisfy the radical no-common-zero condition. -/
theorem paperPCoordinatePowers_cover (d : ℕ) :
    PaperPFormsCoverProjective (K := K) (n := n)
      (fun i : Fin n ⊕ Unit => (X i) ^ d) := by
  apply (paperPIrrelevant_le_coordinateIdeal (K := K) (n := n)).trans
  change Ideal.span (Set.range (X : Fin n ⊕ Unit → MvPolynomial (Fin n ⊕ Unit) K)) ≤
    (Ideal.span (Set.range (fun i : Fin n ⊕ Unit => (X i) ^ d))).radical
  rw [Ideal.span_le, Set.range_subset_iff]
  intro i
  exact Ideal.mem_radical_iff.mpr ⟨d, Ideal.subset_span ⟨i, rfl⟩⟩

#print axioms paperPCoordinatePowers_cover

end Pcf
