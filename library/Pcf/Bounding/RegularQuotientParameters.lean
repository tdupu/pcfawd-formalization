module

public import Pcf.Vendor.RegularLocalization.RegularLocalRingBasic
public import Mathlib.LinearAlgebra.LinearIndependent.Lemmas
public import Mathlib.RingTheory.KrullDimension.NonZeroDivisors

/-!
# Parameters for a regular quotient of a regular local ring

If `R` is a regular local ring and `R ⧸ I` is regular, then `I` is generated by
part of a regular system of parameters of `R` (Stacks Project Tag `00NR`).
We record the stronger form used by the Jacobian criterion: `I` is generated by
finitely many elements whose classes in `m / m²` are linearly independent.
-/

@[expose] public section

namespace Pcf

open IsLocalRing

universe u

variable {R : Type u} [CommRing R]

/-- Choose finitely many elements of an ideal whose cotangent classes are
independent and span the image of the ideal in the cotangent space. -/
theorem exists_finset_cotangent_basis_of_ideal [IsLocalRing R] [IsNoetherianRing R]
    (I : Ideal R) (hI : I ≤ maximalIdeal R) :
    ∃ (S : Finset R) (hS : (S : Set R) ⊆ maximalIdeal R), (S : Set R) ⊆ I ∧
      LinearIndependent (ResidueField R) ((maximalIdeal R).toCotangent ∘ Set.inclusion hS) ∧
      Submodule.span (ResidueField R)
          (Set.range ((maximalIdeal R).toCotangent ∘ Set.inclusion hS)) =
        Submodule.span (ResidueField R)
          (Set.range (fun x : I ↦ (maximalIdeal R).toCotangent ⟨x, hI x.2⟩)) := by
  classical
  let v : I → CotangentSpace R := fun x ↦ (maximalIdeal R).toCotangent ⟨x, hI x.2⟩
  obtain ⟨ι, a, ha, hspan, hli⟩ := exists_linearIndependent' (ResidueField R) v
  have : Finite ι := hli.finite
  let := Fintype.ofFinite ι
  let g : ι → R := fun i ↦ ((a i : I) : R)
  have hg : Function.Injective g := fun i j h ↦ ha (Subtype.ext h)
  let S : Finset R := Finset.univ.image g
  have hSI : (S : Set R) ⊆ I := by
    intro x hx
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hx
    exact (a i).2
  have hSm : (S : Set R) ⊆ maximalIdeal R := fun x hx ↦ hI (hSI hx)
  let b : ι → S := fun i ↦ ⟨g i, Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩⟩
  have hb : Function.Bijective b := by
    constructor
    · intro i j h
      exact hg (by simpa [b] using congrArg (fun s : S ↦ (s : R)) h)
    · intro s
      obtain ⟨i, _, hi⟩ := Finset.mem_image.mp s.2
      exact ⟨i, Subtype.ext hi⟩
  let e := Equiv.ofBijective b hb
  let w := (maximalIdeal R).toCotangent ∘ Set.inclusion hSm
  have hcomp : w ∘ e = v ∘ a := rfl
  have hrange : Set.range w = Set.range (v ∘ a) := by
    rw [← hcomp]
    exact (e.surjective.range_comp w).symm
  refine ⟨S, hSm, hSI, (linearIndependent_equiv' e hcomp).mp hli, ?_⟩
  change Submodule.span _ (Set.range w) = _
  rw [hrange, hspan]

/-- The core of Stacks Lemma 10.106.4: the ideal of a regular quotient of a
regular local ring is generated by finitely many elements whose classes in
`m / m²` are linearly independent. -/
theorem exists_finset_span_eq_linearIndependent_of_regular_quotient [IsRegularLocalRing R]
    (I : Ideal R) [IsRegularLocalRing (R ⧸ I)] :
    ∃ (S : Finset R) (hS : (S : Set R) ⊆ maximalIdeal R),
      Ideal.span (S : Set R) = I ∧
      LinearIndependent (ResidueField R) ((maximalIdeal R).toCotangent ∘ Set.inclusion hS) := by
  classical
  have hI : I ≤ maximalIdeal R :=
    le_maximalIdeal (Ideal.Quotient.nontrivial_iff.mp inferInstance)
  obtain ⟨S, hSm, hSI, hli, hspan⟩ := exists_finset_cotangent_basis_of_ideal I hI
  refine ⟨S, hSm, ?_, hli⟩
  obtain ⟨hreg, hdim⟩ :=
    ((Vendor.quotient_isRegularLocalRing_tfae R S hSm).out 2 3).mp hli
  have hJ : Ideal.span (S : Set R) ≤ I := Ideal.span_le.mpr hSI
  -- the image of `I` in `m/m²` has dimension `card S`
  have himg : (Submodule.comap (maximalIdeal R).subtype
      (RingHom.ker (algebraMap R (R ⧸ I)))).map (toCotangentSpace R) =
        Submodule.span (ResidueField R)
          (Set.range ((maximalIdeal R).toCotangent ∘ Set.inclusion hSm)) := by
    rw [hspan]
    apply le_antisymm
    · rintro _ ⟨x, hx, rfl⟩
      have hx' : (x : R) ∈ I := by
        simpa [Ideal.Quotient.algebraMap_eq] using hx
      exact Submodule.subset_span ⟨⟨x, hx'⟩, by simp [toCotangentSpace_eq_toCotangent]⟩
    · rw [Submodule.span_le]
      rintro _ ⟨x, rfl⟩
      refine ⟨⟨x, hI x.2⟩, ?_, by simp [toCotangentSpace_eq_toCotangent]⟩
      simp [Ideal.Quotient.algebraMap_eq]
  have : IsLocalHom (algebraMap R (R ⧸ I)) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  have hdimI := spanFinrank_maximalIdeal_add_finrank_eq_of_surjective
    (S := R ⧸ I) (Ideal.Quotient.mk_surjective (I := I))
  rw [himg, finrank_span_eq_card hli] at hdimI
  simp only [Finset.coe_sort_coe, Fintype.card_coe] at hdimI
  have hdimI' : ringKrullDim (R ⧸ I) + (S.card : WithBot ℕ∞) = ringKrullDim R := by
    rw [← (isRegularLocalRing_iff (R ⧸ I)).mp inferInstance,
      ← (isRegularLocalRing_iff R).mp inferInstance, ← hdimI]
    norm_cast
  have heqdim : ringKrullDim (R ⧸ Ideal.span (S : Set R)) = ringKrullDim (R ⧸ I) :=
    ENat.WithBot.add_natCast_cancel.mp (hdim.trans hdimI'.symm)
  by_contra hne
  obtain ⟨x, hxI, hxJ⟩ := IsConcreteLE.exists_of_lt (lt_of_le_of_ne hJ hne)
  have : IsDomain (R ⧸ Ideal.span (S : Set R)) := Vendor.isDomain_of_isRegularLocalRing _
  have hx0 : (Ideal.Quotient.mk (Ideal.span (S : Set R))) x ≠ 0 := by
    simpa [Ideal.Quotient.eq_zero_iff_mem] using hxJ
  have hdrop := ringKrullDim_succ_le_of_surjective (Ideal.Quotient.factor hJ)
    (Ideal.Quotient.factor_surjective hJ)
    (mem_nonZeroDivisors_iff_ne_zero.mpr hx0)
    (by simpa [Ideal.Quotient.factor_mk, Ideal.Quotient.eq_zero_iff_mem] using hxI)
  rw [heqdim, ← (isRegularLocalRing_iff (R ⧸ I)).mp inferInstance] at hdrop
  norm_cast at hdrop
  omega

/-- If `R` and `R ⧸ I` are regular local rings, then `I ∩ m² ⊆ m I`. Equivalently,
`I ⊗ κ → m / m²` is injective. This is the form of Stacks `00NR` used by the
Jacobian criterion. -/
theorem inf_sq_le_smul_of_regular_quotient [IsRegularLocalRing R]
    (I : Ideal R) [IsRegularLocalRing (R ⧸ I)] :
    I ⊓ maximalIdeal R ^ 2 ≤ maximalIdeal R • I := by
  classical
  obtain ⟨S, hSm, hspan, hli⟩ := exists_finset_span_eq_linearIndependent_of_regular_quotient I
  rintro x ⟨hxI, hx2⟩
  rw [← hspan] at hxI
  obtain ⟨a, rfl⟩ := Submodule.mem_span_finset'.mp hxI
  have hxm : (∑ s : (S : Set R), a s • (s : R)) ∈ maximalIdeal R :=
    Ideal.sum_mem _ fun s _ ↦ Ideal.mul_mem_left _ _ (hSm s.2)
  have hzero : (maximalIdeal R).toCotangent ⟨_, hxm⟩ = 0 :=
    (Ideal.toCotangent_eq_zero _ _).mpr hx2
  have hsum : (maximalIdeal R).toCotangent ⟨_, hxm⟩ =
      ∑ s : (S : Set R), (residue R (a s)) •
        ((maximalIdeal R).toCotangent ∘ Set.inclusion hSm) s := by
    have hel : (⟨_, hxm⟩ : maximalIdeal R) =
        ∑ s : (S : Set R), a s • (⟨s, hSm s.2⟩ : maximalIdeal R) := by
      ext
      simp
    rw [hel, map_sum]
    refine Finset.sum_congr rfl fun s _ ↦ ?_
    rw [map_smul, ← ResidueField.algebraMap_eq, algebraMap_smul]
    rfl
  have ha := (Fintype.linearIndependent_iff.mp hli) _ (hsum ▸ hzero)
  refine Submodule.sum_mem _ fun s _ ↦ Submodule.smul_mem_smul ?_ ?_
  · have := ha s
    simpa [residue_eq_zero_iff] using this
  · rw [← hspan]
    exact Ideal.subset_span s.2

/-- Stacks Lemma 10.106.4. Let `R` be a regular local ring and `I` an ideal with
`R ⧸ I` regular local. Then a minimal generating set `T` of the maximal ideal
(of cardinality `dim R`) contains a subset `S` generating `I`. -/
@[stacks 00NR]
theorem exists_parameters_of_regular_quotient [IsRegularLocalRing R]
    (I : Ideal R) [IsRegularLocalRing (R ⧸ I)] :
    ∃ S T : Finset R, S ⊆ T ∧ Ideal.span (S : Set R) = I ∧
      Ideal.span (T : Set R) = maximalIdeal R ∧
      (T.card : WithBot ℕ∞) = ringKrullDim R := by
  obtain ⟨S, hSm, hspan, hli⟩ := exists_finset_span_eq_linearIndependent_of_regular_quotient I
  obtain ⟨T, hST, hcard, hT⟩ :=
    ((Vendor.quotient_isRegularLocalRing_tfae R S hSm).out 2 1).mp hli
  exact ⟨S, T, hST, hspan, hT, hcard⟩

#print axioms exists_finset_cotangent_basis_of_ideal
#print axioms exists_finset_span_eq_linearIndependent_of_regular_quotient
#print axioms inf_sq_le_smul_of_regular_quotient
#print axioms exists_parameters_of_regular_quotient

end Pcf
