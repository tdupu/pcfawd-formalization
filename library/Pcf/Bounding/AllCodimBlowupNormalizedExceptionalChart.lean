/-!
# The exceptional ideal sheaf on the normalized standard Rees opens

On the inverse image of a nonempty standard Rees open under absolute
normalization, the actual pulled-back centre ideal sheaf is generated by the
image of the exceptional chart coordinate, and that generator is a
nonzerodivisor. This is the local effective-Cartier equation of the
exceptional divisor in `latex/paper-p.tex`, Theorem `thm:allcodim-normal`,
stated for the scheme-theoretic ideal sheaf rather than for an affine model.
-/

@[expose] public section

namespace Pcf.Bounding.AllCodimBlowup

open AlgebraicGeometry CategoryTheory

universe u

noncomputable section

set_option linter.style.haveILetI false

/-- Every open lies in the preimage of the top open. -/
theorem le_preimage_top {X Y : Scheme.{u}} (f : X ⟶ Y) (U : X.Opens) :
    U ≤ f ⁻¹ᵁ ⊤ :=
  fun _ _ => trivial

/-- Pullback of an ideal sheaf from an affine scheme, evaluated on an affine
open, is extension of the global ideal along the restriction map. -/
theorem ideal_comap_of_isAffine {X Y : Scheme.{u}} [IsAffine Y]
    (D : Y.IdealSheafData) (f : X ⟶ Y) (V : X.affineOpens) :
    (D.comap f).ideal V =
      (D.ideal ⟨⊤, isAffineOpen_top Y⟩).map (f.appLE ⊤ V.1 (le_preimage_top _ _)).hom := by
  haveI : IsAffine V.1.toScheme := V.2
  have h := ideal_comap_affine D (V.1.ι ≫ f)
  rw [Scheme.IdealSheafData.comap_comp,
    Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion] at h
  simp only [Scheme.Opens.ι_appIso, Iso.refl_inv] at h
  let W : X.affineOpens :=
    ⟨V.1.ι ''ᵁ ⊤, (isAffineOpen_top V.1.toScheme).image_of_isOpenImmersion _⟩
  have hVW : V ≤ W := by
    change V.1 ≤ V.1.ι ''ᵁ ⊤
    rw [Scheme.Opens.ι_image_top]
  rw [← (D.comap f).map_ideal hVW]
  change ((D.comap f).ideal W).map _ = _
  have h' : (D.comap f).ideal W = _ := (Ideal.comap_id _).symm.trans h
  have hres (y : Γ(X, ⊤)) : X.presheaf.map (homOfLE hVW).op
      (X.presheaf.map (homOfLE (le_top : W.1 ≤ ⊤)).op y) =
        X.presheaf.map (homOfLE (le_top : V.1 ≤ ⊤)).op y := by
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have hc (x : Γ(Y, ⊤)) : (X.presheaf.map (homOfLE hVW).op).hom
      (((V.1.ι ≫ f).appTop).hom x) = (f.appLE ⊤ V.1 (le_preimage_top _ _)).hom x := by
    rw [Scheme.Hom.comp_appTop, Scheme.Opens.ι_appTop]
    unfold Scheme.Hom.appLE
    exact hres (f.appTop x)
  rw [h']
  erw [Ideal.map_map]
  congr 1
  ext x
  exact hc x

/-- Restriction from global sections to global sections is `appTop`. -/
theorem appLE_top_top {X Y : Scheme.{u}} (f : X ⟶ Y) (e : (⊤ : X.Opens) ≤ f ⁻¹ᵁ ⊤) :
    f.appLE ⊤ ⊤ e = f.appTop := by
  rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
  rfl

/-- The inverse of `IsOpenImmersion.ΓIsoTop` is restriction along the open
immersion. -/
theorem ΓIsoTop_inv_eq_appLE {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f] :
    (IsOpenImmersion.ΓIsoTop f).inv = f.appLE f.opensRange ⊤ (by
      intro x _
      exact ⟨x, rfl⟩) := by
  rw [IsOpenImmersion.ΓIsoTop, Iso.trans_inv, Iso.symm_inv, ← Iso.eq_comp_inv,
    Scheme.Hom.appLE_appIso_inv]
  simp only [Functor.mapIso_inv, Iso.op_inv, eqToIso.inv]
  rfl

section Rees

variable {R : Type u} [CommRing R]

attribute [local instance] reesProjChartAlgebra

/-- The inverse chart iso on sections of a standard open is restriction
along the open immersion. -/
theorem reesProjStandardOpen_sectionsIso_hom (I : Ideal R) (a : I) :
    (reesProjStandardOpen_sectionsIso I a).hom =
      (reesProjChartOpen I a).appLE (reesProjStandardOpen I a) ⊤ (by
        intro x _
        exact ⟨x, rfl⟩) ≫ (Scheme.ΓSpecIso (.of (reesProjChart I a))).hom := by
  exact congrArg (· ≫ (Scheme.ΓSpecIso (.of (reesProjChart I a))).hom)
    (ΓIsoTop_inv_eq_appLE (reesProjChartOpen I a))

/-- The base map of the actual Rees `Proj`, restricted to a standard open,
is the structure map of its degree-zero chart. -/
theorem reesProjToSpec_appLE_standardOpen (I : Ideal R) (a : I) :
    (Scheme.ΓSpecIso (.of R)).inv ≫
        (reesProjToSpec I).appLE ⊤ (reesProjStandardOpen I a) (le_preimage_top _ _) =
      CommRingCat.ofHom (algebraMap R (reesProjChart I a)) ≫
        (reesProjStandardOpen_sectionsIso I a).inv := by
  rw [Iso.eq_comp_inv, Category.assoc, reesProjStandardOpen_sectionsIso_hom,
    Scheme.Hom.appLE_comp_appLE_assoc, appLE_top_top, reesProjChartOpen_toSpec_alg,
    Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc]

/-- The global centre ideal of the affine centre sheaf. -/
theorem affineCenterIdealSheaf_ideal_top (I : Ideal R) :
    (affineCenterIdealSheaf I).ideal ⟨⊤, isAffineOpen_top _⟩ =
      I.map (Scheme.ΓSpecIso (.of R)).inv.hom := by
  simp only [affineCenterIdealSheaf, Scheme.IdealSheafData.ofIdealTop_ideal]
  change Ideal.map ((Spec (.of R)).presheaf.map
    (homOfLE (le_top : (⊤ : (Spec (.of R)).Opens) ≤ ⊤)).op).hom _ = _
  have hid : (homOfLE (le_top : (⊤ : (Spec (.of R)).Opens) ≤ ⊤)).op =
      𝟙 (Opposite.op (⊤ : (Spec (.of R)).Opens)) := Subsingleton.elim _ _
  rw [hid, (Spec (.of R)).presheaf.map_id, CommRingCat.hom_id, Ideal.map_id]

/-- The exceptional chart coordinate as a section over the actual standard
Rees open. -/
def reesProjStandardOpenCoordinate (I : Ideal R) (a : I) :
    Γ(reesProj I, reesProjStandardOpen I a) :=
  (reesProjStandardOpen_sectionsIso I a).inv.hom
    ((reesProjChartAlgEquiv I a).symm (algebraMap R (affineBlowupChart I a) a.1))

/-- On the actual standard Rees open, the extended centre ideal is generated
by the exceptional coordinate. -/
theorem centerIdeal_map_reesProjStandardOpen (I : Ideal R) (a : I) :
    I.map ((Scheme.ΓSpecIso (.of R)).inv ≫
        (reesProjToSpec I).appLE ⊤ (reesProjStandardOpen I a) (le_preimage_top _ _)).hom =
      Ideal.span {reesProjStandardOpenCoordinate I a} := by
  rw [reesProjToSpec_appLE_standardOpen, CommRingCat.hom_comp, ← Ideal.map_map,
    CommRingCat.hom_ofHom, centerIdeal_map_reesProjChart_eq_span, Ideal.map_span]
  change Ideal.span (_ '' {_}) = _
  rw [Set.image_singleton]
  rfl

variable [IsDomain R]

/-- The inverse image of a nonzero standard Rees open under absolute
normalization, as an affine open. -/
def normalizedReesStandardAffineOpen (I : Ideal R) (a : I) (ha : (a : R) ≠ 0) :
    letI : IsIntegral (reesProj I) := reesProj_isIntegral I a ha
    (Palomar.normalization (reesProj I)).affineOpens :=
  letI : IsIntegral (reesProj I) := reesProj_isIntegral I a ha
  ⟨_, normalizedReesProjStandardOpen_isAffine I a ha⟩

/-- The exceptional coordinate pulled back to the normalized standard open. -/
def normalizedReesExceptionalCoordinate (I : Ideal R) (a : I) (ha : (a : R) ≠ 0) :
    letI : IsIntegral (reesProj I) := reesProj_isIntegral I a ha
    Γ(Palomar.normalization (reesProj I), (normalizedReesStandardAffineOpen I a ha).1) :=
  letI : IsIntegral (reesProj I) := reesProj_isIntegral I a ha
  ((Palomar.normalizationMap (reesProj I)).app (reesProjStandardOpen I a)).hom
    (reesProjStandardOpenCoordinate I a)

/-- **Local equation of the normalized exceptional divisor.** On the inverse
image of a nonzero standard Rees open under absolute normalization, the actual
pulled-back centre ideal sheaf is generated by the exceptional coordinate. -/
theorem normalizedReesExceptionalIdealSheaf_ideal_eq_span
    (I : Ideal R) (a : I) (ha : (a : R) ≠ 0) :
    letI : IsIntegral (reesProj I) := reesProj_isIntegral I a ha
    (normalizedReesExceptionalIdealSheaf I a ha).ideal
        (normalizedReesStandardAffineOpen I a ha) =
      Ideal.span {normalizedReesExceptionalCoordinate I a ha} := by
  letI : IsIntegral (reesProj I) := reesProj_isIntegral I a ha
  let π := Palomar.normalizationMap (reesProj I)
  rw [normalizedReesExceptionalIdealSheaf, reesExceptionalIdealSheaf,
    ← Scheme.IdealSheafData.comap_comp, ideal_comap_of_isAffine,
    affineCenterIdealSheaf_ideal_top, Ideal.map_map]
  have hfac := Scheme.Hom.appLE_comp_appLE π (reesProjToSpec I) ⊤
    (reesProjStandardOpen I a) (π ⁻¹ᵁ reesProjStandardOpen I a) (le_preimage_top _ _) le_rfl
  rw [← Scheme.Hom.app_eq_appLE] at hfac
  have hring : ((Scheme.ΓSpecIso (.of R)).inv ≫ (π ≫ reesProjToSpec I).appLE ⊤
      (normalizedReesStandardAffineOpen I a ha).1 (le_preimage_top _ _)).hom =
      (π.app (reesProjStandardOpen I a)).hom.comp ((Scheme.ΓSpecIso (.of R)).inv ≫
        (reesProjToSpec I).appLE ⊤ (reesProjStandardOpen I a) (le_preimage_top _ _)).hom := by
    rw [← CommRingCat.hom_comp, Category.assoc]
    exact congrArg (fun g => ((Scheme.ΓSpecIso (.of R)).inv ≫ g).hom) hfac.symm
  rw [← CommRingCat.hom_comp, hring]
  refine (Ideal.map_map _ _).symm.trans ?_
  rw [centerIdeal_map_reesProjStandardOpen]
  refine (Ideal.map_span _ _).trans ?_
  rw [Set.image_singleton]
  rfl

/-- The normalized exceptional coordinate is a nonzerodivisor. -/
theorem normalizedReesExceptionalCoordinate_mem_nonZeroDivisors
    (I : Ideal R) (a : I) (ha : (a : R) ≠ 0) :
    letI : IsIntegral (reesProj I) := reesProj_isIntegral I a ha
    normalizedReesExceptionalCoordinate I a ha ∈
      nonZeroDivisors Γ(Palomar.normalization (reesProj I),
        (normalizedReesStandardAffineOpen I a ha).1) := by
  letI : IsIntegral (reesProj I) := reesProj_isIntegral I a ha
  let X := reesProj I
  let N := Palomar.normalization X
  let π := Palomar.normalizationMap X
  let U := reesProjStandardOpen I a
  haveI : Nonempty U := reesProjStandardOpen_nonempty I a ha
  let η := genericPoint N
  have hπη : π η = genericPoint X := map_genericPoint_eq_of_isDominant π
  have hηU : π η ∈ U := by
    rw [hπη]
    exact ((genericPoint_spec X).mem_open_set_iff U.isOpen).mpr
      (by simpa using (inferInstance : Nonempty U))
  haveI : Nonempty (normalizedReesStandardAffineOpen I a ha).1 := ⟨⟨η, hηU⟩⟩
  letI : IsDomain (reesProjChart I a) := reesProjChart_isDomain_of_nonzero I a ha
  have hinj : Function.Injective (π.app U).hom := by
    intro x y hxy
    apply germ_injective_of_isIntegral X (π η) hηU
    apply (ConcreteCategory.bijective_of_isIso (π.stalkMap η)).1
    rw [Scheme.Hom.germ_stalkMap_apply, Scheme.Hom.germ_stalkMap_apply, hxy]
  have hc : reesProjStandardOpenCoordinate I a ≠ 0 := by
    intro hz
    have hc' := nonZeroDivisors.ne_zero
      (centerCoordinate_reesProjChart_mem_nonZeroDivisors I a ha)
    apply hc'
    apply (ConcreteCategory.bijective_of_isIso
      (reesProjStandardOpen_sectionsIso I a).inv).1
    rw [map_zero]
    exact hz
  apply mem_nonZeroDivisors_of_ne_zero
  intro hz
  apply hc
  apply hinj
  rw [map_zero]
  exact hz

omit [IsDomain R] in
/-- The standard opens indexed by the centre elements cover the Rees `Proj`. -/
theorem iSup_reesProjStandardOpen_eq_top (I : Ideal R) :
    ⨆ a : I, reesProjStandardOpen I a = ⊤ := by
  have h := Proj.iSup_basicOpen_eq_top (reesGrade I) (reesDegreeOne I)
    (reesIrrelevant_le_degreeOneSpan I)
  refine Eq.trans ?_ h
  congr 1
  funext a
  exact Proj.opensRange_awayι _ _ _ _

omit [IsDomain R] in
/-- The zero centre element indexes the empty standard open. -/
theorem reesProjStandardOpen_zero (I : Ideal R) :
    reesProjStandardOpen I 0 = ⊥ := by
  have h0 : reesDegreeOne I 0 = 0 := by
    apply Subtype.ext
    simp [reesDegreeOne]
  change (reesProjChartOpen I 0).opensRange = ⊥
  refine (Proj.opensRange_awayι _ _ _ _).trans ?_
  rw [h0, Proj.basicOpen_zero]
  rfl

/-- **The normalized exceptional divisor is effective Cartier.** For a
nonzero centre in a domain, the actual pullback of the centre ideal sheaf to
the absolute normalization of the Rees blow-up is locally generated by one
nonzerodivisor on affine opens covering the normalization. -/
theorem normalizedReesExceptionalIdealSheaf_isEffectiveCartier
    (I : Ideal R) (a : I) (ha : (a : R) ≠ 0) :
    letI : IsIntegral (reesProj I) := reesProj_isIntegral I a ha
    Pcf.Stacks.SchemeLevel.IsEffectiveCartier
      (normalizedReesExceptionalIdealSheaf I a ha) := by
  letI : IsIntegral (reesProj I) := reesProj_isIntegral I a ha
  intro x
  have hx : Palomar.normalizationMap (reesProj I) x ∈
      ⨆ b : I, reesProjStandardOpen I b := by
    rw [iSup_reesProjStandardOpen_eq_top]
    trivial
  obtain ⟨b, hb⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  have hb0 : (b : R) ≠ 0 := by
    intro hz
    have : b = 0 := Subtype.ext hz
    subst this
    rw [reesProjStandardOpen_zero] at hb
    exact hb
  exact ⟨normalizedReesStandardAffineOpen I b hb0, hb,
    normalizedReesExceptionalCoordinate I b hb0,
    normalizedReesExceptionalCoordinate_mem_nonZeroDivisors I b hb0,
    normalizedReesExceptionalIdealSheaf_ideal_eq_span I b hb0⟩

#print axioms ideal_comap_of_isAffine
#print axioms ΓIsoTop_inv_eq_appLE
#print axioms reesProjToSpec_appLE_standardOpen
#print axioms centerIdeal_map_reesProjStandardOpen
#print axioms normalizedReesExceptionalIdealSheaf_ideal_eq_span
#print axioms normalizedReesExceptionalCoordinate_mem_nonZeroDivisors
#print axioms iSup_reesProjStandardOpen_eq_top
#print axioms normalizedReesExceptionalIdealSheaf_isEffectiveCartier

end Rees

