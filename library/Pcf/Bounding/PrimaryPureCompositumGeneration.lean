module

public import Pcf.Bounding.PrimaryPureCompositum

/-!
# Generation of the reduced tensor compositum

The reduced tensor field used for `L'=LK'` in `paper-p.tex`, Lemma
`lem:primary-fibres`, is generated by the images of the original source
function field and the finite purely inseparable base alteration.
-/

@[expose] public section

namespace Pcf.Bounding.PrimaryFibres

set_option linter.style.haveILetI false

open Algebra
open scoped TensorProduct

universe u

variable (K E P : Type u) [Field K] [Field E] [Field P]
  [Algebra K E] [Algebra K P] [IsPurelyInseparable K P]

/-- The second field's canonical map into the reduced tensor field. -/
def pureCompositumRightMap : P →+* pureCompositum K E P :=
  (Ideal.Quotient.mk (nilradical (E ⊗[K] P))).comp
    (Algebra.TensorProduct.includeRight : P →ₐ[K] E ⊗[K] P).toRingHom

omit [IsPurelyInseparable K P] in
/-- The reduced tensor algebra is generated over `E` by the image of `P`.
For a purely inseparable `P/K` its reduction is a field, so this identifies
that field as the compositum rather than an unidentified field quotient. -/
theorem pureCompositum_adjoin_right_eq_top :
    Algebra.adjoin E
      (Set.range (pureCompositumRightMap K E P)) = ⊤ := by
  have h : ∀ t : E ⊗[K] P,
      (Ideal.Quotient.mk (nilradical (E ⊗[K] P))) t ∈
        Algebra.adjoin E (Set.range (pureCompositumRightMap K E P)) := by
    intro t
    induction t using TensorProduct.inductionOn with
    | tmul e p =>
      have he : algebraMap E (pureCompositum K E P) e ∈
          Algebra.adjoin E (Set.range (pureCompositumRightMap K E P)) :=
        Subalgebra.algebraMap_mem _ _
      have hp : pureCompositumRightMap K E P p ∈
          Algebra.adjoin E (Set.range (pureCompositumRightMap K E P)) :=
        Algebra.subset_adjoin ⟨p, rfl⟩
      convert mul_mem he hp using 1
      change (Ideal.Quotient.mk (nilradical (E ⊗[K] P))) (e ⊗ₜ[K] p) =
        (Ideal.Quotient.mk (nilradical (E ⊗[K] P))) (e ⊗ₜ[K] 1) *
          (Ideal.Quotient.mk (nilradical (E ⊗[K] P))) (1 ⊗ₜ[K] p)
      rw [← map_mul]
      simp
    | add x y hx hy =>
      simpa only [map_add] using add_mem hx hy
  apply top_unique
  intro x _
  obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact h t

#print axioms pureCompositum_adjoin_right_eq_top

end Pcf.Bounding.PrimaryFibres
