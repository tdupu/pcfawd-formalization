module

public import Pcf.Bounding.PrimaryFiniteDenseOpenSpreading
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Finite stages of a purely inseparable extension

The alteration in `paper-p.tex`, Lemma `lem:primary-fibres`, must be a *finite*
purely inseparable extension. Any finite collection of elements in a purely
inseparable extension is contained in such a finite intermediate field.
The degree of this stage is a power of the characteristic, supplying the
`p^a` parameter used in the valuation comparison.
-/

@[expose] public section

namespace Pcf.Bounding.PrimaryFibres

variable (K E : Type*) [Field K] [Field E] [Algebra K E]
  [IsPurelyInseparable K E]

/-- A finite set in a purely inseparable extension generates a finite
purely inseparable intermediate field. -/
theorem finite_set_contained_in_finite_pure_subextension
    (s : Finset E) :
    ∃ F : IntermediateField K E,
      FiniteDimensional K F ∧ IsPurelyInseparable K F ∧
        ∀ x ∈ s, x ∈ F := by
  let F : IntermediateField K E := IntermediateField.adjoin K (s : Set E)
  have hfin : FiniteDimensional K F := by
    dsimp [F]
    infer_instance
  have hpure : IsPurelyInseparable K F := by
    dsimp [F]
    infer_instance
  refine ⟨F, hfin, hpure, ?_⟩
  intro x hx
  exact IntermediateField.subset_adjoin K (s : Set E) hx

/-- The finite stage generated by any finite set has degree `p^a` in
exponential characteristic `p`. This is the degree shape required in the
source's `p`-primary multiplicity bound. -/
theorem finite_pure_stage_degree_pow
    (p : ℕ) [ExpChar K p] (s : Finset E) :
    ∃ F : IntermediateField K E, ∃ a : ℕ,
      (∀ x ∈ s, x ∈ F) ∧ Module.finrank K F = p ^ a := by
  obtain ⟨F, hfin, hpure, hs⟩ :=
    finite_set_contained_in_finite_pure_subextension K E s
  have : FiniteDimensional K F := hfin
  have : IsPurelyInseparable K F := hpure
  obtain ⟨a, ha⟩ := IsPurelyInseparable.finrank_eq_pow K F p
  exact ⟨F, a, hs, ha⟩

#print axioms finite_set_contained_in_finite_pure_subextension
#print axioms finite_pure_stage_degree_pow

end Pcf.Bounding.PrimaryFibres
