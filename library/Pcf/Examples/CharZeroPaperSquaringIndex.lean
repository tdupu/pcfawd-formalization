/-!
# The ramification index of projective squaring along `H_i`, `ex:squaring-PN`

The actual divisorial ramification index of the squaring endomorphism `ψ` of
`ℙ^N` along each coordinate hyperplane `H_i` is exactly `2`.

The index is computed on an affine chart `x_a ≠ 0`, `a ≠ i`, with the
polynomial coordinates of the chart. There the chart morphism is `t ↦ t^2`,
the prime of `H_i` is generated by one coordinate `t_k`, and its image `t_k^2`
lies in the extended prime from below. Hence the localized fibre ring is a
quotient of `D/m^2` for the discrete valuation ring `D`, so the index is at
most two. The lower bound is the Jacobian criterion.
-/

@[expose] public section
namespace Pcf.Examples.CharZeroPaperSquaringIndex
open MvPolynomial AlgebraicGeometry CategoryTheory Pcf.PaperCharZero
open Pcf.Examples.CharZeroPaperSquaringProjective Pcf.Examples.CharZeroPaperSquaringBranch
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option linter.style.haveILetI false
universe u

/-! ## A ring-theoretic upper bound -/

/-- If a height-one prime `q = (s)` of a Noetherian domain has `s^2` in the image
of the base, its ramification index is at most two. -/
theorem ramificationIdx_le_two {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [IsDomain S] [IsNoetherianRing S] (q : Ideal S) [hq : q.IsPrime] (s : S)
    (hqs : q = Ideal.span {s}) (hs : s ≠ 0) (r : R) (hr : algebraMap R S r = s ^ 2) :
    q.ramificationIdx R ≤ 2 := by
  let D := Localization.AtPrime q
  have hinj : Function.Injective (algebraMap S D) :=
    IsLocalization.injective D (Ideal.primeCompl_le_nonZeroDivisors q)
  let t : D := algebraMap S D s
  have ht : t ≠ 0 := fun h => hs (hinj (h.trans (map_zero _).symm))
  have hm : IsLocalRing.maximalIdeal D = Ideal.span {t} := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal,
      congrArg (fun I : Ideal S => Ideal.map (algebraMap S D) I) hqs]
    simp only [Ideal.map_span, Set.image_singleton, t]
  have hfield : ¬ IsField D := by
    intro hF
    have := (IsLocalRing.isField_iff_maximalIdeal_eq.mp hF)
    rw [hm, Ideal.span_singleton_eq_bot] at this
    exact ht this
  have hdvr : IsDiscreteValuationRing D :=
    ((IsDiscreteValuationRing.TFAE D hfield).out 1 5).mpr
      (show (IsLocalRing.maximalIdeal D).IsPrincipal from ⟨⟨t, hm⟩⟩)
  have hrq : r ∈ q.under R := by
    change algebraMap R S r ∈ q
    rw [hr, hqs]
    exact Ideal.mem_span_singleton.mpr ⟨s, sq s⟩
  let J : Ideal D := (q.under R).map (algebraMap R D)
  have hle : IsLocalRing.maximalIdeal D ^ 2 ≤ J := by
    rw [hm, Ideal.span_singleton_pow, Ideal.span_singleton_le_iff_mem]
    have : t ^ 2 = algebraMap R D r := by
      rw [IsScalarTower.algebraMap_apply R S D, hr, map_pow]
    rw [this]
    exact Ideal.mem_map_of_mem _ hrq
  have hlen : Module.length D (D ⧸ J) ≤ 2 := by
    have h2 := IsDiscreteValuationRing.length_quotient_pow_maximalIdeal (R := D) 2
    calc Module.length D (D ⧸ J)
        ≤ Module.length D (D ⧸ (IsLocalRing.maximalIdeal D ^ 2)) :=
          Module.length_le_of_surjective
            (Submodule.factor hle) (Submodule.factor_surjective hle)
      _ = 2 := by rw [h2]; rfl
  rw [Ideal.ramificationIdx_def]
  have hfin : Module.length D (D ⧸ J) ≠ ⊤ := ne_top_of_le_ne_top (by simp) hlen
  exact (ENat.toNat_le_toNat hlen (by simp)).trans (by simp)

/-! ## The squaring chart -/

variable {K : Type u} [Field K] {n : ℕ}
attribute [local instance] MvPolynomial.gradedAlgebra
local notation "polyGrade" => MvPolynomial.homogeneousSubmodule (Fin n ⊕ Unit) K

/-- The chart permutation swapping the chosen nonvanishing coordinate with the
last one. -/
def chartPerm [NeZero n] (i : Fin n ⊕ Unit) : (Fin n ⊕ Unit) ≃ (Fin n ⊕ Unit) :=
  Equiv.swap (otherIndex i) (Sum.inr ())

/-- The reindexed forms on that chart. -/
noncomputable abbrev chartForms [NeZero n] (i : Fin n ⊕ Unit) :
    Fin n ⊕ Unit → MvPolynomial (Fin n ⊕ Unit) K :=
  projReindexedForms squaringForms (chartPerm i) (chartPerm i).symm

theorem chartForms_eq [NeZero n] (i k : Fin n ⊕ Unit) :
    chartForms (K := K) i k = X k ^ 2 := by
  simp [chartForms, projReindexedForms, squaringForms]

theorem chartForms_dehomogenize_last [NeZero n] (i : Fin n ⊕ Unit) :
    projDehomogenize (chartForms (K := K) i (Sum.inr ())) = 1 := by
  rw [chartForms_eq]
  simp [projDehomogenize]

/-- The chart coordinate ring. -/
noncomputable abbrev ChartRing [NeZero n] (i : Fin n ⊕ Unit) :=
  ProjFormsChartRing (chartForms (K := K) i)

theorem chartRing_algebraMap_surjective [NeZero n] (i : Fin n ⊕ Unit) :
    Function.Surjective (algebraMap (MvPolynomial (Fin n) K) (ChartRing (K := K) i)) := by
  intro z
  obtain ⟨⟨a, ⟨_, m, rfl⟩⟩, rfl⟩ := IsLocalization.mk'_surjective
    (Submonoid.powers (projDehomogenize (chartForms (K := K) i (Sum.inr ())))) z
  refine ⟨a, ?_⟩
  rw [IsLocalization.eq_mk'_iff_mul_eq]
  simp [chartForms_dehomogenize_last]

theorem chartRing_algebraMap_injective [NeZero n] (i : Fin n ⊕ Unit) :
    Function.Injective (algebraMap (MvPolynomial (Fin n) K) (ChartRing (K := K) i)) := by
  apply IsLocalization.injective (M := Submonoid.powers
    (projDehomogenize (chartForms (K := K) i (Sum.inr ())))) (ChartRing (K := K) i)
  apply powers_le_nonZeroDivisors_of_noZeroDivisors
  rw [chartForms_dehomogenize_last]
  exact one_ne_zero

instance chartRing_isDomain [NeZero n] (i : Fin n ⊕ Unit) : IsDomain (ChartRing (K := K) i) :=
  IsLocalization.isDomain_localization
    (M := Submonoid.powers (projDehomogenize (chartForms (K := K) i (Sum.inr ()))))
    (powers_le_nonZeroDivisors_of_noZeroDivisors (by
      rw [chartForms_dehomogenize_last]
      exact one_ne_zero))

instance chartRing_isNoetherianRing [NeZero n] (i : Fin n ⊕ Unit) :
    IsNoetherianRing (ChartRing (K := K) i) :=
  IsLocalization.isNoetherianRing
    (Submonoid.powers (projDehomogenize (chartForms (K := K) i (Sum.inr ()))))
    (ChartRing (K := K) i) inferInstance

theorem chart_algebraMap_C [NeZero n] (i : Fin n ⊕ Unit) (a : K) :
    algebraMap (MvPolynomial (Fin n) K) (ChartRing (K := K) i) (C a) =
      projChartPullback (chartForms (K := K) i) (C a) := by
  rw [← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply, AlgHom.commutes]

theorem chartPullback_X [NeZero n] (i : Fin n ⊕ Unit) (k : Fin n) :
    projChartPullback (chartForms (K := K) i) (X k) =
      algebraMap (MvPolynomial (Fin n) K) (ChartRing (K := K) i) (X k) ^ 2 := by
  have hu : ((projChartDenominatorUnit (chartForms (K := K) i))⁻¹ : (ChartRing (K := K) i)ˣ) =
      1 := by
    rw [inv_eq_one]
    apply Units.ext
    simp [projChartDenominatorUnit, chartForms_dehomogenize_last]
  simp [projChartPullback, hu, chartForms_eq, projDehomogenize]

/-- The chart pullback is the localization of coordinatewise squaring. -/
theorem chartPullback_eq [NeZero n] (i : Fin n ⊕ Unit) :
    (projChartPullback (chartForms (K := K) i)).toRingHom =
      (algebraMap (MvPolynomial (Fin n) K) (ChartRing (K := K) i)).comp
        (expand 2 : MvPolynomial (Fin n) K →ₐ[K] _).toRingHom := by
  have h : projChartPullback (chartForms (K := K) i) =
      (IsScalarTower.toAlgHom K (MvPolynomial (Fin n) K) (ChartRing (K := K) i)).comp
        (expand 2) := by
    apply MvPolynomial.algHom_ext
    intro k
    rw [chartPullback_X]
    simp [expand]
  rw [h]
  rfl

theorem chartPullback_injective [NeZero n] (i : Fin n ⊕ Unit) :
    Function.Injective (projChartPullback (chartForms (K := K) i)) := by
  have h := congrArg DFunLike.coe (chartPullback_eq (K := K) i)
  change Function.Injective ((projChartPullback (chartForms (K := K) i)).toRingHom)
  rw [chartPullback_eq]
  exact (chartRing_algebraMap_injective i).comp (expand_injective two_pos)

theorem chartPullback_isIntegral [NeZero n] (i : Fin n ⊕ Unit) :
    (projChartPullback (chartForms (K := K) i)).toRingHom.IsIntegral := by
  intro z
  obtain ⟨P, rfl⟩ := chartRing_algebraMap_surjective (K := K) i z
  induction P using MvPolynomial.induction_on with
  | C a =>
    rw [chart_algebraMap_C]
    exact RingHom.isIntegralElem_map (projChartPullback (chartForms (K := K) i)).toRingHom
  | add P Q hP hQ => rw [map_add]; exact hP.add _ hQ
  | mul_X P k hP =>
    rw [map_mul]
    exact hP.mul _ (isIntegralElem_of_sq_eq _ (a := X k) (chartPullback_X i k).symm)

/-- The target polynomial ring, as a type carrying the chart pullback as its
algebra structure on the chart ring. -/
def ChartBase (n : ℕ) (K : Type u) [Field K] : Type u := MvPolynomial (Fin n) K

noncomputable instance : CommRing (ChartBase n K) :=
  inferInstanceAs (CommRing (MvPolynomial (Fin n) K))
noncomputable instance : IsDomain (ChartBase n K) :=
  inferInstanceAs (IsDomain (MvPolynomial (Fin n) K))
noncomputable instance : IsNoetherianRing (ChartBase n K) :=
  inferInstanceAs (IsNoetherianRing (MvPolynomial (Fin n) K))
noncomputable instance : IsIntegrallyClosed (ChartBase n K) :=
  inferInstanceAs (IsIntegrallyClosed (MvPolynomial (Fin n) K))

/-- The chart pullback as an algebra structure. -/
noncomputable instance chartAlgebra [NeZero n] (i : Fin n ⊕ Unit) :
    Algebra (ChartBase n K) (ChartRing (K := K) i) :=
  (projChartPullback (chartForms (K := K) i)).toRingHom.toAlgebra

theorem chartAlgebra_algebraMap [NeZero n] (i : Fin n ⊕ Unit) :
    (algebraMap (ChartBase n K) (ChartRing (K := K) i) : ChartBase n K →+* _) =
      (projChartPullback (chartForms (K := K) i)).toRingHom := rfl

instance chartAlgebra_faithfulSMul [NeZero n] (i : Fin n ⊕ Unit) :
    FaithfulSMul (ChartBase n K) (ChartRing (K := K) i) :=
  (faithfulSMul_iff_algebraMap_injective _ _).mpr (chartPullback_injective i)

/-- The chart ring is a finite module over the target polynomial ring. -/
instance chartAlgebra_finite [NeZero n] (i : Fin n ⊕ Unit) :
    Module.Finite (ChartBase n K) (ChartRing (K := K) i) := by
  classical
  let loc := algebraMap (MvPolynomial (Fin n) K) (ChartRing (K := K) i)
  have hsurj : Function.Surjective loc := chartRing_algebraMap_surjective i
  have hC (a : K) : loc (C a) = algebraMap (ChartBase n K) (ChartRing (K := K) i) (C a) :=
    chart_algebraMap_C i a
  have : Algebra.IsIntegral (ChartBase n K) (ChartRing (K := K) i) :=
    ⟨chartPullback_isIntegral i⟩
  have : Algebra.FiniteType (ChartBase n K) (ChartRing (K := K) i) := by
    refine ⟨⟨Finset.univ.image fun k => loc (X k), ?_⟩⟩
    rw [eq_top_iff]
    rintro z -
    obtain ⟨P, rfl⟩ := hsurj z
    induction P using MvPolynomial.induction_on with
    | C a =>
      rw [hC]
      exact Subalgebra.algebraMap_mem _ _
    | add P Q hP hQ => rw [map_add]; exact Subalgebra.add_mem _ hP hQ
    | mul_X P k hP =>
      rw [map_mul]
      exact Subalgebra.mul_mem _ hP (Algebra.subset_adjoin (by simp))
  exact Algebra.IsIntegral.finite

/-- The image of `x_i` under the chart permutation is a chart coordinate. -/
theorem chartPerm_apply [NeZero n] (i : Fin n ⊕ Unit) :
    ∃ k : Fin n, chartPerm i i = Sum.inl k := by
  rcases i with k | u
  · exact ⟨k, by simp [chartPerm, otherIndex]⟩
  · exact ⟨0, by simp [chartPerm, otherIndex]⟩

/-- `ex:squaring-PN`: the actual divisorial ramification index of `ψ` along each
coordinate hyperplane is exactly two.

Manuscript: `ex:squaring-PN` (Example 4.1). -/
theorem squaringMap_ramificationIdx_hyperplane [CharZero K] [NeZero n] (i : Fin n ⊕ Unit) :
    schemeDivisorRamificationIdx (squaringMap (K := K) (n := n)) (hyperplaneDivisor i) = 2 := by
  classical
  let e := chartPerm i
  let j := projAnySourceChartToProj (squaringForms (K := K) (n := n)) 2
    squaringForms_isHomogeneous e e
  let ι := projAnyTargetChartToProj (K := K) (n := n) e
  let g := projChartSchemeMap (chartForms (K := K) i)
  have hsq : j ≫ squaringMap = g ≫ ι :=
    projForms_anyPolynomialDoubleChart_comp_map _ 2 squaringForms_isHomogeneous two_pos
      squaringForms_cover e e
  -- the hyperplane lies in the source chart
  have hmem : (hyperplane (K := K) i : AlgebraicGeometry.Proj polyGrade) ∈ j.opensRange := by
    rw [projAnySourceChartToProj_opensRange]
    change X (e.symm (Sum.inr ())) * squaringForms (e.symm (Sum.inr ())) ∉
      Ideal.span {(X i : MvPolynomial (Fin n ⊕ Unit) K)}
    have he : e.symm (Sum.inr ()) = otherIndex i := by
      simp [e, chartPerm, Equiv.symm_swap]
    rw [he]
    intro h
    have hp : (Ideal.span {(X i : MvPolynomial (Fin n ⊕ Unit) K)}).IsPrime :=
      (Ideal.span_singleton_prime (X_ne_zero i)).mpr X_prime
    rcases hp.mem_or_mem h with h | h
    · exact X_not_mem_span_X (otherIndex_ne i) h
    · exact X_not_mem_span_X (otherIndex_ne i) (hp.mem_of_pow_mem 2 h)
  obtain ⟨x0, hx0⟩ := hmem
  have hcoh : Order.coheight x0 = 1 := by
    rw [← coheight_eq_of_isOpenImmersion j]
    rw [hx0]
    exact hyperplane_coheight i
  let x : SchemeDivisorPoint (Spec (CommRingCat.of (ChartRing (K := K) i))) := ⟨x0, hcoh⟩
  have : Nonempty (Spec (CommRingCat.of (ChartRing (K := K) i))) := ⟨x0⟩
  have : IsDominant j := isDominant_of_isOpenImmersion j
  have : Surjective g :=
    ⟨(chartPullback_isIntegral i).comap_surjective (chartPullback_injective i)⟩
  have : IsNormalScheme (Spec (CommRingCat.of (MvPolynomial (Fin n) K))) :=
    Pcf.Examples.CharZeroPaperSmoothBranch.normal_spec _
  have hjx : Order.coheight (j x.1) = 1 := by
    change Order.coheight (j x0) = 1
    rw [hx0]
    exact hyperplane_coheight i
  have hgx : Order.coheight (g x.1) = 1 := by
    rw [← coheight_eq_of_isOpenImmersion ι]
    have h := congrArg (fun φ => φ x0) hsq
    simp only [Scheme.Hom.comp_apply] at h
    change Order.coheight (ι (g x0)) = 1
    rw [← h, hx0, squaringMap_hyperplane]
    exact hyperplane_coheight i
  have hsquare := schemeDivisorRamificationIdx_eq_of_openSquare j ι g squaringMap hsq x hjx hgx
  have hH : (⟨j x.1, hjx⟩ : SchemeDivisorPoint (AlgebraicGeometry.Proj polyGrade)) =
      hyperplaneDivisor i := Subtype.ext hx0
  rw [hH] at hsquare
  rw [hsquare]
  have hspec := Pcf.Examples.CharZeroPaperSingularImageBounding.schemeDivisorRamificationIdx_specMap
    (R := ChartBase n K) (S := ChartRing (K := K) i) x
  have hle : schemeDivisorRamificationIdx g x ≤ 2 := by
    change schemeDivisorRamificationIdx
      (Spec.map (CommRingCat.ofHom (algebraMap (ChartBase n K) (ChartRing (K := K) i)))) x ≤ 2
    rw [hspec]
    obtain ⟨k, hk⟩ := chartPerm_apply (n := n) i
    let loc := algebraMap (MvPolynomial (Fin n) K) (ChartRing (K := K) i)
    let s := loc (X k)
    have hinj := chartRing_algebraMap_injective (K := K) i
    have hsurj := chartRing_algebraMap_surjective (K := K) i
    have hs : s ≠ 0 := fun h => X_ne_zero k (hinj (h.trans (map_zero _).symm))
    -- `s` lies in the prime of the hyperplane
    have hsq_mem : s ∈ x0.asIdeal := by
      have hpre := projAnySourceChartToProj_preimage_basicOpen (squaringForms (K := K) (n := n))
        2 squaringForms_isHomogeneous e e (X i) (isHomogeneous_X K i)
      have hnot : x0 ∉ j ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen polyGrade (X i) := by
        change j x0 ∉ AlgebraicGeometry.Proj.basicOpen polyGrade (X i)
        rw [hx0]
        change ¬ (X i ∉ Ideal.span {(X i : MvPolynomial (Fin n ⊕ Unit) K)})
        exact not_not.mpr (Ideal.mem_span_singleton_self _)
      rw [hpre] at hnot
      have hd : projDehomogenize (rename e (X i : MvPolynomial (Fin n ⊕ Unit) K)) = X k := by
        rw [rename_X]
        change projDehomogenize (X (chartPerm i i)) = X k
        rw [hk]
        simp [projDehomogenize]
      rw [hd] at hnot
      by_contra hc
      exact hnot hc
    have hprime : (Ideal.span {s}).IsPrime := by
      have hX : (Ideal.span {(X k : MvPolynomial (Fin n) K)}).IsPrime :=
        (Ideal.span_singleton_prime (X_ne_zero k)).mpr X_prime
      have := Ideal.map_isPrime_of_surjective hsurj (I := Ideal.span {X k})
        (by rw [(RingHom.injective_iff_ker_eq_bot _).mp hinj]; exact bot_le)
      rwa [Ideal.map_span, Set.image_singleton] at this
    have hheight : x0.asIdeal.height = 1 := by
      rw [idealHeight_eq_coheight]
      exact hcoh
    have hqs : x0.asIdeal = Ideal.span {s} := by
      have hle' : Ideal.span {s} ≤ x0.asIdeal := (Ideal.span_singleton_le_iff_mem _).mpr hsq_mem
      by_contra hne
      have hlt : Ideal.span {s} < x0.asIdeal := lt_of_le_of_ne hle' (Ne.symm hne)
      have h2 := Ideal.height_add_one_le_of_lt_of_isPrime hlt
      have h1 : 1 ≤ (Ideal.span {s}).height := by
        have h0 := Ideal.height_add_one_le_of_lt_of_isPrime
          (I := (⊥ : Ideal (ChartRing (K := K) i))) (J := Ideal.span {s})
          (bot_lt_iff_ne_bot.mpr (by simpa [Ideal.span_singleton_eq_bot] using hs))
        simpa [Ideal.height_bot] using h0
      rw [hheight] at h2
      have : (2 : ℕ∞) ≤ 1 := by
        calc (2 : ℕ∞) = 1 + 1 := by norm_num
          _ ≤ (Ideal.span {s}).height + 1 := by gcongr
          _ ≤ 1 := h2
      exact absurd this (by norm_num)
    exact ramificationIdx_le_two (R := ChartBase n K) x0.asIdeal s hqs hs
      (X k : MvPolynomial (Fin n) K) (chartPullback_X i k)
  have hgt := squaringMap_ramified (K := K) (n := n) i
  rw [hsquare] at hgt
  omega

#print axioms chartForms_eq
#print axioms chartRing_algebraMap_surjective
#print axioms chartRing_algebraMap_injective
#print axioms chartPullback_X
#print axioms chartPullback_eq
#print axioms chartPullback_injective
#print axioms chartPullback_isIntegral
#print axioms chartAlgebra_finite
#print axioms squaringMap_ramificationIdx_hyperplane
#print axioms ramificationIdx_le_two
end Pcf.Examples.CharZeroPaperSquaringIndex
