module

public import Pcf.Examples.PaperP.TwoChartPinchPushout

/-!
# The pinching map `ν` is finite

For `paper-p.tex`, Example `ex:monodromy-loss` (l. 846–868): the pinching map `ν` of the finite
pushout construction [Fer03, §5.4] is finite.

* `FerrandPushout.pr₂_finite`: for `π : A' → A` surjective and `β : B → A` finite, the second
  projection `pr₂ : A' ×_A B → A'` is finite. The `Fib`-module `A'` is generated by `1` and lifts
  `g'_j` of `B`-module generators `g_j` of `A`: if `π a' = Σ β(b_j) g_j` and `π c_j = β b_j`, then
  `(b_j, c_j) ∈ Fib` and `a' - Σ c_j g'_j ∈ ker π = pr₂ (ker pr₁)`.
* `PinchData.nu_isFinite`: for `β0`, `β1` finite, `ν : Ep × 𝔸¹ → Xp` is finite (chartwise it is
  `Spec pr₂`, `isPullback_nu_0/1`; finiteness is local on the target).
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Limits

namespace Pcf.Examples.PaperP.FerrandPushout

universe u

variable {A' A B : Type u} [CommRing A'] [CommRing A] [CommRing B] {π : A' →+* A} {β : B →+* A}

/-- **`pr₂ : A' ×_A B → A'` is finite** when `π` is surjective and `β` is finite. -/
theorem pr₂_finite (hπ : Function.Surjective π) (hβ : β.Finite) : (pr₂ π β).Finite := by
  classical
  let _ := (pr₂ π β).toAlgebra
  let _ := β.toAlgebra
  have hfin : Module.Finite B A := hβ
  obtain ⟨s, hs⟩ := hfin.fg_top
  choose lift hlift using hπ
  refine ⟨⟨insert 1 (s.image lift), ?_⟩⟩
  rw [eq_top_iff]
  intro a' _
  have hmem : π a' ∈ Submodule.span B (s : Set A) := by rw [hs]; trivial
  obtain ⟨f, -, hf⟩ := Submodule.mem_span_finset.mp hmem
  let c : A → A' := fun g => lift (β (f g))
  let w : A → Fib π β := fun g => ⟨(f g, c g), by
    rw [mem_fib]; exact (hlift _).symm⟩
  set d := a' - ∑ g ∈ s, c g * lift g with hd
  have hdπ : π d = 0 := by
    rw [hd, map_sub, map_sum, ← hf]
    refine sub_eq_zero.mpr (Finset.sum_congr rfl fun g _ => ?_)
    rw [map_mul, hlift, hlift]
    rfl
  have ha' : a' = (kerElt (β := β) d hdπ) • (1 : A') + ∑ g ∈ s, w g • lift g := by
    change a' = d * 1 + ∑ g ∈ s, c g * lift g
    rw [mul_one, hd, sub_add_cancel]
  rw [ha']
  refine Submodule.add_mem _ (Submodule.smul_mem _ _ (Submodule.subset_span ?_))
    (Submodule.sum_mem _ fun g hg => Submodule.smul_mem _ _ (Submodule.subset_span ?_))
  · simp
  · simp only [Finset.coe_insert, Finset.coe_image]
    exact Set.mem_insert_of_mem _ ⟨g, hg, rfl⟩

theorem SpecMap_pr₂_isFinite (hπ : Function.Surjective π) (hβ : β.Finite) :
    IsFinite (Spec.map (CommRingCat.ofHom (pr₂ π β))) :=
  (IsFinite.SpecMap_iff _).mpr (pr₂_finite hπ hβ)

end Pcf.Examples.PaperP.FerrandPushout

namespace Pcf.Examples.PaperP.TwoChartPinch.PinchData

open Pcf.Examples.PaperP.FerrandPushout

set_option backward.isDefEq.respectTransparency false
attribute [local instance] MvPolynomial.gradedAlgebra

universe u

variable {k : Type u} [Field k] {Z0 Z1 Z01 : Type u} [CommRing Z0] [CommRing Z1] [CommRing Z01]
  (D : PinchData k Z0 Z1 Z01)

/-- **The pinching map `ν : Ep × 𝔸¹ → Xp` is finite.** -/
theorem nu_isFinite (hβ0 : D.β0.Finite) (hβ1 : D.β1.Finite) : IsFinite D.nu := by
  refine IsZariskiLocalAtTarget.of_openCover (TwoChartGlue.openCover D.f0 D.f1) fun j => ?_
  rcases j with ⟨_ | _⟩
  · have h := D.isPullback_nu_0.flip
    change IsFinite (pullback.snd D.nu (TwoChartGlue.ι₀ D.f0 D.f1))
    rw [← h.isoPullback_inv_snd, MorphismProperty.cancel_left_of_respectsIso @IsFinite]
    exact SpecMap_pr₂_isFinite (pi0_surjective (Z0 := Z0)) hβ0
  · have h := D.isPullback_nu_1.flip
    change IsFinite (pullback.snd D.nu (TwoChartGlue.ι₁ D.f0 D.f1))
    rw [← h.isoPullback_inv_snd, MorphismProperty.cancel_left_of_respectsIso @IsFinite]
    exact SpecMap_pr₂_isFinite (pi1_surjective (Z1 := Z1)) hβ1

end Pcf.Examples.PaperP.TwoChartPinch.PinchData

#print axioms Pcf.Examples.PaperP.FerrandPushout.pr₂_finite
#print axioms Pcf.Examples.PaperP.TwoChartPinch.PinchData.nu_isFinite
