module

public import Pcf.Examples.PaperP.QuadricConePuncturedChart
public import Mathlib.Algebra.QuadraticAlgebra.Basic

/-!
# Quadratic algebra maps onto the punctured cone charts

The source on `D(x)` is generated by a root `u` of `T²-x`, and on `D(z)`
by a root `v` of `T²-z`. We construct surjective maps from the corresponding
quadratic algebras. Injectivity, required for the actual presentation isomorphism
and an étaleness theorem, is not yet proved here.
-/

@[expose] public section

namespace Pcf.Examples.PaperP.QuadricConePuncturedChart
open AlgebraicGeometry CategoryTheory
variable (k : Type*) [Field k] [CharZero k]

noncomputable def quadraticChartX :
    QuadraticAlgebra (TargetX k)
      (algebraMap (QuadricConeInjective.CoordinateRing k) (TargetX k)
        (QuadricConeInjective.x k)) 0 →ₐ[TargetX k] SourceX k :=
  QuadraticAlgebra.lift ⟨algebraMap (QuadricConeAmbientFinite.Plane k) (SourceX k)
    (QuadricConeAmbientFinite.u k), by
      simp only [Algebra.smul_def, mul_one, map_zero, zero_mul, add_zero]
      change _ = chartX k (algebraMap (QuadricConeInjective.CoordinateRing k)
        (TargetX k) (QuadricConeInjective.x k))
      simpa only [pow_two] using (chartX_x k).symm⟩

omit [CharZero k] in
theorem quadraticChartX_surjective : Function.Surjective (quadraticChartX k) := by
  exact (QuadraticAlgebra.lift_surjective_iff _).mpr (adjoin_u_eq_top k)

noncomputable def quadraticChartZ :
    QuadraticAlgebra (TargetZ k)
      (algebraMap (QuadricConeInjective.CoordinateRing k) (TargetZ k)
        (QuadricConeInjective.z k)) 0 →ₐ[TargetZ k] SourceZ k :=
  QuadraticAlgebra.lift ⟨algebraMap (QuadricConeAmbientFinite.Plane k) (SourceZ k)
    (QuadricConeAmbientFinite.v k), by
      simp only [Algebra.smul_def, mul_one, map_zero, zero_mul, add_zero]
      change _ = chartZ k (algebraMap (QuadricConeInjective.CoordinateRing k)
        (TargetZ k) (QuadricConeInjective.z k))
      simpa only [pow_two] using (chartZ_z k).symm⟩

omit [CharZero k] in
theorem quadraticChartZ_surjective : Function.Surjective (quadraticChartZ k) := by
  exact (QuadraticAlgebra.lift_surjective_iff _).mpr (adjoin_v_eq_top k)

#print axioms quadraticChartX_surjective
#print axioms quadraticChartZ_surjective

end Pcf.Examples.PaperP.QuadricConePuncturedChart
