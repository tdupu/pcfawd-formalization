module

public import Pcf.Examples.PaperP.BasilicaProjectiveAffineChart
public import Mathlib.Algebra.QuadraticAlgebra.Basic

/-!
# Finiteness of the global basilica scheme morphism

For `latex/paper-p.tex`, Example `ex:basilica`, the inverse image of the
other standard target chart is `D₊(u² - v²)`. Its homogeneous coordinate
ring is generated by `s = v²/(u²-v²)` and `t = uv/(u²-v²)`, with
`t² = s(s+1)`. The chart pullback sends the target parameter to `s`, so
`t` is integral and the actual chart morphism is finite. Together with
the finite polynomial chart, this proves finiteness of the global Proj
morphism over every field.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory MvPolynomial HomogeneousLocalization
namespace Pcf.Examples.PaperP.BasilicaProjectiveScheme
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option linter.style.haveILetI false
variable (k : Type*) [Field k]
attribute [local instance] MvPolynomial.gradedAlgebra
local notation "u" => (X (Sum.inl 0) : Coordinates k)
local notation "v" => (X (Sum.inr ()) : Coordinates k)
/-- The pullback of the first target coordinate. -/
noncomputable abbrev infinityPreimageDenom : Coordinates k := aeval (forms k) u
theorem infinityPreimageDenom_ne_zero : infinityPreimageDenom k ≠ 0 := by
  intro h
  have he := congrArg
    (MvPolynomial.eval (Sum.elim (fun _ : Fin 1 => (1 : k)) (fun _ : Unit => 0))) h
  simp [infinityPreimageDenom, forms] at he
theorem infinityDenom_homogeneous : (infinityPreimageDenom k).IsHomogeneous 2 := by
  simpa only [infinityPreimageDenom, aeval_X] using forms_homogeneous k (Sum.inl 0)
local instance infinityLocDomain : IsDomain (Localization.Away (infinityPreimageDenom k)) :=
  Localization.Away.isDomain (infinityPreimageDenom_ne_zero k)
abbrev InfinityPreimageRing := Away (grading k) (infinityPreimageDenom k)
noncomputable def infinityPreimageS : InfinityPreimageRing k :=
  Away.mk (grading k) (infinityDenom_homogeneous k) 1 (v ^ 2)
    (by simpa using (isHomogeneous_X k (Sum.inr ())).pow 2)
noncomputable def infinityPreimageT : InfinityPreimageRing k :=
  Away.mk (grading k) (infinityDenom_homogeneous k) 1 (u * v)
    (by simpa using (isHomogeneous_X k (Sum.inl 0)).mul (isHomogeneous_X k (Sum.inr ())))
noncomputable def infinityPreimageU : InfinityPreimageRing k :=
  Away.mk (grading k) (infinityDenom_homogeneous k) 1 (u ^ 2)
    (by simpa using (isHomogeneous_X k (Sum.inl 0)).pow 2)

theorem infinityFraction_val_mul_denom (P : Coordinates k) (hP : P ∈ grading k 2) :
    (Away.mk (grading k) (infinityDenom_homogeneous k) 1 P
      (by simpa using hP)).val * algebraMap (Coordinates k)
        (Localization.Away (infinityPreimageDenom k)) (infinityPreimageDenom k) =
      algebraMap (Coordinates k) (Localization.Away (infinityPreimageDenom k)) P := by
  simpa only [Away.val_mk, pow_one, Localization.mk_eq_mk'] using
    (IsLocalization.mk'_spec (M := Submonoid.powers (infinityPreimageDenom k))
      (Localization.Away (infinityPreimageDenom k)) P
      ⟨infinityPreimageDenom k, 1, by simp⟩)

theorem infinityPreimageS_add_one : infinityPreimageS k + 1 = infinityPreimageU k := by
  apply HomogeneousLocalization.val_injective
  rw [val_add, val_one]
  have hunit := IsLocalization.Away.algebraMap_isUnit
    (S := Localization.Away (infinityPreimageDenom k)) (infinityPreimageDenom k)
  apply mul_right_cancel₀ hunit.ne_zero
  rw [add_mul, one_mul]
  rw [show (infinityPreimageS k).val * algebraMap (Coordinates k)
      (Localization.Away (infinityPreimageDenom k)) (infinityPreimageDenom k) =
      algebraMap (Coordinates k) (Localization.Away (infinityPreimageDenom k)) (v ^ 2) from
      infinityFraction_val_mul_denom k _ ((isHomogeneous_X k (Sum.inr ())).pow 2)]
  rw [show (infinityPreimageU k).val * algebraMap (Coordinates k)
      (Localization.Away (infinityPreimageDenom k)) (infinityPreimageDenom k) =
      algebraMap (Coordinates k) (Localization.Away (infinityPreimageDenom k)) (u ^ 2) from
      infinityFraction_val_mul_denom k _ ((isHomogeneous_X k (Sum.inl 0)).pow 2)]
  rw [← map_add]
  congr 1
  simp [infinityPreimageDenom, forms]

theorem infinityPreimageT_sq :
    infinityPreimageT k ^ 2 = infinityPreimageS k * (infinityPreimageS k + 1) := by
  rw [infinityPreimageS_add_one]
  apply HomogeneousLocalization.val_injective
  simp only [val_pow, val_mul, infinityPreimageT, infinityPreimageS, infinityPreimageU,
    Away.val_mk, Localization.mk_pow, Localization.mk_mul]
  congr 1
  · simp only [pow_two]
    ring
  · simp [pow_two]
noncomputable def infinityPreimage22 : InfinityPreimageRing k :=
  Away.mk (grading k) (infinityDenom_homogeneous k) 2 (u ^ 2 * v ^ 2)
    (by
      change (u ^ 2 * v ^ 2).IsHomogeneous 4
      exact ((isHomogeneous_X k (Sum.inl 0)).pow 2).mul
        ((isHomogeneous_X k (Sum.inr ())).pow 2))

theorem infinityPreimage22_eq_S_mul_U :
    infinityPreimage22 k = infinityPreimageS k * infinityPreimageU k := by
  apply HomogeneousLocalization.val_injective
  simp only [infinityPreimage22, val_mul, infinityPreimageS, infinityPreimageU,
    Away.val_mk, Localization.mk_mul]
  congr 1 <;> simp [pow_two, mul_comm]

theorem coordinates_adjoin_variables :
    Algebra.adjoin (grading k 0) (Set.range (X : Index → Coordinates k)) = ⊤ := by
  apply eq_top_iff.mpr
  intro P _
  induction P using MvPolynomial.induction_on with
  | C a =>
    exact (Algebra.adjoin (grading k 0) (Set.range (X : Index → Coordinates k))).algebraMap_mem
      ⟨C a, by
        change (C a : Coordinates k).IsHomogeneous 0
        exact isHomogeneous_C Index a⟩
  | add P Q hP hQ => exact add_mem (hP trivial) (hQ trivial)
  | mul_X P i hP => exact mul_mem (hP trivial) (Algebra.subset_adjoin ⟨i, rfl⟩)

/-- The second source chart has two explicit algebra generators. -/
theorem infinityPreimage_adjoin_ST :
    Algebra.adjoin (grading k 0) {infinityPreimageS k, infinityPreimageT k} = ⊤ := by
  let S := Algebra.adjoin (grading k 0) {infinityPreimageS k, infinityPreimageT k}
  have hs : infinityPreimageS k ∈ S := Algebra.subset_adjoin (Or.inl rfl)
  have ht : infinityPreimageT k ∈ S := Algebra.subset_adjoin (Or.inr rfl)
  have hu : infinityPreimageU k ∈ S := by
    rw [← infinityPreimageS_add_one]
    exact add_mem hs (one_mem S)
  have hgen := Away.adjoin_mk_prod_pow_eq_top (infinityDenom_homogeneous k)
    Index (X : Index → Coordinates k) (coordinates_adjoin_variables k)
    (fun _ : Index => (1 : ℕ)) (fun i => isHomogeneous_X k i)
  apply eq_top_iff.mpr
  intro z _
  have hz : z ∈ Algebra.adjoin (grading k 0)
      { Away.mk (grading k) (infinityDenom_homogeneous k) a
        (∏ i : Index, X i ^ ai i)
        (hai ▸ SetLike.prod_pow_mem_graded _ _ _ _ fun i _ => isHomogeneous_X k i) |
        (a : ℕ) (ai : Index → ℕ) (hai : ∑ i : Index, ai i • (1 : ℕ) = a • 2)
        (_ : ∀ i, ai i ≤ 2) } := by
    rw [hgen]
    trivial
  apply (Algebra.adjoin_le (S := S) ?_) hz
  rintro _ ⟨m, ai, hai, hbound, rfl⟩
  have h0 := hbound (Sum.inl 0)
  have h1 := hbound (Sum.inr ())
  have hsum : ai (Sum.inl 0) + ai (Sum.inr ()) = m * 2 := by
    simpa [Fintype.sum_sum_type, Fin.sum_univ_one, smul_eq_mul] using hai
  interval_cases ha : ai (Sum.inl 0) <;> interval_cases hb : ai (Sum.inr ())
  all_goals try omega
  all_goals have hm : m = (ai (Sum.inl 0) + ai (Sum.inr ())) / 2 := by omega
  all_goals simp only [ha, hb] at hm
  all_goals norm_num at hm
  all_goals subst m
  all_goals simp only [Fintype.prod_sum_type, Fintype.prod_unique,
    (show (default : Fin 1) = 0 from Subsingleton.elim _ _),
    (show (default : Unit) = () from rfl), ha, hb,
    pow_zero, pow_one, mul_one, one_mul]
  · have he : Away.mk (grading k) (infinityDenom_homogeneous k) 0 1
        (by
          change (1 : Coordinates k).IsHomogeneous 0
          exact isHomogeneous_one Index k) =
        (1 : InfinityPreimageRing k) := by
      apply HomogeneousLocalization.val_injective
      simp [Away.val_mk, val_one]
    rw [he]
    exact one_mem S
  · exact hs
  · exact ht
  · exact hu
  · change infinityPreimage22 k ∈ S
    rw [infinityPreimage22_eq_S_mul_U]
    exact mul_mem hs hu


abbrev InfinityTargetRing := Away (grading k) u
noncomputable def infinityTargetParameter : InfinityTargetRing k :=
  Away.mk (grading k) (isHomogeneous_X k (Sum.inl 0)) 1 v
    (by simpa using isHomogeneous_X k (Sum.inr ()))
noncomputable def infinityPullback : InfinityTargetRing k →+* InfinityPreimageRing k :=
  Pcf.paperPFormsAwayMap (forms k) 2 (forms_homogeneous k) u
noncomputable instance infinityPullbackAlgebra :
    Algebra (InfinityTargetRing k) (InfinityPreimageRing k) := (infinityPullback k).toAlgebra

theorem infinityPullback_parameter :
    infinityPullback k (infinityTargetParameter k) = infinityPreimageS k := by
  apply HomogeneousLocalization.val_injective
  change Localization.mk (aeval (forms k) v) ⟨aeval (forms k) (u ^ 1), _⟩ = _
  simp [infinityPreimageS, Away.val_mk, forms]

theorem infinityPullback_zeroDegree (a : grading k 0) :
    infinityPullback k (algebraMap (grading k 0) (InfinityTargetRing k) a) =
      algebraMap (grading k 0) (InfinityPreimageRing k) a := by
  have ha : (a : Coordinates k).IsHomogeneous 0 := a.property
  have he : C ((a : Coordinates k).coeff 0) = (a : Coordinates k) := by
    simpa only [MvPolynomial.homogeneousComponent_zero] using
      MvPolynomial.homogeneousComponent_eq_self ha
  let c : NumDenSameDeg (grading k) (Submonoid.powers u) :=
    ⟨0, a, 1, one_mem _⟩
  have hc : algebraMap (grading k 0) (InfinityTargetRing k) a = HomogeneousLocalization.mk c := rfl
  rw [hc]
  unfold infinityPullback Pcf.paperPFormsAwayMap
  rw [Pcf.paperPDegreeLocalizationMap_mk]
  apply HomogeneousLocalization.val_injective
  change Localization.mk (aeval (forms k) (a : Coordinates k)) ⟨aeval (forms k) 1, _⟩ =
    Localization.mk (a : Coordinates k) ⟨1, _⟩
  have hf : aeval (forms k) (a : Coordinates k) = (a : Coordinates k) := by
    calc
      _ = aeval (forms k) (C ((a : Coordinates k).coeff 0)) := congrArg (aeval (forms k)) he.symm
      _ = C ((a : Coordinates k).coeff 0) := by simp
      _ = (a : Coordinates k) := he
  congr 1
  apply Subtype.ext
  exact map_one (aeval (forms k))

/-- Over the target chart, only the quadratic generator is needed. -/
theorem infinityPreimage_adjoin_T :
    Algebra.adjoin (InfinityTargetRing k) {infinityPreimageT k} = ⊤ := by
  let S := Algebra.adjoin (InfinityTargetRing k) {infinityPreimageT k}
  let S0 : Subalgebra (grading k 0) (InfinityPreimageRing k) :=
    { S.toSubring with
      algebraMap_mem' := fun a => by
        have h := S.algebraMap_mem (algebraMap (grading k 0) (InfinityTargetRing k) a)
        change infinityPullback k (algebraMap (grading k 0) (InfinityTargetRing k) a) ∈ S at h
        rwa [infinityPullback_zeroDegree] at h }
  have hs : infinityPreimageS k ∈ S0 := by
    change infinityPreimageS k ∈ S
    rw [← infinityPullback_parameter]
    exact S.algebraMap_mem (infinityTargetParameter k)
  have ht : infinityPreimageT k ∈ S0 := by
    change infinityPreimageT k ∈ S
    exact Algebra.subset_adjoin rfl
  have hle : Algebra.adjoin (grading k 0) {infinityPreimageS k, infinityPreimageT k} ≤ S0 := by
    apply Algebra.adjoin_le
    intro z hz
    rcases hz with rfl | hz
    · exact hs
    · obtain rfl := Set.mem_singleton_iff.mp hz
      exact ht
  rw [infinityPreimage_adjoin_ST] at hle
  have htop : S0 = ⊤ := top_le_iff.mp hle
  apply eq_top_iff.mpr
  intro z _
  have hz : z ∈ S0 := by rw [htop]; trivial
  exact hz

theorem infinityPreimageT_isIntegral : IsIntegral (InfinityTargetRing k) (infinityPreimageT k) := by
  apply IsIntegral.of_pow (by decide : 0 < 2)
  rw [infinityPreimageT_sq, ← infinityPullback_parameter]
  exact (isIntegral_algebraMap).mul ((isIntegral_algebraMap).add (isIntegral_one))

theorem infinityPreimage_moduleFinite :
    Module.Finite (InfinityTargetRing k) (InfinityPreimageRing k) := by
  have h := (infinityPreimageT_isIntegral k).fg_adjoin_singleton
  rw [infinityPreimage_adjoin_T] at h
  rw [Module.finite_def]
  simpa using h

theorem infinityPullback_finite : (infinityPullback k).Finite := infinityPreimage_moduleFinite k

noncomputable def infinityTargetOpen : (Proj (grading k)).Opens :=
  AlgebraicGeometry.Proj.basicOpen (grading k) u
noncomputable def infinitySourceOpen : (Proj (grading k)).Opens :=
  AlgebraicGeometry.Proj.basicOpen (grading k) (infinityPreimageDenom k)
noncomputable def infinitySourceChartIso : (infinitySourceOpen k).toScheme ≅
    Spec (.of (InfinityPreimageRing k)) :=
  AlgebraicGeometry.Proj.basicOpenIsoSpec (grading k) (infinityPreimageDenom k)
    (infinityDenom_homogeneous k) (by decide : 0 < 2)
noncomputable def infinityTargetChartIso : (infinityTargetOpen k).toScheme ≅
    Spec (.of (InfinityTargetRing k)) :=
  AlgebraicGeometry.Proj.basicOpenIsoSpec (grading k) u (isHomogeneous_X k (Sum.inl 0))
    Nat.zero_lt_one
noncomputable def infinityRestriction : (infinitySourceOpen k).toScheme ⟶
    (infinityTargetOpen k).toScheme :=
  (schemeMap k).resLE (infinityTargetOpen k) (infinitySourceOpen k) le_rfl

/-- The actual restricted scheme map is induced by the finite chart ring map. -/
theorem infinityRestriction_eq_conjugate :
    infinityRestriction k = (infinitySourceChartIso k).hom ≫
      Spec.map (CommRingCat.ofHom (infinityPullback k)) ≫ (infinityTargetChartIso k).inv := by
  have h := Pcf.paperPForms_awayι_comp_map (forms k) 2 (by decide) (forms_homogeneous k)
    (forms_cover k) Nat.zero_lt_one u (isHomogeneous_X k (Sum.inl 0))
  simp only [AlgebraicGeometry.Proj.awayι, Category.assoc] at h
  have hres : (infinitySourceOpen k).ι ≫ schemeMap k =
      infinityRestriction k ≫ (infinityTargetOpen k).ι := by simp [infinityRestriction]
  change (infinitySourceChartIso k).inv ≫ (infinitySourceOpen k).ι ≫ schemeMap k =
    Spec.map (CommRingCat.ofHom (infinityPullback k)) ≫
      (infinityTargetChartIso k).inv ≫ (infinityTargetOpen k).ι at h
  rw [hres, ← Category.assoc, ← Category.assoc] at h
  have h' := (cancel_mono (infinityTargetOpen k).ι).mp h
  apply (cancel_epi (infinitySourceChartIso k).inv).mp
  simpa [Category.assoc] using h'

theorem infinityRestriction_finite : IsFinite (infinityRestriction k) := by
  rw [infinityRestriction_eq_conjugate]
  haveI : IsFinite (Spec.map (CommRingCat.ofHom (infinityPullback k))) :=
    (IsFinite.SpecMap_iff _).mpr (infinityPullback_finite k)
  infer_instance

/-- The actual projective basilica morphism is finite over every field.

`paper-p.tex` correspondence: Example 4.2 (`ex:basilica`). -/
theorem global_schemeMap_finite : IsFinite (schemeMap k) := by
  apply (IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := @IsFinite)
    (fun i : Index => AlgebraicGeometry.Proj.basicOpen (grading k) (X i))
    (Pcf.paperPSourceCoordinates_basicOpen_cover (K := k) (n := 1))).mpr
  intro i
  cases i with
  | inl i =>
    have hi : i = 0 := Subsingleton.elim _ _
    subst i
    change IsFinite ((schemeMap k) ∣_ infinityTargetOpen k)
    have he : (schemeMap k) ∣_ infinityTargetOpen k = infinityRestriction k := by
      exact ((schemeMap k).resLE_eq_morphismRestrict).symm
    rw [he]
    exact infinityRestriction_finite k
  | inr i =>
    have hi : i = () := Subsingleton.elim _ _
    subst i
    change IsFinite ((schemeMap k) ∣_ affineOpen k)
    let e := (Proj (grading k)).isoOfEq (show schemeMap k ⁻¹ᵁ affineOpen k = affineOpen k from
      preimage_affineChart k)
    have he : (schemeMap k) ∣_ affineOpen k = e.hom ≫ affineRestriction k := by
      apply (cancel_mono (affineOpen k).ι).mp
      simp [e, affineRestriction, Scheme.isoOfEq, Category.assoc]
    rw [he]
    haveI : IsFinite (affineRestriction k) := affineRestriction_finite k
    infer_instance

end Pcf.Examples.PaperP.BasilicaProjectiveScheme
