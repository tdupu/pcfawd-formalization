/-!
# Even and odd parts of the nodal parametrization

The image of the nodal coordinate ring in `k[t]` is generated by
`x=t²-1` and `y=t(t²-1)`. A relation in the normal form `a(x)+b(x)y`
can vanish only when both coefficients vanish. This is an algebraic
input toward proving that the candidate parametrization of
`paper-p.tex`, Example `ex:loci-compared`, is the normalization.
-/

@[expose] public section

namespace Pcf.Examples.PaperP.NodalCubic

open Polynomial AlgebraicGeometry CategoryTheory

variable (k : Type*) [Field k]

private theorem quadratic_substitution_ne_C :
    (X ^ 2 - 1 : k[X]) ≠ C ((X ^ 2 - 1 : k[X]).coeff 0) := by
  intro h
  have hd := congrArg Polynomial.natDegree h
  have hdegree : (X ^ 2 - 1 : k[X]).natDegree = 2 := by
    simpa only [map_one] using
      (Polynomial.natDegree_X_pow_sub_C (R := k) (n := 2) (r := 1))
  rw [hdegree, natDegree_C] at hd
  omega

/-- Substituting `t²-1` into a polynomial is injective. -/
theorem quadratic_substitution_injective :
    Function.Injective (fun a : k[X] => a.comp (X ^ 2 - 1)) := by
  intro a b hab
  have hzero : (a - b).comp (X ^ 2 - 1 : k[X]) = 0 := by
    have hab' : a.comp (X ^ 2 - 1 : k[X]) = b.comp (X ^ 2 - 1 : k[X]) := hab
    rw [sub_comp, hab', sub_self]
  rcases (Polynomial.comp_eq_zero_iff.mp hzero) with h | h
  · exact sub_eq_zero.mp h
  · exact False.elim (quadratic_substitution_ne_C k h.2)

/-- The even and odd parts of a nodal normal-form relation are independent
in characteristic zero. -/
theorem parametrization_normalForm_independent [CharZero k]
    (a b : k[X])
    (h : a.comp (X ^ 2 - 1) +
      X * (X ^ 2 - 1) * b.comp (X ^ 2 - 1) = 0) :
    a = 0 ∧ b = 0 := by
  let q : k[X] := X ^ 2 - 1
  have hqneg : q.comp (-X) = q := by
    simp only [q, sub_comp, pow_comp, X_comp, one_comp]
    ring
  have hneg : a.comp q - X * q * b.comp q = 0 := by
    have hh : (a.comp q + X * q * b.comp q).comp (-X) = 0 := by
      simpa only [q, zero_comp] using congrArg (fun p : k[X] => p.comp (-X)) h
    simpa only [add_comp, mul_comp, comp_assoc, X_comp, hqneg,
      zero_comp, neg_mul, sub_eq_add_neg] using hh
  have htwo : (2 : k[X]) * (X * q * b.comp q) = 0 := by
    linear_combination h - hneg
  have hterm : X * q * b.comp q = 0 :=
    (mul_eq_zero.mp htwo).resolve_left (by norm_num)
  have hq : q ≠ 0 := by
    intro heq
    have hd := congrArg Polynomial.natDegree heq
    have hdegree : q.natDegree = 2 := by
      simpa only [q, map_one] using
        (Polynomial.natDegree_X_pow_sub_C (R := k) (n := 2) (r := 1))
    rw [hdegree, natDegree_zero] at hd
    omega
  have hbcomp : b.comp q = 0 := by
    have hXq : X * q ≠ 0 := mul_ne_zero (by simp) hq
    exact (mul_eq_zero.mp hterm).resolve_left hXq
  have hacomp : a.comp q = 0 := by
    have h' : a.comp q + X * q * b.comp q = 0 := h
    simpa only [hterm, add_zero] using h'
  constructor
  · exact quadratic_substitution_injective k (by simpa [q] using hacomp)
  · exact quadratic_substitution_injective k (by simpa [q] using hbcomp)

/-- The defining equation of the nodal cubic, inside its actual affine
coordinate ring. -/
theorem coordinate_y_sq_eq :
    (Ideal.Quotient.mk (ideal k) (MvPolynomial.X 1) : CoordinateRing k) ^ 2 =
      (Ideal.Quotient.mk (ideal k) (MvPolynomial.X 0) : CoordinateRing k) ^ 2 *
        (Ideal.Quotient.mk (ideal k) (MvPolynomial.X 0) + 1) := by
  have hrel : Ideal.Quotient.mk (ideal k) (equation k) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
  unfold equation at hrel
  simpa only [map_sub, map_mul, map_pow, map_add, map_one, sub_eq_zero] using hrel

/-- Every function on the nodal cubic has a representative linear in `y`
with coefficients in `k[x]`. -/
theorem coordinate_normalForm (c : CoordinateRing k) :
    ∃ a b : k[X], c = projection k a + projection k b *
      (Ideal.Quotient.mk (ideal k) (MvPolynomial.X 1) : CoordinateRing k) := by
  let x : CoordinateRing k := Ideal.Quotient.mk (ideal k) (MvPolynomial.X 0)
  let y : CoordinateRing k := Ideal.Quotient.mk (ideal k) (MvPolynomial.X 1)
  have hy : y ^ 2 = x ^ 2 * (x + 1) := coordinate_y_sq_eq k
  refine Quotient.inductionOn c ?_
  intro p
  induction p using MvPolynomial.induction_on with
  | C a =>
      refine ⟨C a, 0, ?_⟩
      change (Ideal.Quotient.mkₐ k (ideal k)) (MvPolynomial.C a) = _
      simp [projection]
  | add p q hp hq =>
      obtain ⟨a, b, hab⟩ := hp
      obtain ⟨a', b', hab'⟩ := hq
      change (Ideal.Quotient.mk (ideal k)) p = _ at hab
      change (Ideal.Quotient.mk (ideal k)) q = _ at hab'
      refine ⟨a + a', b + b', ?_⟩
      change (Ideal.Quotient.mk (ideal k)) (p + q) = _
      rw [map_add, hab, hab']
      simp only [map_add]
      ring
  | mul_X p i hp =>
      obtain ⟨a, b, hab⟩ := hp
      change (Ideal.Quotient.mk (ideal k)) p = _ at hab
      fin_cases i
      · refine ⟨a * X, b * X, ?_⟩
        change (Ideal.Quotient.mk (ideal k)) (p * MvPolynomial.X 0) = _
        rw [map_mul, hab]
        simp only [map_mul, projection_X]
        ring
      · refine ⟨b * X ^ 2 * (X + 1), a, ?_⟩
        change (Ideal.Quotient.mk (ideal k)) (p * MvPolynomial.X 1) = _
        rw [map_mul, hab]
        simp only [map_mul, map_pow, map_add, map_one, projection_X]
        linear_combination (projection k b) * hy

/-- On the polynomial subring `k[x]`, the parametrization substitutes
`x=t²-1`. -/
theorem parametrization_projection_apply (a : k[X]) :
    parametrization k (projection k a) = a.comp (X ^ 2 - 1) := by
  have h := congrArg (fun f : k[X] →ₐ[k] k[X] => f a)
    (parametrization_comp_projection k)
  simpa only [AlgHom.comp_apply, Polynomial.comp_eq_aeval] using h

/-- The nodal parametrization is injective in characteristic zero. The
defining equation supplies a linear-in-`y` normal form; its image splits
into independent even and odd parts in the parameter `t`. -/
theorem parametrization_injective [CharZero k] :
    Function.Injective (parametrization k) := by
  intro c d hcd
  have hzero : parametrization k (c - d) = 0 := by
    rw [map_sub, hcd, sub_self]
  obtain ⟨a, b, hab⟩ := coordinate_normalForm k (c - d)
  have hparity : a.comp (X ^ 2 - 1) +
      X * (X ^ 2 - 1) * b.comp (X ^ 2 - 1) = 0 := by
    rw [hab, map_add, map_mul, parametrization_projection_apply,
      parametrization_projection_apply, parametrization_y] at hzero
    convert hzero using 1
    ring
  obtain ⟨ha, hb⟩ := parametrization_normalForm_independent k a b hparity
  rw [ha, hb] at hab
  simp only [map_zero, zero_mul, add_zero] at hab
  exact sub_eq_zero.mp hab

/-- The nodal cubic's actual coordinate ring is a domain in characteristic
zero, as witnessed by its injection into `k[t]`. -/
instance coordinateRing_isDomain [CharZero k] : IsDomain (CoordinateRing k) :=
  Function.Injective.isDomain (parametrization k).toRingHom
    (parametrization_injective k)

/-- The parametrization is injective after inverting the nodal coordinate
`x`; together with surjectivity, this gives the explicit birational chart. -/
theorem parametrization_away_x_injective [CharZero k] :
    Function.Injective (Localization.awayMap (parametrization k).toRingHom
      (Ideal.Quotient.mk (ideal k) (MvPolynomial.X 0) : CoordinateRing k)) := by
  rw [Localization.awayMap_injective_iff]
  intro a ha
  have ha0 : a = 0 := parametrization_injective k (by simpa using ha)
  exact ⟨0, by simp [ha0]⟩

/-- On the dense principal open where `x ≠ 0`, the coordinate map is an
isomorphism. This is the ring-level birationality assertion for the nodal
parametrization. -/
noncomputable def parametrization_away_x_equiv [CharZero k] :
    Localization.Away
        (Ideal.Quotient.mk (ideal k) (MvPolynomial.X 0) : CoordinateRing k) ≃+*
      Localization.Away ((X : k[X]) ^ 2 - 1) := by
  have hx : (parametrization k).toRingHom
      (Ideal.Quotient.mk (ideal k) (MvPolynomial.X 0) : CoordinateRing k) =
      (X : k[X]) ^ 2 - 1 := parametrization_x k
  rw [← hx]
  exact RingEquiv.ofBijective
    (Localization.awayMap (parametrization k).toRingHom
      (Ideal.Quotient.mk (ideal k) (MvPolynomial.X 0) : CoordinateRing k))
    ⟨parametrization_away_x_injective k, parametrization_away_x_surjective k⟩

/-- The explicit isomorphism away from the node extends to an isomorphism
of the two function fields. -/
noncomputable def nodalFunctionFieldEquiv [CharZero k] :
    FractionRing (CoordinateRing k) ≃+* FractionRing k[X] := by
  let x : CoordinateRing k :=
    Ideal.Quotient.mk (ideal k) (MvPolynomial.X 0)
  let t2 : k[X] := X ^ 2 - 1
  have ht2ne : t2 ≠ 0 := by
    simpa only [t2, map_one] using
      (X_pow_sub_C_ne_zero (R := k) (n := 2) (by decide) (1 : k))
  have hxne : x ≠ 0 := by
    intro hx
    have h := congrArg (parametrization k) hx
    apply ht2ne
    simpa only [x, t2, map_zero, parametrization_x] using h
  have hxm : Submonoid.powers x ≤ nonZeroDivisors (CoordinateRing k) := by
    intro a ha
    rcases ha with ⟨n, rfl⟩
    exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n hxne)
  have ht2m : Submonoid.powers t2 ≤ nonZeroDivisors k[X] := by
    intro a ha
    rcases ha with ⟨n, rfl⟩
    exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n ht2ne)
  letI : Algebra (Localization.Away x) (FractionRing (CoordinateRing k)) :=
    IsLocalization.localizationAlgebraOfSubmonoidLe _ _ (Submonoid.powers x)
      (nonZeroDivisors (CoordinateRing k)) hxm
  haveI : IsScalarTower (CoordinateRing k) (Localization.Away x)
      (FractionRing (CoordinateRing k)) :=
    IsLocalization.localization_isScalarTower_of_submonoid_le _ _
      (Submonoid.powers x) (nonZeroDivisors (CoordinateRing k)) hxm
  letI : Algebra (Localization.Away t2) (FractionRing k[X]) :=
    IsLocalization.localizationAlgebraOfSubmonoidLe _ _ (Submonoid.powers t2)
      (nonZeroDivisors k[X]) ht2m
  haveI : IsScalarTower k[X] (Localization.Away t2) (FractionRing k[X]) :=
    IsLocalization.localization_isScalarTower_of_submonoid_le _ _
      (Submonoid.powers t2) (nonZeroDivisors k[X]) ht2m
  haveI : IsFractionRing (Localization.Away x) (FractionRing (CoordinateRing k)) :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization
      (Submonoid.powers x) _ _
  haveI : IsFractionRing (Localization.Away t2) (FractionRing k[X]) :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization
      (Submonoid.powers t2) _ _
  exact IsFractionRing.ringEquivOfRingEquiv (parametrization_away_x_equiv k)

/-- The parameter fraction field is a fraction field of the nodal
coordinate ring via the original parametrization. -/
instance parameterFractionRing_isFractionRing [CharZero k] :
    IsFractionRing (CoordinateRing k) (FractionRing k[X]) := by
  have hinj : Function.Injective
      (algebraMap (CoordinateRing k) (FractionRing k[X])) := by
    intro a b hab
    apply parametrization_injective k
    apply IsFractionRing.injective k[X] (FractionRing k[X])
    simpa only [IsScalarTower.algebraMap_apply (CoordinateRing k) k[X]
      (FractionRing k[X]), algebraMap_parametrization] using hab
  change IsLocalization (nonZeroDivisors (CoordinateRing k)) (FractionRing k[X])
  rw [isLocalization_iff_isLocalizationMap]
  refine ⟨?_, ?_, ?_⟩
  · intro y
    exact isUnit_iff_ne_zero.mpr (by
      intro hy
      exact (mem_nonZeroDivisors_iff_ne_zero.mp y.property) (hinj (by simpa using hy)))
  · intro z
    let x : CoordinateRing k :=
      Ideal.Quotient.mk (ideal k) (MvPolynomial.X 0)
    have hxne : x ≠ 0 := by
      intro hx
      have h := congrArg (parametrization k) hx
      have ht : (X ^ 2 - 1 : k[X]) ≠ 0 := by
        simpa only [map_one] using
          (X_pow_sub_C_ne_zero (R := k) (n := 2) (by decide) (1 : k))
      exact ht (by simpa only [x, map_zero, parametrization_x] using h)
    have hclear := (Localization.awayMap_surjective_iff.mp
      (parametrization_away_x_surjective k))
    obtain ⟨p, q, hq, hpq⟩ := IsFractionRing.div_surjective k[X] z
    obtain ⟨a, m, ha⟩ := hclear p
    obtain ⟨b, n, hb⟩ := hclear q
    have hqne : q ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hq
    have hbne : b ≠ 0 := by
      intro hb0
      rw [hb0, map_zero] at hb
      have hxn : (parametrization k) x ≠ 0 := by
        intro h0
        exact hxne ((parametrization_injective k) (by simpa using h0))
      exact (mul_ne_zero (pow_ne_zero n hxn) hqne) hb.symm
    refine ⟨(a * x ^ n, ⟨b * x ^ m,
      mem_nonZeroDivisors_iff_ne_zero.mpr
        (mul_ne_zero hbne (pow_ne_zero m hxne))⟩), ?_⟩
    change z * algebraMap (CoordinateRing k) (FractionRing k[X]) (b * x ^ m) =
      algebraMap (CoordinateRing k) (FractionRing k[X]) (a * x ^ n)
    rw [← hpq]
    simp only [IsScalarTower.algebraMap_apply (CoordinateRing k) k[X]
      (FractionRing k[X]), algebraMap_parametrization, map_mul, map_pow]
    change (parametrization k) a = (parametrization k) x ^ m * p at ha
    change (parametrization k) b = (parametrization k) x ^ n * q at hb
    rw [ha, hb]
    simp only [map_mul, map_pow]
    have hqmap : algebraMap k[X] (FractionRing k[X]) q ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hq
    field_simp [hqmap]
  · intro a b h
    exact ⟨1, by simpa using hinj h⟩

/-- Canonical function-field equivalence over the nodal coordinate ring. -/
noncomputable def canonicalNodalFunctionFieldEquiv [CharZero k] :
    FractionRing (CoordinateRing k) ≃ₐ[CoordinateRing k] FractionRing k[X] :=
  IsLocalization.algEquiv (nonZeroDivisors (CoordinateRing k))
    (FractionRing (CoordinateRing k)) (FractionRing k[X])

/-- The parameter ring is the integral closure of the nodal coordinate
ring in the parameter fraction field. The away-`x` equivalence proves
this extension is birational. -/
instance parameterRing_isIntegralClosure [CharZero k] :
    IsIntegralClosure k[X] (CoordinateRing k) (FractionRing k[X]) :=
  inferInstance

/-- The actual parameter ring is canonically isomorphic, over the nodal
coordinate ring, to its integral closure in the parameter function field. -/
noncomputable def parameterRing_integralClosureEquiv [CharZero k] :
    k[X] ≃ₐ[CoordinateRing k]
      integralClosure (CoordinateRing k) (FractionRing k[X]) :=
  IsIntegralClosure.equiv (CoordinateRing k) k[X] (FractionRing k[X])
    (integralClosure (CoordinateRing k) (FractionRing k[X]))

/-- Scheme-level form of the integral-closure identification in the
parameter function field. -/
noncomputable def parameterSpec_integralClosureIso [CharZero k] :
    Spec (.of k[X]) ≅
      Spec (.of (integralClosure (CoordinateRing k) (FractionRing k[X]))) :=
  (Scheme.Spec.mapIso
    (parameterRing_integralClosureEquiv k).toCommRingCatIso.op).symm

/-- The integral-closure identification respects the map to the nodal cubic. -/
theorem parameterSpec_integralClosureIso_over_node [CharZero k] :
    (parameterSpec_integralClosureIso k).hom ≫
        Spec.map (CommRingCat.ofHom
          (algebraMap (CoordinateRing k)
            (integralClosure (CoordinateRing k) (FractionRing k[X])))) =
      normalizationSchemeMap k := by
  unfold parameterSpec_integralClosureIso normalizationSchemeMap
  simp only [Iso.symm_hom, Functor.mapIso_inv, Iso.op_inv, Scheme.Spec_map]
  rw [← Spec.map_comp]
  congr 1
  apply CommRingCat.hom_ext
  apply RingHom.ext
  intro a
  change (parameterRing_integralClosureEquiv k).symm
    (algebraMap (CoordinateRing k)
      (integralClosure (CoordinateRing k) (FractionRing k[X])) a) =
    parametrization k a
  rw [← (parameterRing_integralClosureEquiv k).commutes a,
    AlgEquiv.symm_apply_apply]
  rfl

/-- The nodal normalization is formally unramified, including over the node.
The two equations `x = t² - 1` and `y = xt` force `dt = 0`: their
differentials give `2t dt = 0` and `(t² - 1) dt = 0`. -/
instance parametrization_formallyUnramified [CharZero k] :
    Algebra.FormallyUnramified (CoordinateRing k) k[X] := by
  let D := KaehlerDifferential.D (CoordinateRing k) k[X]
  have hX : D (X : k[X]) = 0 := by
    have hx : D ((X : k[X]) ^ 2 - 1) = 0 := by
      rw [← parametrization_x k, ← algebraMap_parametrization]
      exact D.map_algebraMap _
    have hy : D (((X : k[X]) ^ 2 - 1) * X) = 0 := by
      have heq : ((X : k[X]) ^ 2 - 1) * X = (X : k[X]) ^ 3 - X := by ring
      rw [heq, ← parametrization_y k, ← algebraMap_parametrization]
      exact D.map_algebraMap _
    simp only [map_sub, Derivation.map_one_eq_zero, sub_zero, Derivation.leibniz_pow,
      Derivation.leibniz] at hx hy
    simp only [Nat.reduceSubDiff, pow_one] at hx hy
    have htwo : IsUnit (2 : k[X]) := by
      rw [show (2 : k[X]) = C (2 : k) by rfl]
      exact isUnit_C.mpr (isUnit_iff_ne_zero.mpr (by norm_num))
    have hXd : (X : k[X]) • D X = 0 := by
      have h2 : (2 : k[X]) • ((X : k[X]) • D X) = 0 := by
        simpa only [two_smul] using hx
      exact htwo.smul_left_cancel.mp (by simpa using h2)
    rw [hx, smul_zero, add_zero] at hy
    have ht2 : (X : k[X]) ^ 2 • D X = 0 := by
      rw [pow_two, mul_smul, hXd, smul_zero]
    simpa only [sub_smul, one_smul, ht2, zero_sub, neg_eq_zero] using hy
  have hD : D = 0 := Derivation.ext_of_adjoin_eq_top
    {(X : k[X])} (parametrization_adjoin_X_eq_top k) (by simpa using hX)
  constructor
  refine (subsingleton_iff_forall_eq 0).mpr fun y ↦ ?_
  have hspan : (⊤ : Submodule k[X] Ω[k[X]⁄CoordinateRing k]) ≤ ⊥ := by
    rw [← KaehlerDifferential.span_range_derivation, Submodule.span_le]
    rintro _ ⟨x, rfl⟩
    change D x ∈ (⊥ : Submodule k[X] Ω[k[X]⁄CoordinateRing k])
    rw [hD]
    simp
  exact hspan trivial

/-- The finite nodal parametrization is unramified everywhere. -/
instance parametrization_unramified [CharZero k] :
    Algebra.Unramified (CoordinateRing k) k[X] where
  formallyUnramified := parametrization_formallyUnramified k
  finiteType := inferInstance

/-- The affine map `A¹ → N` is formally unramified as a scheme morphism. -/
instance normalizationSchemeMap_formallyUnramified [CharZero k] :
    AlgebraicGeometry.FormallyUnramified (normalizationSchemeMap k) := by
  unfold normalizationSchemeMap
  rw [AlgebraicGeometry.HasRingHomProperty.Spec_iff
    (P := @AlgebraicGeometry.FormallyUnramified)]
  change (algebraMap (CoordinateRing k) k[X]).FormallyUnramified
  exact RingHom.formallyUnramified_algebraMap.mpr
    (parametrization_formallyUnramified k)

/-- The nodal normalization map is unramified but not étale: it fails
flatness at the node. -/
theorem normalizationSchemeMap_not_etale [CharZero k] :
    ¬ AlgebraicGeometry.Etale (normalizationSchemeMap k) := by
  intro he
  exact normalizationSchemeMap_not_flat k
    (AlgebraicGeometry.Etale.iff_flat_and_formallyUnramified.mp he).1

