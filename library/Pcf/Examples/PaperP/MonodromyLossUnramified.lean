module

public import Pcf.Examples.PaperP.MonodromyLossProper
public import Mathlib.AlgebraicGeometry.Morphisms.FormallyUnramified
public import Mathlib.Tactic.Module

/-!
# The chart pieces of `φ = 1 + ι` are unramified (`ex:monodromy-loss`)

For `latex/paper-p.tex`, Example `ex:monodromy-loss`. In characteristic 3 the curve
`y² = x³ - x` has `-dx = 2y dy`, so `dx = y dy` and `Ω_A` is generated by `dy`; the
invariant differential pulls back by `φ = 1 + ι` to a unit multiple. Concretely, for each chart
piece `phiⱼ` of `φ` every derivation killing the image of `phiⱼ` is zero:

* `ringHom_formallyUnramified_of_derivation`: a general criterion (all `ℤ`-derivations into
  modules that kill `f(R)` vanish implies `f` formally unramified).
* `A_adjoin`, `B_adjoin`: `A = k[x, y]`, `B = k[s, w]` as `k`-algebras.
* **`phi1_formallyUnramified`**, **`phi2_formallyUnramified`**,
  **`phi3_formallyUnramified`**.

The ring identities used to invert the pulled-back differentials were found with Singular
(over `GF(3)`) and are re-checked by `linear_combination` in Lean.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Limits Polynomial
namespace Pcf.Examples.PaperP.MonodromyLossCurve
set_option backward.isDefEq.respectTransparency false
set_option linter.style.haveILetI false
set_option linter.unusedSimpArgs false
universe u

section General

/-- An additive map satisfying the Leibniz rule (a derivation over `ℤ`, stated without the
`ℤ`-algebra instance to avoid instance diamonds on localizations). -/
def IsDer {S M : Type u} [CommRing S] [AddCommGroup M] [Module S M] (d : S → M) : Prop :=
  (∀ a b, d (a + b) = d a + d b) ∧ ∀ a b, d (a * b) = a • d b + b • d a

namespace IsDer
variable {S M : Type u} [CommRing S] [AddCommGroup M] [Module S M] {d : S → M}

theorem add (hd : IsDer d) (a b : S) : d (a + b) = d a + d b := hd.1 a b
theorem mul (hd : IsDer d) (a b : S) : d (a * b) = a • d b + b • d a := hd.2 a b
theorem zero (hd : IsDer d) : d 0 = 0 := by
  have := hd.add 0 0; rw [add_zero] at this
  exact (add_eq_left.mp this.symm)
theorem one (hd : IsDer d) : d 1 = 0 := by
  have := hd.mul 1 1; rw [mul_one, one_smul] at this
  exact (add_eq_left.mp this.symm)
theorem neg (hd : IsDer d) (a : S) : d (-a) = -d a := by
  have := hd.add a (-a); rw [add_neg_cancel, hd.zero] at this
  exact (neg_eq_of_add_eq_zero_right this.symm).symm
theorem sub (hd : IsDer d) (a b : S) : d (a - b) = d a - d b := by
  rw [sub_eq_add_neg, hd.add, hd.neg, sub_eq_add_neg]
theorem pow_two' (hd : IsDer d) (a : S) : d (a ^ 2) = (2 * a) • d a := by
  rw [pow_two, hd.mul, ← add_smul, two_mul]
theorem pow_three' (hd : IsDer d) (a : S) : d (a ^ 3) = (3 * a ^ 2) • d a := by
  rw [pow_succ, hd.mul, hd.pow_two', smul_smul, ← add_smul]; congr 1; ring
theorem pow_four' (hd : IsDer d) (a : S) : d (a ^ 4) = (4 * a ^ 3) • d a := by
  rw [pow_succ, hd.mul, hd.pow_three', smul_smul, ← add_smul]; congr 1; ring

end IsDer

/-- **Unramifiedness from derivations.** If every derivation of `S` into an `S`-module that
kills `f(R)` vanishes, then `f : R → S` is formally unramified. -/
theorem ringHom_formallyUnramified_of_derivation {R S : Type u} [CommRing R] [CommRing S]
    (f : R →+* S)
    (h : ∀ (M : Type u) [AddCommGroup M] [Module S M] (d : S → M), IsDer d →
      (∀ r, d (f r) = 0) → ∀ s, d s = 0) : f.FormallyUnramified := by
  letI := f.toAlgebra
  refine ⟨⟨fun a b => ?_⟩⟩
  have hD : ∀ s, KaehlerDifferential.D R S s = 0 := by
    refine h _ (KaehlerDifferential.D R S)
      ⟨fun a b => map_add _ a b, fun a b => Derivation.leibniz _ a b⟩ fun r => ?_
    change KaehlerDifferential.D R S (algebraMap R S r) = 0
    exact (KaehlerDifferential.D R S).map_algebraMap r
  have htop := KaehlerDifferential.span_range_derivation R S
  have hall : ∀ m : Ω[S⁄R], m = 0 := by
    intro m
    have hm : m ∈ Submodule.span S (Set.range (KaehlerDifferential.D R S)) := by
      rw [htop]; trivial
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hm
    · rintro _ ⟨s, rfl⟩; exact hD s
    · rfl
    · intro x y _ _ hx hy; rw [hx, hy, add_zero]
    · intro a x _ hx; rw [hx, smul_zero]
  rw [hall a, hall b]

/-- A derivation vanishing on the image of a localization map vanishes. -/
theorem derivation_eq_zero_of_isLocalization {P S : Type u} [CommRing P] [CommRing S]
    [Algebra P S] (T : Submonoid P) [IsLocalization T S] {M : Type u} [AddCommGroup M]
    [Module S M] {d : S → M} (hd : IsDer d) (h : ∀ p, d (algebraMap P S p) = 0) (s : S) :
    d s = 0 := by
  obtain ⟨⟨p, t⟩, rfl⟩ := IsLocalization.mk'_surjective T s
  have hspec := IsLocalization.mk'_spec S p t
  have hu : IsUnit (algebraMap P S t) := IsLocalization.map_units S t
  have e := congrArg d hspec
  rw [hd.mul, h, h, smul_zero, zero_add] at e
  obtain ⟨u, hu'⟩ := hu
  have : (↑u⁻¹ : S) • (↑u : S) • d (IsLocalization.mk' S p t) = 0 := by
    rw [hu', e, smul_zero]
  rw [smul_smul, Units.inv_mul, one_smul] at this
  exact this

end General

section Adjoin
variable (k : Type u) [Field k]

theorem A_algebraMap_eq (a : k) : AdjoinRoot.of (W k).polynomial (C a) = algebraMap k (A k) a := by
  rw [AdjoinRoot.algebraMap_eq', RingHom.comp_apply]; rfl

theorem B_algebraMap_eq (a : k) : AdjoinRoot.of (fB k) (C a) = algebraMap k (B k) a := by
  rw [AdjoinRoot.algebraMap_eq', RingHom.comp_apply]; rfl

/-- `A = k[x, y]`. -/
theorem A_adjoin : Algebra.adjoin k {xA k, yA k} = ⊤ := by
  rw [eq_top_iff]
  rintro a -
  induction a using AdjoinRoot.induction_on with
  | ih p =>
    induction p using Polynomial.induction_on' with
    | add p q hp hq => rw [map_add]; exact add_mem hp hq
    | monomial n c =>
      rw [← C_mul_X_pow_eq_monomial, map_mul, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C]
      refine mul_mem ?_ (pow_mem (Algebra.subset_adjoin (by simp [yA])) n)
      induction c using Polynomial.induction_on' with
      | add p q hp hq => rw [map_add]; exact add_mem hp hq
      | monomial m a =>
        rw [← C_mul_X_pow_eq_monomial, map_mul, map_pow]
        refine mul_mem ?_ (pow_mem (Algebra.subset_adjoin (by simp [xA])) m)
        rw [A_algebraMap_eq]
        exact Subalgebra.algebraMap_mem _ a

/-- `B = k[s, w]`. -/
theorem B_adjoin : Algebra.adjoin k {sB k, wB k} = ⊤ := by
  rw [eq_top_iff]
  rintro a -
  induction a using AdjoinRoot.induction_on with
  | ih p =>
    induction p using Polynomial.induction_on' with
    | add p q hp hq => rw [map_add]; exact add_mem hp hq
    | monomial n c =>
      rw [← C_mul_X_pow_eq_monomial, map_mul, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C]
      refine mul_mem ?_ (pow_mem (Algebra.subset_adjoin (by simp [sB])) n)
      induction c using Polynomial.induction_on' with
      | add p q hp hq => rw [map_add]; exact add_mem hp hq
      | monomial m a =>
        rw [← C_mul_X_pow_eq_monomial, map_mul, map_pow]
        refine mul_mem ?_ (pow_mem (Algebra.subset_adjoin (by simp [wB])) m)
        rw [B_algebraMap_eq]
        exact Subalgebra.algebraMap_mem _ a

/-- A derivation on a `k`-algebra `T` killing `k`, vanishing at the images of `x, y`, kills
the image of `A`. -/
theorem derivation_A_eq_zero {T : Type u} [CommRing T] [Algebra k T] {M : Type u}
    [AddCommGroup M] [Module T M] {d : T → M} (hd : IsDer d) (g : A k →ₐ[k] T)
    (hk : ∀ c : k, d (algebraMap k T c) = 0) (hx : d (g (xA k)) = 0) (hy : d (g (yA k)) = 0)
    (a : A k) : d (g a) = 0 := by
  have ha : a ∈ Algebra.adjoin k {xA k, yA k} := by rw [A_adjoin]; trivial
  induction ha using Algebra.adjoin_induction with
  | mem z hz =>
    rcases hz with rfl | rfl
    · exact hx
    · exact hy
  | algebraMap c => rw [AlgHom.commutes]; exact hk c
  | add a b _ _ ha hb => rw [map_add, hd.add, ha, hb, add_zero]
  | mul a b _ _ ha hb => rw [map_mul, hd.mul, ha, hb, smul_zero, smul_zero, add_zero]

theorem derivation_B_eq_zero {T : Type u} [CommRing T] [Algebra k T] {M : Type u}
    [AddCommGroup M] [Module T M] {d : T → M} (hd : IsDer d) (g : B k →ₐ[k] T)
    (hk : ∀ c : k, d (algebraMap k T c) = 0) (hs : d (g (sB k)) = 0) (hw : d (g (wB k)) = 0)
    (b : B k) : d (g b) = 0 := by
  have hb : b ∈ Algebra.adjoin k {sB k, wB k} := by rw [B_adjoin]; trivial
  induction hb using Algebra.adjoin_induction with
  | mem z hz =>
    rcases hz with rfl | rfl
    · exact hs
    · exact hw
  | algebraMap c => rw [AlgHom.commutes]; exact hk c
  | add a b _ _ ha hb => rw [map_add, hd.add, ha, hb, add_zero]
  | mul a b _ _ ha hb => rw [map_mul, hd.mul, ha, hb, smul_zero, smul_zero, add_zero]

end Adjoin

section Pieces
variable (k : Type u) [Field k] [CharP k 3] (i : k) (hi : i ^ 2 = -1)

/-- `phi1` on generators. -/
theorem phi1_yA : phi1 k i hi (yA k) = -(1 + algebraMap k (Ax k) i) *
    algebraMap (A k) (Ax k) (yA k) * (algebraMap (A k) (Ax k) (xA k) ^ 2 + 1) * invX k ^ 2 :=
  liftA_y k _ _ _

include hi in
/-- **`phi1 : A → A[1/x]` is formally unramified.** -/
theorem phi1_formallyUnramified : (phi1 k i hi).FormallyUnramified := by
  refine ringHom_formallyUnramified_of_derivation _ fun M _ _ d hD hd => ?_
  set X := algebraMap (A k) (Ax k) (xA k) with hXdef
  set Y := algebraMap (A k) (Ax k) (yA k) with hYdef
  set U := invX k with hUdef
  set c := algebraMap k (Ax k) i with hcdef
  have hk : ∀ r : k, d (algebraMap k (Ax k) r) = 0 := fun r => by
    rw [← phi1_algebraMap k i hi]; exact hd _
  have hc0 : d c = 0 := hk i
  have hXU : X * U = 1 := IsLocalization.Away.mul_invSelf (xA k)
  have hYrel : Y ^ 2 = X ^ 3 - X := by
    have := congrArg (algebraMap (A k) (Ax k)) (A_rel k); simpa using this
  have hcc : c ^ 2 = -1 := by
    have := congrArg (algebraMap k (Ax k)) hi; simpa using this
  have h3 : (3 : Ax k) = 0 := three_eq_zero k (Ax k)
  have h3m : ∀ m : M, (3 : Ax k) • m = 0 := fun m => by rw [h3, zero_smul]
  have hE := hd (yA k)
  rw [phi1_yA] at hE
  simp only [hD.mul, hD.add, hD.neg, hD.one, hD.pow_two', smul_zero, add_zero,
    zero_add] at hE
  rw [← hXdef, ← hYdef, ← hUdef, ← hcdef, hc0, smul_neg, smul_zero, neg_zero, add_zero] at hE
  clear_value X Y U c
  -- `dU = -U² dX`
  have hU : d U = -(U ^ 2) • d X := by
    have e := congrArg d hXU
    rw [hD.mul, hD.one] at e
    calc d U = (U * X) • d U := by rw [mul_comm, hXU, one_smul]
      _ = U • (X • d U) := by rw [mul_smul]
      _ = U • (-(U • d X)) := by rw [eq_neg_of_add_eq_zero_left e]
      _ = -(U ^ 2) • d X := by rw [smul_neg, smul_smul, neg_smul, pow_two]
  -- `dX = y dy` (characteristic 3)
  have hX : d X = Y • d Y := by
    have e := congrArg d hYrel
    rw [hD.pow_two', hD.sub, hD.pow_three'] at e
    have h0 : (3 * X ^ 2) • d X = 0 := by rw [mul_smul, h3m]
    rw [h0, zero_sub] at e
    have h1 : d X = -((2 * Y) • d Y) := by rw [e, neg_neg]
    rw [h1, ← neg_smul]
    have h2 : -(2 * Y) = Y - 3 * Y := by ring
    rw [h2, sub_smul, mul_smul, h3m, sub_zero]
  rw [hU, hX] at hE
  simp only [smul_smul, smul_add, smul_neg, ← add_smul, ← neg_smul] at hE
  set α := (-(1 + c) * 2 * X * Y * U ^ 2 - -(1 + c) * 2 * Y * (X ^ 2 + 1) * U * U ^ 2) * Y +
    -(1 + c) * (X ^ 2 + 1) * U ^ 2 with hα
  have key : ∀ γ : Ax k, γ • d Y = 0 → γ = α → d Y = 0 := by
    intro γ hγ hγα
    have hinv : (c - 1) * α = 1 := by
      rw [hα]
      linear_combination (2*U^2*X^2*c^2 - 2*U^2*X^2 + 2*U^2*X*Y^2*c^2 - 2*U^2*X*Y^2 -
        2*U^2*c^2 + 2*U^2 + U*X*c^2 - U*X + c^2 - 1) * hXU + (2*U^3*c^2 - 2*U^3) * hYrel +
        (1 - 3*U^2) * hcc + (2*U^2 - 1) * h3
    rw [← one_smul (Ax k) (d Y), ← hinv, mul_smul, ← hγα, hγ, smul_zero]
  have hY0 : d Y = 0 := key _ hE (by rw [hα]; ring)
  have hX0 : d X = 0 := by rw [hX, hY0, smul_zero]
  have hA : ∀ a : A k, d (algebraMap (A k) (Ax k) a) = 0 :=
    derivation_A_eq_zero k hD (IsScalarTower.toAlgHom k (A k) (Ax k)) hk
      (by rw [IsScalarTower.coe_toAlgHom', ← hXdef]; exact hX0)
      (by rw [IsScalarTower.coe_toAlgHom', ← hYdef]; exact hY0)
  exact derivation_eq_zero_of_isLocalization (Submonoid.powers (xA k)) hD hA

theorem phi2_sB : phi2 k i hi (sB k) = (1 + algebraMap k (Aq k) i) *
    algebraMap (A k) (Aq k) (yA k) * (algebraMap (A k) (Aq k) (xA k) ^ 2 - 1) * invQ k :=
  liftB_s k _ _ _

theorem phi2_wB : phi2 k i hi (wB k) = (1 - algebraMap k (Aq k) i) *
    algebraMap (A k) (Aq k) (xA k) * algebraMap (A k) (Aq k) (yA k) * invQ k :=
  liftB_w k _ _ _

include hi in
/-- **`phi2 : B → A[1/(x⁴ - 1)]` is formally unramified.** -/
theorem phi2_formallyUnramified : (phi2 k i hi).FormallyUnramified := by
  refine ringHom_formallyUnramified_of_derivation _ fun M _ _ d hD hd => ?_
  letI : Algebra ℕ (Aq k) := Semiring.toNatAlgebra
  letI : Algebra ℤ (Aq k) := Ring.toIntAlgebra _
  set X := algebraMap (A k) (Aq k) (xA k) with hXdef
  set Y := algebraMap (A k) (Aq k) (yA k) with hYdef
  set V := invQ k with hVdef
  set c := algebraMap k (Aq k) i with hcdef
  have hk : ∀ r : k, d (algebraMap k (Aq k) r) = 0 := fun r => by
    rw [← phi2_algebraMap k i hi]; exact hd _
  have hc0 : d c = 0 := hk i
  have hXV : (X ^ 4 - 1) * V = 1 := by
    rw [hXdef, hVdef]
    have := IsLocalization.Away.mul_invSelf (S := Aq k) (qA k)
    simpa using this
  have hYrel : Y ^ 2 = X ^ 3 - X := by
    have := congrArg (algebraMap (A k) (Aq k)) (A_rel k); simpa using this
  have hcc : c ^ 2 = -1 := by
    have := congrArg (algebraMap k (Aq k)) hi; simpa using this
  have h3 : (3 : Aq k) = 0 := three_eq_zero k (Aq k)
  have h3m : ∀ m : M, (3 : Aq k) • m = 0 := fun m => by rw [h3, zero_smul]
  have hs := hd (sB k)
  have hw := hd (wB k)
  rw [phi2_sB] at hs
  rw [phi2_wB] at hw
  simp only [hD.mul, hD.add, hD.sub, hD.one, hD.pow_two'] at hs hw
  simp only [← hXdef, ← hYdef, ← hVdef, ← hcdef, hc0] at hs hw
  clear_value X Y V c
  have hV : d V = -(V ^ 2 * (4 * X ^ 3)) • d X := by
    have e := congrArg d hXV
    rw [hD.mul, hD.sub, hD.pow_four', hD.one, sub_zero] at e
    linear_combination (norm := module) V • e - hXV • d V
  have hX : d X = Y • d Y := by
    have e := congrArg d hYrel
    rw [hD.pow_two', hD.sub, hD.pow_three'] at e
    linear_combination (norm := module) e + h3m (X ^ 2 • d X - Y • d Y)
  rw [hV, hX] at hs hw
  have hαs : (-4*V^2*X^5*Y^2*c - 4*V^2*X^5*Y^2 + 4*V^2*X^3*Y^2*c + 4*V^2*X^3*Y^2 + V*X^2*c + V*X^2
      + 2*V*X*Y^2*c + 2*V*X*Y^2 - V*c - V) • d Y = 0 := by
    linear_combination (norm := module) hs
  have hαw : (4*V^2*X^4*Y^2*c - 4*V^2*X^4*Y^2 - V*X*c + V*X - V*Y^2*c + V*Y^2) • d Y = 0 := by
    linear_combination (norm := module) hw
  have hab : (-X^2*c + X^2 + X*Y^2*c^2 + X*Y^2 + c - 1) * (-4*V^2*X^5*Y^2*c - 4*V^2*X^5*Y^2
      + 4*V^2*X^3*Y^2*c + 4*V^2*X^3*Y^2 + V*X^2*c + V*X^2 + 2*V*X*Y^2*c + 2*V*X*Y^2 - V*c - V)
      + (X^3*c + X^3 - X^2*Y^2*c^2 - X^2*Y^2*c + X^2*Y^2 - X*c - X + Y^2*c^3
      + Y^2*c^2) * (4*V^2*X^4*Y^2*c - 4*V^2*X^4*Y^2 - V*X*c + V*X - V*Y^2*c + V*Y^2) = 1 := by
    linear_combination (-V*X^4*c^2 + V*X^4 + V*X^3*Y^2*c^3 + V*X^3*Y^2*c - V*X^3*Y^2 + V*X^2*Y^4*c^3
        - V*X^2*Y^4*c^2 + V*X^2*Y^4*c + V*X^2*Y^4 + V*X^2*c^2 - V*X^2 - V*X*Y^2*c^2 - V*X*Y^2
        + V*Y^4*c^4 - V*Y^4*c^2 - X^2*c^2 - X^2 + X*Y^2*c^3 + X*Y^2*c^2 + X*Y^2*c + X*Y^2 + c^2
        - 1) * hXV + (-V^2*X^5*c^2 + V^2*X^5 + V^2*X^4*Y^2*c^3 + V^2*X^4*Y^2*c^2 + V^2*X^4*Y^2*c
        + V^2*X^4*Y^2 + V^2*X^2*Y^2*c^3 - V^2*X^2*Y^2*c^2 + V^2*X^2*Y^2*c + V^2*X^2*Y^2 + V^2*X*c^2
        - V^2*X + V^2*Y^2*c^2 - V*X^3*c^2 - V*X^3 + V*X^2*Y^2*c^3 + V*X^2*Y^2*c^2 + V*X^2*Y^2*c
        + V*X^2*Y^2 + V*X*c^2 - V*X - V*Y^2*c^3 - V*Y^2*c) * hYrel + (V^2*Y^4*c^2 + V*X^4
        + V*X^3*Y^2*c + V*X^3*Y^2 - V*X^2 - V*X*Y^2*c^2 + V*X*Y^2*c + V*Y^4*c - X^2 + X*Y^2*c
        + X*Y^2 + 1) * hcc + (3*V^2*X^7*Y^2*c^2 - 2*V^2*X^7*Y^2 - 3*V^2*X^6*Y^4*c^3
        - V^2*X^6*Y^4*c^2 + V^2*X^6*Y^4*c - 3*V^2*X^6*Y^4 - 4*V^2*X^5*Y^2*c^2 + 4*V^2*X^5*Y^2
        + V^2*X^4*Y^4*c^4 + V^2*X^4*Y^4*c^3 + V^2*X^4*Y^4*c + V^2*X^4*Y^4 + 2*V^2*X^3*Y^2*c^2
        - 2*V^2*X^3*Y^2 - V^2*X*Y^2*c^2 - V^2*Y^4*c^2 - V*X^4*c^2 + V*X^4 - V*X^3*Y^2*c^2
        - V*X^3*Y^2*c + V*X^3*Y^2 + V*X^2*Y^4*c^3 + V*X^2*Y^4 + V*X^2*c^2 - V*X^2 + V*X*Y^2*c^2
        - V*X*Y^2 - 1) * h3
  have hY0 : d Y = 0 := by
    rw [← one_smul (Aq k) (d Y), ← hab, add_smul, mul_smul, mul_smul, hαs, hαw, smul_zero,
      smul_zero, add_zero]
  have hX0 : d X = 0 := by rw [hX, hY0, smul_zero]
  have hA : ∀ a : A k, d (algebraMap (A k) (Aq k) a) = 0 :=
    derivation_A_eq_zero k hD (IsScalarTower.toAlgHom k (A k) (Aq k)) hk
      (by rw [IsScalarTower.coe_toAlgHom', ← hXdef]; exact hX0)
      (by rw [IsScalarTower.coe_toAlgHom', ← hYdef]; exact hY0)
  exact derivation_eq_zero_of_isLocalization (Submonoid.powers (qA k)) hD hA

theorem phi3_sB : phi3 k i hi (sB k) = (1 + algebraMap k (Be k) i) *
    algebraMap (B k) (Be k) (sB k) * invE k :=
  liftB_s k _ _ _

theorem phi3_wB : phi3 k i hi (wB k) = (1 - algebraMap k (Be k) i) *
    algebraMap (B k) (Be k) (sB k) ^ 3 * invE k :=
  liftB_w k _ _ _

include hi in
/-- **`phi3 : B → B[1/(1 - ws)]` is formally unramified.** -/
theorem phi3_formallyUnramified : (phi3 k i hi).FormallyUnramified := by
  refine ringHom_formallyUnramified_of_derivation _ fun M _ _ d hD hd => ?_
  letI : Algebra ℕ (Be k) := Semiring.toNatAlgebra
  letI : Algebra ℤ (Be k) := Ring.toIntAlgebra _
  set S := algebraMap (B k) (Be k) (sB k) with hSdef
  set W := algebraMap (B k) (Be k) (wB k) with hWdef
  set T := invE k with hTdef
  set c := algebraMap k (Be k) i with hcdef
  have hk : ∀ r : k, d (algebraMap k (Be k) r) = 0 := fun r => by
    rw [← phi3_algebraMap k i hi]; exact hd _
  have hc0 : d c = 0 := hk i
  have hWT : (1 - W * S) * T = 1 := by
    rw [hSdef, hWdef, hTdef]
    have := IsLocalization.Away.mul_invSelf (S := Be k) (eB k)
    simpa using this
  have hBrel : S ^ 3 = W ^ 2 * S + W := by
    have := congrArg (algebraMap (B k) (Be k)) (B_rel k); simpa using this
  have hcc : c ^ 2 = -1 := by
    have := congrArg (algebraMap k (Be k)) hi; simpa using this
  have h3 : (3 : Be k) = 0 := three_eq_zero k (Be k)
  have h3m : ∀ m : M, (3 : Be k) • m = 0 := fun m => by rw [h3, zero_smul]
  have hs := hd (sB k)
  have hw := hd (wB k)
  rw [phi3_sB] at hs
  rw [phi3_wB] at hw
  simp only [hD.mul, hD.add, hD.sub, hD.one, hD.pow_three'] at hs hw
  simp only [← hSdef, ← hWdef, ← hTdef, ← hcdef, hc0] at hs hw
  clear_value S W T c
  have hT : d T = T ^ 2 • (W • d S + S • d W) := by
    have e := congrArg d hWT
    rw [hD.mul, hD.sub, hD.one, hD.mul] at e
    linear_combination (norm := module) T • e - hWT • d T
  have hW : d W = -(T * W ^ 2) • d S := by
    have e := congrArg d hBrel
    rw [hD.pow_three', hD.add, hD.mul, hD.pow_two'] at e
    linear_combination (norm := module) (-T) • e - hWT • d W +
      h3m ((S ^ 2 * T) • d S - (W * S * T) • d W)
  rw [hT, hW] at hs hw
  have hαs : (-S^2*T^3*W^2*c - S^2*T^3*W^2 + S*T^2*W*c + S*T^2*W + T*c + T) • d S = 0 := by
    linear_combination (norm := module) hs
  have hαw : (S^4*T^3*W^2*c - S^4*T^3*W^2 - S^3*T^2*W*c + S^3*T^2*W - 3*S^2*T*c
      + 3*S^2*T) • d S = 0 := by
    linear_combination (norm := module) hw
  have hab : (-S^3*T*W^3*c^3 + S^3*T*W^3*c^2 + S^3*T*W^3*c - S^3*T*W^3 + S^3*W^3*c^3 - S^3*W^3*c^2
      - S^3*W^3*c + S^3*W^3 + S^2*T*W^2*c^3 + S^2*T*W^2*c^2 - S^2*T*W^2*c - S^2*W^2*c^3
      - S^2*W^2*c^2 + S^2*W^2*c - S*T*W^5*c^3 + S*T*W^5*c^2 + S*W^5*c^3 - S*W^5*c^2 - S*W*c + S*W
      + T*W^4*c^3 + T*W^4*c^2 - T*W^4*c - T*c + T - W^4*c^3 - W^4*c^2 + W^4*c - c
      + 1) * (-S^2*T^3*W^2*c - S^2*T^3*W^2 + S*T^2*W*c + S*T^2*W + T*c + T) + (S^2*T*c + S^2*T
      - S^2*c - S^2 + T*W^2*c + T*W^2 - W^2*c - W^2) * (S^4*T^3*W^2*c - S^4*T^3*W^2 - S^3*T^2*W*c
      + S^3*T^2*W - 3*S^2*T*c + 3*S^2*T) = 1 := by
    linear_combination (-S^5*T^3*W*c^2 + S^5*T^3*W + S^5*T^2*W*c^2 - S^5*T^2*W - S^4*T^3*W^4*c^4
        - S^4*T^3*W^4*c^2 - S^4*T^3*W^4 + S^4*T^2*W^4*c^4 + S^4*T^2*W^4*c^2 + S^4*T^2*W^4
        - S^3*T^3*W^3*c^3 + S^3*T^3*W^3*c^2 - S^3*T^3*W^3*c - S^3*T^2*W^3*c^4 + S^3*T^2*W^3*c^3
        + S^3*T^2*W^3*c^2 + S^3*T^2*W^3*c - S^3*T^2*W^3 + S^3*T*W^3*c^4 + S^3*T*W^3*c^2 + S^3*T*W^3
        - S^2*T^3*W^6*c^4 + S^2*T^3*W^6*c^2 + S^2*T^3*W^2*c^4 - S^2*T^3*W^2*c^3 + S^2*T^3*W^2*c^2
        - S^2*T^3*W^2*c - S^2*T^3*W^2 + S^2*T^2*W^6*c^4 - S^2*T^2*W^6*c^2 - S^2*T^2*W^2
        - S^2*T*W^2*c^4 + S^2*T*W^2*c^3 + S^2*T*W^2*c - S^2*T*W^2 + S^2*W^2*c^2 + S^2*W^2
        - S*T^3*W^5*c^3 + S*T^3*W^5*c^2 - S*T^3*W^5*c - S*T^3*W*c^2 - S*T^3*W - S*T^2*W^5*c^4
        + S*T^2*W^5*c^3 + S*T^2*W^5*c + S*T^2*W*c^2 + S*T*W^5*c^4 - S*T*W^5*c^2 - S*T*W*c^2 - S*T*W
        + T^3*W^4*c^4 - T^3*W^4*c^3 + T^3*W^4*c^2 - T^3*W^4*c + T^3*W^4 - T^3*c^2 - T^3
        + T^2*W^4*c^2 + T^2*W^4 + T^2*c^2 + T^2 - T*W^4*c^4 + T*W^4*c^3 + T*W^4*c - T*c^2 + T
        + W^4*c^2 + W^4 + 1) * hWT + (S^2*T^4*W*c^2 - S^2*T^4*W - S^2*T^2*W*c^2 + S^2*T^2*W
        + T^4*W^3*c^2 - T^4*W^3 - T^3*W^3 - T^2*W^3*c^2 - T*W^3) * hBrel + (S^3*T^4*W^3*c^2
        - S^3*T^4*W^3 - S^3*T^3*W^3*c^2 + S^3*T^3*W^3 + S^3*T^2*W^3*c^2 - S^3*T^2*W^3
        - S^3*T*W^3*c^2 + S^3*T*W^3 - S^2*T^4*W^2*c^2 + S^2*T^4*W^2*c + S^2*T^4*W^2
        + S^2*T^3*W^2*c^2 - S^2*T^3*W^2*c - S^2*T^3*W^2 - S^2*T^2*W^2*c^2 + S^2*T^2*W^2*c
        + S^2*T^2*W^2 + S^2*T*W^2*c^2 - S^2*T*W^2*c + S^2*T*W^2 + S^2*W^2 + S*T^4*W^5*c^2
        - S*T^3*W^5*c^2 + S*T^3*W + S*T^2*W^5*c^2 - S*T*W^5*c^2 + S*T*W - T^4*W^4*c^2 + T^4*W^4*c
        + T^4*W^4 + T^4 + T^3*W^4*c^2 - T^3*W^4*c - T^3*W^4 + T^3 - T^2*W^4*c^2 + T^2*W^4*c
        + T^2*W^4 + T^2 + T*W^4*c^2 - T*W^4*c + T*W^4 + T + W^4) * hcc + (-S^5*T^4*W^5*c^2
        + S^5*T^3*W^5*c^2 - S^5*T^3*W*c^2 + S^5*T^3*W + S^5*T^2*W*c^2 - S^5*T^2*W - S^4*T^4*W^4*c^3
        + S^4*T^4*W^4*c^2 - S^4*T^3*W^4*c^4 + S^4*T^3*W^4*c^3 - S^4*T^3*W^4 + S^4*T^2*W^4*c^4
        + S^4*T^2*W^4 - S^4*T^2*c^2 + S^4*T^2 + S^4*T*c^2 - S^4*T + S^3*T^3*W^3*c^4 - S^3*T^3*W^3*c
        - 2*S^3*T^2*W^3*c^4 + S^3*T^2*W^3*c^2 + S^3*T^2*W^3*c - S^3*T^2*W^3 + S^3*T*W^3*c^4
        + S^3*T*W^3 - S^2*T^4*W^6*c^3 - S^2*T^4*W^2 - S^2*T^3*W^6*c^4 + S^2*T^3*W^6*c^3
        + S^2*T^3*W^6*c^2 + S^2*T^3*W^2*c^2 + S^2*T^2*W^6*c^4 - S^2*T^2*W^6*c^2 + S^2*T^2*W^2*c^4
        - 2*S^2*T^2*W^2*c^2 - S^2*T^2*W^2*c + S^2*T^2*W^2 - S^2*T*W^2*c^4 + S^2*T*W^2*c
        - 2*S^2*T*W^2 + S*T^3*W^5*c^4 + S*T^3*W^5*c^2 - S*T^3*W^5*c - S*T^3*W*c^2 - 2*S*T^2*W^5*c^4
        + S*T^2*W^5*c + S*T^2*W + S*T*W^5*c^4 - S*T*W*c^2 - T^4*W^4 - T^3*c^2 - T^3 + T^2*W^4*c^4
        - T^2*W^4*c - T*W^4*c^4 - T*W^4*c^2 + T*W^4*c - T*W^4 - T*c^2) * h3
  have hS0 : d S = 0 := by
    rw [← one_smul (Be k) (d S), ← hab, add_smul, mul_smul, mul_smul, hαs, hαw, smul_zero,
      smul_zero, add_zero]
  have hW0 : d W = 0 := by rw [hW, hS0, smul_zero]
  have hB : ∀ b : B k, d (algebraMap (B k) (Be k) b) = 0 :=
    derivation_B_eq_zero k hD (IsScalarTower.toAlgHom k (B k) (Be k)) hk
      (by rw [IsScalarTower.coe_toAlgHom', ← hSdef]; exact hS0)
      (by rw [IsScalarTower.coe_toAlgHom', ← hWdef]; exact hW0)
  exact derivation_eq_zero_of_isLocalization (Submonoid.powers (eB k)) hD hB

