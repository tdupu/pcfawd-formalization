module

public import Pcf.Examples.Cusp
public import Pcf.Examples.PaperP.CuspFiber
public import Mathlib.Algebra.Polynomial.Expand
public import Mathlib.RingTheory.Polynomial.Ideal
public import Mathlib.RingTheory.Unramified.Field
public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import Mathlib.AlgebraicGeometry.Morphisms.Finite
public import Mathlib.RingTheory.Spectrum.Prime.Topology

/-!
# The divisor restriction in `paper-p.tex`, Example `ex:branch-singular`

The coordinate map on the two affine lines is `u ↦ u²`.  This file proves
that the resulting actual scheme map is finite and surjective.  The ambient
quadric-cone geometry is a separate part of the example.
-/

@[expose] public section

namespace Pcf.Examples.PaperP.QuadricConeRestriction

open AlgebraicGeometry CategoryTheory Polynomial

set_option linter.style.haveILetI false

variable (k : Type*) [Field k]

/-- Coordinate map of the restriction from `A=V(v)` to `B=V(y,z)`. -/
noncomputable def coordinateMap : k[X] →ₐ[k] k[X] :=
  Polynomial.expand k 2

@[simp] theorem coordinateMap_X : coordinateMap k X = (X : k[X]) ^ 2 := by
  exact Polynomial.expand_X 2

/-- The three ambient cone coordinates restrict to `(u²,0,0)`, with the
first coordinate given by `coordinateMap`. -/
theorem ambient_cone_restriction (i : Fin 3) :
    MvPolynomial.aeval ![(X : k[X]), 0] (Pcf.Examples.Cusp.coneMap k i) =
      ![coordinateMap k X, 0, 0] i := by
  rw [Pcf.Examples.Cusp.coneMap_restrict]
  simp only [coordinateMap_X]

/-- The parameter is integral over the target coordinate ring. -/
theorem parameter_isIntegral :
    letI : Algebra k[X] k[X] := (coordinateMap k).toRingHom.toAlgebra
    IsIntegral k[X] (X : k[X]) := by
  letI : Algebra k[X] k[X] := (coordinateMap k).toRingHom.toAlgebra
  apply IsIntegral.of_pow (by decide : 0 < 2)
  rw [← coordinateMap_X k]
  exact isIntegral_algebraMap

/-- The source is generated by its parameter over the target ring. -/
theorem adjoin_parameter_eq_top :
    letI : Algebra k[X] k[X] := (coordinateMap k).toRingHom.toAlgebra
    Algebra.adjoin k[X] {(X : k[X])} = ⊤ := by
  letI : Algebra k[X] k[X] := (coordinateMap k).toRingHom.toAlgebra
  let A := Algebra.adjoin k[X] {(X : k[X])}
  have hX : (X : k[X]) ∈ A := Algebra.subset_adjoin rfl
  refine eq_top_iff.mpr fun q _ => ?_
  change q ∈ A
  induction q using Polynomial.induction_on' with
  | add a b ha hb => exact add_mem (ha trivial) (hb trivial)
  | monomial n a =>
      have hC : (C a : k[X]) ∈ A := by
        have h := Subalgebra.algebraMap_mem A (algebraMap k k[X] a)
        have heq : algebraMap k[X] k[X] (algebraMap k k[X] a) = C a := by
          exact (coordinateMap k).commutes a
        rwa [heq] at h
      simpa only [Polynomial.C_mul_X_pow_eq_monomial] using
        mul_mem hC (pow_mem hX n)

/-- The restricted coordinate-ring map is integral. -/
theorem coordinateMap_isIntegral : (coordinateMap k).toRingHom.IsIntegral := by
  letI : Algebra k[X] k[X] := (coordinateMap k).toRingHom.toAlgebra
  have hclosure : integralClosure k[X] k[X] = ⊤ := by
    apply eq_top_iff.mpr
    intro q _
    have hq : q ∈ Algebra.adjoin k[X] {(X : k[X])} := by
      rw [adjoin_parameter_eq_top k]
      trivial
    exact (Algebra.adjoin_le (S := integralClosure k[X] k[X])
      (fun x hx => by
        obtain rfl := Set.mem_singleton_iff.mp hx
        exact parameter_isIntegral k)) hq
  intro q
  exact (integralClosure_eq_top_iff.mp hclosure).isIntegral q

/-- The restricted coordinate-ring map is finite type. -/
theorem coordinateMap_finiteType : (coordinateMap k).toRingHom.FiniteType := by
  apply RingHom.FiniteType.of_comp_finiteType
    (f := algebraMap k k[X])
  have heq : (coordinateMap k).toRingHom.comp (algebraMap k k[X]) =
      algebraMap k k[X] :=
    RingHom.ext fun a => (coordinateMap k).commutes a
  rw [heq]
  exact RingHom.finiteType_algebraMap.mpr inferInstance

/-- The restricted coordinate-ring map is finite. -/
theorem coordinateMap_finite : (coordinateMap k).toRingHom.Finite :=
  (coordinateMap_isIntegral k).to_finite (coordinateMap_finiteType k)

theorem coordinateMap_injective : Function.Injective (coordinateMap k) := by
  change Function.Injective (Polynomial.expand k 2)
  exact Polynomial.expand_injective (R := k) (by decide : 0 < 2)

/-- The finite restriction as a scheme morphism. -/
noncomputable def schemeMap : Spec (.of k[X]) ⟶ Spec (.of k[X]) :=
  Spec.map (CommRingCat.ofHom (coordinateMap k).toRingHom)

theorem schemeMap_finite : IsFinite (schemeMap k) := by
  exact (IsFinite.SpecMap_iff _).mpr (coordinateMap_finite k)

theorem schemeMap_surjective : Surjective (schemeMap k) := by
  rw [surjective_iff]
  exact (coordinateMap_finite k).to_isIntegral.comap_surjective
    (coordinateMap_injective k)

/-- The origin in the target affine line. -/
noncomputable def originIdeal : Ideal k[X] := Ideal.span {(X : k[X])}

private instance originIdeal_isMaximal : (originIdeal k).IsMaximal := by
  rw [originIdeal, ← Polynomial.ker_constantCoeff]
  exact RingHom.ker_isMaximal_of_surjective _ (fun a => ⟨C a, by simp⟩)

/-- The origin fibre ideal of the restricted map is `(u²)`. -/
theorem originIdeal_map :
    Ideal.map (coordinateMap k).toRingHom (originIdeal k) =
      Pcf.Examples.PaperP.CuspFiber.fiberIdeal k := by
  rw [originIdeal, Pcf.Examples.PaperP.CuspFiber.fiberIdeal_eq]
  simp [Ideal.map_span, coordinateMap_X]

/-- The actual scheme fibre over the origin has coordinate ring
`k[u]/(u²)`, hence is nonreduced. -/
theorem originFiber_not_isReduced :
    ¬ IsReduced (k[X] ⧸ Ideal.map (coordinateMap k).toRingHom (originIdeal k)) := by
  rw [originIdeal_map]
  exact Pcf.Examples.PaperP.CuspFiber.fiber_not_isReduced k

/-- The restricted coordinate map is not formally unramified. -/
theorem coordinateMap_not_formallyUnramified :
    letI : Algebra k[X] k[X] := (coordinateMap k).toRingHom.toAlgebra
    ¬ Algebra.FormallyUnramified k[X] k[X] := by
  letI : Algebra k[X] k[X] := (coordinateMap k).toRingHom.toAlgebra
  intro hunram
  haveI : Algebra.FormallyUnramified k[X] k[X] := hunram
  haveI : Algebra.EssFiniteType k[X] k[X] :=
    (coordinateMap_finiteType k).essFiniteType
  have hrad :
      (Ideal.map (coordinateMap k).toRingHom (originIdeal k)).IsRadical :=
    Algebra.FormallyUnramified.isRadical_map_isMaximal
      k[X] k[X] (originIdeal k)
  exact originFiber_not_isReduced k
    ((Ideal.isRadical_iff_quotient_reduced _).mp hrad)

/-- The actual restricted affine-line scheme map is not étale globally. -/
theorem schemeMap_not_etale : ¬ AlgebraicGeometry.Etale (schemeMap k) := by
  intro hetale
  have hring :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.Etale)).mp hetale
  change (coordinateMap k).toRingHom.Etale at hring
  letI : Algebra k[X] k[X] := (coordinateMap k).toRingHom.toAlgebra
  haveI : Algebra.Etale k[X] k[X] := RingHom.etale_algebraMap.mp hring
  exact coordinateMap_not_formallyUnramified k inferInstance

/-- In characteristic zero the affine Jacobian of `u↦u²` vanishes
precisely at the source origin. -/
theorem derivative_zero_iff [CharZero k] (a : k) :
    ((coordinateMap k X).derivative).eval a = 0 ↔ a = 0 := by
  rw [coordinateMap_X]
  simp only [Polynomial.derivative_pow, Polynomial.derivative_X,
    mul_one, Polynomial.eval_mul, Polynomial.eval_C, Nat.reduceSub, pow_one,
    Polynomial.eval_X]
  constructor
  · intro h
    exact (mul_eq_zero.mp h).resolve_left (by norm_num)
  · intro h
    simp [h]

#print axioms parameter_isIntegral
#print axioms ambient_cone_restriction
#print axioms coordinateMap_finite
#print axioms coordinateMap_injective
#print axioms schemeMap_finite
#print axioms schemeMap_surjective
#print axioms originIdeal_map
#print axioms originFiber_not_isReduced
#print axioms coordinateMap_not_formallyUnramified
#print axioms schemeMap_not_etale
#print axioms derivative_zero_iff

end Pcf.Examples.PaperP.QuadricConeRestriction
