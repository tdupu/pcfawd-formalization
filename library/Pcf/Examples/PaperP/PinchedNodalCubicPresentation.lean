module

public import Pcf.Examples.Pinched
public import Mathlib.Algebra.Polynomial.Expand
public import Mathlib.Algebra.Polynomial.Div
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# `B` is the nodal cubic `d² = b(b - 4)²`

For `paper-p.tex`, the Singular remark inside Example `ex:pinched`: "`B` is the nodal cubic
`d² = b(b - 4)²`". Here `B = Spec R_B`, `R_B = {p ∈ k[z] : p(2) = p(-2)}`, `b = z²`,
`d = z³ - 4z`.

* `nodeMap_range`: `R_B = k[z², z³ - 4z]`.
* `ker_nodeMap`: the kernel of `k[b, d] → k[z]`, `b ↦ z²`, `d ↦ z³ - 4z`, is generated by
  `d² - b(b - 4)²`.
* `nodalCubicEquiv : k[b, d]/(d² - b(b - 4)²) ≃ₐ[k] R_B`.
-/

@[expose] public section

namespace Pcf.Examples.PaperP.PinchedNodalCubicPresentation

open Polynomial Pcf.Examples.Pinched

set_option linter.unusedSectionVars false

universe u

variable (k : Type u) [Field k] [CharZero k]

local notation "Two" => MvPolynomial (Fin 2) k

/-- `k[b, d] → k[z]`, `b ↦ z²`, `d ↦ z³ - 4z`. -/
noncomputable def nodeMap : Two →ₐ[k] k[X] := MvPolynomial.aeval ![X ^ 2, X ^ 3 - 4 * X]

/-- The nodal cubic relation `d² - b(b - 4)²`. -/
noncomputable def cubicRel : Two :=
  MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 * (MvPolynomial.X 0 - 4) ^ 2

/-- `k[b] → k[b, d]`. -/
noncomputable def ι : k[X] →ₐ[k] Two := Polynomial.aeval (MvPolynomial.X 0)

theorem nodeMap_ι (p : k[X]) : nodeMap k (ι k p) = expand k 2 p := by
  rw [← AlgHom.comp_apply]
  congr 1
  apply Polynomial.algHom_ext
  simp [nodeMap, ι]

theorem nodeMap_cubicRel : nodeMap k (cubicRel k) = 0 := by
  simp [nodeMap, cubicRel]
  ring

/-- Even/odd decomposition `p = E(z²) + z O(z²)`. -/
theorem exists_even_odd (p : k[X]) : ∃ E O : k[X], p = expand k 2 E + X * expand k 2 O := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
    obtain ⟨E₁, O₁, rfl⟩ := hp
    obtain ⟨E₂, O₂, rfl⟩ := hq
    exact ⟨E₁ + E₂, O₁ + O₂, by simp only [map_add]; ring⟩
  | monomial n a =>
    rw [← C_mul_X_pow_eq_monomial]
    rcases Nat.even_or_odd' n with ⟨m, rfl | rfl⟩
    · exact ⟨C a * X ^ m, 0, by
        simp only [map_mul, expand_C, map_pow, expand_X, map_zero, mul_zero, add_zero]; ring⟩
    · exact ⟨0, C a * X ^ m, by
        simp only [map_mul, expand_C, map_pow, expand_X, map_zero, zero_add]; ring⟩

/-- **`R_B = k[z², z³ - 4z]`.** -/
theorem nodeMap_range : (nodeMap k).range = nodeAlg k := by
  apply le_antisymm
  · rintro _ ⟨q, rfl⟩
    rw [mem_nodeAlg_iff]
    change Polynomial.aeval (2 : k) (nodeMap k q) = Polynomial.aeval (-2 : k) (nodeMap k q)
    rw [← AlgHom.comp_apply, ← AlgHom.comp_apply]
    congr 1
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i
    · simp [nodeMap]
    · simp [nodeMap]; ring
  · intro p hp
    obtain ⟨E, O, rfl⟩ := exists_even_odd k p
    rw [mem_nodeAlg_iff] at hp
    simp [expand_eq_comp_X_pow] at hp
    have hO : O.eval 4 = 0 := by
      have h4 : (4 : k) * O.eval 4 = 0 := by norm_num at hp; linear_combination hp
      rcases mul_eq_zero.mp h4 with h | h
      · norm_num at h
      · exact h
    have hdiv := (mul_divByMonic_eq_iff_isRoot (p := O) (a := 4)).mpr hO
    set O' := O /ₘ (X - C 4)
    refine ⟨ι k E + ι k O' * MvPolynomial.X 1, ?_⟩
    change nodeMap k _ = _
    rw [map_add, map_mul, nodeMap_ι, nodeMap_ι, ← hdiv]
    simp [nodeMap, map_ofNat]
    ring

/-- Normal form `P₀(b) + P₁(b) d` modulo `d² - b(b - 4)²`. -/
theorem exists_normalForm (P : Two) :
    ∃ P₀ P₁ : k[X], P - (ι k P₀ + ι k P₁ * MvPolynomial.X 1) ∈
      Ideal.span {cubicRel k} := by
  induction P using MvPolynomial.induction_on with
  | C a => exact ⟨C a, 0, by simp [ι]⟩
  | add p q hp hq =>
    obtain ⟨a₀, a₁, hp⟩ := hp
    obtain ⟨b₀, b₁, hq⟩ := hq
    refine ⟨a₀ + b₀, a₁ + b₁, ?_⟩
    convert Ideal.add_mem _ hp hq using 1
    simp only [map_add]
    ring
  | mul_X p i hp =>
    obtain ⟨P₀, P₁, hp⟩ := hp
    fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.isValue]
    · refine ⟨P₀ * X, P₁ * X, ?_⟩
      convert Ideal.mul_mem_right (MvPolynomial.X 0) _ hp using 1
      simp [ι]
      ring
    · refine ⟨P₁ * (X * (X - 4) ^ 2), P₀, ?_⟩
      have key : p * MvPolynomial.X 1 - (ι k (P₁ * (X * (X - 4) ^ 2)) +
          ι k P₀ * MvPolynomial.X 1) =
          (p - (ι k P₀ + ι k P₁ * MvPolynomial.X 1)) * MvPolynomial.X 1 +
            ι k P₁ * cubicRel k := by
        simp [ι, cubicRel, map_ofNat]
        ring
      rw [key]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp)
        (Ideal.mul_mem_left _ _ (Ideal.subset_span rfl))

/-- **The kernel of `k[b, d] → R_B` is `(d² - b(b - 4)²)`.** -/
theorem ker_nodeMap : RingHom.ker (nodeMap k) = Ideal.span {cubicRel k} := by
  apply le_antisymm
  · intro P hP
    rw [RingHom.mem_ker] at hP
    obtain ⟨P₀, P₁, hN⟩ := exists_normalForm k P
    have hN0 : nodeMap k (ι k P₀ + ι k P₁ * MvPolynomial.X 1) = 0 := by
      have : nodeMap k (P - (ι k P₀ + ι k P₁ * MvPolynomial.X 1)) = 0 := by
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hN
        rw [← hc, map_mul, nodeMap_cubicRel, mul_zero]
      rwa [map_sub, hP, zero_sub, neg_eq_zero] at this
    rw [map_add, map_mul, nodeMap_ι, nodeMap_ι] at hN0
    simp only [nodeMap, MvPolynomial.aeval_X, Matrix.cons_val_one, Matrix.cons_val_zero] at hN0
    let σ : k[X] →ₐ[k] k[X] := Polynomial.aeval (-X)
    have hσ : ∀ q, σ (expand k 2 q) = expand k 2 q := by
      intro q
      rw [← AlgHom.comp_apply]
      congr 1
      apply Polynomial.algHom_ext
      simp [σ]
    have hN1 := congrArg σ hN0
    rw [map_add, map_mul, hσ, hσ, map_zero] at hN1
    simp only [σ, map_sub, map_pow, map_mul, aeval_X, map_ofNat] at hN1
    have h2 : (2 : k[X]) ≠ 0 := two_ne_zero
    have hP₀ : P₀ = 0 := by
      have : (2 : k[X]) * expand k 2 P₀ = 0 := by linear_combination hN0 + hN1
      rcases mul_eq_zero.mp this with h | h
      · exact absurd h h2
      · exact expand_injective (n := 2) (by norm_num) (by rw [h, map_zero])
    have hP₁ : P₁ = 0 := by
      have : (2 : k[X]) * (X ^ 3 - 4 * X) * expand k 2 P₁ = 0 := by
        linear_combination hN0 - hN1
      have hne : (X ^ 3 - 4 * X : k[X]) ≠ 0 := by
        intro h
        have := congrArg (Polynomial.eval 1) h
        norm_num at this
      rcases mul_eq_zero.mp this with h | h
      · rcases mul_eq_zero.mp h with h | h
        · exact absurd h h2
        · exact absurd h hne
      · exact expand_injective (n := 2) (by norm_num) (by rw [h, map_zero])
    rw [hP₀, hP₁] at hN
    simpa using hN
  · rw [Ideal.span_le]
    rintro _ rfl
    exact nodeMap_cubicRel k

/-- `k[b, d] → R_B`. -/
noncomputable def nodeMapR : Two →ₐ[k] nodeAlg k :=
  (nodeMap k).codRestrict (nodeAlg k) (fun x => nodeMap_range k ▸ AlgHom.mem_range_self _ x)

theorem nodeMapR_surjective : Function.Surjective (nodeMapR k) := by
  rintro ⟨y, hy⟩
  rw [← nodeMap_range k] at hy
  obtain ⟨x, rfl⟩ := hy
  exact ⟨x, rfl⟩

theorem ker_nodeMapR : RingHom.ker (nodeMapR k) = Ideal.span {cubicRel k} := by
  rw [← ker_nodeMap]
  ext x
  simp only [RingHom.mem_ker]
  exact ⟨fun h => congrArg Subtype.val h, fun h => Subtype.ext h⟩

/-- **`B` is the nodal cubic**: `k[b, d]/(d² - b(b - 4)²) ≃ₐ[k] R_B`.

`paper-p.tex` correspondence: Example A.9 (`ex:pinched`). -/
noncomputable def nodalCubicEquiv : (Two ⧸ Ideal.span {cubicRel k}) ≃ₐ[k] nodeAlg k :=
  (Ideal.quotientEquivAlgOfEq k (ker_nodeMapR k).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (nodeMapR_surjective k))

#print axioms nodeMap_range
#print axioms ker_nodeMap
#print axioms nodalCubicEquiv

end Pcf.Examples.PaperP.PinchedNodalCubicPresentation
