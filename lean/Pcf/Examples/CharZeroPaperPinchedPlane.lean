/-!
# The pinched plane of `paper.tex`, Example `ex:pinched`

Let `k` have characteristic zero, `S = k[z,w]` and
`R = {h ∈ S : h(2,1) = h(-2,1)}`, `X = Spec R`. This file proves, for the
actual rings and affine schemes:

* `R` is the displayed equalizer (`pinchedAlg`); it is a domain of finite type
  over `k`, generated by `w, z², z(w-1), z³-4z` (`adjoin_generators_eq`), so
  `X` is an integral scheme of finite type over `k`;
* `S` is integral over `R` and birational to it, hence `S` is the integral
  closure of `R` in its fraction field; `normalizationIso` identifies `𝔸² =
  Spec S` with the project's canonical normalization `Palomar.normalization X`
  over `X`, so `ν : 𝔸² → X` is the normalization;
* `ν` is an isomorphism away from the glued point `o = ν(2,1) = ν(-2,1)`: for
  every nonzero `c` in the maximal ideal of `o`, the base change of `ν` to the
  basic open `D(c)` is the isomorphism `Spec S_c → Spec R_c` (an actual
  pullback square, `nu_isPullback_away`, `nu_away_isIso`), and the opens
  `D(w-1)`, `D(z²-4)` cover `X ∖ {o}` (`basicOpen_cover`);
* the squaring map `(z,w) ↦ (z²,w²)` descends to `f : X → X`, `f ∘ ν = ν ∘ f̃`,
  and `f` is finite and surjective.

No normalization, branch or PCF assertion is an input.
-/

@[expose] public section
noncomputable section

namespace Pcf.Examples.CharZeroPaperPinched

open CategoryTheory AlgebraicGeometry MvPolynomial

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

universe u

/-! ### The pinched coordinate ring -/

section Ring

variable (k : Type u) [Field k]

/-- The plane coordinate ring `S = k[z, w]`; variable `0` is `z`, `1` is `w`. -/
abbrev PlaneRing := MvPolynomial (Fin 2) k

/-- Evaluation at `p₁ = (2, 1)`. -/
def evalTwoOne : PlaneRing k →ₐ[k] k := aeval ![2, 1]

/-- Evaluation at `p₂ = (-2, 1)`. -/
def evalNegTwoOne : PlaneRing k →ₐ[k] k := aeval ![-2, 1]

/-- `R = {h ∈ k[z, w] : h(2, 1) = h(-2, 1)}`, the displayed equalizer. -/
def pinchedAlg : Subalgebra k (PlaneRing k) :=
  AlgHom.equalizer (evalTwoOne k) (evalNegTwoOne k)

theorem mem_pinchedAlg_iff {h : PlaneRing k} :
    h ∈ pinchedAlg k ↔ aeval ![(2 : k), 1] h = aeval ![(-2 : k), 1] h := Iff.rfl

/-- The pullback `f̃* : h ↦ h(z², w²)` along the squaring map. -/
def squaringMap : PlaneRing k →ₐ[k] PlaneRing k := aeval ![X 0 ^ 2, X 1 ^ 2]

@[simp] theorem squaringMap_X0 : squaringMap k (X 0) = X 0 ^ 2 := by simp [squaringMap]
@[simp] theorem squaringMap_X1 : squaringMap k (X 1) = X 1 ^ 2 := by simp [squaringMap]

/-- `f̃*(h)` takes the value `h(4, 1)` at both `p₁` and `p₂`. -/
theorem squaringMap_mem (h : PlaneRing k) : squaringMap k h ∈ pinchedAlg k := by
  rw [mem_pinchedAlg_iff, squaringMap, ← AlgHom.comp_apply, comp_aeval, ← AlgHom.comp_apply,
    comp_aeval]
  congr 2
  funext i
  fin_cases i <;> simp

theorem squaringMap_eq_expand : squaringMap k = expand 2 := by
  apply MvPolynomial.algHom_ext
  intro i
  fin_cases i <;> simp [squaringMap, expand]

theorem squaringMap_injective : Function.Injective (squaringMap k) := by
  rw [squaringMap_eq_expand]
  exact expand_injective (by norm_num)

theorem w_mem : (X 1 : PlaneRing k) ∈ pinchedAlg k := by
  simp [mem_pinchedAlg_iff]

theorem z_sq_mem : (X 0 ^ 2 : PlaneRing k) ∈ pinchedAlg k := by
  simp [mem_pinchedAlg_iff]

theorem z_mul_w_sub_one_mem : (X 0 * (X 1 - 1) : PlaneRing k) ∈ pinchedAlg k := by
  simp [mem_pinchedAlg_iff]

theorem z_cubed_sub_mem : (X 0 ^ 3 - 4 * X 0 : PlaneRing k) ∈ pinchedAlg k := by
  simp [mem_pinchedAlg_iff]
  norm_num

/-- The generators `w, z², z(w - 1), z³ - 4z`. -/
def generators : Set (PlaneRing k) :=
  {X 1, X 0 ^ 2, X 0 * (X 1 - 1), X 0 ^ 3 - 4 * X 0}

theorem adjoin_generators_le : Algebra.adjoin k (generators k) ≤ pinchedAlg k := by
  rw [Algebra.adjoin_le_iff]
  rintro h (rfl | rfl | rfl | rfl)
  · exact w_mem k
  · exact z_sq_mem k
  · exact z_mul_w_sub_one_mem k
  · exact z_cubed_sub_mem k

/-- The ideal `𝔪_{p₁} ∩ 𝔪_{p₂} = (w - 1, z² - 4)` of `k[z, w]`. -/
def glueIdeal : Ideal (PlaneRing k) := Ideal.span {X 1 - 1, X 0 ^ 2 - 4}

/-- Every polynomial is congruent to `a + b z` modulo `(w - 1, z² - 4)`. -/
theorem exists_reduce (h : PlaneRing k) :
    ∃ a b : k, h - (C a + C b * X 0) ∈ glueIdeal k := by
  induction h using MvPolynomial.induction_on with
  | C a => exact ⟨a, 0, by simp⟩
  | add p q hp hq =>
    obtain ⟨a, b, hp⟩ := hp
    obtain ⟨c, d, hq⟩ := hq
    refine ⟨a + c, b + d, ?_⟩
    convert Ideal.add_mem _ hp hq using 1
    simp only [C_add]
    ring
  | mul_X p i hp =>
    obtain ⟨a, b, hp⟩ := hp
    fin_cases i <;> simp only [Fin.isValue, Fin.zero_eta, Fin.mk_one]
    · refine ⟨4 * b, a, ?_⟩
      have h1 : (p - (C a + C b * X 0)) * X 0 ∈ glueIdeal k := Ideal.mul_mem_right _ _ hp
      have h2 : C b * (X 0 ^ 2 - 4) ∈ glueIdeal k :=
        Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))
      convert Ideal.add_mem _ h1 h2 using 1
      simp only [C_mul, map_ofNat]
      ring
    · refine ⟨a, b, ?_⟩
      have h1 : (p - (C a + C b * X 0)) * X 1 ∈ glueIdeal k := Ideal.mul_mem_right _ _ hp
      have h2 : (C a + C b * X 0) * (X 1 - 1) ∈ glueIdeal k :=
        Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))
      convert Ideal.add_mem _ h1 h2 using 1
      ring

theorem evalTwoOne_eq_zero_of_mem {x : PlaneRing k} (hx : x ∈ glueIdeal k) :
    aeval ![(2 : k), 1] x = 0 := by
  obtain ⟨p, q, rfl⟩ := Ideal.mem_span_pair.mp hx
  simp
  norm_num

theorem evalNegTwoOne_eq_zero_of_mem {x : PlaneRing k} (hx : x ∈ glueIdeal k) :
    aeval ![(-2 : k), 1] x = 0 := by
  obtain ⟨p, q, rfl⟩ := Ideal.mem_span_pair.mp hx
  simp
  norm_num

/-- The ideal `(w - 1, z² - 4)` lies in the subalgebra generated by the generators. -/
theorem glueIdeal_le_adjoin :
    (glueIdeal k : Set (PlaneRing k)) ⊆ Algebra.adjoin k (generators k) := by
  set A := Algebra.adjoin k (generators k) with hA
  have hw : (X 1 : PlaneRing k) ∈ A := Algebra.subset_adjoin (by simp [generators])
  have hz2 : (X 0 ^ 2 : PlaneRing k) ∈ A := Algebra.subset_adjoin (by simp [generators])
  have hzw : (X 0 * (X 1 - 1) : PlaneRing k) ∈ A :=
    Algebra.subset_adjoin (by simp [generators])
  have hz3 : (X 0 ^ 3 - 4 * X 0 : PlaneRing k) ∈ A :=
    Algebra.subset_adjoin (by simp [generators])
  have hw1 : (X 1 - 1 : PlaneRing k) ∈ A := A.sub_mem hw A.one_mem
  have h4 : (4 : PlaneRing k) ∈ A := by exact_mod_cast A.natCast_mem 4
  have hz24 : (X 0 ^ 2 - 4 : PlaneRing k) ∈ A := A.sub_mem hz2 h4
  have key : ∀ p : PlaneRing k,
      p * (X 1 - 1) ∈ A ∧ p * (X 0 ^ 2 - 4) ∈ A ∧
      p * (X 0 * (X 1 - 1)) ∈ A ∧ p * (X 0 ^ 3 - 4 * X 0) ∈ A := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a =>
      have ha : (C a : PlaneRing k) ∈ A := A.algebraMap_mem a
      exact ⟨A.mul_mem ha hw1, A.mul_mem ha hz24, A.mul_mem ha hzw, A.mul_mem ha hz3⟩
    | add p q hp hq =>
      obtain ⟨hp1, hp2, hp3, hp4⟩ := hp
      obtain ⟨hq1, hq2, hq3, hq4⟩ := hq
      exact ⟨by rw [add_mul]; exact A.add_mem hp1 hq1, by rw [add_mul]; exact A.add_mem hp2 hq2,
        by rw [add_mul]; exact A.add_mem hp3 hq3, by rw [add_mul]; exact A.add_mem hp4 hq4⟩
    | mul_X p i hp =>
      obtain ⟨hp1, hp2, hp3, hp4⟩ := hp
      fin_cases i <;> simp only [Fin.isValue, Fin.zero_eta, Fin.mk_one]
      · refine ⟨?_, ?_, ?_, ?_⟩
        · convert hp3 using 1; ring
        · convert hp4 using 1; ring
        · convert A.mul_mem hp1 hz2 using 1; ring
        · convert A.mul_mem hp2 hz2 using 1; ring
      · refine ⟨?_, ?_, ?_, ?_⟩
        · convert A.mul_mem hp1 hw using 1; ring
        · convert A.mul_mem hp2 hw using 1; ring
        · convert A.mul_mem hp3 hw using 1; ring
        · convert A.mul_mem hp4 hw using 1; ring
  intro x hx
  obtain ⟨p, q, rfl⟩ := Ideal.mem_span_pair.mp hx
  exact A.add_mem (key p).1 (key q).2.1

variable [CharZero k]

/-- `R = k + (w - 1, z² - 4)`. -/
theorem sub_C_mem_glueIdeal {h : PlaneRing k} (hh : h ∈ pinchedAlg k) :
    ∃ a : k, h - C a ∈ glueIdeal k := by
  obtain ⟨a, b, hab⟩ := exists_reduce k h
  have e1 := evalTwoOne_eq_zero_of_mem k hab
  have e2 := evalNegTwoOne_eq_zero_of_mem k hab
  rw [mem_pinchedAlg_iff] at hh
  simp only [map_sub, map_add, map_mul, aeval_C, aeval_X] at e1 e2
  simp only [Matrix.cons_val_zero] at e1 e2
  have hb : b = 0 := by
    have h4 : (4 : k) * b = 0 := by linear_combination e2 - e1 + hh
    rcases mul_eq_zero.mp h4 with h | h
    · exact absurd h (by norm_num)
    · exact h
  refine ⟨a, ?_⟩
  simpa [hb] using hab

/-- `ex:pinched`: `R = k[w, z², z(w - 1), z³ - 4z]`. -/
theorem adjoin_generators_eq : Algebra.adjoin k (generators k) = pinchedAlg k := by
  refine le_antisymm (adjoin_generators_le k) ?_
  intro h hh
  obtain ⟨a, ha⟩ := sub_C_mem_glueIdeal k hh
  have : h = C a + (h - C a) := by ring
  rw [this]
  exact (Algebra.adjoin k (generators k)).add_mem
      ((Algebra.adjoin k (generators k)).algebraMap_mem a)
    (glueIdeal_le_adjoin k ha)

end Ring

/-! ### `R` as a ring; finiteness, integrality and birationality -/

section Structure

variable (k : Type u) [Field k]

/-- The pinched coordinate ring `R`, with a single ring structure. -/
def PinchedRing : Type u := ↥(pinchedAlg k)

instance : CommRing (PinchedRing k) := inferInstanceAs (CommRing ↥(pinchedAlg k))
instance pinched_isDomain : IsDomain (PinchedRing k) :=
  inferInstanceAs (IsDomain ↥(pinchedAlg k))
instance : Algebra k (PinchedRing k) := inferInstanceAs (Algebra k ↥(pinchedAlg k))
instance : Algebra (PinchedRing k) (PlaneRing k) :=
  inferInstanceAs (Algebra ↥(pinchedAlg k) (PlaneRing k))
instance : IsScalarTower k (PinchedRing k) (PlaneRing k) :=
  inferInstanceAs (IsScalarTower k ↥(pinchedAlg k) (PlaneRing k))

/-- The underlying polynomial of an element of `R`. -/
abbrev val (r : PinchedRing k) : PlaneRing k := (r : ↥(pinchedAlg k)).1

theorem val_mem (r : PinchedRing k) : val k r ∈ pinchedAlg k := (r : ↥(pinchedAlg k)).2

/-- The element of `R` given by a polynomial in the equalizer. -/
abbrev mk (h : PlaneRing k) (hh : h ∈ pinchedAlg k) : PinchedRing k := (⟨h, hh⟩ : ↥(pinchedAlg k))

theorem algebraMap_pinched (r : PinchedRing k) :
    algebraMap (PinchedRing k) (PlaneRing k) r = val k r := rfl

theorem val_injective : Function.Injective (val k) :=
  Subtype.val_injective (p := fun h => h ∈ pinchedAlg k)

theorem algebraMap_injective : Function.Injective (algebraMap (PinchedRing k) (PlaneRing k)) :=
  val_injective k

instance pinched_faithfulSMul : FaithfulSMul (PinchedRing k) (PlaneRing k) :=
  (faithfulSMul_iff_algebraMap_injective _ _).mpr (val_injective k)

theorem val_mem_iff (r : PinchedRing k) :
    evalTwoOne k (val k r) = evalNegTwoOne k (val k r) := val_mem k r

/-- `S` is integral over `R`: every `h` is a root of
`(T - h(p₁))(T - h(p₂)) - (h - h(p₁))(h - h(p₂))`, with coefficients in `R`. -/
instance plane_isIntegral : Algebra.IsIntegral (PinchedRing k) (PlaneRing k) := by
  constructor
  intro h
  let a : k := aeval ![(2 : k), 1] h
  let b : k := aeval ![(-2 : k), 1] h
  let r : PlaneRing k := (h - C a) * (h - C b)
  have hr : r ∈ pinchedAlg k := by
    rw [mem_pinchedAlg_iff]
    simp [r, a, b]
  let c₁ : PinchedRing k := algebraMap k (PinchedRing k) (a + b)
  let c₀ : PinchedRing k := algebraMap k (PinchedRing k) (a * b) - mk k r hr
  refine ⟨Polynomial.X ^ 2 - Polynomial.C c₁ * Polynomial.X + Polynomial.C c₀, ?_, ?_⟩
  · monicity!
  · simp only [Polynomial.eval₂_add, Polynomial.eval₂_sub, Polynomial.eval₂_mul,
      Polynomial.eval₂_X_pow, Polynomial.eval₂_C, Polynomial.eval₂_X]
    have h1 : algebraMap (PinchedRing k) (PlaneRing k) c₁ = C (a + b) := rfl
    have h0 : algebraMap (PinchedRing k) (PlaneRing k) c₀ = C (a * b) - r := rfl
    rw [h1, h0]
    simp only [r, C_add, C_mul]
    ring

instance plane_moduleFinite [CharZero k] : Module.Finite (PinchedRing k) (PlaneRing k) := by
  haveI : Algebra.FiniteType (PinchedRing k) (PlaneRing k) :=
    Algebra.FiniteType.of_restrictScalars_finiteType k (PinchedRing k) (PlaneRing k)
  exact Algebra.IsIntegral.finite

/-- `R` is a finitely generated `k`-algebra. -/
instance pinched_finiteType [CharZero k] : Algebra.FiniteType k (PinchedRing k) := by
  change Algebra.FiniteType k ↥(pinchedAlg k)
  rw [← Subalgebra.fg_iff_finiteType, ← adjoin_generators_eq k]
  have hfin : (generators k).Finite := by
    unfold generators
    exact Set.toFinite _
  classical
  exact ⟨hfin.toFinset, by simp⟩

instance pinched_isNoetherianRing [CharZero k] : IsNoetherianRing (PinchedRing k) :=
  Algebra.FiniteType.isNoetherianRing k (PinchedRing k)

/-- If a nonzero `d ∈ R` satisfies `d·S ⊆ R`, then `R ⊆ S` is birational. -/
theorem isFractionRing_of_conductor {A B : Type u} [CommRing A] [IsDomain A] [CommRing B]
    [IsDomain B] [Algebra A B] [FaithfulSMul A B] (d : A) (hd : d ≠ 0)
    (h : ∀ s : B, ∃ r : A, algebraMap A B r = algebraMap A B d * s) :
    IsFractionRing A (FractionRing B) := by
  have hRS : Function.Injective (algebraMap A B) := FaithfulSMul.algebraMap_injective A B
  have hinj : Function.Injective (algebraMap A (FractionRing B)) := by
    rw [IsScalarTower.algebraMap_eq A B (FractionRing B)]
    exact (IsFractionRing.injective B (FractionRing B)).comp hRS
  change IsLocalization (nonZeroDivisors A) (FractionRing B)
  rw [isLocalization_iff_isLocalizationMap]
  refine ⟨?_, ?_, ?_⟩
  · intro y
    exact isUnit_iff_ne_zero.mpr (by
      intro hy
      exact (mem_nonZeroDivisors_iff_ne_zero.mp y.property) (hinj (by rw [map_zero]; exact hy)))
  · intro z
    obtain ⟨p, q, hq, hpq⟩ := IsFractionRing.div_surjective B z
    obtain ⟨a, ha⟩ := h p
    obtain ⟨b, hb⟩ := h q
    have hqne : q ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hq
    have hbne : b ≠ 0 := by
      intro hb0
      rw [hb0, map_zero] at hb
      exact (mul_ne_zero ((map_ne_zero_iff _ hRS).mpr hd) hqne) hb.symm
    refine ⟨(a, ⟨b, mem_nonZeroDivisors_iff_ne_zero.mpr hbne⟩), ?_⟩
    change z * algebraMap A (FractionRing B) b = algebraMap A (FractionRing B) a
    rw [← hpq]
    simp only [IsScalarTower.algebraMap_apply A B (FractionRing B), ha, hb, map_mul]
    have hqmap : algebraMap B (FractionRing B) q ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hq
    field_simp [hqmap]
  · intro a b hab
    exact ⟨1, by simpa using hinj hab⟩

/-- `R ⊆ k[z, w]` is birational: `(w - 1)·k[z, w] ⊆ R`. -/
instance pinched_isFractionRing :
    IsFractionRing (PinchedRing k) (FractionRing (PlaneRing k)) := by
  have hd : (X 1 - 1 : PlaneRing k) ∈ pinchedAlg k := by
    rw [mem_pinchedAlg_iff]
    simp
  refine isFractionRing_of_conductor (A := PinchedRing k) (B := PlaneRing k)
    (mk k (X 1 - 1) hd) ?_ ?_
  · intro h0
    have := congrArg (val k) h0
    change (X 1 - 1 : PlaneRing k) = 0 at this
    have h := congrArg (aeval ![(0 : k), 0]) this
    simp at h
  · intro s
    refine ⟨mk k ((X 1 - 1) * s) ?_, rfl⟩
    rw [mem_pinchedAlg_iff]
    simp

/-- `k[z, w]` is the integral closure of `R` in its fraction field. -/
instance plane_isIntegralClosure :
    IsIntegralClosure (PlaneRing k) (PinchedRing k) (FractionRing (PlaneRing k)) :=
  IsIntegralClosure.of_isIntegrallyClosed _ _ _

end Structure

/-! ### The glued point and the conductor -/

section Conductor

variable (k : Type u) [Field k]

/-- The maximal ideal `𝔪_o = {h ∈ R : h(2,1) = 0}` of the glued point `o`. -/
def oIdeal : Ideal (PinchedRing k) :=
  RingHom.ker ((evalTwoOne k).toRingHom.comp (algebraMap (PinchedRing k) (PlaneRing k)))

theorem mem_oIdeal_iff (h : PinchedRing k) : h ∈ oIdeal k ↔ evalTwoOne k (val k h) = 0 :=
  Iff.rfl

instance oIdeal_isMaximal : (oIdeal k).IsMaximal := by
  unfold oIdeal
  apply RingHom.ker_isMaximal_of_surjective
  intro c
  refine ⟨algebraMap k (PinchedRing k) c, ?_⟩
  change evalTwoOne k (algebraMap k (PlaneRing k) c) = c
  simp

/-- **The conductor**: an element of `𝔪_o` multiplies `S` into `R`. -/
theorem mul_mem_of_mem_oIdeal {h : PinchedRing k} (hh : h ∈ oIdeal k) (s : PlaneRing k) :
    val k h * s ∈ pinchedAlg k := by
  have h1 := (mem_oIdeal_iff k h).mp hh
  have h2 := val_mem_iff k h
  rw [h1] at h2
  rw [mem_pinchedAlg_iff, map_mul, map_mul]
  change evalTwoOne k _ * _ = evalNegTwoOne k _ * _
  rw [h1, ← h2, zero_mul, zero_mul]

theorem conductor (h : PinchedRing k) (hh : h ∈ oIdeal k) (s : PlaneRing k) :
    ∃ a : PinchedRing k, algebraMap _ (PlaneRing k) a = algebraMap _ (PlaneRing k) h * s :=
  ⟨mk k _ (mul_mem_of_mem_oIdeal k hh s), rfl⟩

/-- The element `w - 1 ∈ R`. -/
def wSubOne : PinchedRing k :=
  mk k (X 1 - 1) (Subalgebra.sub_mem _ (w_mem k) (Subalgebra.one_mem _))

/-- The element `z² - 4 ∈ R`. -/
def zSqSubFour : PinchedRing k :=
  mk k (X 0 ^ 2 - 4) (Subalgebra.sub_mem _ (z_sq_mem k)
    (by rw [mem_pinchedAlg_iff]; simp))

theorem wSubOne_mem_oIdeal : wSubOne k ∈ oIdeal k := by
  rw [mem_oIdeal_iff]; change evalTwoOne k (X 1 - 1) = 0; simp [evalTwoOne]

theorem zSqSubFour_mem_oIdeal : zSqSubFour k ∈ oIdeal k := by
  rw [mem_oIdeal_iff]; change evalTwoOne k (X 0 ^ 2 - 4) = 0; simp [evalTwoOne]; norm_num

theorem wSubOne_ne_zero : wSubOne k ≠ 0 := by
  intro h
  have := congrArg (val k) h
  change (X 1 - 1 : PlaneRing k) = 0 at this
  have h2 := congrArg (aeval ![(0 : k), 0]) this
  simp at h2

theorem zSqSubFour_ne_zero [CharZero k] : zSqSubFour k ≠ 0 := by
  intro h
  have := congrArg (val k) h
  change (X 0 ^ 2 - 4 : PlaneRing k) = 0 at this
  have h2 := congrArg (aeval ![(0 : k), 0]) this
  simp at h2

/-- If `c ∈ M` multiplies `B` into `A`, and `A ∩ c·N ⊆ M`, then `B_N` is `A_M`. -/
theorem isLocalization_of_conductor {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    (hAB : Function.Injective (algebraMap A B))
    (M : Submonoid A) (N : Submonoid B) (T : Type*) [CommRing T] [Algebra B T] [Algebra A T]
    [IsScalarTower A B T] [IsLocalization N T] (hN : N ≤ nonZeroDivisors B)
    (hMN : ∀ m ∈ M, algebraMap A B m ∈ N) (c : A)
    (hcond : ∀ b : B, ∃ a : A, algebraMap A B a = algebraMap A B c * b)
    (hden : ∀ a : A, ∀ u ∈ N, algebraMap A B a = algebraMap A B c * u → a ∈ M) :
    IsLocalization M T := by
  rw [isLocalization_iff]
  refine ⟨?_, ?_, ?_⟩
  · rintro ⟨m, hm⟩
    rw [IsScalarTower.algebraMap_apply A B T]
    exact IsLocalization.map_units T (⟨_, hMN m hm⟩ : N)
  · intro z
    obtain ⟨⟨b, u⟩, hz⟩ := IsLocalization.surj N z
    obtain ⟨a1, ha1⟩ := hcond b
    obtain ⟨a2, ha2⟩ := hcond u
    refine ⟨(a1, ⟨a2, hden a2 u u.2 ha2⟩), ?_⟩
    simp only [IsScalarTower.algebraMap_apply A B T, ha1, ha2, map_mul]
    rw [← hz]; ring
  · intro x y hxy
    refine ⟨1, ?_⟩
    rw [IsScalarTower.algebraMap_apply A B T, IsScalarTower.algebraMap_apply A B T] at hxy
    rw [hAB (IsLocalization.injective T hN hxy)]

/-- For `0 ≠ c ∈ 𝔪_o`, `S_c` is the localization `R_c`. -/
theorem isLocalization_away_of_mem_oIdeal (c : PinchedRing k) (hc : c ∈ oIdeal k) (h0 : c ≠ 0) :
    IsLocalization.Away c (Localization.Away (algebraMap (PinchedRing k) (PlaneRing k) c)) := by
  refine isLocalization_of_conductor (algebraMap_injective k) _
    (Submonoid.powers (algebraMap _ (PlaneRing k) c)) _ ?_ ?_ c (conductor k c hc) ?_
  · exact powers_le_nonZeroDivisors_of_noZeroDivisors
      ((map_ne_zero_iff _ (algebraMap_injective k)).mpr h0)
  · rintro m ⟨n, rfl⟩
    exact ⟨n, by simp⟩
  · rintro a u ⟨n, rfl⟩ hu
    refine ⟨n + 1, algebraMap_injective k ?_⟩
    rw [hu, map_pow, pow_succ']

theorem exists_mem_oIdeal_not_mem (P : Ideal (PinchedRing k)) [P.IsPrime]
    (hne : P ≠ oIdeal k) : ∃ c ∈ oIdeal k, c ∉ P := by
  by_contra hcon
  push Not at hcon
  exact hne ((oIdeal_isMaximal k).eq_of_le (Ideal.IsPrime.ne_top ‹_›) hcon).symm

end Conductor

/-! ### The schemes -/

section Schemes

variable (k : Type u) [Field k]

/-- The pinched plane `X = Spec R`. -/
abbrev pinchedPlane : Scheme.{u} := Spec (.of (PinchedRing k))

/-- The plane `𝔸² = Spec k[z, w]`. -/
abbrev plane : Scheme.{u} := Spec (.of (PlaneRing k))

/-- The map `ν : 𝔸² → X`. -/
def nu : plane k ⟶ pinchedPlane k :=
  Spec.map (CommRingCat.ofHom (algebraMap (PinchedRing k) (PlaneRing k)))

instance pinchedPlane_isIntegral : IsIntegral (pinchedPlane k) := inferInstance

instance nu_isFinite [CharZero k] : IsFinite (nu k) :=
  (IsFinite.SpecMap_iff _).mpr (RingHom.finite_algebraMap.mpr inferInstance)

instance nu_surjective [CharZero k] : Surjective (nu k) := by
  constructor
  exact (algebraMap_isIntegral_iff.mpr inferInstance :
    (algebraMap (PinchedRing k) (PlaneRing k)).IsIntegral).comap_surjective
      (algebraMap_injective k)

instance nu_isDominant [CharZero k] : IsDominant (nu k) := inferInstance

/-- The integral closure of `R` in `Frac(S)` is `S`, as `R`-algebras. -/
def integralClosureEquiv :
    PlaneRing k ≃ₐ[PinchedRing k]
      integralClosure (PinchedRing k) (FractionRing (PlaneRing k)) :=
  IsIntegralClosure.equiv (PinchedRing k) (PlaneRing k) (FractionRing (PlaneRing k))
    (integralClosure (PinchedRing k) (FractionRing (PlaneRing k)))

/-- `𝔸²` is isomorphic to the canonical normalization of the pinched plane. -/
def normalizationIso : plane k ≅ Palomar.normalization (pinchedPlane k) :=
  Scheme.Spec.mapIso (RingEquiv.toCommRingCatIso
      (integralClosureEquiv k).toRingEquiv).symm.op ≪≫
    Pcf.PaperCharZero.affineNormalizationIso (.of (PinchedRing k)) (FractionRing (PlaneRing k))

set_option backward.isDefEq.respectTransparency false in
/-- `ex:pinched`: the normalization of `X` is `ν : 𝔸² → X`. -/
theorem normalizationIso_comm :
    (normalizationIso k).hom ≫ Palomar.normalizationMap (pinchedPlane k) = nu k := by
  simp only [normalizationIso, Iso.trans_hom, Category.assoc,
    Pcf.PaperCharZero.affineNormalizationIso_hom_normalizationMap]
  change Spec.map _ ≫ Spec.map _ = _
  rw [← Spec.map_comp]
  congr 1
  apply CommRingCat.hom_ext
  apply RingHom.ext
  intro r
  exact (integralClosureEquiv k).symm.commutes r

end Schemes

/-! ### `ν` is an isomorphism away from the glued point -/

section AwayFromO

variable (k : Type u) [Field k]

/-- The glued point `o ∈ X`. -/
def oPoint : pinchedPlane k := ⟨oIdeal k, inferInstance⟩

/-- `o = ν(2, 1) = ν(-2, 1)`. -/
theorem nu_points (P : plane k)
    (hP : P.asIdeal = RingHom.ker (evalTwoOne k).toRingHom ∨
      P.asIdeal = RingHom.ker (evalNegTwoOne k).toRingHom) :
    nu k P = oPoint k := by
  apply PrimeSpectrum.ext
  ext h
  change algebraMap _ (PlaneRing k) h ∈ P.asIdeal ↔ h ∈ oIdeal k
  rw [mem_oIdeal_iff]
  rcases hP with hP | hP <;> rw [hP]
  · rfl
  · change evalNegTwoOne k (val k h) = 0 ↔ _
    rw [← val_mem_iff]

/-- The base change of `ν` along `Spec R_c → X` is `Spec S_c → Spec R_c`. -/
theorem nu_isPullback_away (c : PinchedRing k) :
    IsPullback
      (Spec.map (CommRingCat.ofHom
        (algebraMap (PlaneRing k) (Localization.Away (algebraMap _ (PlaneRing k) c)))))
      (Spec.map (CommRingCat.ofHom (Localization.awayMap (algebraMap _ (PlaneRing k)) c)))
      (nu k)
      (Spec.map (CommRingCat.ofHom (algebraMap (PinchedRing k) (Localization.Away c)))) := by
  apply isPullback_SpecMap_of_isPushout
  have : IsLocalization ((Submonoid.powers c).map (algebraMap _ (PlaneRing k)))
      (Localization.Away (algebraMap _ (PlaneRing k) c)) := by
    rw [Submonoid.map_powers]
    infer_instance
  refine (CommRingCat.isPushout_of_isLocalization (algebraMap _ (PlaneRing k))
    (Localization.awayMap (algebraMap _ (PlaneRing k)) c) ?_ (Submonoid.powers c))
  exact IsLocalization.map_comp _

/-- The open immersion `Spec R_c → X` has image the basic open `D(c)`. -/
theorem away_range (c : PinchedRing k) :
    Set.range (Spec.map (CommRingCat.ofHom
      (algebraMap (PinchedRing k) (Localization.Away c)))) =
      (PrimeSpectrum.basicOpen c : Set (PrimeSpectrum (PinchedRing k))) :=
  PrimeSpectrum.localization_away_comap_range (Localization.Away c) c

/-- **`ν` is an isomorphism over `D(c)`** for `0 ≠ c ∈ 𝔪_o`. -/
theorem nu_away_isIso [CharZero k] (c : PinchedRing k) (hc : c ∈ oIdeal k) (h0 : c ≠ 0) :
    IsIso (Spec.map (CommRingCat.ofHom (Localization.awayMap (algebraMap _ (PlaneRing k)) c))) := by
  haveI := isLocalization_away_of_mem_oIdeal k c hc h0
  let e : Localization.Away c ≃ₐ[PinchedRing k]
      Localization.Away (algebraMap _ (PlaneRing k) c) :=
    IsLocalization.algEquiv (Submonoid.powers c) _ _
  have he : Localization.awayMap (algebraMap _ (PlaneRing k)) c = e.toRingEquiv.toRingHom := by
    apply IsLocalization.ringHom_ext (Submonoid.powers c)
    ext r
    simp only [RingHom.comp_apply, Localization.awayMap, IsLocalization.Away.map,
      IsLocalization.map_eq]
    change _ = e (algebraMap _ _ r)
    rw [AlgEquiv.commutes]
    exact IsScalarTower.algebraMap_apply _ (PlaneRing k) _ r
  rw [he]
  exact (Scheme.Spec.mapIso (RingEquiv.toCommRingCatIso e.toRingEquiv).op).isIso_hom

/-- An element of `R` vanishing at both `w - 1` and `z² - 4` modulo a prime `P` forces
`𝔪_o ⊆ P`: the conductor gives `h² = r₁(w - 1) + r₂(z² - 4)`. -/
theorem oIdeal_le_of_mem [CharZero k] {P : Ideal (PinchedRing k)} [hP : P.IsPrime]
    (hw : wSubOne k ∈ P) (hz : zSqSubFour k ∈ P) : oIdeal k ≤ P := by
  intro h hh
  have hglue : val k h ∈ glueIdeal k := by
    obtain ⟨a, ha⟩ := sub_C_mem_glueIdeal k (val_mem k h)
    have e := evalTwoOne_eq_zero_of_mem k ha
    rw [map_sub] at e
    change evalTwoOne k _ - evalTwoOne k _ = 0 at e
    rw [(mem_oIdeal_iff k h).mp hh] at e
    have : a = 0 := by simpa [evalTwoOne] using e
    simpa [this] using ha
  obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hglue
  apply hP.mem_of_pow_mem 2
  obtain ⟨r1, hr1⟩ := conductor k h hh a
  obtain ⟨r2, hr2⟩ := conductor k h hh b
  have : h ^ 2 = r1 * wSubOne k + r2 * zSqSubFour k := by
    apply algebraMap_injective k
    rw [map_add, map_mul, map_mul, hr1, hr2, map_pow]
    change val k h ^ 2 = val k h * a * (X 1 - 1) + val k h * b * (X 0 ^ 2 - 4)
    rw [sq]
    nth_rewrite 2 [← hab]
    ring
  rw [this]
  exact P.add_mem (P.mul_mem_left _ hw) (P.mul_mem_left _ hz)

/-- **`D(w - 1) ∪ D(z² - 4) = X ∖ {o}`**. -/
theorem basicOpen_cover [CharZero k] (P : pinchedPlane k) :
    (wSubOne k ∉ P.asIdeal ∨ zSqSubFour k ∉ P.asIdeal) ↔ P ≠ oPoint k := by
  constructor
  · rintro (h | h) rfl
    · exact h (wSubOne_mem_oIdeal k)
    · exact h (zSqSubFour_mem_oIdeal k)
  · intro hne
    have := P.isPrime
    by_contra hc
    push Not at hc
    apply hne
    apply PrimeSpectrum.ext
    exact ((oIdeal_isMaximal k).eq_of_le P.isPrime.ne_top (oIdeal_le_of_mem k hc.1 hc.2)).symm

end AwayFromO

/-! ### The descended squaring map -/

section Ambient

variable (k : Type u) [Field k]

/-- `f* : R → R`, the restriction of `f̃*`. -/
def fStar : PinchedRing k →+* PinchedRing k where
  toFun r := mk k (squaringMap k (val k r)) (squaringMap_mem k _)
  map_one' := by apply val_injective; exact map_one (squaringMap k)
  map_mul' a b := by apply val_injective; exact map_mul (squaringMap k) _ _
  map_zero' := by apply val_injective; exact map_zero (squaringMap k)
  map_add' a b := by apply val_injective; exact map_add (squaringMap k) _ _

theorem val_fStar (r : PinchedRing k) : val k (fStar k r) = squaringMap k (val k r) := rfl

/-- The actual map `f : X → X`. -/
def ambientMap : pinchedPlane k ⟶ pinchedPlane k := Spec.map (CommRingCat.ofHom (fStar k))

/-- `f̃ : 𝔸² → 𝔸²`, `(z, w) ↦ (z², w²)`. -/
def planeSquaring : plane k ⟶ plane k := Spec.map (CommRingCat.ofHom (squaringMap k).toRingHom)

/-- `f ∘ ν = ν ∘ f̃`. -/
theorem planeSquaring_nu : planeSquaring k ≫ nu k = nu k ≫ ambientMap k := by
  unfold planeSquaring ambientMap nu
  rw [← Spec.map_comp, ← Spec.map_comp]
  rfl

theorem fStar_injective : Function.Injective (fStar k) := by
  intro a b h
  apply val_injective
  exact squaringMap_injective k (congrArg (val k) h)

theorem fStar_comp_algebraMap :
    (fStar k).comp (algebraMap k (PinchedRing k)) = algebraMap k (PinchedRing k) := by
  ext c
  apply val_injective
  exact (squaringMap k).commutes c

/-- `k[z, w]` is integral over `R` through `f*`: `z⁴ = f*(z²)`, `w² = f*(w)`. -/
theorem plane_isIntegralElem_over_f (p : PlaneRing k) :
    ((algebraMap (PinchedRing k) (PlaneRing k)).comp (fStar k)).IsIntegralElem p := by
  let φ := (algebraMap (PinchedRing k) (PlaneRing k)).comp (fStar k)
  have hX0 : φ.IsIntegralElem (X 0 : PlaneRing k) := by
    refine ⟨Polynomial.X ^ 4 - Polynomial.C (mk k (X 0 ^ 2) (z_sq_mem k)),
      Polynomial.monic_X_pow_sub_C _ (by norm_num), ?_⟩
    simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
    change (X 0 : PlaneRing k) ^ 4 - squaringMap k (X 0 ^ 2) = 0
    simp only [map_pow, squaringMap_X0]
    ring
  have hX1 : φ.IsIntegralElem (X 1 : PlaneRing k) := by
    refine ⟨Polynomial.X ^ 2 - Polynomial.C (mk k (X 1) (w_mem k)),
      Polynomial.monic_X_pow_sub_C _ (by norm_num), ?_⟩
    simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
    change (X 1 : PlaneRing k) ^ 2 - squaringMap k (X 1) = 0
    simp
  have hC (a : k) : φ.IsIntegralElem (C a) := by
    have h := RingHom.isIntegralElem_map φ (x := algebraMap k (PinchedRing k) a)
    have hφ : φ (algebraMap k (PinchedRing k) a) = C a := by
      change val k (fStar k (algebraMap k (PinchedRing k) a)) = C a
      rw [← RingHom.comp_apply, fStar_comp_algebraMap]
      rfl
    rwa [hφ] at h
  induction p using MvPolynomial.induction_on with
  | C a => exact hC a
  | add p q hp hq => exact RingHom.IsIntegralElem.add φ hp hq
  | mul_X p i hp =>
      fin_cases i
      · exact RingHom.IsIntegralElem.mul φ hp hX0
      · exact RingHom.IsIntegralElem.mul φ hp hX1

/-- `f* : R → R` is finite. -/
theorem fStar_finite [CharZero k] : (fStar k).Finite := by
  refine RingHom.finite_iff_isIntegral_and_finiteType.mpr ⟨?_, ?_⟩
  · intro r
    obtain ⟨P, hP, hev⟩ := plane_isIntegralElem_over_f k (val k r)
    refine ⟨P, hP, ?_⟩
    apply val_injective
    change algebraMap (PinchedRing k) (PlaneRing k) (P.eval₂ (fStar k) r) =
      algebraMap (PinchedRing k) (PlaneRing k) 0
    rw [Polynomial.hom_eval₂, map_zero]
    exact hev
  · apply RingHom.FiniteType.of_comp_finiteType (f := algebraMap k (PinchedRing k))
    rw [fStar_comp_algebraMap]
    exact RingHom.finiteType_algebraMap.mpr inferInstance

/-- `ex:pinched`: `f` is finite. -/
instance ambientMap_isFinite [CharZero k] : IsFinite (ambientMap k) :=
  (IsFinite.SpecMap_iff (CommRingCat.ofHom (fStar k))).mpr (fStar_finite k)

/-- `ex:pinched`: `f` is surjective. -/
instance ambientMap_surjective [CharZero k] : Surjective (ambientMap k) := by
  constructor
  exact (fStar_finite k).to_isIntegral.comap_surjective (fStar_injective k)

instance ambientMap_isDominant [CharZero k] : IsDominant (ambientMap k) := inferInstance

end Ambient

