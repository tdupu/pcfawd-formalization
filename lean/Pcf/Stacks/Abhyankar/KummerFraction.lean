import Pcf.Stacks.Abhyankar.KummerDVR
import Mathlib.RingTheory.Polynomial.GaussLemma
import Mathlib.RingTheory.RamificationInertia.Ramification

/-!
# Fraction fields and ramification for the root algebra in Stacks Tag 09EV

This file continues the clause-level root-extension calculation used in the proof of Stacks
Tag `09EV`.  It transports the Eisenstein polynomial to the fraction field, computes the
degree of its root field, identifies the integral root algebra as the integral closure in its
own fraction field, and computes the ramification index of the distinguished root prime.

This is not the full tag.  In particular, no equivalence between the fraction field of the
integral root algebra and the displayed `AdjoinRoot` over `FractionRing A` is claimed here,
and intermediate extensions are not classified.
-/

open Polynomial IsLocalRing

universe u

namespace Pcf.Stacks

variable {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]

/-- Mapping `X^n - π` to the fraction field gives the same root polynomial formed there. -/
theorem dvrRootPoly_map_fractionRing (π : A) (n : ℕ) :
    (dvrRootPoly π n).map (algebraMap A (FractionRing A)) =
      dvrRootPoly (algebraMap A (FractionRing A) π) n := by
  simp [dvrRootPoly]

/-- The root polynomial remains irreducible over the fraction field. -/
theorem dvrRootFractionPoly_irreducible (π : A) {n : ℕ} (hn : 1 ≤ n)
    (hπ : Irreducible π) :
    Irreducible (dvrRootPoly (algebraMap A (FractionRing A) π) n) := by
  rw [← dvrRootPoly_map_fractionRing]
  exact (dvrRootPoly_monic π hn).irreducible_iff_irreducible_map_fraction_map.mp
    (dvrRootPoly_irreducible π hn hπ)

/-- The displayed root algebra over the fraction field is a field. -/
theorem dvrRootFractionAlgebra_isField (π : A) {n : ℕ} (hn : 1 ≤ n)
    (hπ : Irreducible π) :
    IsField (AdjoinRoot (dvrRootPoly (algebraMap A (FractionRing A) π) n)) := by
  rw [AdjoinRoot.isField_iff_irreducible]
  exact dvrRootFractionPoly_irreducible π hn hπ

/-- The displayed root field has degree `n` over the fraction field of the DVR. -/
theorem dvrRootFractionAlgebra_finrank (π : A) {n : ℕ} (hn : 1 ≤ n) :
    Module.finrank (FractionRing A)
      (AdjoinRoot (dvrRootPoly (algebraMap A (FractionRing A) π) n)) = n :=
  dvrRootAlgebra_finrank (algebraMap A (FractionRing A) π) hn

/-- The integral root algebra is the integral closure of `A` in its own fraction field.

This is the intrinsic integral-closure statement.  Transporting it to the displayed
`AdjoinRoot` over `FractionRing A` requires a separate fraction-field/base-change
equivalence and is deliberately not folded into this theorem. -/
theorem dvrRootAlgebra_isIntegralClosure_fractionRing (π : A) {n : ℕ} (hn : 1 ≤ n)
    (hπ : Irreducible π) :
    IsIntegralClosure (AdjoinRoot (dvrRootPoly π n)) A
      (FractionRing (AdjoinRoot (dvrRootPoly π n))) := by
  letI : IsDomain (AdjoinRoot (dvrRootPoly π n)) := dvrRootAlgebra_isDomain π hn hπ
  letI : IsLocalRing (AdjoinRoot (dvrRootPoly π n)) := dvrRootAlgebra_isLocalRing π hn hπ
  letI : IsDiscreteValuationRing (AdjoinRoot (dvrRootPoly π n)) :=
    dvrRootAlgebra_isDiscreteValuationRing π hn hπ
  letI : Algebra.IsIntegral A (AdjoinRoot (dvrRootPoly π n)) :=
    AdjoinRoot.isIntegral_of_monic (dvrRootPoly_monic π hn)
  exact IsIntegralClosure.of_isIntegrallyClosed _ _ _

/-- The prime generated by the distinguished root has ramification index `n` over `A`.
This is the ramification-index calculation for the standard root extension in `09EV`. -/
theorem dvrRootIdeal_ramificationIdx (π : A) {n : ℕ} (hn : 1 ≤ n)
    (hπ : Irreducible π) :
    (Ideal.span {AdjoinRoot.root (dvrRootPoly π n)}).ramificationIdx A = n := by
  letI : IsDomain (AdjoinRoot (dvrRootPoly π n)) := dvrRootAlgebra_isDomain π hn hπ
  letI : IsLocalRing (AdjoinRoot (dvrRootPoly π n)) := dvrRootAlgebra_isLocalRing π hn hπ
  letI : IsDiscreteValuationRing (AdjoinRoot (dvrRootPoly π n)) :=
    dvrRootAlgebra_isDiscreteValuationRing π hn hπ
  letI : Algebra.IsIntegral A (AdjoinRoot (dvrRootPoly π n)) :=
    AdjoinRoot.isIntegral_of_monic (dvrRootPoly_monic π hn)
  letI : FaithfulSMul A (AdjoinRoot (dvrRootPoly π n)) :=
    AdjoinRoot.faithfulSMul_of_monic_of_degree_pos (dvrRootPoly_monic π hn) <| by
      rw [← natDegree_pos_iff_degree_pos, dvrRootPoly, natDegree_X_pow_sub_C]
      exact hn
  letI : IsLocalHom (algebraMap A (AdjoinRoot (dvrRootPoly π n))) :=
    AdjoinRoot.isLocalHom_of_monic_of_degree_pos (dvrRootPoly_monic π hn) <| by
      rw [← natDegree_pos_iff_degree_pos, dvrRootPoly, natDegree_X_pow_sub_C]
      exact hn
  have hrootIdeal : maximalIdeal (AdjoinRoot (dvrRootPoly π n)) =
      Ideal.span {AdjoinRoot.root (dvrRootPoly π n)} :=
    (IsLocalRing.eq_maximalIdeal (dvrRootIdeal_isMaximal π hn hπ)).symm
  letI : (Ideal.span {AdjoinRoot.root (dvrRootPoly π n)}).IsPrime :=
    (dvrRootIdeal_isMaximal π hn hπ).isPrime
  letI : (Ideal.span {AdjoinRoot.root (dvrRootPoly π n)}).LiesOver (maximalIdeal A) :=
    ⟨by
      rw [← hrootIdeal]
      exact (IsLocalRing.maximalIdeal_comap
        (algebraMap A (AdjoinRoot (dvrRootPoly π n)))).symm⟩
  have hmap : Ideal.map (algebraMap A (AdjoinRoot (dvrRootPoly π n))) (maximalIdeal A) =
      (Ideal.span {AdjoinRoot.root (dvrRootPoly π n)}) ^ n := by
    rw [hπ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton,
      Ideal.span_singleton_pow, dvrRoot_pow_eq]
  have hbase_ne : maximalIdeal A ≠ ⊥ := by
    rw [hπ.maximalIdeal_eq]
    intro hbot
    have : π ∈ (⊥ : Ideal A) := by
      rw [← hbot]
      exact Ideal.subset_span (Set.mem_singleton _)
    exact hπ.ne_zero (Ideal.mem_bot.mp this)
  have hroot_ne : Ideal.span {AdjoinRoot.root (dvrRootPoly π n)} ≠ ⊥ :=
    Ideal.ne_bot_of_liesOver_of_ne_bot hbase_ne _
  rw [Ideal.IsDedekindDomain.ramificationIdx_eq_multiplicity _ _
      (Ideal.map_ne_bot_of_ne_bot hbase_ne), hmap]
  exact multiplicity_pow_self_of_prime
    (Ideal.prime_of_isPrime hroot_ne inferInstance) n

#print axioms dvrRootFractionPoly_irreducible
#print axioms dvrRootFractionAlgebra_isField
#print axioms dvrRootFractionAlgebra_finrank
#print axioms dvrRootAlgebra_isIntegralClosure_fractionRing
#print axioms dvrRootIdeal_ramificationIdx

end Pcf.Stacks
