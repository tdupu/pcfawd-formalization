module

public import Pcf.Stacks.Abhyankar.KummerIntermediateEquiv
public import Pcf.Stacks.Abhyankar.StrictComponentClassification

/-!
# Tame Kummer classification (Stacks Tag `09EV`, clause (6)) in any characteristic

Stacks Lemma 15.116.2 (Tag `09EV`): let `A` be a DVR with uniformizer `π` and `K₁ = K[π^{1/n}]`,
`n ≥ 2`.  Clause (6): if `n` is prime to the residue characteristic of `A`, then `K₁/K` is tamely
ramified and *any subextension of `K₁/K` is generated by `π^{1/d}` for some divisor `d` of `n`*.

Phase 1 (`KummerNormDescent.lean`, `KummerIntermediateEquiv.lean`) proved this with the extra
hypothesis `[CharZero A]`.  That hypothesis is vacuous: the proof of
`dvrRootFraction_intermediate_eq_power` only calls
`dvrRootFraction_intermediate_eq_power_of_rootOfUnity_descent` (the norm argument) and
`dvrRootFraction_rootOfUnity_mem_base` (Stacks' root-of-unity descent, which uses exactly the
tame hypothesis "`n` is a unit in `κ_A`"), neither of which assumes characteristic zero.  This
file restates the classification without `CharZero`, in the exact form consumed by the tame proof
of Tag `0EYG`, and adds the degenerate exponent `n = 1` (not in the statement of `09EV`, where
`n ≥ 2`; for `n = 1` the root field is `K` itself and the claim is trivial).

## Stacks proof step → Lean lemma

| `09EV` step | Lean |
| --- | --- |
| (1)–(5), `A[π^{1/n}]` is a DVR, `[K₁ : K] = n` | phase 1: `KummerDVR.lean`, `KummerFraction.lean` |
| (6) "it suffices to show every `n`th root of unity `ζ ∈ K'` is contained in `K`, see Fields 9.24.3" | `dvrRootFraction_intermediate_eq_power_of_rootOfUnity_descent` (phase 1) |
| (6) "`ζ = a + b` … thus `b = 0` and `ζ ∈ A`" (root-of-unity descent, uses `n ∈ κ_A^×`) | `dvrRootFraction_rootOfUnity_mem_base` (phase 1) |
| (6) assembled, tame case | `dvrRootFraction_intermediate_eq_power_tame` (this file) |
| embedding form used in `0EYG` paragraph 5 | `exists_dvrRootFractionPowerEquiv_of_embedding_tame` |

Divergence from Stacks: Stacks' Fields Lemma 9.24.3 (intermediate fields of `K(a^{1/n})` when
all `n`th roots of unity lie in `K`) is replaced in phase 1 by a norm argument
(`radical_pow_relative_finrank_mem`); this file inherits that route.
-/

@[expose] public section

universe u

open IsLocalRing Polynomial

namespace Pcf.Stacks

set_option linter.style.haveILetI false

/-- **Stacks Tag `09EV`, clause (6), tame case, any characteristic.**  The intermediate fields of
the root field `K(π^{1/n})` (`n ≥ 2`, `n` a unit in `κ_A`) are exactly the fields generated by
powers of its root.

This is `dvrRootFraction_intermediate_eq_power` with the (unused) hypothesis `[CharZero A]`
removed; the proof is the same two phase-1 lemmas. -/
@[stacks 09EV "clause (6), intermediate fields of the tame radical extension, any characteristic"]
theorem dvrRootFraction_intermediate_eq_power_tame
    {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    (π : A) {n : ℕ} (hn : 2 ≤ n) (hπ : Irreducible π)
    (hunit : IsUnit ((n : ℕ) : ResidueField A)) :
    letI : Field (AdjoinRoot (dvrRootPoly (algebraMap A (FractionRing A) π) n)) :=
      (dvrRootFractionAlgebra_isField π (by omega : 1 ≤ n) hπ).toField
    ∀ M : IntermediateField (FractionRing A)
        (AdjoinRoot (dvrRootPoly (algebraMap A (FractionRing A) π) n)),
      ∃ e : ℕ, e ∣ n ∧ 1 ≤ e ∧
        M = IntermediateField.adjoin (FractionRing A)
          {AdjoinRoot.root (dvrRootPoly (algebraMap A (FractionRing A) π) n) ^ (n / e)} :=
  dvrRootFraction_intermediate_eq_power_of_rootOfUnity_descent π
    (by omega : 1 ≤ n) hπ (dvrRootFraction_rootOfUnity_mem_base π hn hπ hunit)

/-- **Stacks Tag `09EV`, clause (6), embedding form, tame case.**  A field `M` embedded over
`K = Frac(A)` in the tame root field `K(π^{1/n})` is isomorphic to `K(π^{1/d})` for a divisor
`d` of `n`.

Compared with phase 1's `exists_dvrRootFractionPowerEquiv_of_embedding`: no `[CharZero A]`, and
the exponent `n = 1` is allowed (then `K(π^{1/1}) = K`, `M = K`, `d = 1`; Stacks states `09EV`
for `n ≥ 2` only, and this case is not part of the tag).  The tameness hypothesis is exactly
Stacks' "`n` is prime to the residue characteristic", i.e. `n ∈ κ_A^×`. -/
@[stacks 09EV "clause (6), tame case, any characteristic; n = 1 added"]
theorem exists_dvrRootFractionPowerEquiv_of_embedding_tame
    {A M : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field M] [Algebra (FractionRing A) M]
    (π : A) {n : ℕ} (hn : 1 ≤ n) (hπ : Irreducible π)
    (hunit : IsUnit ((n : ℕ) : IsLocalRing.ResidueField A))
    (f : M →ₐ[FractionRing A]
      AdjoinRoot (dvrRootPoly (algebraMap A (FractionRing A) π) n)) :
    ∃ d : ℕ, d ∣ n ∧ 1 ≤ d ∧
      Nonempty (M ≃ₐ[FractionRing A]
        AdjoinRoot (dvrRootPoly (algebraMap A (FractionRing A) π) d)) := by
  let K := FractionRing A
  let L := AdjoinRoot (dvrRootPoly (algebraMap A K π) n)
  letI : Field L := (dvrRootFractionAlgebra_isField π hn hπ).toField
  rcases Nat.lt_or_ge n 2 with hn1 | hn2
  · -- `n = 1`: the root field is `K` itself and `M = K`.
    have hn1' : n = 1 := by omega
    refine ⟨n, dvd_rfl, hn, ⟨?_⟩⟩
    have hL : Module.finrank K L = 1 := by
      rw [dvrRootFractionAlgebra_finrank π hn, hn1']
    haveI : FiniteDimensional K L := Module.finite_of_finrank_eq_succ hL
    have hinj : Function.Injective f := f.toRingHom.injective
    have hinj' : Function.Injective (f.toLinearMap : M →ₗ[K] L) := hinj
    haveI : FiniteDimensional K M :=
      Module.Finite.of_injective f.toLinearMap hinj'
    have hM : Module.finrank K M = 1 := by
      have hle : Module.finrank K M ≤ Module.finrank K L :=
        LinearMap.finrank_le_finrank_of_injective hinj'
      have hpos : 0 < Module.finrank K M := Module.finrank_pos
      omega
    have hbij : Function.Bijective f :=
      ⟨hinj, (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
        (f := f.toLinearMap) (hM.trans hL.symm)).mp hinj⟩
    exact AlgEquiv.ofBijective f hbij
  · obtain ⟨d, hdvd, hd, hfield⟩ :=
      dvrRootFraction_intermediate_eq_power_tame π hn2 hπ hunit f.fieldRange
    refine ⟨d, hdvd, hd, ?_⟩
    let toRange : M ≃ₐ[K] f.fieldRange := AlgEquiv.ofInjective f f.injective
    let identifyRange : f.fieldRange ≃ₐ[K]
        IntermediateField.adjoin K
          {(AdjoinRoot.root (dvrRootPoly (algebraMap A K π) n) ^ (n / d))} :=
      IntermediateField.equivOfEq hfield
    exact ⟨(toRange.trans identifyRange).trans
      (dvrRootFractionPowerEquiv π hn hd hdvd hπ).symm⟩

/-- **Stacks Tag `09EV`, clause (6), over an arbitrary fraction field of the DVR, tame case.**
If `M` is a field embedded over `K = Frac(B)` in `K(π^{1/n})`, with `B` a DVR and `n ≥ 1` a
unit in its residue field, then `M ≅ K(π^{1/d})` for a divisor `d` of `n`.

This is `exists_dvrRootFractionPowerEquiv_of_embedding_tame` transported from `FractionRing B`
to any field `K` with `IsFractionRing B K` (the proof of phase 1's
`exists_dvrRootFractionPowerEquiv_of_embedding_of_isFractionRing`, without `CharZero`). -/
@[stacks 09EV "clause (6), tame case, any characteristic; n = 1 added; arbitrary fraction field"]
theorem exists_dvrRootFractionPowerEquiv_of_embedding_of_isFractionRing_tame
    {B : Type u} [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    (K : Type u) [Field K] [Algebra B K] [IsFractionRing B K]
    {M : Type u} [Field M] [Algebra B M] [Algebra K M] [IsScalarTower B K M]
    (π : B) {n : ℕ} (hn : 1 ≤ n) (hπ : Irreducible π)
    (hunit : IsUnit ((n : ℕ) : ResidueField B))
    (f : M →ₐ[K] AdjoinRoot (dvrRootPoly (algebraMap B K π) n)) :
    ∃ d : ℕ, d ∣ n ∧ 1 ≤ d ∧
      Nonempty (M ≃ₐ[K] AdjoinRoot (dvrRootPoly (algebraMap B K π) d)) := by
  let K₀ := FractionRing B
  let e : K₀ ≃ₐ[B] K := FractionRing.algEquiv B K
  letI : Algebra K₀ M := ((algebraMap K M).comp e.toRingHom).toAlgebra
  haveI : IsScalarTower B K₀ M := IsScalarTower.of_algebraMap_eq fun b ↦ by
    change algebraMap B M b = algebraMap K M (e (algebraMap B K₀ b))
    rw [e.commutes, ← IsScalarTower.algebraMap_apply]
  let ψ := rootAlgebraFractionEquiv e π n
  let f₀ : M →ₐ[B] AdjoinRoot (dvrRootPoly (algebraMap B K₀ π) n) :=
    ψ.symm.toAlgHom.comp (f.restrictScalars B)
  let f₀' : M →ₐ[K₀] AdjoinRoot (dvrRootPoly (algebraMap B K₀ π) n) :=
    AlgHom.extendScalarsOfIsFractionRing (A := B) (K := K₀) f₀
  obtain ⟨d, hd, hd1, ⟨g⟩⟩ :=
    exists_dvrRootFractionPowerEquiv_of_embedding_tame π hn hπ hunit f₀'
  refine ⟨d, hd, hd1, ⟨?_⟩⟩
  let g' : M ≃ₐ[B] AdjoinRoot (dvrRootPoly (algebraMap B K π) d) :=
    (g.restrictScalars B).trans (rootAlgebraFractionEquiv e π d)
  exact AlgEquiv.extendScalarsOfIsFractionRing (A := B) (K := K) g'

#print axioms dvrRootFraction_intermediate_eq_power_tame
#print axioms exists_dvrRootFractionPowerEquiv_of_embedding_tame
#print axioms exists_dvrRootFractionPowerEquiv_of_embedding_of_isFractionRing_tame

end Pcf.Stacks
