module

public import Pcf.Stacks.Abhyankar.KummerFraction
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# Degrees of the power-generated subfields in Stacks Tag 0EXP

This file computes the degree of the candidate intermediate fields in Tag `0EXP`,
specialized to the Eisenstein root extension of Tag `09EV`.  It does not assert that
these are all of the intermediate fields.
-/

@[expose] public section

open Polynomial

universe u

namespace Pcf.Stacks

variable {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]

/-- If `d ∣ n`, the `(n / d)`-th power of the distinguished root has minimal polynomial
`X^d - π` over the fraction field of the DVR. -/
theorem dvrRootFraction_power_minpoly (π : A) {n d : ℕ} (hn : 1 ≤ n)
    (hd : 1 ≤ d) (hdiv : d ∣ n) (hπ : Irreducible π) :
    minpoly (FractionRing A)
      (AdjoinRoot.root (dvrRootPoly (algebraMap A (FractionRing A) π) n) ^ (n / d)) =
      dvrRootPoly (algebraMap A (FractionRing A) π) d := by
  letI : Field (AdjoinRoot (dvrRootPoly (algebraMap A (FractionRing A) π) n)) :=
    (dvrRootFractionAlgebra_isField π hn hπ).toField
  have hpow :
      (AdjoinRoot.root (dvrRootPoly (algebraMap A (FractionRing A) π) n) ^ (n / d)) ^ d =
        algebraMap (FractionRing A)
          (AdjoinRoot (dvrRootPoly (algebraMap A (FractionRing A) π) n))
          (algebraMap A (FractionRing A) π) := by
    rw [← pow_mul, Nat.div_mul_cancel hdiv]
    exact dvrRoot_pow_eq (algebraMap A (FractionRing A) π) n
  apply (minpoly.eq_of_irreducible_of_monic
    (dvrRootFractionPoly_irreducible π hd hπ) ?_
    (dvrRootPoly_monic _ hd)).symm
  change (aeval
      (AdjoinRoot.root (dvrRootPoly (algebraMap A (FractionRing A) π) n) ^ (n / d))
      ((X : (FractionRing A)[X]) ^ d - C (algebraMap A (FractionRing A) π))) = 0
  rw [aeval_sub, aeval_X_pow, aeval_C]
  exact sub_eq_zero.mpr hpow

/-- The candidate subfield generated by the `(n / d)`-th power has degree `d` over
`Frac(A)`.  This is the degree computation in the first sentence of Tag `0EXP`. -/
theorem dvrRootFraction_power_adjoin_finrank (π : A) {n d : ℕ} (hn : 1 ≤ n)
    (hd : 1 ≤ d) (hdiv : d ∣ n) (hπ : Irreducible π) :
    letI : Field (AdjoinRoot (dvrRootPoly (algebraMap A (FractionRing A) π) n)) :=
      (dvrRootFractionAlgebra_isField π hn hπ).toField
    Module.finrank (FractionRing A)
      (IntermediateField.adjoin (FractionRing A)
        {AdjoinRoot.root (dvrRootPoly (algebraMap A (FractionRing A) π) n) ^ (n / d)}) = d := by
  letI : Field (AdjoinRoot (dvrRootPoly (algebraMap A (FractionRing A) π) n)) :=
    (dvrRootFractionAlgebra_isField π hn hπ).toField
  let β := AdjoinRoot.root (dvrRootPoly (algebraMap A (FractionRing A) π) n) ^ (n / d)
  have hmin : minpoly (FractionRing A) β =
      dvrRootPoly (algebraMap A (FractionRing A) π) d :=
    dvrRootFraction_power_minpoly π hn hd hdiv hπ
  have hβ : IsIntegral (FractionRing A) β := by
    apply IsIntegral.of_pow hd
    have hpow : β ^ d =
        algebraMap (FractionRing A)
          (AdjoinRoot (dvrRootPoly (algebraMap A (FractionRing A) π) n))
          (algebraMap A (FractionRing A) π) := by
      dsimp only [β]
      rw [← pow_mul, Nat.div_mul_cancel hdiv]
      exact dvrRoot_pow_eq (algebraMap A (FractionRing A) π) n
    rw [hpow]
    exact isIntegral_algebraMap
  rw [IntermediateField.adjoin.finrank hβ, hmin]
  simp [dvrRootPoly]

/-- The degree of the full root field over the power-generated candidate is `n / d`. -/
theorem dvrRootFraction_power_relative_finrank (π : A) {n d : ℕ} (hn : 1 ≤ n)
    (hd : 1 ≤ d) (hdiv : d ∣ n) (hπ : Irreducible π) :
    letI : Field (AdjoinRoot (dvrRootPoly (algebraMap A (FractionRing A) π) n)) :=
      (dvrRootFractionAlgebra_isField π hn hπ).toField
    let L := AdjoinRoot (dvrRootPoly (algebraMap A (FractionRing A) π) n)
    let M := IntermediateField.adjoin (FractionRing A)
      {AdjoinRoot.root (dvrRootPoly (algebraMap A (FractionRing A) π) n) ^ (n / d)}
    Module.finrank M L = n / d := by
  letI : Field (AdjoinRoot (dvrRootPoly (algebraMap A (FractionRing A) π) n)) :=
    (dvrRootFractionAlgebra_isField π hn hπ).toField
  let L := AdjoinRoot (dvrRootPoly (algebraMap A (FractionRing A) π) n)
  let M := IntermediateField.adjoin (FractionRing A)
    {AdjoinRoot.root (dvrRootPoly (algebraMap A (FractionRing A) π) n) ^ (n / d)}
  have hM : Module.finrank (FractionRing A) M = d :=
    dvrRootFraction_power_adjoin_finrank π hn hd hdiv hπ
  have hL : Module.finrank (FractionRing A) L = n :=
    dvrRootFractionAlgebra_finrank π hn
  dsimp only
  rw [← Module.finrank_div_finrank_cancel_left (FractionRing A) M L
    (show Module.finrank (FractionRing A) M ≠ 0 by omega), hM, hL]

#print axioms dvrRootFraction_power_minpoly
#print axioms dvrRootFraction_power_adjoin_finrank
#print axioms dvrRootFraction_power_relative_finrank

end Pcf.Stacks
