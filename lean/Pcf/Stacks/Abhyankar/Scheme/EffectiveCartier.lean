module

public import Pcf.Stacks.Abhyankar.Scheme.Defs

/-!
# Effective Cartier divisors: basic API

API for `Pcf.Stacks.SchemeLevel.IsEffectiveCartier` (Stacks Definition 31.14.1, Tag `01WR`).
Mathlib at the pin has no effective Cartier divisors (no declaration mentions "Cartier"); the
definition uses Mathlib's ideal sheaves `Scheme.IdealSheafData`.

* `ideal_eq_top_of_disjoint`: on an affine open disjoint from the support, the ideal is the unit
  ideal;
* `isEffectiveCartier_iff`: Stacks Lemma 31.14.2 (Tag `01WS`), (1) ⇔ (2): it suffices to have
  local nonzerodivisor equations at the points of `D`.
-/

@[expose] public section

universe u

open AlgebraicGeometry CategoryTheory

namespace Pcf.Stacks.SchemeLevel

variable {X : Scheme.{u}}

/-- On an affine open disjoint from the support of an ideal sheaf, the ideal is the unit ideal. -/
theorem ideal_eq_top_of_disjoint (D : X.IdealSheafData) (U : X.affineOpens)
    (hU : ∀ x ∈ U.1, x ∉ D.support) : D.ideal U = ⊤ := by
  rw [← PrimeSpectrum.zeroLocus_empty_iff_eq_top]
  refine Set.eq_empty_of_forall_notMem fun p hp ↦ ?_
  have hpU : U.2.fromSpec p ∈ U.1 := by
    rw [← SetLike.mem_coe, ← U.2.range_fromSpec]; exact Set.mem_range_self p
  refine hU _ hpU ((Scheme.IdealSheafData.mem_support_iff_of_mem hpU).mpr ?_)
  rw [← U.2.fromSpec_preimage_zeroLocus] at hp
  exact hp

/-- **Stacks Lemma 31.14.2 (Tag `01WS`), (1) ⇔ (2).**  An ideal sheaf defines an effective
Cartier divisor iff every point of its support has an affine open neighbourhood on which the
ideal is generated by one nonzerodivisor. -/
@[stacks 01WS "(1) ⇔ (2), with `IsEffectiveCartier` the local form of (1)"]
theorem isEffectiveCartier_iff (D : X.IdealSheafData) :
    IsEffectiveCartier D ↔ ∀ x ∈ D.support, ∃ U : X.affineOpens, x ∈ U.1 ∧
      ∃ a : Γ(X, U), a ∈ nonZeroDivisors Γ(X, U) ∧ D.ideal U = Ideal.span {a} := by
  refine ⟨fun h x _ ↦ h x, fun h x ↦ ?_⟩
  by_cases hx : x ∈ D.support
  · exact h x hx
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUD⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
    (show x ∈ (D.support.compl : Set X) from hx) D.support.compl.2
  refine ⟨⟨U, hU⟩, hxU, 1, one_mem _, ?_⟩
  rw [Ideal.span_singleton_one]
  exact ideal_eq_top_of_disjoint D ⟨U, hU⟩ fun y hy ↦ hUD hy

#print axioms ideal_eq_top_of_disjoint
#print axioms isEffectiveCartier_iff

end Pcf.Stacks.SchemeLevel
