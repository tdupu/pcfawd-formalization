module

public import Pcf.Stacks.Abhyankar.Scheme.NormalizationChart
public import Pcf.Stacks.Abhyankar.Scheme.ChartData

/-!
# The reduced preimage `π⁻¹(D)_red` of an effective Cartier divisor

For `π : Y' → X` and an ideal sheaf `D` on `X`, `D' = π⁻¹(D)_red` is the ideal sheaf
`(D.comap π).radical` (Mathlib's `IdealSheafData.comap` is the scheme-theoretic inverse image
and `radical` the reduction).  On an affine open `W ⊂ π⁻¹V`, where `D ∩ V = V(a)`, its ideal is
`√(a)` (`ideal_radical_comap_eq`).  From this:

* `isEffectiveCartier_radical_comap`: if for every chart `V` and every point of `π⁻¹V ∩ π⁻¹D`
  the ideal `√(a)` becomes principal, generated by a nonzerodivisor, on a basic open around the
  point, then `D'` is an effective Cartier divisor;
* `isRegularScheme_radical_comap`: if `Γ(π⁻¹V)/√(a)` is a regular ring on charts covering `X`,
  then `D'` is a regular scheme.

These are the local-to-global steps for clauses (2) and (3) of Stacks Tag `0EYH`.
-/

@[expose] public section

universe u

open AlgebraicGeometry CategoryTheory Limits

namespace Pcf.Stacks.SchemeLevel

variable {X Y : Scheme.{u}}

/-- On an affine open `W ⊂ π⁻¹V`, where `D` is cut out by `a` on `V`, the ideal of
`π⁻¹(D)_red` is `√(a)`. -/
theorem ideal_radical_comap_eq (π : Y ⟶ X) {D : X.IdealSheafData} {V : X.affineOpens}
    {a : Γ(X, V)} (hDa : D.ideal V = Ideal.span {a}) (W : Y.affineOpens)
    (hW : (W : Y.Opens) ≤ π ⁻¹ᵁ V.1) :
    ((D.comap π).radical).ideal W =
      (Ideal.span {Y.presheaf.map (homOfLE hW).op (π.app V.1 a)}).radical := by
  rw [← Scheme.IdealSheafData.vanishingIdeal_support, Scheme.IdealSheafData.support_comap]
  refine ideal_vanishingIdeal_eq_radical _ W _ fun y hy ↦ ?_
  have hyV : π y ∈ V.1 := hW hy
  rw [Scheme.basicOpen_res, TopologicalSpace.Opens.mem_inf, ← Scheme.preimage_basicOpen]
  simp only [hy, true_and]
  exact mem_support_iff_of_ideal_eq hDa hyV

/-- **Effective Cartier divisor criterion for `π⁻¹(D)_red`.** -/
theorem isEffectiveCartier_radical_comap (π : Y ⟶ X) [IsAffineHom π] {D : X.IdealSheafData}
    (hD : IsEffectiveCartier D)
    (h : ∀ (V : X.affineOpens) (a : Γ(X, V)), D.ideal V = Ideal.span {a} →
      ∀ Q : PrimeSpectrum Γ(Y, π ⁻¹ᵁ V.1), π.app V.1 a ∈ Q.asIdeal →
        ∃ g : Γ(Y, π ⁻¹ᵁ V.1), g ∉ Q.asIdeal ∧
          ∃ t : Γ(Y, Y.basicOpen g), t ∈ nonZeroDivisors Γ(Y, Y.basicOpen g) ∧
            (Ideal.span {Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op (π.app V.1 a)}).radical =
              Ideal.span {t}) :
    IsEffectiveCartier (D.comap π).radical := by
  intro y
  obtain ⟨V, hyV, a, -, hDa⟩ := hD (π y)
  have hpre : IsAffineOpen (π ⁻¹ᵁ V.1) := V.2.preimage π
  let Q := hpre.primeIdealOf ⟨y, hyV⟩
  by_cases hyD : π.app V.1 a ∈ Q.asIdeal
  · obtain ⟨g, hgQ, t, ht, hrad⟩ := h V a hDa Q hyD
    let W : Y.affineOpens := ⟨Y.basicOpen g, hpre.basicOpen g⟩
    have hyW : y ∈ W.1 := by
      have := (mem_basicOpen_iff_notMem_primeIdealOf hpre g ⟨y, hyV⟩).mpr hgQ
      exact this
    refine ⟨W, hyW, t, ht, ?_⟩
    rw [ideal_radical_comap_eq π hDa W ((Y.basicOpen_le g)), ← hrad]
  · let s := π.app V.1 a
    let W : Y.affineOpens := ⟨Y.basicOpen s, hpre.basicOpen s⟩
    have hyW : y ∈ W.1 := (mem_basicOpen_iff_notMem_primeIdealOf hpre s ⟨y, hyV⟩).mpr hyD
    refine ⟨W, hyW, 1, one_mem _, ?_⟩
    rw [ideal_radical_comap_eq π hDa W (Y.basicOpen_le s), Ideal.span_singleton_one,
      Ideal.span_singleton_eq_top.mpr ?_, Ideal.radical_top]
    exact Y.toRingedSpace.isUnit_res_basicOpen s

/-- **Regularity criterion for `π⁻¹(D)_red`.** -/
theorem isRegularScheme_radical_comap (π : Y ⟶ X) [IsAffineHom π] {D : X.IdealSheafData}
    (hD : IsEffectiveCartier D)
    (h : ∀ (V : X.affineOpens) (a : Γ(X, V)), D.ideal V = Ideal.span {a} →
      IsRegularRing (Γ(Y, π ⁻¹ᵁ V.1) ⧸ (Ideal.span {π.app V.1 a}).radical)) :
    IsRegularScheme ((D.comap π).radical).subscheme := by
  intro z
  obtain ⟨V, hyV, a, -, hDa⟩ := hD (π ((D.comap π).radical.subschemeι z))
  let W : Y.affineOpens := ⟨π ⁻¹ᵁ V.1, V.2.preimage π⟩
  refine ⟨⟨(D.comap π).radical.subschemeι ⁻¹ᵁ W.1, W.2.preimage _⟩, hyV, ?_⟩
  have hI := ideal_radical_comap_eq π hDa W le_rfl
  have := h V a hDa
  have e := ((D.comap π).radical.subschemeObjIso W).commRingCatIsoToRingEquiv
  have hid : Y.presheaf.map (homOfLE (le_refl (W : Y.Opens))).op (π.app V.1 a) =
      π.app V.1 a := by simp
  rw [hid] at hI
  exact IsRegularRing.of_ringEquiv (e.trans (Ideal.quotEquivOfEq hI)).symm

end Pcf.Stacks.SchemeLevel
