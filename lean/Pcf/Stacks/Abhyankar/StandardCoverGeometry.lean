import Pcf.Stacks.Abhyankar.StandardCoverNormalization
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Geometric properties of finite unions of standard root covers

This file packages the remaining elementary geometry in Stacks Project Tag `0EYH` for a
finite disjoint union of standard models.  The coordinate ring is finite free.  The
reduced inverse image of the divisor is the product of the root divisors, and its quotient
ring is regular.

The finite-product lemmas at the start fill small API gaps in Mathlib: radicals commute
with finite products, quotients by product ideals are products of quotients, and a finite
product of regular rings is regular.
-/

universe u

open Polynomial

namespace Pcf.Stacks

/-- The radical of a product ideal in a finite product is the product of the radicals. -/
theorem radical_pi_of_finite {ι : Type} [Finite ι]
    {A : ι → Type u} [∀ i, CommRing (A i)] (I : ∀ i, Ideal (A i)) :
    (Ideal.pi I).radical = Ideal.pi (fun i => (I i).radical) := by
  classical
  apply le_antisymm
  · intro x hx i
    obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hx
    exact Ideal.mem_radical_iff.mpr ⟨n, hn i⟩
  · intro x hx
    have hx' : ∀ i, x i ∈ (I i).radical := hx
    choose n hn using fun i => Ideal.mem_radical_iff.mp (hx' i)
    let _ := Fintype.ofFinite ι
    refine Ideal.mem_radical_iff.mpr ⟨∑ i, n i, ?_⟩
    intro i
    have hle : n i ≤ ∑ j, n j :=
      Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
    obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le hle
    rw [Pi.pow_apply, hk, pow_add]
    exact (I i).mul_mem_right _ (hn i)

/-- A quotient of a finite product by a product ideal is the product of the component
quotients. -/
noncomputable def quotientPiRingEquiv {ι : Type} [Finite ι]
    (A : ι → Type u) [∀ i, CommRing (A i)] (I : ∀ i, Ideal (A i)) :
    ((∀ i, A i) ⧸ Ideal.pi I) ≃+* (∀ i, A i ⧸ I i) := by
  classical
  let f : (∀ i, A i) →+* (∀ i, A i ⧸ I i) :=
    RingHom.pi fun i => (Ideal.Quotient.mk (I i)).comp (Pi.evalRingHom A i)
  let g : ((∀ i, A i) ⧸ Ideal.pi I) →+* (∀ i, A i ⧸ I i) :=
    Ideal.Quotient.lift (Ideal.pi I) f fun x hx => by
      ext i
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (hx i)
  apply RingEquiv.ofBijective g
  constructor
  · intro x y hxy
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
    apply Ideal.Quotient.eq.mpr
    intro i
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change g (Ideal.Quotient.mk (Ideal.pi I) x) i -
      g (Ideal.Quotient.mk (Ideal.pi I) y) i = 0
    rw [hxy, sub_self]
  · intro x
    choose y hy using fun i => Ideal.Quotient.mk_surjective (x i)
    refine ⟨Ideal.Quotient.mk (Ideal.pi I) (fun i => y i), ?_⟩
    ext i
    exact hy i

/-- A finite product of regular rings is regular. -/
theorem isRegularRing_pi_of_finite {ι : Type} [Finite ι]
    (A : ι → Type u) [∀ i, CommRing (A i)] [∀ i, IsRegularRing (A i)] :
    IsRegularRing (∀ i, A i) := by
  let _ := Fintype.ofFinite ι
  rw [isRegularRing_iff]
  intro p hp
  let P : PrimeSpectrum (∀ i, A i) := ⟨p, hp⟩
  obtain ⟨i, q, hq⟩ := PrimeSpectrum.exists_comap_evalRingHom_eq P
  have hideal : q.asIdeal.comap (Pi.evalRingHom A i) = p :=
    congrArg PrimeSpectrum.asIdeal hq
  subst p
  let E : Localization.AtPrime (q.asIdeal.comap (Pi.evalRingHom A i)) ≃+*
      Localization.AtPrime q.asIdeal :=
    RingEquiv.ofBijective (Localization.AtPrime.mapPiEvalRingHom q.asIdeal)
      (Localization.AtPrime.mapPiEvalRingHom_bijective q.asIdeal)
  exact IsRegularLocalRing.of_ringEquiv E.symm

/-- The reduced inverse-image ideal for a finite disjoint union of standard covers: on
each component it is generated by the distinguished root. -/
noncomputable def standardCoversReducedDivisorIdeal
    {R : Type u} [CommRing R] {ι : Type}
    (u : ι → Rˣ) (a : R) (e : ι → ℕ) :
    Ideal (∀ i, AdjoinRoot (Pcf.LocalModel.localPoly (u i) a (e i))) :=
  Ideal.pi fun i => Ideal.span
    ({AdjoinRoot.root (Pcf.LocalModel.localPoly (u i) a (e i))} :
      Set (AdjoinRoot (Pcf.LocalModel.localPoly (u i) a (e i))))

/-- On a finite union of standard covers, the ideal generated by the roots is exactly the
radical of the pullback of the base divisor. -/
theorem standardCovers_radical_span_algebraMap_eq_reducedDivisorIdeal
    {R : Type u} [CommRing R] {ι : Type} [Finite ι]
    (u : ι → Rˣ) (a : R) (e : ι → ℕ) (he : ∀ i, 1 ≤ e i)
    [IsReduced (R ⧸ Ideal.span ({a} : Set R))] :
    (Ideal.span ({algebraMap R
      (∀ i, AdjoinRoot (Pcf.LocalModel.localPoly (u i) a (e i))) a} :
        Set (∀ i, AdjoinRoot (Pcf.LocalModel.localPoly (u i) a (e i))))).radical =
      standardCoversReducedDivisorIdeal u a e := by
  let A := fun i => AdjoinRoot (Pcf.LocalModel.localPoly (u i) a (e i))
  let I : ∀ i, Ideal (A i) := fun i => Ideal.span
    ({AdjoinRoot.root (Pcf.LocalModel.localPoly (u i) a (e i))} : Set (A i))
  have hspan : Ideal.span ({algebraMap R (∀ i, A i) a} : Set (∀ i, A i)) =
      Ideal.pi (fun i => Ideal.span ({algebraMap R (A i) a} : Set (A i))) := by
    rw [← Ideal.pi_span]
    rfl
  rw [hspan, radical_pi_of_finite]
  apply congrArg Ideal.pi
  funext i
  exact Pcf.LocalModel.radical_span_algebraMap_eq_span_root (u i) a (he i)

/-- A finite union of standard root covers is finite over the base. -/
theorem standardCovers_finite
    {R : Type u} [CommRing R] {ι : Type} [Finite ι]
    (u : ι → Rˣ) (a : R) (e : ι → ℕ) (he : ∀ i, 1 ≤ e i) :
    Module.Finite R (∀ i, AdjoinRoot (Pcf.LocalModel.localPoly (u i) a (e i))) := by
  let _ (i : ι) : Module.Finite R
      (AdjoinRoot (Pcf.LocalModel.localPoly (u i) a (e i))) :=
    standardCover_finite (u i) a (he i)
  exact Module.Finite.pi

/-- A finite union of standard root covers is free over the base, hence finite locally
free together with `standardCovers_finite`. -/
theorem standardCovers_free
    {R : Type u} [CommRing R] {ι : Type} [Finite ι]
    (u : ι → Rˣ) (a : R) (e : ι → ℕ) (he : ∀ i, 1 ≤ e i) :
    Module.Free R (∀ i, AdjoinRoot (Pcf.LocalModel.localPoly (u i) a (e i))) := by
  let _ (i : ι) : Module.Free R
      (AdjoinRoot (Pcf.LocalModel.localPoly (u i) a (e i))) :=
    standardCover_free (u i) a (he i)
  exact Module.Free.pi R _

/-- The reduced divisor in a finite union of standard covers is a finite product of
copies of the base divisor. -/
noncomputable def standardCoversReducedDivisorQuotientEquiv
    {R : Type u} [CommRing R] {ι : Type} [Finite ι]
    (u : ι → Rˣ) (a : R) (e : ι → ℕ) (he : ∀ i, 1 ≤ e i) :
    ((∀ i, AdjoinRoot (Pcf.LocalModel.localPoly (u i) a (e i))) ⧸
        standardCoversReducedDivisorIdeal u a e) ≃+*
      (∀ _i : ι, R ⧸ Ideal.span ({a} : Set R)) :=
  (quotientPiRingEquiv
    (fun i => AdjoinRoot (Pcf.LocalModel.localPoly (u i) a (e i)))
    (fun i => Ideal.span
      ({AdjoinRoot.root (Pcf.LocalModel.localPoly (u i) a (e i))} :
        Set (AdjoinRoot (Pcf.LocalModel.localPoly (u i) a (e i)))))).trans
    (RingEquiv.piCongrRight fun i =>
      (Pcf.LocalModel.quotientRootEquiv (u i) a (he i)).toRingEquiv)

/-- The reduced inverse image of a regular divisor in a finite union of standard covers
is regular. -/
theorem standardCoversReducedDivisor_isRegularRing
    {R : Type u} [CommRing R] {ι : Type} [Finite ι]
    (u : ι → Rˣ) (a : R) (e : ι → ℕ) (he : ∀ i, 1 ≤ e i)
    [IsRegularRing (R ⧸ Ideal.span ({a} : Set R))] :
    IsRegularRing
      ((∀ i, AdjoinRoot (Pcf.LocalModel.localPoly (u i) a (e i))) ⧸
        standardCoversReducedDivisorIdeal u a e) := by
  let _ : IsRegularRing (∀ _i : ι, R ⧸ Ideal.span ({a} : Set R)) :=
    isRegularRing_pi_of_finite _
  exact IsRegularRing.of_ringEquiv
    (standardCoversReducedDivisorQuotientEquiv u a e he).symm

#print axioms radical_pi_of_finite
#print axioms quotientPiRingEquiv
#print axioms isRegularRing_pi_of_finite
#print axioms standardCovers_radical_span_algebraMap_eq_reducedDivisorIdeal
#print axioms standardCovers_finite
#print axioms standardCovers_free
#print axioms standardCoversReducedDivisorQuotientEquiv
#print axioms standardCoversReducedDivisor_isRegularRing

end Pcf.Stacks
