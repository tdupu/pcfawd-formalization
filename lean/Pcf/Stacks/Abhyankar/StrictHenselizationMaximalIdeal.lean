import Mathlib.RingTheory.Unramified.LocalRing
import Pcf.Stacks.Abhyankar.StrictHenselizationBase

/-!
# The maximal ideal of the strict local colimit

The maximal ideal of the localized pointed-etale colimit is generated by the maximal ideal of
the base.  An element of the colimit comes from an etale stage.  Localizing that stage at the
kernel of its geometric point gives a local essentially-finite-type unramified algebra, where the
claim is Mathlib's form of Stacks Tag `00UW`.  Ideal membership uses only one denominator, so it
descends again to an etale localization away from one element and hence to an object of the
pointed-etale diagram.
-/

universe u

namespace Pcf.Stacks.PointedEtaleNeighborhood

variable {R Ω : Type u} [CommRing R] [IsLocalRing R] [Field Ω]
  [Algebra R Ω] [Algebra (IsLocalRing.ResidueField R) Ω]
  [IsScalarTower R (IsLocalRing.ResidueField R) Ω]
  [IsSepClosure (IsLocalRing.ResidueField R) Ω]

omit [IsSepClosure (IsLocalRing.ResidueField R) Ω] in
/-- The geometric point of a pointed etale neighbourhood lies over the maximal ideal of the
base. -/
theorem point_ker_under (X : PointedEtaleNeighborhood R Ω) :
    (RingHom.ker X.point.toRingHom).under R = IsLocalRing.maximalIdeal R := by
  ext r
  rw [Ideal.mem_under, RingHom.mem_ker]
  change X.point (algebraMap R X r) = 0 ↔ r ∈ IsLocalRing.maximalIdeal R
  rw [X.point.commutes]
  rw [IsScalarTower.algebraMap_apply R (IsLocalRing.ResidueField R) Ω]
  rw [map_eq_zero_iff (algebraMap (IsLocalRing.ResidueField R) Ω)
    (RingHom.injective _)]
  exact IsLocalRing.residue_eq_zero_iff r

/-- The maximal ideal of the strict local colimit is the extension of the maximal ideal of the
base.  This is the maximal-ideal comparison used in Stacks Tag `06LN`. -/
theorem map_maximalIdeal_localColimit :
    (IsLocalRing.maximalIdeal R).map (algebraMap R (LocalColimit R Ω)) =
      IsLocalRing.maximalIdeal (LocalColimit R Ω) := by
  apply le_antisymm
  · exact map_le_maximalIdeal_localColimit (R := R) (Ω := Ω)
      (IsLocalRing.maximalIdeal R) le_rfl
  · intro a ha
    obtain ⟨X, x, rfl⟩ := exists_stage_of_localColimit_element (R := R) (Ω := Ω) a
    have hpointx : X.point x = 0 := by
      calc
        X.point x = residueFieldAlgEquiv (R := R) (Ω := Ω)
            (IsLocalRing.residue (LocalColimit R Ω)
              (toLocalColimitAlgHom (R := R) (Ω := Ω) X x)) :=
          (residueFieldAlgEquiv_residue_toLocalColimitAlgHom
            (R := R) (Ω := Ω) X x).symm
        _ = residueFieldAlgEquiv (R := R) (Ω := Ω) 0 := by
          congr 1
          exact (IsLocalRing.residue_eq_zero_iff _).mpr ha
        _ = 0 := map_zero _
    let Q : Ideal X := RingHom.ker X.point.toRingHom
    let _ : Q.IsPrime := by
      dsimp only [Q]
      exact RingHom.ker_isPrime _
    let L := Localization.AtPrime Q
    let _ : IsLocalRing L := IsLocalization.AtPrime.isLocalRing L Q
    let _ : IsLocalHom (algebraMap R L) := by
      apply ((IsLocalRing.local_hom_TFAE (algebraMap R L)).out 4 1).mp
      intro r hr
      rw [Ideal.mem_comap]
      rw [IsScalarTower.algebraMap_apply R X L,
        IsLocalization.AtPrime.to_map_mem_maximal_iff L Q]
      rw [← Ideal.mem_under, point_ker_under (R := R) (Ω := Ω) X]
      exact hr
    have hxL : algebraMap X L x ∈ IsLocalRing.maximalIdeal L := by
      rw [IsLocalization.AtPrime.to_map_mem_maximal_iff L Q]
      exact hpointx
    have hxL' : algebraMap X L x ∈
        (IsLocalRing.maximalIdeal R).map (algebraMap R L) := by
      rw [Algebra.FormallyUnramified.map_maximalIdeal (R := R) (S := L)]
      exact hxL
    have hxL'' : algebraMap X L x ∈
        ((IsLocalRing.maximalIdeal R).map (algebraMap R X)).map
          (algebraMap X L) := by
      rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq R X L]
      exact hxL'
    obtain ⟨s, hsQ, hsx⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff Q.primeCompl L
        ((IsLocalRing.maximalIdeal R).map (algebraMap R X)) x).mp hxL''
    have hpoints : X.point s ≠ 0 := by
      intro hs
      apply hsQ
      change X.point s = 0
      exact hs
    have hpointsUnit : IsUnit (X.point s) := isUnit_iff_ne_zero.mpr hpoints
    let S := Localization.Away s
    let pointS : S →ₐ[R] Ω :=
      IsLocalization.Away.liftAlgHom s (f := X.point) hpointsUnit
    let N := ofEtaleAlgebra S pointS
    let j : X ⟶ N := homToOfEtaleAlgebra S pointS
      (IsScalarTower.toAlgHom R X S) (by
        ext z
        simp [pointS])
    let E : N ≃ₐ[R] S := ofEtaleAlgebraEquiv S pointS
    let n : N := E.symm (algebraMap X S x)
    have hxS : algebraMap X S x ∈
        ((IsLocalRing.maximalIdeal R).map (algebraMap R X)).map
          (algebraMap X S) := by
      apply (IsLocalization.algebraMap_mem_map_algebraMap_iff
        (Submonoid.powers s) S
        ((IsLocalRing.maximalIdeal R).map (algebraMap R X)) x).mpr
      exact ⟨s, ⟨1, by simp⟩, hsx⟩
    have hn : n ∈ (IsLocalRing.maximalIdeal R).map (algebraMap R N) := by
      have hmap := Ideal.mem_map_of_mem E.symm.toRingEquiv.toRingHom hxS
      rw [Ideal.map_map, Ideal.map_map] at hmap
      have hcomp : (E.symm.toRingEquiv.toRingHom.comp (algebraMap X S)).comp
          (algebraMap R X) = algebraMap R N := by
        ext r
        change E.symm (algebraMap X S (algebraMap R X r)) = algebraMap R N r
        rw [← IsScalarTower.algebraMap_apply R X S]
        exact E.symm.commutes r
      rw [hcomp] at hmap
      exact hmap
    have hn' := Ideal.mem_map_of_mem
      (toLocalColimitAlgHom (R := R) (Ω := Ω) N).toRingHom hn
    have hvalue : toLocalColimitAlgHom (R := R) (Ω := Ω) N n =
        toLocalColimitAlgHom (R := R) (Ω := Ω) X x := by
      rw [← DFunLike.congr_fun
        (toLocalColimitAlgHom_naturality (R := R) (Ω := Ω) j) x]
      rfl
    rw [Ideal.map_map] at hn'
    have hcomp : (toLocalColimitAlgHom (R := R) (Ω := Ω) N).toRingHom.comp
        (algebraMap R N) = algebraMap R (LocalColimit R Ω) := by
      ext r
      exact (toLocalColimitAlgHom (R := R) (Ω := Ω) N).commutes r
    rw [hcomp] at hn'
    change toLocalColimitAlgHom (R := R) (Ω := Ω) N n ∈
      (IsLocalRing.maximalIdeal R).map (algebraMap R (LocalColimit R Ω)) at hn'
    rw [hvalue] at hn'
    exact hn'

end Pcf.Stacks.PointedEtaleNeighborhood
