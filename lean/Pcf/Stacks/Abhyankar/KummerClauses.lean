module

public import Pcf.Stacks.Abhyankar.KummerFractionEquiv
public import Mathlib.RingTheory.RamificationInertia.Basic

/-!
# The first five clauses of Stacks Tag 09EV

Stacks Tag `09EV` considers a DVR `A` with uniformizer `π`, puts
`K₁ = Frac(A)(π^(1/n))`, and records six facts about this extension.  This file packages
clauses (1)--(5): its degree, integral closure, DVR structure, ramification index, and total
ramification.  Clause (6), the classification of intermediate fields under the tame
hypothesis, is deliberately not claimed here.

The predicate `IsTotallyRamifiedAt` is the ring-theoretic content of Stacks Definition
`09E9` for an integral closure: there is a unique maximal ideal above the chosen maximal
ideal and its residue extension has degree one.
-/

@[expose] public section

open Polynomial IsLocalRing

universe u v

namespace Pcf.Stacks

/-- An integral extension ring is totally ramified at `p` when it has a unique maximal
ideal, that ideal lies over `p`, and the corresponding residue extension has degree one.

In applications `S` is the integral closure of `R` in a finite field extension.  This is
the algebraic content of Stacks Definition `09E9`, clause (3), without bundling the
integral-closure hypothesis into the predicate. -/
def IsTotallyRamifiedAt (R : Type u) (S : Type v) [CommRing R] [CommRing S]
    [Algebra R S] (p : Ideal R) : Prop :=
  ∃ q : Ideal S,
    q.IsMaximal ∧ q.LiesOver p ∧
      (∀ Q : Ideal S, Q.IsMaximal → Q = q) ∧ q.inertiaDeg R = 1

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]

/-- If the residue algebra map at maximal ideals is bijective, then the inertia degree is
one.  This isolates the conversion from a trivial residue extension to Mathlib's
`Ideal.inertiaDeg`. -/
theorem inertiaDeg_eq_one_of_residue_algebraMap_bijective (p : Ideal R) (q : Ideal S)
    [p.IsMaximal] [q.IsMaximal] [q.LiesOver p]
    (h : Function.Bijective (algebraMap (R ⧸ p) (S ⧸ q))) :
    q.inertiaDeg R = 1 := by
  rw [Ideal.inertiaDeg_eq_of_isMaximal p q]
  let e : (R ⧸ p) ≃ₐ[R ⧸ p] (S ⧸ q) :=
    AlgEquiv.ofBijective (Algebra.ofId (R ⧸ p) (S ⧸ q)) h
  exact e.toLinearEquiv.finrank_eq.symm.trans (Module.finrank_self (R ⧸ p))

/-- An `R`-algebra equivalence between the two residue rings makes the canonical residue
algebra map bijective. -/
theorem residue_algebraMap_bijective_of_algEquiv (p : Ideal R) (q : Ideal S)
    [q.LiesOver p] (e : (S ⧸ q) ≃ₐ[R] (R ⧸ p)) :
    Function.Bijective (algebraMap (R ⧸ p) (S ⧸ q)) := by
  refine ⟨FaithfulSMul.algebraMap_injective (R ⧸ p) _, ?_⟩
  intro y
  obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (e y)
  refine ⟨Ideal.Quotient.mk p a, ?_⟩
  apply e.injective
  rw [Ideal.Quotient.algebraMap_mk_of_liesOver]
  change e (algebraMap R (S ⧸ q) a) = e y
  rw [e.commutes, Ideal.Quotient.algebraMap_eq]
  exact ha

variable {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]

theorem dvrRootIdeal_under (π : A) {n : ℕ} (hn : 1 ≤ n)
    (hπ : Irreducible π) :
    (Ideal.span {AdjoinRoot.root (dvrRootPoly π n)}).under A = Ideal.span {π} := by
  letI : IsDomain (AdjoinRoot (dvrRootPoly π n)) := dvrRootAlgebra_isDomain π hn hπ
  letI : IsLocalRing (AdjoinRoot (dvrRootPoly π n)) :=
    dvrRootAlgebra_isLocalRing π hn hπ
  letI : IsLocalHom (algebraMap A (AdjoinRoot (dvrRootPoly π n))) :=
    AdjoinRoot.isLocalHom_of_monic_of_degree_pos (dvrRootPoly_monic π hn) <| by
      rw [← natDegree_pos_iff_degree_pos, dvrRootPoly, natDegree_X_pow_sub_C]
      exact hn
  rw [IsLocalRing.eq_maximalIdeal (dvrRootIdeal_isMaximal π hn hπ)]
  change (maximalIdeal (AdjoinRoot (dvrRootPoly π n))).comap
      (algebraMap A (AdjoinRoot (dvrRootPoly π n))) = Ideal.span {π}
  rw [IsLocalRing.maximalIdeal_comap, hπ.maximalIdeal_eq]

/-- The root ideal lies over the maximal ideal generated by the DVR uniformizer. -/
theorem dvrRootIdeal_liesOver (π : A) {n : ℕ} (hn : 1 ≤ n)
    (hπ : Irreducible π) :
    (Ideal.span {AdjoinRoot.root (dvrRootPoly π n)}).LiesOver (Ideal.span {π}) :=
  ⟨(dvrRootIdeal_under π hn hπ).symm⟩

/-- The root ideal has inertia degree one over the maximal ideal of the original DVR. -/
theorem dvrRootIdeal_inertiaDeg (π : A) {n : ℕ} (hn : 1 ≤ n)
    (hπ : Irreducible π) :
    (Ideal.span {AdjoinRoot.root (dvrRootPoly π n)}).inertiaDeg A = 1 := by
  let q : Ideal (AdjoinRoot (dvrRootPoly π n)) :=
    Ideal.span {AdjoinRoot.root (dvrRootPoly π n)}
  let p : Ideal A := Ideal.span {π}
  letI : p.IsMaximal := PrincipalIdealRing.isMaximal_of_irreducible hπ
  letI : q.IsMaximal := dvrRootIdeal_isMaximal π hn hπ
  letI : q.LiesOver p := dvrRootIdeal_liesOver π hn hπ
  apply inertiaDeg_eq_one_of_residue_algebraMap_bijective p q
  exact residue_algebraMap_bijective_of_algEquiv p q (dvrRootQuotientEquiv π hn)

/-- Clause (5) of Stacks Tag `09EV`: the standard root extension is totally ramified at
the maximal ideal generated by `π`. -/
theorem dvrRootExtension_isTotallyRamifiedAt (π : A) {n : ℕ} (hn : 1 ≤ n)
    (hπ : Irreducible π) :
    IsTotallyRamifiedAt A (AdjoinRoot (dvrRootPoly π n)) (Ideal.span {π}) := by
  let q : Ideal (AdjoinRoot (dvrRootPoly π n)) :=
    Ideal.span {AdjoinRoot.root (dvrRootPoly π n)}
  refine ⟨q, dvrRootIdeal_isMaximal π hn hπ, dvrRootIdeal_liesOver π hn hπ, ?_,
    dvrRootIdeal_inertiaDeg π hn hπ⟩
  intro Q hQ
  letI : IsDomain (AdjoinRoot (dvrRootPoly π n)) := dvrRootAlgebra_isDomain π hn hπ
  letI : IsLocalRing (AdjoinRoot (dvrRootPoly π n)) :=
    dvrRootAlgebra_isLocalRing π hn hπ
  calc
    Q = maximalIdeal (AdjoinRoot (dvrRootPoly π n)) := IsLocalRing.eq_maximalIdeal hQ
    _ = q := (IsLocalRing.eq_maximalIdeal (dvrRootIdeal_isMaximal π hn hπ)).symm

/-- Clauses (1)--(5) of Stacks Tag `09EV`, with `K₁` realized as the fraction field of
the integral root algebra and explicitly identified with the displayed field obtained by
adjoining an `n`th root of `π`.

The five conjuncts after the equivalence are, in tag order: degree `n`, integral closure,
DVR structure, ramification index `n`, and total ramification.  The theorem assumes the
tag's hypothesis `n ≥ 2`.  It makes no claim about clause (6). -/
theorem dvrRootExtension_clauses_one_to_five (π : A) {n : ℕ} (hn : 2 ≤ n)
    (hπ : Irreducible π) :
    let B := AdjoinRoot (dvrRootPoly π n)
    letI hB : IsDomain B := dvrRootAlgebra_isDomain π (by omega) hπ
    letI : Algebra (FractionRing A) (FractionRing B) :=
      dvrRootFractionRingAlgebra π (by omega) hπ
    ∃ e : FractionRing B ≃ₐ[FractionRing A]
        AdjoinRoot (dvrRootPoly (algebraMap A (FractionRing A) π) n),
      Module.finrank (FractionRing A) (FractionRing B) = n ∧
      IsIntegralClosure B A (FractionRing B) ∧
      @IsDiscreteValuationRing B _ hB ∧
      (Ideal.span {AdjoinRoot.root (dvrRootPoly π n)}).ramificationIdx A = n ∧
      IsTotallyRamifiedAt A B (Ideal.span {π}) := by
  let hn1 : 1 ≤ n := by omega
  let B := AdjoinRoot (dvrRootPoly π n)
  letI hB : IsDomain B := dvrRootAlgebra_isDomain π hn1 hπ
  letI : Algebra (FractionRing A) (FractionRing B) :=
    dvrRootFractionRingAlgebra π hn1 hπ
  refine ⟨dvrRootFractionEquiv π hn1 hπ, dvrRootFractionRing_finrank π hn1 hπ,
    dvrRootAlgebra_isIntegralClosure_fractionRing π hn1 hπ,
    dvrRootAlgebra_isDiscreteValuationRing π hn1 hπ,
    dvrRootIdeal_ramificationIdx π hn1 hπ,
    dvrRootExtension_isTotallyRamifiedAt π hn1 hπ⟩

#print axioms inertiaDeg_eq_one_of_residue_algebraMap_bijective
#print axioms residue_algebraMap_bijective_of_algEquiv
#print axioms dvrRootIdeal_under
#print axioms dvrRootIdeal_liesOver
#print axioms dvrRootIdeal_inertiaDeg
#print axioms dvrRootExtension_isTotallyRamifiedAt
#print axioms dvrRootExtension_clauses_one_to_five

end Pcf.Stacks
