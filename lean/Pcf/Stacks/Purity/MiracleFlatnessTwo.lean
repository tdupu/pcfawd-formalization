/-!
# The two-dimensional miracle-flatness relation

The dimension-two branch of Stacks Tag `0BMA` uses miracle flatness (Tag `00R4`).  At the
pinned Mathlib revision the required Cohen--Macaulay module theorem is not available.  This
file starts the elementary replacement: for an `M`-regular pair `x, y`, every relation
`x • a + y • b = 0` is the obvious Koszul relation.

This is a genuine algebraic consequence of module regularity.  It does not assume flatness or
the conclusion of the purity theorem.
-/

@[expose] public section

open RingTheory.Sequence TensorProduct
open scoped Pointwise

universe u v

namespace Pcf.Stacks

set_option linter.style.haveILetI false

variable {R : Type u} {M : Type v}
  [CommRing R] [AddCommGroup M] [Module R M]

/-- The first differential of the two-element Koszul complex on `x, y` with coefficients in
`M`, in the sign convention `c ↦ (-yc, xc)`. -/
def koszulPairLeft (x y : R) : M →ₗ[R] M × M where
  toFun c := (-(y • c), x • c)
  map_add' a b := by
    ext <;> dsimp <;> module
  map_smul' r c := by
    ext <;> dsimp <;> simp only [smul_neg, smul_smul] <;> module

/-- The second differential of the two-element Koszul complex on `x, y` with coefficients in
`M`, `(a, b) ↦ xa + yb`. -/
def koszulPairRight (x y : R) : M × M →ₗ[R] M where
  toFun p := x • p.1 + y • p.2
  map_add' a b := by simp only [Prod.fst_add, Prod.snd_add, smul_add]; abel
  map_smul' r c := by
    simp only [Prod.smul_fst, Prod.smul_snd, RingHom.id_apply, smul_add, smul_smul]
    module

/-- The canonical identification of the tensor product of a rank-two free module with two
copies of the coefficient module. -/
noncomputable def koszulPairTensorEquiv : (R × R) ⊗[R] M ≃ₗ[R] (M × M) :=
  TensorProduct.prodLeft R R R R M ≪≫ₗ
    (TensorProduct.lid R M).prodCongr (TensorProduct.lid R M)

@[simp]
theorem koszulPairTensorEquiv_tmul (a b : R) (m : M) :
    koszulPairTensorEquiv ((a, b) ⊗ₜ[R] m) = (a • m, b • m) := by
  rfl

/-- Tensoring the first Koszul differential and applying the canonical tensor identifications
gives the first Koszul differential on the coefficient module. -/
theorem koszulPairTensorEquiv_rTensor_left
    (x y : R) :
    (koszulPairTensorEquiv (R := R) (M := M)).toLinearMap.comp
        ((koszulPairLeft (M := R) x y).rTensor M) =
      (koszulPairLeft (M := M) x y).comp (TensorProduct.lid R M).toLinearMap := by
  apply TensorProduct.ext'
  intro r m
  change ((-(y * r)) • m, (x * r) • m) = (-(y • (r • m)), x • (r • m))
  ext <;> module

/-- Tensoring the second Koszul differential and applying the canonical tensor identifications
gives the second Koszul differential on the coefficient module. -/
theorem lid_rTensor_koszulPairRight
    (x y : R) :
    (TensorProduct.lid R M).toLinearMap.comp
        ((koszulPairRight (M := R) x y).rTensor M) =
      (koszulPairRight (M := M) x y).comp
        (koszulPairTensorEquiv (R := R) (M := M)).toLinearMap := by
  apply TensorProduct.ext'
  rintro ⟨a, b⟩ m
  change (x * a + y * b) • m = x • (a • m) + y • (b • m)
  module

/-- Exactness at the middle of the two-element Koszul complex for an `M`-regular pair.

If multiplication by `x` is injective on `M` and multiplication by `y` is injective on
`M / xM`, then every relation `x a + y b = 0` is generated by `(-y, x)`.  This is the
relation calculation used in the elementary dimension-two miracle-flatness argument. -/
theorem exists_koszul_relation_of_isSMulRegular_pair
    {x y : R} {a b : M}
    (hx : IsSMulRegular M x)
    (hy : IsSMulRegular (QuotSMulTop x M) y)
    (h : x • a + y • b = 0) :
    ∃ c : M, a = -(y • c) ∧ b = x • c := by
  let q : M →ₗ[R] QuotSMulTop x M := (x • (⊤ : Submodule R M)).mkQ
  have hxa : q (x • a) = 0 := by
    change (Submodule.mkQ (x • (⊤ : Submodule R M))) (x • a) = 0
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact Submodule.smul_mem_pointwise_smul a x ⊤ trivial
  have hyb : y • q b = 0 := by
    have hq := DFunLike.congr_arg q h
    simpa only [map_add, map_smul, map_zero, hxa, zero_add] using hq
  have hqb : q b = 0 := by
    apply hy
    simpa only [smul_zero] using hyb
  have hb_range : b ∈ LinearMap.range (LinearMap.lsmul R M x) := by
    rw [← (LinearMap.exact_lsmul_mkQ_smul_top M x).linearMap_ker_eq]
    exact hqb
  obtain ⟨c, hc⟩ := hb_range
  change x • c = b at hc
  refine ⟨c, ?_, ?_⟩
  · apply hx
    rw [← hc] at h
    calc
      x • a = -(y • (x • c)) := eq_neg_of_add_eq_zero_left h
      _ = x • (-(y • c)) := by simp only [smul_neg, smul_smul, mul_comm x y]
  · exact hc.symm

/-- The two-element Koszul complex is exact in the middle for an `M`-regular pair. -/
theorem exact_koszulPair_of_isSMulRegular
    {x y : R}
    (hx : IsSMulRegular M x)
    (hy : IsSMulRegular (QuotSMulTop x M) y) :
    Function.Exact (koszulPairLeft (M := M) x y) (koszulPairRight (M := M) x y) := by
  intro p
  constructor
  · intro hp
    obtain ⟨c, hc₁, hc₂⟩ :=
      exists_koszul_relation_of_isSMulRegular_pair hx hy hp
    refine ⟨c, ?_⟩
    ext
    · exact hc₁.symm
    · exact hc₂.symm
  · rintro ⟨c, rfl⟩
    change x • (-(y • c)) + y • (x • c) = 0
    simp only [smul_neg, smul_smul]
    rw [mul_comm x y, neg_add_cancel]

/-- After tensoring the rank-two Koszul complex with M, it remains exact in the middle when
x, y is an M-regular pair.  This is the tensor form needed to prove injectivity of the
maximal-ideal multiplication map in the dimension-two miracle-flatness argument. -/
theorem exact_rTensor_koszulPair_of_isSMulRegular
    {x y : R}
    (hx : IsSMulRegular M x)
    (hy : IsSMulRegular (QuotSMulTop x M) y) :
    Function.Exact
      ((koszulPairLeft (M := R) x y).rTensor M)
      ((koszulPairRight (M := R) x y).rTensor M) := by
  let e₁ := TensorProduct.lid R M
  let e₂ := koszulPairTensorEquiv (R := R) (M := M)
  have hcomm₁ := koszulPairTensorEquiv_rTensor_left (M := M) x y
  have hcomm₂ := lid_rTensor_koszulPairRight (M := M) x y
  have hexact := exact_koszulPair_of_isSMulRegular hx hy
  intro z
  constructor
  · intro hz
    have hz' : koszulPairRight (M := M) x y (e₂ z) = 0 := by
      calc
        koszulPairRight (M := M) x y (e₂ z) =
            e₁ (((koszulPairRight (M := R) x y).rTensor M) z) :=
          (LinearMap.congr_fun hcomm₂ z).symm
        _ = 0 := by rw [hz, map_zero]
    obtain ⟨c, hc⟩ := (hexact (e₂ z)).mp hz'
    refine ⟨e₁.symm c, ?_⟩
    apply e₂.injective
    calc
      e₂ (((koszulPairLeft (M := R) x y).rTensor M) (e₁.symm c)) =
          koszulPairLeft (M := M) x y (e₁ (e₁.symm c)) :=
        LinearMap.congr_fun hcomm₁ (e₁.symm c)
      _ = e₂ z := by rw [e₁.apply_symm_apply, hc]
  · rintro ⟨w, rfl⟩
    apply e₁.injective
    calc
      e₁ (((koszulPairRight (M := R) x y).rTensor M)
          (((koszulPairLeft (M := R) x y).rTensor M) w)) =
          koszulPairRight (M := M) x y
            (e₂ (((koszulPairLeft (M := R) x y).rTensor M) w)) :=
        LinearMap.congr_fun hcomm₂ _
      _ = koszulPairRight (M := M) x y (koszulPairLeft (M := M) x y (e₁ w)) := by
        exact congrArg (koszulPairRight (M := M) x y)
          (LinearMap.congr_fun hcomm₁ w)
      _ = 0 := (hexact (koszulPairLeft (M := M) x y (e₁ w))).mpr ⟨e₁ w, rfl⟩
      _ = e₁ 0 := (map_zero e₁).symm

/-- If `x, y` is a regular pair both on the base ring and on `M`, tensoring the inclusion
of the ideal `(x, y)` into the base ring with `M` is injective.

This is the precise two-generator ideal criterion needed by the elementary
dimension-two miracle-flatness argument.  The proof compares the two tensorized Koszul
complexes: exactness for the ring identifies the tensor product of the ideal as the
cokernel of the first differential, while exactness for `M` prevents the inclusion from
acquiring a kernel. -/
theorem range_koszulPairRight_subtype_rTensor_injective_of_isSMulRegular
    {x y : R}
    (hxR : IsSMulRegular R x)
    (hyR : IsSMulRegular (QuotSMulTop x R) y)
    (hxM : IsSMulRegular M x)
    (hyM : IsSMulRegular (QuotSMulTop x M) y) :
    Function.Injective
      ((LinearMap.range (koszulPairRight (M := R) x y)).subtype.rTensor M) := by
  let f := koszulPairLeft (M := R) x y
  let g₀ := koszulPairRight (M := R) x y
  let I := LinearMap.range g₀
  let g : R × R →ₗ[R] I := g₀.rangeRestrict
  let i : I →ₗ[R] R := I.subtype
  have hsurj : Function.Surjective g := g₀.surjective_rangeRestrict
  have hexactRing : Function.Exact f g := by
    rw [LinearMap.exact_iff, LinearMap.ker_rangeRestrict]
    exact LinearMap.exact_iff.mp (exact_koszulPair_of_isSMulRegular hxR hyR)
  have hexactRange : Function.Exact (f.rTensor M) (g.rTensor M) :=
    _root_.rTensor_exact M hexactRing hsurj
  have hexactModule : Function.Exact (f.rTensor M) (g₀.rTensor M) :=
    exact_rTensor_koszulPair_of_isSMulRegular hxM hyM
  apply LinearMap.ker_eq_bot.mp
  apply le_antisymm
  · intro z hz
    rw [Submodule.mem_bot]
    have hz' : (i.rTensor M) z = 0 := LinearMap.mem_ker.mp hz
    obtain ⟨w, hw⟩ := g.rTensor_surjective M hsurj z
    have hg₀w : (g₀.rTensor M) w = 0 := by
      calc
        (g₀.rTensor M) w = ((i.comp g).rTensor M) w := rfl
        _ = (i.rTensor M) ((g.rTensor M) w) :=
          LinearMap.rTensor_comp_apply M i g w
        _ = (i.rTensor M) z := by rw [hw]
        _ = 0 := hz'
    have hwRange : w ∈ LinearMap.range (f.rTensor M) := (hexactModule w).mp hg₀w
    have hgw : (g.rTensor M) w = 0 := (hexactRange w).mpr hwRange
    exact hw.symm.trans hgw
  · exact bot_le

/-- The range of the second two-element Koszul differential over the base ring is the
two-generated ideal `(x, y)`. -/
theorem range_koszulPairRight_eq_span (x y : R) :
    LinearMap.range (koszulPairRight (M := R) x y) =
      Ideal.span ({x, y} : Set R) := by
  ext z
  constructor
  · rintro ⟨⟨a, b⟩, rfl⟩
    rw [Ideal.mem_span_pair]
    exact ⟨a, b, by change a * x + b * y = x * a + y * b; ring⟩
  · intro hz
    rw [Ideal.mem_span_pair] at hz
    obtain ⟨a, b, hab⟩ := hz
    refine ⟨(a, b), ?_⟩
    change x * a + y * b = z
    calc
      x * a + y * b = a * x + b * y := by ring
      _ = z := hab

/-- A two-dimensional regular local ring admits a regular pair which generates its maximal
ideal.  The first element is chosen as a minimal generator; its quotient is a one-dimensional
regular local domain, whose principal maximal ideal supplies the second element. -/
theorem exists_regular_pair_span_maximalIdeal_of_dimension_two
    {A : Type u} [CommRing A] [hregA : IsRegularLocalRing A]
    (hdim : ringKrullDim A = 2) :
    ∃ x y : A,
      Ideal.span ({x, y} : Set A) = IsLocalRing.maximalIdeal A ∧
      IsSMulRegular A x ∧ IsSMulRegular (QuotSMulTop x A) y := by
  classical
  obtain ⟨x, hxm, hx2, hregQ, hdimQ⟩ :=
    exists_regularLocalRing_quotient_of_ringKrullDim_eq_succ A 1 (by
      convert hdim using 1
      norm_num)
  let I : Ideal A := Ideal.span ({x} : Set A)
  let Q := A ⧸ I
  letI : IsDomain A := Pcf.Vendor.isDomain_of_isRegularLocalRing A
  have hx : x ≠ 0 := by
    intro hx0
    apply hx2
    rw [hx0]
    exact Submodule.zero_mem _
  have hIne : I ≠ ⊤ := by
    apply ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal A).ne_top
    rw [Ideal.span_le, Set.singleton_subset_iff]
    exact hxm
  letI : Nontrivial Q := Ideal.Quotient.nontrivial_iff.mpr hIne
  letI : IsLocalHom (Ideal.Quotient.mk I) :=
    IsLocalHom.of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  letI : IsRegularLocalRing Q := hregQ
  letI : IsDomain Q := Pcf.Vendor.isDomain_of_isRegularLocalRing Q
  have hfinQ : Module.finrank (IsLocalRing.ResidueField Q)
      (IsLocalRing.CotangentSpace Q) = 1 := by
    have hreg := (IsRegularLocalRing.iff_finrank_cotangentSpace Q).mp inferInstance
    rw [hdimQ] at hreg
    exact_mod_cast hreg
  have hprincipal : (IsLocalRing.maximalIdeal Q).IsPrincipal :=
    IsLocalRing.finrank_cotangentSpace_le_one_iff.mp hfinQ.le
  obtain ⟨yb, hyb⟩ := hprincipal
  have hmaxQne : IsLocalRing.maximalIdeal Q ≠ ⊥ :=
    maximalIdeal_ne_bot_of_one_le_ringKrullDim Q (by rw [hdimQ]; exact le_rfl)
  have hyb0 : yb ≠ 0 := by
    intro hy0
    apply hmaxQne
    rw [hyb, hy0]
    simp
  obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective yb
  have hym : y ∈ IsLocalRing.maximalIdeal A := by
    rw [← IsLocalRing.maximalIdeal_comap (Ideal.Quotient.mk I)]
    change Ideal.Quotient.mk I y ∈ IsLocalRing.maximalIdeal Q
    rw [hy]
    rw [hyb]
    exact Ideal.mem_span_singleton_self yb
  have hspan : Ideal.span ({x, y} : Set A) = IsLocalRing.maximalIdeal A := by
    let q : A →+* Q := Ideal.Quotient.mk I
    haveI : IsLocalHom q :=
      IsLocalHom.of_surjective q Ideal.Quotient.mk_surjective
    have hmap : (Ideal.span ({x, y} : Set A)).map q = IsLocalRing.maximalIdeal Q := by
      rw [Ideal.map_span, Set.image_insert_eq, Set.image_singleton]
      change Ideal.span ({Ideal.Quotient.mk I x, Ideal.Quotient.mk I y} : Set Q) = _
      rw [show Ideal.Quotient.mk I x = 0 by
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self x), hy]
      rw [Ideal.span_pair_comm, Ideal.span_pair_zero]
      exact hyb.symm
    have hker : RingHom.ker q = I := Ideal.mk_ker
    have hker_le : RingHom.ker q ≤ Ideal.span ({x, y} : Set A) := by
      rw [hker, Ideal.span_le]
      intro z hz
      simp only [Set.mem_singleton_iff] at hz
      subst z
      exact Ideal.subset_span (Set.mem_insert x {y})
    calc
      Ideal.span ({x, y} : Set A) =
          ((Ideal.span ({x, y} : Set A)).map q).comap q := by
            rw [Ideal.comap_map_of_surjective q Ideal.Quotient.mk_surjective,
              ← RingHom.ker_eq_comap_bot, sup_eq_left.mpr hker_le]
      _ = (IsLocalRing.maximalIdeal Q).comap q := by rw [hmap]
      _ = IsLocalRing.maximalIdeal A := IsLocalRing.maximalIdeal_comap q
  have hxreg : IsSMulRegular A x := isSMulRegular_self_of_ne_zero A hx
  have hyQ : IsSMulRegular Q (Ideal.Quotient.mk I y) := by
    apply isSMulRegular_self_of_ne_zero Q
    rw [hy]
    exact hyb0
  have hyQR : IsSMulRegular Q y :=
    (isSMulRegular_algebraMap_iff Q).mp (by simpa [Q] using hyQ)
  let e : QuotSMulTop x A ≃ₗ[A] Q :=
    Submodule.quotEquivOfEq (x • (⊤ : Submodule A A)) I (by
      rw [← Submodule.ideal_span_singleton_smul]
      simp [I])
  have hyreg : IsSMulRegular (QuotSMulTop x A) y :=
    (e.isSMulRegular_congr y).mpr hyQR
  exact ⟨x, y, hspan, hxreg, hyreg⟩

/-- Elementary two-dimensional miracle flatness for a chosen regular parameter pair.

If the maximal ideal of a local ring is generated by `x, y`, that pair is regular on the
ring, and it is also regular on a finitely presented module `M`, then `M` is free.  This
packages the exact algebraic conclusion used in the two-dimensional branch of Stacks Tag
`0BMA`; geometric applications must still construct the parameter pair and prove its
regularity on the finite normal algebra. -/
theorem Module.free_of_regular_pair_generates_maximalIdeal
    [IsLocalRing R] [Module.FinitePresentation R M]
    {x y : R}
    (hspan : Ideal.span ({x, y} : Set R) = IsLocalRing.maximalIdeal R)
    (hxR : IsSMulRegular R x)
    (hyR : IsSMulRegular (QuotSMulTop x R) y)
    (hxM : IsSMulRegular M x)
    (hyM : IsSMulRegular (QuotSMulTop x M) y) :
    Module.Free R M := by
  apply Module.free_of_maximalIdeal_rTensor_injective
  rw [← hspan, ← range_koszulPairRight_eq_span x y]
  exact range_koszulPairRight_subtype_rTensor_injective_of_isSMulRegular hxR hyR hxM hyM

/-- A system of two parameters pulled back along an integral local map to a normal local domain
is a regular pair, provided the first parameter remains nonzero.

The point is the local `S₂` argument in the dimension-two case of Stacks Tag `0BMA`.  If the
second parameter lay in an associated prime of the first principal quotient, then that prime
would contain both parameters.  Integrality and incomparability force it to be the closed point,
contradicting normality and dimension at least two. -/
theorem isWeaklyRegular_pair_of_integral_local_normal
    {B : Type v} [CommRing B] [Algebra R B]
    [IsLocalRing R] [IsLocalRing B] [IsLocalHom (algebraMap R B)]
    [IsNoetherianRing B] [IsDomain B] [IsIntegrallyClosed B]
    [Algebra.IsIntegral R B]
    {x y : R}
    (hspan : Ideal.span ({x, y} : Set R) = IsLocalRing.maximalIdeal R)
    (hxB : algebraMap R B x ≠ 0)
    (hdimB : 2 ≤ ringKrullDim B) :
    IsWeaklyRegular B [x, y] := by
  let xb : B := algebraMap R B x
  let yb : B := algebraMap R B y
  have hxm : x ∈ IsLocalRing.maximalIdeal R := by
    rw [← hspan]
    exact Ideal.subset_span (Set.mem_insert x {y})
  have hxbm : xb ∈ IsLocalRing.maximalIdeal B :=
    map_nonunit (algebraMap R B) x hxm
  have hxb : IsSMulRegular B xb := isSMulRegular_self_of_ne_zero B hxB
  have hclosed : IsLocalRing.maximalIdeal B ∉
      associatedPrimes B (QuotSMulTop xb B) :=
    principalQuotientsAvoidClosedPoint_of_two_le_ringKrullDim B hdimB xb hxbm hxB
  have hyb : IsSMulRegular (QuotSMulTop xb B) yb := by
    by_contra hyb
    have hyUnion : yb ∈
        ⋃ p ∈ associatedPrimes B (QuotSMulTop xb B), (p : Set B) := by
      rw [biUnion_associatedPrimes_eq_compl_regular B (QuotSMulTop xb B)]
      change ¬IsSMulRegular (QuotSMulTop xb B) yb
      exact hyb
    simp only [Set.mem_iUnion] at hyUnion
    obtain ⟨p, hpAss, hyp⟩ := hyUnion
    have hpPrime : p.IsPrime := IsAssociatedPrime.isPrime hpAss
    have hxp : xb ∈ p := by
      apply IsAssociatedPrime.annihilator_le hpAss
      rw [Submodule.annihilator_top]
      exact QuotSMulTop.mem_annihilator B xb
    have hpUnderPrime : (p.comap (algebraMap R B)).IsPrime := hpPrime.comap _
    have hcomap : p.comap (algebraMap R B) = IsLocalRing.maximalIdeal R := by
      apply le_antisymm
      · exact IsLocalRing.le_maximalIdeal hpUnderPrime.ne_top'
      · rw [← hspan, Ideal.span_le]
        intro z hz
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
        rcases hz with (rfl | rfl)
        · exact hxp
        · exact hyp
    have hp_le : p ≤ IsLocalRing.maximalIdeal B :=
      IsLocalRing.le_maximalIdeal hpPrime.ne_top'
    have hp_eq : p = IsLocalRing.maximalIdeal B := by
      apply le_antisymm hp_le
      by_contra hnot
      have hp_ne : p ≠ IsLocalRing.maximalIdeal B := by
        intro hp
        exact hnot (hp ▸ le_rfl)
      have hp_lt : p < IsLocalRing.maximalIdeal B := lt_of_le_of_ne hp_le hp_ne
      have hunder_lt := Ideal.IsIntegral.under_lt_under (R := R) hp_lt
      rw [Ideal.under_def, Ideal.under_def, hcomap,
        IsLocalRing.maximalIdeal_comap (algebraMap R B)] at hunder_lt
      exact (lt_irrefl _ hunder_lt)
    exact hclosed (hp_eq ▸ hpAss)
  have hweakB : IsWeaklyRegular B [xb, yb] :=
    IsWeaklyRegular.cons hxb
      (IsWeaklyRegular.cons hyb (IsWeaklyRegular.nil B _))
  rw [← isWeaklyRegular_map_algebraMap_iff (S := B) (M := B) [x, y]]
  simpa [xb, yb] using hweakB

/-- The dimension-two finite normal local case of miracle flatness.

This is the flatness/freeness conclusion used in the dimension-two branch of Stacks Tag `0BMA`:
an integral local finite-presentation algebra which is a normal local domain of dimension at
least two is free once a regular parameter pair on the base generates the maximal ideal and the
first parameter remains nonzero upstairs. -/
theorem Module.free_of_finitePresentation_integral_local_normal_dimension_two
    {B : Type v} [CommRing B] [Algebra R B]
    [IsLocalRing R] [IsLocalRing B] [IsLocalHom (algebraMap R B)]
    [IsNoetherianRing B] [IsDomain B] [IsIntegrallyClosed B]
    [Algebra.IsIntegral R B] [Module.FinitePresentation R B]
    {x y : R}
    (hspan : Ideal.span ({x, y} : Set R) = IsLocalRing.maximalIdeal R)
    (hxR : IsSMulRegular R x)
    (hyR : IsSMulRegular (QuotSMulTop x R) y)
    (hxB : algebraMap R B x ≠ 0)
    (hdimB : 2 ≤ ringKrullDim B) :
    Module.Free R B := by
  have hweak := isWeaklyRegular_pair_of_integral_local_normal hspan hxB hdimB
  have hpair := (isWeaklyRegular_cons_iff B x [y]).mp hweak
  have hyB := ((isWeaklyRegular_cons_iff (QuotSMulTop x B) y []).mp hpair.2).1
  exact Module.free_of_regular_pair_generates_maximalIdeal hspan hxR hyR hpair.1 hyB

/-- Parameter-free form of the dimension-two miracle-flatness result.

For a faithful integral local map from a two-dimensional regular local ring to a
two-dimensional normal local domain, finite presentation implies freeness.  This is the exact
module-theoretic conclusion of the dimension-two case in Stacks Tag `0BMA`; the remaining purity
work is the discriminant/branch-locus argument which turns this finite free map into an étale one.
-/
theorem Module.free_of_finitePresentation_integral_local_normal_of_dimensions_eq_two
    {B : Type v} [CommRing B] [Algebra R B]
    [IsRegularLocalRing R] [IsLocalRing B] [IsLocalHom (algebraMap R B)]
    [IsNoetherianRing B] [IsDomain B] [IsIntegrallyClosed B]
    [Algebra.IsIntegral R B] [FaithfulSMul R B] [Module.FinitePresentation R B]
    (hdimR : ringKrullDim R = 2)
    (hdimB : ringKrullDim B = 2) :
    Module.Free R B := by
  obtain ⟨x, y, hspan, hxR, hyR⟩ :=
    exists_regular_pair_span_maximalIdeal_of_dimension_two hdimR
  have hx : x ≠ 0 := by
    intro h
    subst x
    exact IsSMulRegular.not_zero hxR
  have hxB : algebraMap R B x ≠ 0 :=
    by simpa using (FaithfulSMul.algebraMap_injective R B).ne hx
  exact Module.free_of_finitePresentation_integral_local_normal_dimension_two
    hspan hxR hyR hxB (by rw [hdimB])

/-- If a pair generates the maximal ideal of the base, then the second member is regular on the
quotient of a finite torsion-free Stacks-normal algebra by the first.  This is the global,
possibly disconnected form of the depth-two input: any associated prime containing both
parameters would have to be the closed point, which normality excludes. -/
theorem isSMulRegular_quotient_of_span_maximalIdeal_of_finite_stacksNormal
    {B : Type v} [CommRing B] [Algebra R B]
    [IsDomain R] [IsLocalRing R] [IsNoetherianRing R] [IsIntegrallyClosed R]
    [Module.IsTorsionFree R B] [Module.Finite R B]
    (hB : IsStacksNormalRing B) (hdim : 2 ≤ ringKrullDim R)
    {x y : R} (hspan : Ideal.span ({x, y} : Set R) = IsLocalRing.maximalIdeal R)
    (hx : x ≠ 0) :
    IsSMulRegular (QuotSMulTop x B) y := by
  have hxm : x ∈ IsLocalRing.maximalIdeal R := by
    rw [← hspan]
    exact Ideal.subset_span (Set.mem_insert x {y})
  have hclosed :=
    principalQuotient_avoid_closedPoint_of_finite_stacksNormal hB hdim x hxm hx
  by_contra hy
  have hyUnion : y ∈
      ⋃ p ∈ associatedPrimes R (QuotSMulTop x B), (p : Set R) := by
    rw [biUnion_associatedPrimes_eq_compl_regular R (QuotSMulTop x B)]
    exact hy
  simp only [Set.mem_iUnion] at hyUnion
  obtain ⟨p, hpAss, hyp⟩ := hyUnion
  have hxp : x ∈ p := by
    apply IsAssociatedPrime.annihilator_le hpAss
    rw [Submodule.annihilator_top]
    exact QuotSMulTop.mem_annihilator B x
  have hp_le : p ≤ IsLocalRing.maximalIdeal R :=
    IsLocalRing.le_maximalIdeal hpAss.isPrime.ne_top'
  have hmax_le : IsLocalRing.maximalIdeal R ≤ p := by
    rw [← hspan, Ideal.span_le]
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with (rfl | rfl)
    · exact hxp
    · exact hyp
  exact hclosed ((le_antisymm hp_le hmax_le) ▸ hpAss)

/-- The complete module-theoretic dimension-two case of Stacks Tag `0BMA`, allowing a
disconnected normal finite algebra.  Over a two-dimensional normal regular local base, every
finite torsion-free Stacks-normal algebra is free. -/
theorem Module.free_of_finite_torsionFree_stacksNormal_dimension_two
    {B : Type v} [CommRing B] [Algebra R B]
    [IsRegularLocalRing R] [IsIntegrallyClosed R]
    [Module.IsTorsionFree R B] [Module.Finite R B]
    (hB : IsStacksNormalRing B) (hdim : ringKrullDim R = 2) :
    Module.Free R B := by
  letI : IsDomain R := Pcf.Vendor.isDomain_of_isRegularLocalRing R
  letI : Module.FinitePresentation R B := Module.finitePresentation_of_finite R B
  obtain ⟨x, y, hspan, hxR, hyR⟩ :=
    exists_regular_pair_span_maximalIdeal_of_dimension_two hdim
  have hx : x ≠ 0 := by
    intro h
    subst x
    exact IsSMulRegular.not_zero hxR
  have hxB : IsSMulRegular B x :=
    (show IsRegular x from isRegular_iff_ne_zero.mpr hx).isSMulRegular
  have hyB : IsSMulRegular (QuotSMulTop x B) y :=
    isSMulRegular_quotient_of_span_maximalIdeal_of_finite_stacksNormal
      hB (by rw [hdim]) hspan hx
  exact Module.free_of_regular_pair_generates_maximalIdeal hspan hxR hyR hxB hyB

end Pcf.Stacks
