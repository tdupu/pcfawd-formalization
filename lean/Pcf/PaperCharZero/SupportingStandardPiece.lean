module

public import Pcf.Bounding.StandardPiece

/-!
# The full standard-piece quotient and reduction chain

Equation `eq:standard-piece` in `paper.tex`. The first quotient equivalence
requires no reducedness hypothesis. The reduction chain requires precisely
that `R/(a)` is reduced; neither regularity nor characteristic zero is needed.
-/

@[expose] public section

namespace Pcf.PaperCharZero

open Polynomial LocalModel

variable {R : Type*} [CommRing R] (u : Rˣ) (a : R) {e : ℕ}

local notation "C" => AdjoinRoot (localPoly u a e)
local notation "I" => Ideal.span ({algebraMap R C a} : Set C)
local notation "J" => Ideal.span ({AdjoinRoot.root (localPoly u a e)} : Set C)

/-- `eq:standard-piece`, first equality: quotienting the actual root algebra by
the base parameter gives the truncated polynomial algebra over `R/(a)`. -/
noncomputable def standardPiece_quotientParameterEquiv :
    C ⧸ I ≃+* (R ⧸ Ideal.span ({a} : Set R))[X] ⧸
      Ideal.span ({X ^ e} : Set (R ⧸ Ideal.span ({a} : Set R))[X]) := by
  have hmap : (localPoly u a e).map (Ideal.Quotient.mk (Ideal.span ({a} : Set R))) =
      (X : (R ⧸ Ideal.span ({a} : Set R))[X]) ^ e := by
    simp [localPoly, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp) :
      a ∈ Ideal.span ({a} : Set R))]
  have hid : (Ideal.span ({a} : Set R)).map (AdjoinRoot.of (localPoly u a e)) = I := by
    rw [Ideal.map_span, Set.image_singleton]
    rfl
  exact (Ideal.quotEquivOfEq hid.symm).trans
    ((AdjoinRoot.quotAdjoinRootEquivQuotPolynomialQuot
      (Ideal.span ({a} : Set R)) (localPoly u a e)).trans
      (Ideal.quotEquivOfEq (congrArg (fun p => Ideal.span ({p} : Set _)) hmap)))

/-- The nilradical of `C/aC` is generated by the image of the actual root,
provided `R/(a)` is reduced. -/
theorem standardPiece_nilradical (he : 1 ≤ e)
    [IsReduced (R ⧸ Ideal.span ({a} : Set R))] :
    nilradical (C ⧸ I) = (J).map (Ideal.Quotient.mk I) := by
  rw [← radical_span_algebraMap_eq_span_root u a he]
  rw [Ideal.map_radical_of_surjective Ideal.Quotient.mk_surjective
    (le_of_eq Ideal.mk_ker), Ideal.map_quotient_self]
  rfl

/-- `eq:standard-piece`, middle equality: the actual quotient by the nilradical
of `C/aC` is isomorphic to `C/zC`. -/
noncomputable def standardPiece_reductionRootEquiv (he : 1 ≤ e)
    [IsReduced (R ⧸ Ideal.span ({a} : Set R))] :
    (C ⧸ I) ⧸ nilradical (C ⧸ I) ≃+* C ⧸ J :=
  (Ideal.quotEquivOfEq (standardPiece_nilradical u a he)).trans
    (DoubleQuot.quotQuotEquivQuotOfLE (span_algebraMap_le_span_root u a he))

/-- The complete ring-equivalence chain of `paper.tex`, `eq:standard-piece`.
The final map is the existing canonical restriction equivalence.

Manuscript: `eq:standard-piece` (equation (2)). -/
theorem standard_piece (he : 1 ≤ e)
    [IsReduced (R ⧸ Ideal.span ({a} : Set R))] :
    Nonempty (C ⧸ I ≃+* (R ⧸ Ideal.span ({a} : Set R))[X] ⧸
      Ideal.span ({X ^ e} : Set (R ⧸ Ideal.span ({a} : Set R))[X])) ∧
    Nonempty ((C ⧸ I) ⧸ nilradical (C ⧸ I) ≃+* C ⧸ J) ∧
    Nonempty ((C ⧸ J) ≃ₐ[R] R ⧸ Ideal.span ({a} : Set R)) :=
  ⟨⟨standardPiece_quotientParameterEquiv u a⟩,
    ⟨standardPiece_reductionRootEquiv u a he⟩, ⟨quotientRootEquiv u a he⟩⟩

end Pcf.PaperCharZero
