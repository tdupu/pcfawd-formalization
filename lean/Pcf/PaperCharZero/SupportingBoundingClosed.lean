module

public import Pcf.PaperCharZero.SupportingBoundingLocus
public import Pcf.Bounding.FiniteTypeSingularLocusClosed
public import Pcf.Bounding.RegularLocalDomain
public import Mathlib.RingTheory.Smooth.Locus

/-!
# Closedness of the exceptional locus and the bounding theorem

This module closes the remaining gap in `thm:bounding` of `paper.tex`: closedness of the two
singular-locus terms of the literal exceptional set
`Σ = (B ∩ Z) ∪ (B ∩ Sing Y) ∪ Sing B`.

The algebraic input is the regular-to-smooth implication over a perfect field
(Stacks Project, Tags `00TV` and `07R5`). If `P → P ⧸ I` is a surjection of regular local
rings, then `I ∩ 𝔪² ⊆ 𝔪 I` (`inf_maximalIdeal_sq_le_mul_of_isRegularLocalRing`): `I` is
generated by lifts of a basis of its image in `𝔪/𝔪²`, by Krull's height theorem and the fact
that a regular local ring is a domain. Combined with the split-injective residue-field
cotangent map of `FiniteTypeSingularLocusClosed` and Mathlib's local Jacobian criterion, this
shows that a regular point of a finite-type algebra over a perfect field is smooth. Hence the
regular locus equals the open smooth locus, and `stalkSingularLocus X` is closed for every
scheme locally of finite type over a perfect field.

Nothing here enlarges `Σ` or replaces the manuscript's support condition: the étaleness
statement in `bounding_theorem` is phrased with `g '' closure {Q} ⊄ Σ`, which is equivalent to
generic-point avoidance only because `Σ` has been proved closed.
-/

@[expose] public section

universe u v

open IsLocalRing

namespace Pcf.PaperCharZero

section RegularQuotient

variable {P : Type u} [CommRing P]

/-- The image in the cotangent space of the elements of an ideal. -/
noncomputable def cotangentImage [IsLocalRing P] (I : Ideal P) :
    Submodule (ResidueField P) (CotangentSpace P) :=
  Submodule.span (ResidueField P) ((maximalIdeal P).toCotangent '' {x | (x : P) ∈ I})

theorem exists_of_mem_cotangentImage [IsLocalRing P] (I : Ideal P)
    {v : CotangentSpace P} (hv : v ∈ cotangentImage I) :
    ∃ x : maximalIdeal P, (x : P) ∈ I ∧ (maximalIdeal P).toCotangent x = v := by
  induction hv using Submodule.span_induction with
  | mem v hv => obtain ⟨x, hx, rfl⟩ := hv; exact ⟨x, hx, rfl⟩
  | zero => exact ⟨0, I.zero_mem, map_zero _⟩
  | add v w _ _ hv hw =>
    obtain ⟨x, hx, rfl⟩ := hv
    obtain ⟨y, hy, rfl⟩ := hw
    exact ⟨x + y, I.add_mem hx hy, map_add _ _ _⟩
  | smul c v _ hv =>
    obtain ⟨x, hx, rfl⟩ := hv
    obtain ⟨a, rfl⟩ := residue_surjective c
    refine ⟨a • x, I.mul_mem_left a hx, ?_⟩
    rw [map_smul, ← ResidueField.algebraMap_eq, algebraMap_smul]

theorem toCotangent_mem_cotangentImage [IsLocalRing P] (I : Ideal P)
    (x : maximalIdeal P) (hx : (x : P) ∈ I) :
    (maximalIdeal P).toCotangent x ∈ cotangentImage I :=
  Submodule.subset_span ⟨x, hx, rfl⟩

/-- Lower bound for the embedding dimension of a quotient. -/
theorem finrank_cotangentSpace_le_spanFinrank_quotient_add
    [IsLocalRing P] [IsNoetherianRing P] (I : Ideal P) [Nontrivial (P ⧸ I)] :
    Module.finrank (ResidueField P) (CotangentSpace P) ≤
      (maximalIdeal (P ⧸ I)).spanFinrank +
        Module.finrank (ResidueField P) (cotangentImage I) := by
  classical
  obtain ⟨u, hu_card, hu_span⟩ :=
    Submodule.FG.exists_span_finset_card_eq_spanFinrank
      (maximalIdeal (P ⧸ I)).fg_of_isNoetherianRing
  choose lift hlift using fun y : u => Ideal.Quotient.mk_surjective (I := I) (y : P ⧸ I)
  have hmk : IsLocalHom (Ideal.Quotient.mk I) :=
    IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  have hmem (x : P) : x ∈ maximalIdeal P ↔ Ideal.Quotient.mk I x ∈ maximalIdeal (P ⧸ I) := by
    rw [← maximalIdeal_comap (Ideal.Quotient.mk I), Ideal.mem_comap]
  have hliftm (y : u) : lift y ∈ maximalIdeal P := by
    rw [hmem, hlift y, ← hu_span]
    exact Submodule.subset_span y.2
  let L : u → maximalIdeal P := fun y => ⟨lift y, hliftm y⟩
  let T : Submodule (ResidueField P) (CotangentSpace P) :=
    Submodule.span (ResidueField P) (Set.range fun y => (maximalIdeal P).toCotangent (L y))
  have htop : T ⊔ cotangentImage I = ⊤ := by
    rw [eq_top_iff]
    intro v _
    obtain ⟨x, rfl⟩ := (maximalIdeal P).toCotangent_surjective v
    have hx : Ideal.Quotient.mk I (x : P) ∈ Submodule.span (P ⧸ I) (u : Set (P ⧸ I)) := by
      rw [hu_span, ← hmem]; exact x.2
    obtain ⟨c, hc⟩ := (Submodule.mem_span_finset).mp hx
    choose c' hc' using fun y : u => Ideal.Quotient.mk_surjective (I := I) (c y)
    let a : maximalIdeal P := ∑ y : u, c' y • L y
    have hz : (x : P) - a ∈ I := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero, ← hc.2]
      simp only [a, Submodule.coe_sum, Submodule.coe_smul, smul_eq_mul, map_sum, map_mul,
        hc', L, hlift]
      exact (Finset.sum_coe_sort u fun y => c y * y).symm
    let z : maximalIdeal P := x - a
    have hxaz : x = a + z := by simp [z]
    rw [hxaz, map_add]
    refine Submodule.add_mem_sup ?_ (toCotangent_mem_cotangentImage I z hz)
    simp only [a, map_sum, map_smul]
    refine Submodule.sum_mem _ fun y _ => ?_
    rw [← IsScalarTower.algebraMap_smul (ResidueField P)]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨y, rfl⟩)
  calc Module.finrank (ResidueField P) (CotangentSpace P)
      = Module.finrank (ResidueField P) (T ⊔ cotangentImage I : Submodule _ _) := by
        rw [htop, finrank_top]
    _ ≤ Module.finrank (ResidueField P) T +
          Module.finrank (ResidueField P) (cotangentImage I) :=
        Submodule.finrank_add_le_finrank_add_finrank _ _
    _ ≤ (maximalIdeal (P ⧸ I)).spanFinrank +
          Module.finrank (ResidueField P) (cotangentImage I) := by
        gcongr
        rw [← hu_card]
        exact (finrank_range_le_card _).trans (by simp)

theorem ncard_range_fin_le {α : Type*} {n : ℕ} (f : Fin n → α) : (Set.range f).ncard ≤ n := by
  rw [← Set.image_univ]
  exact (Set.ncard_image_le Set.finite_univ).trans (by simp)

/-- Upper bound for the embedding dimension of a quotient. -/
theorem spanFinrank_maximalIdeal_quotient_le
    [IsLocalRing P] (J : Ideal P) [Nontrivial (P ⧸ J)] (S T : Set P) (hS : S ⊆ J)
    (hT : T.Finite) (h : Ideal.span (S ∪ T) = maximalIdeal P) :
    (maximalIdeal (P ⧸ J)).spanFinrank ≤ T.ncard := by
  have hmax : maximalIdeal (P ⧸ J) = Ideal.span (Ideal.Quotient.mk J '' T) := by
    rw [← map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective, ← h, Ideal.map_span,
      Set.image_union, Ideal.span_union]
    have : Ideal.span (Ideal.Quotient.mk J '' S) = ⊥ := by
      rw [Ideal.span_eq_bot]
      rintro _ ⟨x, hx, rfl⟩
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (hS hx)
    rw [this, bot_sup_eq]
  rw [hmax]
  exact (Submodule.spanFinrank_span_le_ncard_of_finite (hT.image _)).trans
    (Set.ncard_image_le hT)

/-- If a regular local ring `P` has a regular quotient `P ⧸ I`, then `I ∩ 𝔪² ⊆ 𝔪 I`;
equivalently, `I` is generated by part of a regular system of parameters of `P`
(Stacks Project, Tag `00NR`). -/
theorem inf_maximalIdeal_sq_le_mul_of_isRegularLocalRing
    [IsRegularLocalRing P] (I : Ideal P) [IsRegularLocalRing (P ⧸ I)] :
    I ⊓ maximalIdeal P ^ 2 ≤ maximalIdeal P * I := by
  classical
  let κ := ResidueField P
  let V := CotangentSpace P
  let W := cotangentImage I
  set c := Module.finrank κ W with hc
  obtain ⟨W', hW'⟩ := exists_isCompl W
  set c' := Module.finrank κ W' with hc'
  have hd : c + c' = Module.finrank κ V := Submodule.finrank_add_eq_of_isCompl hW'
  have hdP : (Module.finrank κ V : WithBot ℕ∞) = ringKrullDim P :=
    (IsRegularLocalRing.iff_finrank_cotangentSpace P).mp inferInstance
  let b := Module.finBasis κ W
  let b' := Module.finBasis κ W'
  choose s hsI hs using fun i => exists_of_mem_cotangentImage I (b i).2
  choose t ht using fun j => (maximalIdeal P).toCotangent_surjective (b' j : V)
  -- the lifts generate the maximal ideal
  have hspanV : Submodule.span κ ((maximalIdeal P).toCotangent ''
      (Set.range s ∪ Set.range t)) = ⊤ := by
    rw [eq_top_iff]
    intro v _
    obtain ⟨w, hw, w', hw', rfl⟩ := Submodule.mem_sup.mp
      (show v ∈ W ⊔ W' by rw [hW'.sup_eq_top]; trivial)
    refine Submodule.add_mem _ ?_ ?_
    · rw [show w = ((⟨w, hw⟩ : W) : V) from rfl, ← b.sum_repr ⟨w, hw⟩, Submodule.coe_sum]
      refine Submodule.sum_mem _ fun i _ => ?_
      rw [Submodule.coe_smul, ← hs i]
      exact Submodule.smul_mem _ _
        (Submodule.subset_span ⟨s i, Or.inl ⟨i, rfl⟩, rfl⟩)
    · rw [show w' = ((⟨w', hw'⟩ : W') : V) from rfl, ← b'.sum_repr ⟨w', hw'⟩,
        Submodule.coe_sum]
      refine Submodule.sum_mem _ fun j _ => ?_
      rw [Submodule.coe_smul, ← ht j]
      exact Submodule.smul_mem _ _
        (Submodule.subset_span ⟨t j, Or.inr ⟨j, rfl⟩, rfl⟩)
  have hspan : Ideal.span (Set.range (fun i => (s i : P)) ∪ Set.range (fun j => (t j : P))) =
      maximalIdeal P := by
    have := congrArg (Submodule.map (maximalIdeal P).subtype)
      ((CotangentSpace.span_image_eq_top_iff).mp hspanV)
    rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype, Set.image_union,
      ← Set.range_comp, ← Set.range_comp] at this
    exact this
  -- the ideal generated by the lifts in `I`
  let J := Ideal.span (Set.range (fun i => (s i : P)))
  have hJI : J ≤ I := Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hsI i)
  have hIne : I ≠ ⊤ := Ideal.Quotient.nontrivial_iff.mp inferInstance
  have : Nontrivial (P ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr (ne_top_of_le_ne_top hIne hJI)
  have hJemb : (maximalIdeal (P ⧸ J)).spanFinrank ≤ c' :=
    (spanFinrank_maximalIdeal_quotient_le J _ _ Ideal.subset_span (Set.finite_range _)
      hspan).trans (ncard_range_fin_le _)
  have hJrank : J.spanFinrank ≤ c :=
    (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)).trans
      (ncard_range_fin_le _)
  have hkrull := ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank J
    (by rw [IsLocalRing.ringJacobson_eq_maximalIdeal]; exact le_trans hJI (le_maximalIdeal hIne))
  have hJdim_le : ringKrullDim (P ⧸ J) ≤ c' :=
    (ringKrullDim_le_spanFinrank_maximalIdeal (P ⧸ J)).trans (by exact_mod_cast hJemb)
  have hJdim : ringKrullDim (P ⧸ J) = c' := by
    refine le_antisymm hJdim_le ?_
    rw [← hdP, ← hd] at hkrull
    have hkrull' : ((c + c' : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (P ⧸ J) + c :=
      hkrull.trans (by gcongr)
    have h0 : 0 ≤ ringKrullDim (P ⧸ J) := ringKrullDim_nonneg_of_nontrivial
    obtain ⟨e, he⟩ : ∃ e : ℕ, ringKrullDim (P ⧸ J) = e := by
      generalize ringKrullDim (P ⧸ J) = D at hJdim_le h0
      induction D using WithBot.recBotCoe with
      | bot => exact absurd h0 (by simp)
      | coe D =>
        induction D using ENat.recTopCoe with
        | top =>
          exfalso
          have h := hJdim_le
          norm_cast at h
        | coe e => exact ⟨e, rfl⟩
    rw [he] at hkrull' ⊢
    have : c + c' ≤ e + c := by exact_mod_cast hkrull'
    exact_mod_cast (by omega : c' ≤ e)
  have : IsRegularLocalRing (P ⧸ J) :=
    IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ (by rw [hJdim]; exact_mod_cast hJemb)
  -- the regular quotient by `I` has dimension at least `c'`
  have hIemb : Module.finrank κ V ≤ (maximalIdeal (P ⧸ I)).spanFinrank + c :=
    finrank_cotangentSpace_le_spanFinrank_quotient_add I
  have hIdim : ((maximalIdeal (P ⧸ I)).spanFinrank : WithBot ℕ∞) = ringKrullDim (P ⧸ I) :=
    IsRegularLocalRing.spanFinrank_maximalIdeal
  have hIJ : I ≤ J := by
    intro x hxI
    by_contra hxJ
    have hx0 : Ideal.Quotient.mk J x ∈ nonZeroDivisors (P ⧸ J) :=
      mem_nonZeroDivisors_of_ne_zero (fun h => hxJ (Ideal.Quotient.eq_zero_iff_mem.mp h))
    have hlt := ringKrullDim_succ_le_of_surjective (Ideal.Quotient.factor hJI)
      (Ideal.Quotient.factor_surjective hJI) hx0
      (by rw [Ideal.Quotient.factor_mk]; exact Ideal.Quotient.eq_zero_iff_mem.mpr hxI)
    rw [← hIdim, hJdim] at hlt
    have : (maximalIdeal (P ⧸ I)).spanFinrank + 1 ≤ c' := by exact_mod_cast hlt
    omega
  -- conclusion
  rintro x ⟨hxI, hx2⟩
  obtain ⟨a, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp (hIJ hxI)
  have hxm : ∑ i, a i * (s i : P) ∈ maximalIdeal P := le_maximalIdeal hIne hxI
  have h0 := ((maximalIdeal P).toCotangent_eq_zero ⟨_, hxm⟩).mpr hx2
  have heq : (⟨_, hxm⟩ : maximalIdeal P) = ∑ i, a i • s i :=
    Subtype.ext (by simp [smul_eq_mul])
  rw [heq, map_sum] at h0
  simp_rw [map_smul, ← IsScalarTower.algebraMap_smul (ResidueField P) (a _), hs] at h0
  have h0' : ∑ i, algebraMap P κ (a i) • b i = 0 := by
    apply Subtype.ext
    rw [Submodule.coe_sum]
    simp only [Submodule.coe_smul, Submodule.coe_zero]
    exact h0
  have ha i : a i ∈ maximalIdeal P := by
    have := Fintype.linearIndependent_iff.mp b.linearIndependent _ h0' i
    rwa [ResidueField.algebraMap_eq, residue_eq_zero_iff] at this
  exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_mul (ha i) (hsI i)

end RegularQuotient

section RegularSmooth

open KaehlerDifferential TensorProduct

/-- The kernel of a surjection between regular local rings meets `𝔪²` only in `𝔪 · ker`. -/
theorem ker_inf_maximalIdeal_sq_le_of_surjective {P R : Type*} [CommRing P] [CommRing R]
    [IsRegularLocalRing P] [IsRegularLocalRing R] (φ : P →+* R) (hφ : Function.Surjective φ) :
    RingHom.ker φ ⊓ maximalIdeal P ^ 2 ≤ maximalIdeal P * RingHom.ker φ := by
  have : IsRegularLocalRing (P ⧸ RingHom.ker φ) :=
    IsRegularLocalRing.of_ringEquiv (RingHom.quotientKerEquivOfSurjective hφ).symm
  exact inf_maximalIdeal_sq_le_mul_of_isRegularLocalRing _

/-- Regular-to-smooth over a perfect field, for a local algebra presented as a quotient of a
regular local, formally smooth algebra with finite free differentials. -/
theorem formallySmooth_of_isRegularLocalRing_of_surjective
    (k P R : Type*) [Field k] [PerfectField k] [CommRing P] [CommRing R]
    [Algebra k P] [Algebra k R] [Algebra P R] [IsScalarTower k P R]
    [IsRegularLocalRing P] [IsRegularLocalRing R] [Algebra.EssFiniteType k R]
    [Algebra.FormallySmooth k P] [Module.Free P Ω[P⁄k]] [Module.Finite P Ω[P⁄k]]
    (hsurj : Function.Surjective (algebraMap P R)) :
    Algebra.FormallySmooth k R := by
  rw [Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange_residueField P hsurj
    (IsNoetherian.noetherian _)]
  let K := ResidueField R
  have hK : Function.Surjective (algebraMap P K) := by
    rw [IsScalarTower.algebraMap_eq P R K, RingHom.coe_comp]
    exact residue_surjective.comp hsurj
  have : Algebra.EssFiniteType k K := Algebra.EssFiniteType.comp k R K
  have hker : RingHom.ker (algebraMap P K) = maximalIdeal P := by
    have : IsLocalHom (algebraMap P R) := IsLocalHom.of_surjective _ hsurj
    ext x
    rw [RingHom.mem_ker, IsScalarTower.algebraMap_eq P R K, RingHom.comp_apply,
      ResidueField.algebraMap_eq, residue_eq_zero_iff, ← Ideal.mem_comap, maximalIdeal_comap]
  rw [injective_iff_map_eq_zero]
  intro z hz
  obtain ⟨i, rfl⟩ : ∃ i, z = (1 : K) ⊗ₜ[P] i := by
    clear hz
    induction z using TensorProduct.inductionOn with
    | tmul a i =>
      obtain ⟨p, rfl⟩ := hK a
      exact ⟨p • i, by rw [tmul_smul, Algebra.algebraMap_eq_smul_one, smul_tmul']⟩
    | add x y hx hy =>
      obtain ⟨i, rfl⟩ := hx
      obtain ⟨j, rfl⟩ := hy
      exact ⟨i + j, (tmul_add _ _ _).symm⟩
  rw [cotangentComplexBaseChange_tmul, one_smul] at hz
  have hiK : (i : P) ∈ RingHom.ker (algebraMap P K) := RingHom.mem_ker.mpr (by
    rw [IsScalarTower.algebraMap_eq P R K, RingHom.comp_apply, RingHom.mem_ker.mp i.2, map_zero])
  obtain ⟨l, hl⟩ := Pcf.exists_retraction_kerCotangentToTensor_of_formallySmooth k P K hK
  have hcot : (RingHom.ker (algebraMap P K)).toCotangent ⟨i, hiK⟩ = 0 := by
    have := LinearMap.congr_fun hl ((RingHom.ker (algebraMap P K)).toCotangent ⟨i, hiK⟩)
    rw [LinearMap.comp_apply, kerCotangentToTensor_toCotangent, LinearMap.id_apply] at this
    rw [← this, ← map_zero l]
    congr 1
  have hi2 : (i : P) ∈ maximalIdeal P ^ 2 := by
    rw [← hker]
    exact (Ideal.toCotangent_eq_zero _ _).mp hcot
  have hmem := ker_inf_maximalIdeal_sq_le_of_surjective (algebraMap P R) hsurj ⟨i.2, hi2⟩
  have hi : i ∈ maximalIdeal P • (⊤ : Submodule P (RingHom.ker (algebraMap P R))) :=
    (Submodule.mem_smul_top_iff _ _ _).mpr (by rw [Ideal.smul_eq_mul]; exact hmem)
  refine Submodule.smul_induction_on (p := fun x => (1 : K) ⊗ₜ[P] x = 0) hi ?_ ?_
  · intro r hr n _
    rw [← smul_tmul, ← Algebra.algebraMap_eq_smul_one,
      show algebraMap P K r = 0 from RingHom.mem_ker.mp (hker ▸ hr), zero_tmul]
  · intro x y hx hy
    rw [tmul_add, hx, hy, add_zero]

/-- Over a perfect field, a regular point of a finite-type algebra is a smooth point. -/
theorem isSmoothAt_of_isRegularLocalRing (k : Type u) [Field k] [PerfectField k]
    (S : Type u) [CommRing S] [Algebra k S] [Algebra.FiniteType k S]
    (p : Ideal S) [p.IsPrime] [IsRegularLocalRing (Localization.AtPrime p)] :
    Algebra.IsSmoothAt k p := by
  obtain ⟨n, φ, hφ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹_›
  let q := p.comap φ.toRingHom
  let P := Localization.AtPrime q
  let ψ : P →+* Localization.AtPrime p := Localization.localRingHom q p φ.toRingHom rfl
  have hψ : Function.Surjective ψ :=
    RingHom.surjective_localRingHom_of_surjective φ.toRingHom hφ p
  let : Algebra P (Localization.AtPrime p) := ψ.toAlgebra
  have : IsScalarTower k P (Localization.AtPrime p) := by
    refine IsScalarTower.of_algebraMap_eq fun x => ?_
    change _ = ψ (algebraMap k P x)
    rw [IsScalarTower.algebraMap_apply k (MvPolynomial (Fin n) k) P,
      Localization.localRingHom_to_map, IsScalarTower.algebraMap_apply k S]
    simp
  have : Algebra.EssFiniteType S (Localization.AtPrime p) :=
    .of_isLocalization _ p.primeCompl
  have : Algebra.EssFiniteType k (Localization.AtPrime p) := .comp _ S _
  have : Algebra.EssFiniteType (MvPolynomial (Fin n) k) P := .of_isLocalization _ q.primeCompl
  have : Algebra.EssFiniteType k P := .comp _ (MvPolynomial (Fin n) k) _
  have : Module.Free P Ω[P⁄k] := Module.free_of_flat_of_isLocalRing
  exact formallySmooth_of_isRegularLocalRing_of_surjective k P _ hψ

/-- Over a perfect field, the pointwise regular locus of a finite-type algebra is exactly its
smooth locus. -/
theorem primeRegularLocus_eq_smoothLocus (k : Type u) [Field k] [PerfectField k]
    (S : Type u) [CommRing S] [Algebra k S] [Algebra.FiniteType k S] :
    primeRegularLocus S = Algebra.smoothLocus k S := by
  have : Algebra.FinitePresentation k S := Algebra.FinitePresentation.of_finiteType.mp ‹_›
  ext p
  constructor
  · intro hp
    have : IsRegularLocalRing (Localization.AtPrime p.asIdeal) := hp
    exact isSmoothAt_of_isRegularLocalRing k S p.asIdeal
  · intro hp
    have : Algebra.IsSmoothAt k p.asIdeal := hp
    exact Pcf.isRegularLocalRing_of_isSmoothAt k S p.asIdeal

/-- Over a perfect field, the pointwise regular locus of a finite-type algebra is open. -/
theorem isOpen_primeRegularLocus_of_finiteType (k : Type u) [Field k] [PerfectField k]
    (S : Type u) [CommRing S] [Algebra k S] [Algebra.FiniteType k S] :
    IsOpen (primeRegularLocus S) := by
  have : Algebra.FinitePresentation k S := Algebra.FinitePresentation.of_finiteType.mp ‹_›
  rw [primeRegularLocus_eq_smoothLocus k S]
  exact Algebra.isOpen_smoothLocus

end RegularSmooth

section SchemeClosed

open AlgebraicGeometry CategoryTheory TopologicalSpace

set_option backward.isDefEq.respectTransparency false in
/-- On a scheme locally of finite type over a perfect field, the pointwise singular locus
`stalkSingularLocus X` is closed (Stacks Project, Tag `07R5`, via the smooth locus). -/
theorem isClosed_stalkSingularLocus_of_perfectField (k : Type u) [Field k] [PerfectField k]
    {X : Scheme.{u}} (s : X ⟶ Spec (.of k)) [LocallyOfFiniteType s] :
    IsClosed (stalkSingularLocus X) := by
  rw [isClosed_stalkSingularLocus_iff_affine]
  intro U
  let φ : k →+* Γ(X, U) := (s.appLE ⊤ U (by simp)).hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom
  let : Algebra k Γ(X, U) := φ.toAlgebra
  have : Algebra.FiniteType k Γ(X, U) := by
    apply RingHom.finiteType_algebraMap.mp
    exact (s.finiteType_appLE (isAffineOpen_top _) U.2 (by simp)).comp
      (Scheme.ΓSpecIso (.of k)).symm.commRingCatIsoToRingEquiv.finite.finiteType
  exact isOpen_primeRegularLocus_of_finiteType k Γ(X, U)

/-- The literal exceptional set `Σ = (B ∩ Z) ∪ (B ∩ Sing Y) ∪ Sing B` of `thm:bounding` is
closed in `B`. -/
theorem isClosed_boundingExceptionalSet
    (k : Type u) [Field k] [CharZero k]
    {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [NoetherianSpace X] [IsLocallyNoetherian Y]
    [IsNormalScheme X] [IsNormalScheme Y]
    (s : Y ⟶ Spec (.of k)) [LocallyOfFiniteType s]
    (f : X ⟶ Y) [IsFinite f] [IsDominant f] (B : SchemeDivisorPoint Y) :
    IsClosed (boundingExceptionalSet f B) :=
  ((isClosed_otherBranch_on_divisor k s f B).union
      ((isClosed_stalkSingularLocus_of_perfectField k s).preimage
        (pointClosureIdealSheaf B.1).subschemeι.continuous)).union
    (isClosed_stalkSingularLocus_of_perfectField k
      ((pointClosureIdealSheaf B.1).subschemeι ≫ s))

/-- For a closed exceptional set, the image of the closure of a source point is contained in it
exactly when the image point is. -/
theorem image_closure_subset_iff_of_isClosed {S T : Scheme.{u}} (g : S ⟶ T) {E : Set T}
    (hE : IsClosed E) (x : S) : g '' closure {x} ⊆ E ↔ g x ∈ E := by
  constructor
  · intro h
    exact h ⟨x, subset_closure rfl, rfl⟩
  · intro h
    refine (image_closure_subset_closure_image g.continuous).trans (closure_minimal ?_ hE)
    rintro _ ⟨y, rfl, rfl⟩
    exact h

/-- `paper.tex`, Theorem `thm:bounding`, with the Noetherian consequences of the variety
hypotheses as instance arguments. -/
theorem bounding_theorem_of_noetherian
    (k : Type u) [Field k] [CharZero k]
    {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [NoetherianSpace X] [IsLocallyNoetherian Y]
    [IsNormalScheme X] [IsNormalScheme Y]
    (s : Y ⟶ Spec (.of k)) [LocallyOfFiniteType s]
    (f : X ⟶ Y) [IsFinite f] [IsDominant f] (A : SchemeDivisorPoint X) :
    (IsClosed (boundingExceptionalSet f (A.mapFiniteDominantNormal f)) ∧
      boundingExceptionalSet f (A.mapFiniteDominantNormal f) ≠ Set.univ) ∧
    ∀ Q : SchemeDivisorPoint (pointClosureIdealSheaf A.1).subscheme,
      ¬ (A.closureMapFiniteDominantNormal f '' closure {Q.1} ⊆
          boundingExceptionalSet f (A.mapFiniteDominantNormal f)) →
      ∃ V : (pointClosureIdealSheaf A.1).subscheme.Opens,
        Q.1 ∈ V ∧ Etale (V.ι ≫ A.closureMapFiniteDominantNormal f) := by
  have hclosed := isClosed_boundingExceptionalSet k s f (A.mapFiniteDominantNormal f)
  refine ⟨⟨hclosed, boundingExceptionalSet_ne_univ f _⟩, fun Q hQ => ?_⟩
  rw [image_closure_subset_iff_of_isClosed _ hclosed] at hQ
  exact etale_at_divisor_outside_boundingExceptionalSet f k s A Q hQ

/-- `paper.tex`, Theorem `thm:bounding` (Bounding theorem).

Let `f : X → Y` be a finite surjective morphism of normal varieties over a field `k` of
characteristic zero (here: integral normal schemes, `Y` of finite type over `k` via `s`), let
`A` be an integral effective divisor of `X`, `B = f(A)`, `g = f|_A : A → B`, `Z` the union of
the branch divisors of `f` other than `B`, and `Σ = (B ∩ Z) ∪ (B ∩ Sing Y) ∪ Sing B`
(`boundingExceptionalSet`). Then `Σ` is a proper closed subset of `B`, and `g` is étale at the
generic point of every integral effective divisor of `A` whose image is not contained in `Σ`. -/
theorem bounding_theorem
    (k : Type u) [Field k] [CharZero k]
    {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [IsNormalScheme X] [IsNormalScheme Y]
    (s : Y ⟶ Spec (.of k)) [LocallyOfFiniteType s] [QuasiCompact s]
    (f : X ⟶ Y) [IsFinite f] [Surjective f] (A : SchemeDivisorPoint X) :
    letI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian s
    (IsClosed (boundingExceptionalSet f (A.mapFiniteDominantNormal f)) ∧
      boundingExceptionalSet f (A.mapFiniteDominantNormal f) ≠ Set.univ) ∧
    ∀ Q : SchemeDivisorPoint (pointClosureIdealSheaf A.1).subscheme,
      ¬ (A.closureMapFiniteDominantNormal f '' closure {Q.1} ⊆
          boundingExceptionalSet f (A.mapFiniteDominantNormal f)) →
      ∃ V : (pointClosureIdealSheaf A.1).subscheme.Opens,
        Q.1 ∈ V ∧ Etale (V.ι ≫ A.closureMapFiniteDominantNormal f) := by
  let : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian s
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace s
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  have : IsNoetherian X := {}
  exact bounding_theorem_of_noetherian k s f A

end SchemeClosed

