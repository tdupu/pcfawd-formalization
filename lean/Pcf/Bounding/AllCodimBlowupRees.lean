module

public import Mathlib.RingTheory.ReesAlgebra
public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.RingTheory.TensorProduct.Maps

/-!
# The Rees algebra map for a pulled-back blow-up center

Theorem `thm:allcodim-normal` in `latex/paper-p.tex` uses the ideals
`J_m = f^{ms*} I` and the blow-ups of `I` and `J_m`. On an affine chart,
the pullback of a center `I` along `f : R →+* S` is `I.map f`.
This file builds the resulting homomorphism between the *actual Rees algebras*,
the graded rings whose Proj defines these affine blow-ups.
-/

@[expose] public section

namespace Pcf.Bounding.AllCodimBlowup

open Polynomial
open scoped TensorProduct

universe u v

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S]

/-- Coefficientwise application of a ring homomorphism carries the Rees algebra
of the center into the Rees algebra of its extension. This is the affine
algebra map underlying the base-changed blow-up in the proof of
`paper-p.tex`, Theorem `thm:allcodim-normal` (first paragraph). -/
theorem polynomial_map_mem_reesAlgebra (f : R →+* S) (I : Ideal R)
    (P : reesAlgebra I) :
    (Polynomial.mapRingHom f) P.1 ∈ reesAlgebra (I.map f) := by
  rw [mem_reesAlgebra_iff]
  intro n
  change (P.1.map f).coeff n ∈ (I.map f) ^ n
  rw [coeff_map]
  rw [← Ideal.map_pow]
  exact Ideal.mem_map_of_mem f ((mem_reesAlgebra_iff I P.1).mp P.2 n)

/-- The map on the affine Rees rings for extension of a blow-up center. -/
noncomputable def reesAlgebraMap (f : R →+* S) (I : Ideal R) :
    reesAlgebra I →+* reesAlgebra (I.map f) :=
  ((Polynomial.mapRingHom f).comp (Subalgebra.val (reesAlgebra I))).codRestrict
    (reesAlgebra (I.map f)) (polynomial_map_mem_reesAlgebra f I)

@[simp] theorem reesAlgebraMap_val (f : R →+* S) (I : Ideal R)
    (P : reesAlgebra I) :
    (reesAlgebraMap f I P).1 = (Polynomial.mapRingHom f) P.1 := rfl

@[simp] theorem reesAlgebraMap_coeff (f : R →+* S) (I : Ideal R)
    (P : reesAlgebra I) (n : ℕ) :
    (reesAlgebraMap f I P).1.coeff n = f (P.1.coeff n) := by
  simp

/-- The Rees homomorphism preserves the degree of a homogeneous monomial. -/
@[simp] theorem reesAlgebraMap_monomial (f : R →+* S) (I : Ideal R)
    (n : ℕ) (r : R) (hr : r ∈ I ^ n) :
    reesAlgebraMap f I
      ⟨monomial n r, reesAlgebra.monomial_mem.mpr hr⟩ =
      ⟨monomial n (f r), reesAlgebra.monomial_mem.mpr
        (by rw [← Ideal.map_pow]; exact Ideal.mem_map_of_mem f hr)⟩ := by
  apply Subtype.ext
  simp [reesAlgebraMap_val]

/-- Composition of the Rees algebra maps, as an equality in the containing
polynomial ring. The middle center is exactly the extension `I.map f` that
appears on the first base change. -/
@[simp] theorem reesAlgebraMap_comp_val {T : Type*} [CommRing T]
    (f : R →+* S) (g : S →+* T) (I : Ideal R) (P : reesAlgebra I) :
    (reesAlgebraMap g (I.map f) (reesAlgebraMap f I P)).1 =
      (Polynomial.mapRingHom (g.comp f)) P.1 := by
  simp [Polynomial.map_map]

/-- Injective base changes induce injective maps on the Rees rings. -/
theorem reesAlgebraMap_injective (f : R →+* S) (hf : Function.Injective f)
    (I : Ideal R) : Function.Injective (reesAlgebraMap f I) := by
  intro P Q h
  apply Subtype.ext
  apply Polynomial.map_injective f hf
  exact congrArg Subtype.val h

/-- Every degree-one generator of the extended center lies in the algebra
generated by the image of the old Rees ring and coefficients in `S`. -/
private theorem degreeOne_mem_adjoin_reesAlgebraMap (f : R →+* S) (I : Ideal R)
    {r : S} (hr : r ∈ I.map f) :
    (⟨monomial 1 r, reesAlgebra.monomial_mem.mpr (by simpa using hr)⟩ :
      reesAlgebra (I.map f)) ∈
      Algebra.adjoin S (Set.range (reesAlgebraMap f I)) := by
  let J : Ideal S := I.map f
  let A := Algebra.adjoin S (Set.range (reesAlgebraMap f I))
  change r ∈ Ideal.span (f '' (I : Set R)) at hr
  induction hr using Submodule.span_induction with
  | mem r hr =>
      rcases hr with ⟨x, hx, rfl⟩
      exact Algebra.subset_adjoin ⟨⟨monomial 1 x,
        reesAlgebra.monomial_mem.mpr (by simpa using hx)⟩, by
          simpa using (reesAlgebraMap_monomial f I 1 x (by simpa using hx))⟩
  | zero =>
      have h : (0 : reesAlgebra (I.map f)) ∈ A := A.zero_mem
      convert h using 1
      apply Subtype.ext
      simp
  | add x y hx hy ihx ihy =>
      simpa [map_add] using A.add_mem ihx ihy
  | smul a x hx ih =>
      have h := A.smul_mem ih a
      convert h using 1
      apply Subtype.ext
      simp [Polynomial.smul_monomial]

/-- Every homogeneous Rees element of the extended ideal is generated by
coefficients from `S` and the image of the original Rees algebra. -/
private theorem monomial_mem_adjoin_reesAlgebraMap (f : R →+* S) (I : Ideal R)
    {n : ℕ} {r : S} (hr : r ∈ (I.map f) ^ n) :
    (⟨monomial n r, reesAlgebra.monomial_mem.mpr hr⟩ :
      reesAlgebra (I.map f)) ∈
      Algebra.adjoin S (Set.range (reesAlgebraMap f I)) := by
  let A := Algebra.adjoin S (Set.range (reesAlgebraMap f I))
  induction n generalizing r with
  | zero =>
      have h : (algebraMap S (reesAlgebra (I.map f))) r ∈ A := A.algebraMap_mem r
      convert h using 1
      apply Subtype.ext
      simp
  | succ n ih =>
      have hmem : ∀ r : S, r ∈ (I.map f) * (I.map f) ^ n →
          ∃ h : monomial (n + 1) r ∈ reesAlgebra (I.map f),
            (⟨monomial (n + 1) r, h⟩ : reesAlgebra (I.map f)) ∈ A := by
        intro r hr
        refine Submodule.smul_induction_on hr ?_ ?_
        · intro a ha b hb
          have ha' := degreeOne_mem_adjoin_reesAlgebraMap f I ha
          have hb' := ih hb
          have h := A.mul_mem ha' hb'
          have hm : monomial (n + 1) (a * b) ∈ reesAlgebra (I.map f) := by
            apply reesAlgebra.monomial_mem.mpr
            rw [pow_succ']
            exact Ideal.mul_mem_mul ha hb
          refine ⟨hm, ?_⟩
          convert h using 1
          apply Subtype.ext
          simp [Polynomial.monomial_mul_monomial, Nat.add_comm]
        · intro a b ha hb
          obtain ⟨hma, hma'⟩ := ha
          obtain ⟨hmb, hmb'⟩ := hb
          have hm : monomial (n + 1) (a + b) ∈ reesAlgebra (I.map f) := by
            simpa using add_mem hma hmb
          refine ⟨hm, ?_⟩
          convert A.add_mem hma' hmb' using 1
          apply Subtype.ext
          simp
      obtain ⟨hm, hA⟩ := hmem r (by simpa [pow_succ'] using hr)
      convert hA using 1

/-- The extended Rees ring is generated as an `S`-algebra by the image of the
original Rees ring. This is the affine algebraic input for the closed immersion
of the blow-up of `I.map f` into the base change of the blow-up of `I` in
`paper-p.tex`, proof of Theorem `thm:allcodim-normal` (first paragraph).

This theorem is about the Rees rings themselves. The scheme-level Proj map,
its closed-immersion property, and normalization remain separate obligations. -/
theorem adjoin_range_reesAlgebraMap_eq_top (f : R →+* S) (I : Ideal R) :
    Algebra.adjoin S (Set.range (reesAlgebraMap f I)) = ⊤ := by
  apply top_unique
  intro P _
  rw [reesAlgebra.as_sum_support P]
  apply Subalgebra.sum_mem
  intro n hn
  exact monomial_mem_adjoin_reesAlgebraMap f I
    ((mem_reesAlgebra_iff (I.map f) P.1).mp P.2 n)

section BaseChange

variable [Algebra R S]

/-- The Rees map is linear over the original coefficient ring when the ring
homomorphism is an algebra map. -/
noncomputable def reesAlgebraMapAlgHom (I : Ideal R) :
    reesAlgebra I →ₐ[R] reesAlgebra (I.map (algebraMap R S)) :=
  AlgHom.mk' (reesAlgebraMap (algebraMap R S) I) (by
    intro c P
    simp only [Algebra.smul_def, map_mul]
    congr 1
    apply Subtype.ext
    simp [reesAlgebraMap_val])

/-- The actual algebra map from the tensor-product base change of the Rees
ring to the Rees ring of the extended ideal. -/
noncomputable def reesAlgebraBaseChange (I : Ideal R) :
    (S ⊗[R] (reesAlgebra I)) →ₐ[S]
      reesAlgebra (I.map (algebraMap R S)) :=
  Algebra.TensorProduct.lift
    (Algebra.ofId S (reesAlgebra (I.map (algebraMap R S))))
    (reesAlgebraMapAlgHom I) (fun _ _ => Commute.all _ _)

@[simp] theorem reesAlgebraBaseChange_tmul (I : Ideal R)
    (s : S) (P : reesAlgebra I) :
    reesAlgebraBaseChange I (s ⊗ₜ[R] P) =
      (algebraMap S (reesAlgebra (I.map (algebraMap R S)))) s *
        reesAlgebraMap (algebraMap R S) I P := by
  simp [reesAlgebraBaseChange, reesAlgebraMapAlgHom]

/-- The canonical tensor-product base-change map of Rees rings is surjective.
This proves the affine ring surjection underlying the closed immersion of the
pulled-back blow-up into the finite base change of the original blow-up in
`paper-p.tex`, proof of Theorem `thm:allcodim-normal` (first paragraph). -/
theorem reesAlgebraBaseChange_surjective (I : Ideal R) :
    Function.Surjective (reesAlgebraBaseChange (R := R) (S := S) I) := by
  rw [← AlgHom.range_eq_top]
  apply top_unique
  calc
    (⊤ : Subalgebra S (reesAlgebra (I.map (algebraMap R S)))) =
        Algebra.adjoin S (Set.range (reesAlgebraMap (algebraMap R S) I)) :=
      (adjoin_range_reesAlgebraMap_eq_top (algebraMap R S) I).symm
    _ ≤ (reesAlgebraBaseChange I).range := by
      apply Algebra.adjoin_le
      rintro _ ⟨P, rfl⟩
      refine ⟨(1 : S) ⊗ₜ[R] P, ?_⟩
      simp

end BaseChange

end Pcf.Bounding.AllCodimBlowup
