module

public import Pcf.Bounding.AllCodimBlowupCharts

/-!
# Degree-one generators of the affine Rees chart

The Rees image chart from `AllCodimBlowupCharts` is exactly the familiar
ring `R[I/a]` generated by fractions `b/a`, `b ∈ I`. This makes the
base-change chart map concrete without assuming a Proj comparison.
-/

@[expose] public section

open Polynomial
open scoped TensorProduct

namespace Pcf.Bounding.AllCodimBlowup

noncomputable section

variable {R : Type*} [CommRing R]

/-- The degree-one fractions generating the affine chart `R[I/a]`. -/
def chartRatioSet (I : Ideal R) (a : I) : Set (Localization.Away a.1) :=
  {z | ∃ b : I,
    z = algebraMap R (Localization.Away a.1) b.1 *
      IsLocalization.Away.invSelf a.1}

/-- A degree-one fraction as an element of the affine Rees chart ring. -/
def chartRatio (I : Ideal R) (a b : I) : affineBlowupChart I a :=
  ⟨algebraMap R (Localization.Away a.1) b.1 *
      IsLocalization.Away.invSelf a.1,
    ratio_mem_affineBlowupChart I a b⟩

@[simp] theorem chartRatio_val (I : Ideal R) (a b : I) :
    (chartRatio I a b : Localization.Away a.1) =
      algebraMap R (Localization.Away a.1) b.1 *
        IsLocalization.Away.invSelf a.1 := rfl

/-- The image of the Rees algebra under `t ↦ a⁻¹` is exactly the
`R`-algebra generated by the fractions `b/a`, `b ∈ I`. -/
theorem affineBlowupChart_eq_adjoin_ratios (I : Ideal R) (a : I) :
    affineBlowupChart I a = Algebra.adjoin R (chartRatioSet I a) := by
  let e : R[X] →ₐ[R] Localization.Away a.1 :=
    Polynomial.aeval (IsLocalization.Away.invSelf a.1)
  have hchart : affineBlowupChart I a = (reesAlgebra I).map e := by
    exact Subalgebra.range_comp_val (reesAlgebra I) e
  rw [hchart, ← adjoin_monomial_eq_reesAlgebra I, AlgHom.map_adjoin]
  congr 1
  ext z
  constructor
  · rintro ⟨P, hP, rfl⟩
    obtain ⟨b, hb, rfl⟩ := Submodule.mem_map.mp hP
    exact ⟨⟨b, hb⟩, by simp [e, Polynomial.aeval_monomial]⟩
  · rintro ⟨b, hb⟩
    refine ⟨monomial 1 b.1, Submodule.mem_map_of_mem b.2, ?_⟩
    simpa [e, Polynomial.aeval_monomial] using hb.symm

section BaseChange

variable {S : Type*} [CommRing S] [Algebra R S]

/-- The map of affine Rees charts sends a degree-one fraction to its
coefficientwise image. -/
theorem affineBlowupChartMap_ratio (I : Ideal R) (a b : I) :
    affineBlowupChartMap (algebraMap R S) I a (chartRatio I a b) =
      chartRatio (I.map (algebraMap R S))
        (mappedCenterElement (algebraMap R S) I a)
        (mappedCenterElement (algebraMap R S) I b) := by
  apply Subtype.ext
  change Localization.awayMap (algebraMap R S) a.1
      (algebraMap R (Localization.Away a.1) b.1 *
        IsLocalization.Away.invSelf a.1) = _
  rw [map_mul, awayMap_invSelf, Localization.awayMap,
    IsLocalization.Away.map, IsLocalization.map_eq]
  rfl

/-- Every degree-one fraction of the extended center is generated by
coefficients from `S` and base-changed fractions from `R[I/a]`. -/
private theorem mapped_ratio_mem_adjoin (I : Ideal R) (a : I)
    {j : S} (hj : j ∈ I.map (algebraMap R S)) :
    chartRatio (I.map (algebraMap R S))
      (mappedCenterElement (algebraMap R S) I a) ⟨j, hj⟩ ∈
      Algebra.adjoin S
        (Set.range (affineBlowupChartMap (algebraMap R S) I a)) := by
  let A := Algebra.adjoin S
    (Set.range (affineBlowupChartMap (algebraMap R S) I a))
  change j ∈ Ideal.span ((algebraMap R S) '' (I : Set R)) at hj
  induction hj using Submodule.span_induction with
  | mem j hj =>
      obtain ⟨b, hb, rfl⟩ := hj
      have h := Algebra.subset_adjoin (R := S)
        (show affineBlowupChartMap (algebraMap R S) I a
            (chartRatio I a ⟨b, hb⟩) ∈
          Set.range (affineBlowupChartMap (algebraMap R S) I a) from
          ⟨_, rfl⟩)
      rw [affineBlowupChartMap_ratio] at h
      exact (SetLike.mem_coe.mp h)
  | zero =>
      have h : (0 : affineBlowupChart (I.map (algebraMap R S))
        (mappedCenterElement (algebraMap R S) I a)) ∈ A := A.zero_mem
      convert h using 1
      apply Subtype.ext
      simp [chartRatio]
  | add x y hx hy ihx ihy =>
      have h := A.add_mem ihx ihy
      convert h using 1
      apply Subtype.ext
      simp [chartRatio, add_mul]
  | smul c x hx ih =>
      have h := A.smul_mem ih c
      convert h using 1
      apply Subtype.ext
      simp [chartRatio, Algebra.smul_def, mul_assoc]

/-- Every element of the extended affine chart is generated over `S` by
the image of the original chart. This is the chart-level algebraic
surjectivity behind the blow-up base-change closed immersion. -/
theorem adjoin_range_affineBlowupChartMap_eq_top (I : Ideal R) (a : I) :
    Algebra.adjoin S
      (Set.range (affineBlowupChartMap (algebraMap R S) I a)) = ⊤ := by
  let J := I.map (algebraMap R S)
  let a' := mappedCenterElement (algebraMap R S) I a
  let T := affineBlowupChart J a'
  let A : Subalgebra S T := Algebra.adjoin S
    (Set.range (affineBlowupChartMap (algebraMap R S) I a))
  let e : T →ₐ[S] Localization.Away a'.1 := Subalgebra.val T
  have hle : T ≤ A.map e := by
    change affineBlowupChart J a' ≤ A.map e
    rw [affineBlowupChart_eq_adjoin_ratios]
    apply Algebra.adjoin_le
    intro z hz
    obtain ⟨b, rfl⟩ := hz
    apply (Subalgebra.mem_map).mpr
    refine ⟨chartRatio J a' b, ?_, rfl⟩
    exact mapped_ratio_mem_adjoin I a b.2
  apply top_unique
  intro y _
  have hy : (y : Localization.Away a'.1) ∈ A.map e := hle y.2
  obtain ⟨x, hx, hxy⟩ := (Subalgebra.mem_map).mp hy
  have : x = y := Subtype.ext hxy
  simpa [A, this] using hx

/-- The chart map preserves the original coefficient algebra. -/
@[simp] theorem affineBlowupChartMap_algebraMap (I : Ideal R) (a : I)
    (r : R) :
    affineBlowupChartMap (algebraMap R S) I a
      (algebraMap R (affineBlowupChart I a) r) =
      algebraMap R (affineBlowupChart (I.map (algebraMap R S))
        (mappedCenterElement (algebraMap R S) I a)) r := by
  apply Subtype.ext
  change Localization.awayMap (algebraMap R S) a.1
    (algebraMap R (Localization.Away a.1) r) =
      algebraMap R (Localization.Away
        (mappedCenterElement (algebraMap R S) I a).1) r
  rw [Localization.awayMap, IsLocalization.Away.map, IsLocalization.map_eq]
  change (algebraMap S (Localization.Away ((algebraMap R S) a.1)))
    ((algebraMap R S) r) =
      (algebraMap R (Localization.Away ((algebraMap R S) a.1))) r
  exact (IsScalarTower.algebraMap_apply R S
    (Localization.Away ((algebraMap R S) a.1)) r).symm

/-- The chart map as an algebra homomorphism over the original base. -/
def affineBlowupChartMapAlgHom (I : Ideal R) (a : I) :
    affineBlowupChart I a →ₐ[R]
      affineBlowupChart (I.map (algebraMap R S))
        (mappedCenterElement (algebraMap R S) I a) :=
  AlgHom.mk' (affineBlowupChartMap (algebraMap R S) I a) (by
    intro r x
    simp only [Algebra.smul_def, map_mul, affineBlowupChartMap_algebraMap])

/-- The tensor-product base change of the original chart maps to the
extended chart. -/
def affineBlowupChartBaseChange (I : Ideal R) (a : I) :
    (S ⊗[R] affineBlowupChart I a) →ₐ[S]
      affineBlowupChart (I.map (algebraMap R S))
        (mappedCenterElement (algebraMap R S) I a) :=
  Algebra.TensorProduct.lift
    (Algebra.ofId S _)
    (affineBlowupChartMapAlgHom (S := S) I a)
    (fun _ _ => Commute.all _ _)

/-- The canonical base-change map onto the affine blow-up chart is
surjective. Its proof uses the degree-one generation of the actual chart
ring, so the closed immersion at this chart requires no extra geometric
hypothesis. -/
theorem affineBlowupChartBaseChange_surjective (I : Ideal R) (a : I) :
    Function.Surjective (affineBlowupChartBaseChange (S := S) I a) := by
  apply (AlgHom.range_eq_top (affineBlowupChartBaseChange (S := S) I a)).mp
  apply top_unique
  rw [← adjoin_range_affineBlowupChartMap_eq_top (S := S) I a]
  apply Algebra.adjoin_le
  rintro y ⟨x, rfl⟩
  refine ⟨(1 : S) ⊗ₜ[R] x, ?_⟩
  simp [affineBlowupChartBaseChange, affineBlowupChartMapAlgHom]

end BaseChange

end

section Scheme

universe u

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]

open CategoryTheory AlgebraicGeometry

/-- The canonical morphism from the affine chart of the extended center to
the base change of the original affine chart. -/
noncomputable def affineBlowupChartBaseChangeSpec (I : Ideal A) (a : I) :
    Spec (.of (affineBlowupChart (I.map (algebraMap A B))
      (mappedCenterElement (algebraMap A B) I a))) ⟶
      Spec (.of (B ⊗[A] affineBlowupChart I a)) :=
  Spec.map (CommRingCat.ofHom
    (affineBlowupChartBaseChange (S := B) I a).toRingHom)

/-- Base change of each actual affine Rees chart is a closed immersion. -/
instance affineBlowupChartBaseChangeSpec_isClosedImmersion
    (I : Ideal A) (a : I) :
    IsClosedImmersion (affineBlowupChartBaseChangeSpec (B := B) I a) := by
  unfold affineBlowupChartBaseChangeSpec
  exact IsClosedImmersion.spec_of_surjective _
    (affineBlowupChartBaseChange_surjective (S := B) I a)

end Scheme

end Pcf.Bounding.AllCodimBlowup
