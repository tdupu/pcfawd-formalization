module

public import Pcf.Bounding.AllCodimBlowupGlobalBaseChange

/-!
# Degree-one affine cover of the Rees Proj

The blow-up charts indexed by elements of the center cover the entire
Rees Proj. This connects the explicit chartwise relative closed immersions
to the Zariski-local closed-immersion criterion.
-/

@[expose] public section

namespace Pcf.Bounding.AllCodimBlowup

open Polynomial AlgebraicGeometry

universe u

variable {R : Type u} [CommRing R]

private theorem positiveMonomial_mem_degreeOneSpan (I : Ideal R)
    (n : ℕ) (hn : 0 < n) {r : R} (hr : r ∈ I ^ n) :
    (⟨monomial n r, reesAlgebra.monomial_mem.mpr hr⟩ : reesAlgebra I) ∈
      Ideal.span (Set.range (reesDegreeOne I)) := by
  let K : Ideal (reesAlgebra I) := Ideal.span (Set.range (reesDegreeOne I))
  cases n with
  | zero => omega
  | succ m =>
      have hmem : ∀ r : R, r ∈ I * I ^ m →
          ∃ h : monomial (m + 1) r ∈ reesAlgebra I,
            (⟨monomial (m + 1) r, h⟩ : reesAlgebra I) ∈ K := by
        intro r hr
        refine Submodule.smul_induction_on hr ?_ ?_
        · intro x hx y hy
          have h1 : reesDegreeOne I ⟨x, hx⟩ ∈ K :=
            Ideal.subset_span ⟨⟨x, hx⟩, rfl⟩
          have hm : monomial (m + 1) (x * y) ∈ reesAlgebra I := by
            apply reesAlgebra.monomial_mem.mpr
            rw [pow_succ']
            exact Ideal.mul_mem_mul hx hy
          have h2 : monomial m y ∈ reesAlgebra I :=
            reesAlgebra.monomial_mem.mpr hy
          have h := Ideal.mul_mem_right
            (⟨monomial m y, h2⟩ : reesAlgebra I) K h1
          refine ⟨hm, ?_⟩
          convert h using 1
          apply Subtype.ext
          simp [reesDegreeOne, Polynomial.monomial_mul_monomial, Nat.add_comm]
        · intro x y hx hy
          obtain ⟨hmx, hmx'⟩ := hx
          obtain ⟨hmy, hmy'⟩ := hy
          have hm : monomial (m + 1) (x + y) ∈ reesAlgebra I := by
            simpa using add_mem hmx hmy
          refine ⟨hm, ?_⟩
          convert K.add_mem hmx' hmy' using 1
          apply Subtype.ext
          simp
      obtain ⟨hm, hK⟩ := hmem r (by simpa [pow_succ'] using hr)
      convert hK using 1

/-- The irrelevant ideal of the Rees grading is generated by the actual
degree-one elements `a t` for `a ∈ I`. -/
theorem reesIrrelevant_le_degreeOneSpan (I : Ideal R) :
    (HomogeneousIdeal.irrelevant (reesGrade I)).toIdeal ≤
      Ideal.span (Set.range (reesDegreeOne I)) := by
  apply (HomogeneousIdeal.toIdeal_irrelevant_le (reesGrade I)).mpr
  intro n hn P hP
  have hmono := reesGrade_eq_monomial I n P hP
  have hc : P.1.coeff n ∈ I ^ n :=
    (mem_reesAlgebra_iff I P.1).mp P.2 n
  have h := positiveMonomial_mem_degreeOneSpan I n hn hc
  have hp : P = (⟨monomial n (P.1.coeff n),
      reesAlgebra.monomial_mem.mpr hc⟩ : reesAlgebra I) :=
    Subtype.ext hmono
  rw [hp]
  exact h

/-- The standard opens `D₊(a t)` for `a ∈ I` form an affine open cover of
the actual Rees Proj. -/
noncomputable def reesProjDegreeOneCover (I : Ideal R) :
    (reesProj I).AffineOpenCover :=
  Proj.affineOpenCoverOfIrrelevantLESpan (reesGrade I)
    (fun a : I => reesDegreeOne I a)
    (fun a => reesDegreeOne_mem_grade I a)
    (fun _ => by decide)
    (reesIrrelevant_le_degreeOneSpan I)

#print axioms reesIrrelevant_le_degreeOneSpan
#print axioms reesProjDegreeOneCover

end Pcf.Bounding.AllCodimBlowup
