module

public import Pcf.Bounding.AllCodimBlowupExceptionalProjChart
public import Pcf.Bounding.AllCodimBlowupGenericStalkIso
public import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic

/-!
# Exceptional equation on the normalization of a Rees chart

On a nonempty standard chart of the Rees blow-up of a domain, the centre
ideal is generated by the chart coordinate. Passing to the integral closure
of that chart in its fraction field preserves this equation and its
non-zero-divisor property. This is the affine normalization input for the
effective Cartier divisor in `paper-p.tex`, Theorem `thm:allcodim-normal`.
-/

@[expose] public section

namespace Pcf.Bounding.AllCodimBlowup

universe u

variable {R : Type u} [CommRing R] [IsDomain R]

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

attribute [local instance] reesProjChartAlgebra

/-- The structural coefficient map on the actual Rees `Proj` chart. -/
noncomputable def reesProjChartBaseMap (I : Ideal R) (a : I) :
    R →+* reesProjChart I a :=
  @algebraMap R (reesProjChart I a) _ _ (reesProjChartAlgebra I a)

/-- The canonical inclusion of a Rees `Proj` chart into its integral closure
inside its fraction field. -/
noncomputable def normalizedReesChartInclusion
    (I : Ideal R) (a : I) (ha : (a : R) ≠ 0) :
    reesProjChart I a →+*
      ↥(integralClosure (reesProjChart I a) (FractionRing (reesProjChart I a))) := by
  letI : IsDomain (reesProjChart I a) :=
    reesProjChart_isDomain_of_nonzero I a ha
  exact @algebraMap (reesProjChart I a)
    ↥(integralClosure (reesProjChart I a) (FractionRing (reesProjChart I a)))
    _ _ (Subalgebra.algebra _)

/-- The extension of the centre ideal to the integral closure of an actual
degree-zero Rees `Proj` chart is generated by its exceptional coordinate. -/
theorem centerIdeal_normalizedReesChart_eq_span
    (I : Ideal R) (a : I) (ha : (a : R) ≠ 0) :
    letI : IsDomain (reesProjChart I a) :=
      reesProjChart_isDomain_of_nonzero I a ha
    I.map ((normalizedReesChartInclusion I a ha).comp
        (reesProjChartBaseMap I a)) =
      Ideal.span {(normalizedReesChartInclusion I a ha
          ((reesProjChartAlgEquiv I a).symm
            (algebraMap R (affineBlowupChart I a) a.1)))} := by
  letI : IsDomain (reesProjChart I a) :=
    reesProjChart_isDomain_of_nonzero I a ha
  let A : Type u := reesProjChart I a
  let c : A := (reesProjChartAlgEquiv I a).symm
    (algebraMap R (affineBlowupChart I a) a.1)
  have hchart : I.map (reesProjChartBaseMap I a) = Ideal.span {c} := by
    exact centerIdeal_map_reesProjChart_eq_span I a
  calc
    I.map ((normalizedReesChartInclusion I a ha).comp (reesProjChartBaseMap I a)) =
        (I.map (reesProjChartBaseMap I a)).map (normalizedReesChartInclusion I a ha) :=
      by rw [Ideal.map_map]
    _ = (Ideal.span {c}).map (normalizedReesChartInclusion I a ha) := by
      exact congrArg (fun J : Ideal A =>
        J.map (normalizedReesChartInclusion I a ha)) hchart
    _ = Ideal.span {normalizedReesChartInclusion I a ha c} := by
      rw [Ideal.map_span, Set.image_singleton]

/-- The exceptional equation stays nonzero on the integral closure chart,
so the extended principal centre ideal is locally Cartier. -/
theorem centerCoordinate_normalizedReesChart_mem_nonZeroDivisors
    (I : Ideal R) (a : I) (ha : (a : R) ≠ 0) :
    letI : IsDomain (reesProjChart I a) :=
      reesProjChart_isDomain_of_nonzero I a ha
    normalizedReesChartInclusion I a ha
        ((reesProjChartAlgEquiv I a).symm
          (algebraMap R (affineBlowupChart I a) a.1)) ∈
      nonZeroDivisors
        ↥(integralClosure (reesProjChart I a) (FractionRing (reesProjChart I a))) := by
  letI : IsDomain (reesProjChart I a) :=
    reesProjChart_isDomain_of_nonzero I a ha
  let A : Type u := reesProjChart I a
  let c : A := (reesProjChartAlgEquiv I a).symm
    (algebraMap R (affineBlowupChart I a) a.1)
  have hc : c ≠ 0 := by
    have hc' := centerCoordinate_reesProjChart_mem_nonZeroDivisors I a ha
    have hc'' : (reesProjChartAlgEquiv I a).symm
        (algebraMap R (affineBlowupChart I a) a.1) ≠ 0 :=
      nonZeroDivisors.ne_zero hc'
    exact hc''
  have hinj : Function.Injective (normalizedReesChartInclusion I a ha) := by
    intro x y h
    apply IsFractionRing.injective A (FractionRing A)
    have h' := congrArg Subtype.val h
    simpa only [normalizedReesChartInclusion, Subalgebra.coe_algebraMap] using h'
  apply mem_nonZeroDivisors_of_ne_zero
  intro hz
  apply hc
  apply hinj
  simpa only [map_zero] using hz

#print axioms normalizedReesChartInclusion
#print axioms reesProjChartBaseMap
#print axioms centerIdeal_normalizedReesChart_eq_span
#print axioms centerCoordinate_normalizedReesChart_mem_nonZeroDivisors

end Pcf.Bounding.AllCodimBlowup
