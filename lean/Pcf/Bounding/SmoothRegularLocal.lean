module

public import Pcf.Bounding.FiniteTypeRegularLocus
public import Pcf.Stacks.Common.EtaleRegular
public import Mathlib.RingTheory.Unramified.LocalStructure
public import Mathlib.RingTheory.Unramified.LocalRing
public import Mathlib.AlgebraicGeometry.Morphisms.Smooth

/-!
# Smooth points have regular local rings

The algebraic argument passes through an étale neighborhood over a polynomial
ring. For a flat unramified local map the maximal ideal of the target is
generated by the maximal ideal of the source, and going down gives the required
dimension inequality.
-/

@[expose] public section

universe u v

open IsLocalRing AlgebraicGeometry CategoryTheory

namespace Pcf

/-- A smooth point of a finitely presented algebra over a regular ring has a
regular local ring. No perfectness or characteristic assumption is needed. -/
theorem isRegularLocalRing_of_isSmoothAt
    (R : Type u) (S : Type v) [CommRing R] [CommRing S]
    [IsRegularRing R] [Algebra R S] [Algebra.FinitePresentation R S]
    (p : Ideal S) [p.IsPrime] [Algebra.IsSmoothAt R p] :
    IsRegularLocalRing (Localization.AtPrime p) := by
  obtain ⟨f, hfp, n, _, _, _⟩ :=
    Algebra.IsSmoothAt.exists_isStandardEtale_mvPolynomial (R := R) (p := p)
  have : IsRegularRing (Localization.Away f) :=
    Pcf.Stacks.isRegularRing_of_etale (MvPolynomial (Fin n) R) (Localization.Away f)
  let q := p.map (algebraMap S (Localization.Away f))
  have : q.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (.powers f) _ _ inferInstance
      ((Ideal.disjoint_powers_iff_notMem_of_isPrime _).mpr hfp)
  have hq : q.comap (algebraMap S (Localization.Away f)) = p :=
    IsLocalization.under_map_of_isPrime_disjoint (.powers f) _ inferInstance
      ((Ideal.disjoint_powers_iff_notMem_of_isPrime _).mpr hfp)
  have hreg := (isRegularLocalRing_localizationAtPrime_iff (.powers f) (Localization.Away f) q).mp
    inferInstance
  have transfer (q' : Ideal S) [q'.IsPrime] (h : q' = p)
      (hr : IsRegularLocalRing (Localization.AtPrime q')) :
      IsRegularLocalRing (Localization.AtPrime p) := by
    subst q'
    exact hr
  exact transfer _ hq hreg

#print axioms isRegularLocalRing_of_isSmoothAt

/-- A smooth algebra over a regular ring is regular. -/
theorem isRegularRing_of_smooth
    (R : Type u) (S : Type v) [CommRing R] [CommRing S]
    [IsRegularRing R] [Algebra R S] [Algebra.Smooth R S] : IsRegularRing S := by
  let : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing R S
  exact isRegularRing_iff.mpr fun p _ ↦ isRegularLocalRing_of_isSmoothAt R S p

#print axioms isRegularRing_of_smooth

/-- On a scheme locally of finite presentation over a regular affine base,
every smooth point has a regular local ring. -/
theorem isRegularLocalRing_stalk_of_mem_smoothLocus
    {X : Scheme.{u}} (R : CommRingCat.{u}) [IsRegularRing R]
    (f : X ⟶ Spec R) [LocallyOfFinitePresentation f]
    (x : X) (hx : x ∈ f.smoothLocus) : IsRegularLocalRing (X.presheaf.stalk x) := by
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  have hVU : V ≤ f ⁻¹ᵁ ⊤ := by simp
  let := (f.appLE ⊤ V hVU).hom.toAlgebra
  have : IsRegularRing Γ(Spec R, ⊤) :=
    IsRegularRing.of_ringEquiv (Scheme.ΓSpecIso R).symm.commRingCatIsoToRingEquiv
  have : Algebra.FinitePresentation Γ(Spec R, ⊤) Γ(X, V) := by
    exact f.finitePresentation_appLE (isAffineOpen_top _) hV hVU
  have : Algebra.IsSmoothAt Γ(Spec R, ⊤) (hV.primeIdealOf ⟨x, hxV⟩).asIdeal :=
    (formallySmooth_stalkMap_iff ⊤ (isAffineOpen_top _) V hV hVU hxV).mp hx
  have : IsRegularLocalRing (Localization.AtPrime (hV.primeIdealOf ⟨x, hxV⟩).asIdeal) :=
    isRegularLocalRing_of_isSmoothAt Γ(Spec R, ⊤) Γ(X, V) _
  let : Algebra Γ(X, V) (X.presheaf.stalk x) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxV⟩
  have : IsLocalization.AtPrime (X.presheaf.stalk x)
      (hV.primeIdealOf ⟨x, hxV⟩).asIdeal := hV.isLocalization_stalk ⟨x, hxV⟩
  exact IsRegularLocalRing.of_ringEquiv
    (IsLocalization.algEquiv (hV.primeIdealOf ⟨x, hxV⟩).asIdeal.primeCompl
      (Localization.AtPrime (hV.primeIdealOf ⟨x, hxV⟩).asIdeal)
      (X.presheaf.stalk x)).toRingEquiv

#print axioms isRegularLocalRing_stalk_of_mem_smoothLocus

/-- The actual stalk singular locus lies in the closed nonsmooth locus over a
regular affine base. This is only an inclusion, not an equality of loci. -/
theorem stalkSingularLocus_subset_compl_smoothLocus
    {X : Scheme.{u}} (R : CommRingCat.{u}) [IsRegularRing R]
    (f : X ⟶ Spec R) [LocallyOfFinitePresentation f] :
    stalkSingularLocus X ⊆ (f.smoothLocus : Set X)ᶜ := by
  intro x hx hs
  exact hx (isRegularLocalRing_stalk_of_mem_smoothLocus R f x hs)

#print axioms stalkSingularLocus_subset_compl_smoothLocus

end Pcf
