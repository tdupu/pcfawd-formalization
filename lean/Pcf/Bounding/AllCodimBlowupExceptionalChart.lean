module

public import Pcf.Bounding.AllCodimBlowupChartGeneration

/-!
# The exceptional centre is principal on each Rees chart

On the chart `R[I/a]`, every `b ∈ I` is `a · (b/a)`. Thus the
pullback of the centre ideal is generated by the chart coordinate `a`.
This is the local algebraic input for the exceptional Cartier divisor
in `latex/paper-p.tex`, proof of `thm:allcodim-normal`.
-/

@[expose] public section

namespace Pcf.Bounding.AllCodimBlowup

universe u

variable {R : Type u} [CommRing R]

set_option linter.style.haveILetI false

/-- Every generator of the centre ideal becomes divisible by the chart
coordinate on `R[I/a]`. -/
theorem algebraMap_eq_center_mul_ratio (I : Ideal R) (a b : I) :
    algebraMap R (affineBlowupChart I a) b.1 =
      algebraMap R (affineBlowupChart I a) a.1 * chartRatio I a b := by
  apply Subtype.ext
  change algebraMap R (Localization.Away a.1) b.1 =
    algebraMap R (Localization.Away a.1) a.1 *
      (algebraMap R (Localization.Away a.1) b.1 *
        IsLocalization.Away.invSelf a.1)
  rw [mul_left_comm, IsLocalization.Away.mul_invSelf]
  simp

/-- The actual extended centre ideal on an affine Rees chart is the
principal ideal generated by its distinguished chart coordinate. -/
theorem centerIdeal_map_affineBlowupChart_eq_span (I : Ideal R) (a : I) :
    I.map (algebraMap R (affineBlowupChart I a)) =
      Ideal.span {algebraMap R (affineBlowupChart I a) a.1} := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro b hb
    have hdiv := algebraMap_eq_center_mul_ratio I a ⟨b, hb⟩
    change algebraMap R (affineBlowupChart I a) b ∈
      Ideal.span {algebraMap R (affineBlowupChart I a) a.1}
    rw [hdiv]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton.mpr ⟨1, by simp⟩)
  · apply Ideal.span_le.mpr
    intro b hb
    have hb' : b = algebraMap R (affineBlowupChart I a) a.1 := by
      simpa using hb
    rw [hb']
    exact Ideal.mem_map_of_mem _ a.2

/-- On a domain chart with `a ≠ 0`, the local equation of the exceptional
centre is a nonzero element. Hence it is a non-zero-divisor in this domain
chart, the local Cartier condition. -/
theorem centerCoordinate_ne_zero (I : Ideal R) (a : I)
    [IsDomain R] (ha : a.1 ≠ 0) :
    algebraMap R (affineBlowupChart I a) a.1 ≠ 0 := by
  intro hzero
  have hinj : Function.Injective (algebraMap R (Localization.Away a.1)) :=
    IsLocalization.injective (Localization.Away a.1)
      (powers_le_nonZeroDivisors_of_noZeroDivisors ha)
  apply ha
  apply hinj
  simpa using congrArg Subtype.val hzero

/-- A nonempty standard Rees chart of an integral affine base is integral.
Together with the previous two lemmas, its pulled-back centre is locally
generated by a non-zero-divisor. -/
theorem affineBlowupChart_isDomain (I : Ideal R) (a : I)
    [IsDomain R] (ha : a.1 ≠ 0) :
    IsDomain (affineBlowupChart I a) := by
  letI : IsDomain (Localization.Away a.1) := Localization.Away.isDomain ha
  infer_instance

/-- The local equation is a non-zero-divisor, as required for the
exceptional effective Cartier divisor. -/
theorem centerCoordinate_mem_nonZeroDivisors (I : Ideal R) (a : I)
    [IsDomain R] (ha : a.1 ≠ 0) :
    algebraMap R (affineBlowupChart I a) a.1 ∈
      nonZeroDivisors (affineBlowupChart I a) := by
  letI : IsDomain (affineBlowupChart I a) := affineBlowupChart_isDomain I a ha
  exact (mem_nonZeroDivisors_iff_ne_zero).mpr (centerCoordinate_ne_zero I a ha)

/-- The extended center is a principal ideal on the chosen blow-up chart. -/
theorem centerIdeal_map_affineBlowupChart_isPrincipal (I : Ideal R) (a : I) :
    (I.map (algebraMap R (affineBlowupChart I a))).IsPrincipal := by
  rw [centerIdeal_map_affineBlowupChart_eq_span]
  infer_instance

/-- The inverse image of the centre on the affine chart has precisely
the support cut out by its single exceptional coordinate. -/
theorem centerZeroLocus_affineBlowupChart (I : Ideal R) (a : I) :
    PrimeSpectrum.zeroLocus
        (I.map (algebraMap R (affineBlowupChart I a)) :
          Set (affineBlowupChart I a)) =
      PrimeSpectrum.zeroLocus
        ({algebraMap R (affineBlowupChart I a) a.1} :
          Set (affineBlowupChart I a)) := by
  rw [centerIdeal_map_affineBlowupChart_eq_span,
    PrimeSpectrum.zeroLocus_span]

/-- Outside the exceptional coordinate's vanishing locus, the pulled-back
centre ideal is the unit ideal. -/
theorem centerZeroLocus_eq_basicOpen_compl (I : Ideal R) (a : I) :
    PrimeSpectrum.zeroLocus
        (I.map (algebraMap R (affineBlowupChart I a)) :
          Set (affineBlowupChart I a)) =
      (PrimeSpectrum.basicOpen
        (algebraMap R (affineBlowupChart I a) a.1) :
          Set (PrimeSpectrum (affineBlowupChart I a)))ᶜ := by
  rw [centerZeroLocus_affineBlowupChart,
    PrimeSpectrum.basicOpen_eq_zeroLocus_compl, compl_compl]

/-- A finitely generated centre gives a finite-type affine blow-up chart.
For a Noetherian affine variety the finite generation follows automatically;
this is the local finite-type input for normalizing the blow-up. -/
theorem affineBlowupChart_finiteType (I : Ideal R) (a : I)
    (hI : I.FG) : Algebra.FiniteType R (affineBlowupChart I a) := by
  letI : Algebra.FiniteType R (reesAlgebra I) :=
    ⟨(reesAlgebra I).fg_top.mpr (reesAlgebra.fg hI)⟩
  exact Algebra.FiniteType.of_surjective (reesChartEval I a).rangeRestrict
    ((reesChartEval I a).rangeRestrict_surjective)

/-- Every standard chart of the blow-up of a Noetherian affine base is
Noetherian. -/
theorem affineBlowupChart_noetherian (I : Ideal R) (a : I)
    [IsNoetherianRing R] : IsNoetherianRing (affineBlowupChart I a) := by
  letI : Algebra.FiniteType R (affineBlowupChart I a) :=
    affineBlowupChart_finiteType I a (IsNoetherian.noetherian I)
  exact Algebra.FiniteType.isNoetherianRing R _

#print axioms algebraMap_eq_center_mul_ratio
#print axioms centerIdeal_map_affineBlowupChart_eq_span
#print axioms centerCoordinate_ne_zero
#print axioms affineBlowupChart_isDomain
#print axioms centerCoordinate_mem_nonZeroDivisors
#print axioms centerIdeal_map_affineBlowupChart_isPrincipal
#print axioms centerZeroLocus_affineBlowupChart
#print axioms centerZeroLocus_eq_basicOpen_compl
#print axioms affineBlowupChart_finiteType
#print axioms affineBlowupChart_noetherian

end Pcf.Bounding.AllCodimBlowup
